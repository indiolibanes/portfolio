---
import HsinStageLayout from '../../layouts/HsinStageLayout.astro';
import HsinSoundtrack from '../../components/HsinSoundtrack.astro';
import '../../styles/hsin-stage.css';
const posterVersion='2.0.1';
const posterCache='lunar-terrace-r2';
---
<HsinStageLayout>
  <main class="hsin-stage" data-hsin-stage data-state="waiting" aria-label="Hsin · palco ao luar">
    <div class="hsin-stage__poster" aria-hidden="true">
      <picture>
        <source media="(min-aspect-ratio: 1/1)" srcset={`/assets/characters/hsin/models/hsin-v${posterVersion}-poster-landscape.webp?v=${posterCache}`} width="1280" height="720" />
        <img src={`/assets/characters/hsin/models/hsin-v${posterVersion}-poster.webp?v=${posterCache}`} width="786" height="1704" alt="" fetchpriority="high" decoding="async" />
      </picture>
    </div>
    <div class="hsin-stage__canvas" data-stage-canvas role="img" aria-label="Hsin no centro de um terraço sobre um lago noturno, sob a lua cheia. Arraste para girar; use a roda do mouse ou dois dedos para aproximar." tabindex="0"></div>
    <header class="hsin-stage__header">
      <h1>Hsin <span>The Moon Fox · V2.0.1</span></h1>
      <a href="/#musica" aria-label="Voltar à seção Música">↗</a>
    </header>
    <div class="hsin-stage__status" data-stage-status role="status" aria-live="polite">Preparando Hsin…</div>
    <div class="hsin-stage__error" data-stage-error hidden>
      <p>A cena não abriu neste navegador.</p>
      <button type="button" data-stage-retry>Tentar novamente</button>
    </div>
    <nav class="hsin-stage__tools" aria-label="Controles da cena">
      <button type="button" data-stage-out aria-label="Afastar" title="Afastar" disabled>−</button>
      <button type="button" data-stage-in aria-label="Aproximar" title="Aproximar" disabled>＋</button>
      <button type="button" data-stage-reset aria-label="Restaurar enquadramento" title="Restaurar enquadramento" disabled>⌂</button>
      <button type="button" data-stage-pause aria-label="Pausar atuação" title="Pausar atuação" aria-pressed="false" disabled>Ⅱ</button>
    </nav>
    <details class="hsin-stage__credits">
      <summary>Créditos</summary>
      <p>Personagem e recursos: Kuro Games. Adaptação: Lvoxx. Re-rig: imblue__. Shaders do asset: LSCherry.</p>
      <p>Estudo de apresentação e atuação. O cenário usa uma aproximação dos materiais, sem reproduzir os shaders do jogo.</p>
      <p>Terraço lunar: pedra, balustrada, vila iluminada, lanternas e flores. Lua dourada e céu procedurais.</p>
    </details>
    <HsinSoundtrack />
    <noscript><p class="hsin-stage__noscript">Ative JavaScript para explorar a cena.</p></noscript>
  </main>
</HsinStageLayout>
<script>
  import {mountHsinStage} from '../../scripts/hsin-stage';
  const root=document.querySelector<HTMLElement>('[data-hsin-stage]');
  if(root)mountHsinStage(root);
</script>
