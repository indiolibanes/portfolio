---
import ExperimentalMenu from '../../components/ExperimentalMenu.astro';
import '../../styles/experimental.css';

const astronautAssetUrl = '/api/sophia/rocket';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content="Sophia em uma experiência tridimensional imersiva." />
    <title>Sophia · Modo Imersivo</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="immersive" data-sophia-immersive data-astronaut-url={astronautAssetUrl}>
      <div class="immersive__stage" data-stage role="img" tabindex="-1" inert aria-label="Sophia astronauta e foguete em três dimensões. Depois da decolagem, arraste para girar e use a roda ou pinça para aproximar."></div>
      <section class="immersive__intro" data-intro aria-label="Início da jornada da Sophia">
        <div class="immersive__intro-frame" aria-hidden="true"><span>PROJECT SOPHIA</span><span>CELESTIAL FLIGHT · 01</span></div>
        <button class="immersive__start" type="button" data-intro-start aria-label="Iniciar a jornada: Sophia vai ao encontro do foguete">
          <span class="immersive__start-preface">PRESS ANY KEY TO</span>
          <span class="immersive__start-main" aria-hidden="true">START<span class="immersive__start-cursor">_</span></span>
          <span class="immersive__start-touch">OU TOQUE PARA COMEÇAR</span>
        </button>
        <div class="immersive__intro-footer" aria-hidden="true"><span>EST. 2026</span><span>AN INTERACTIVE JOURNEY</span></div>
      </section>
      <div class="immersive__launch-hud" data-launch-hud hidden aria-live="polite" aria-atomic="true">
        <span class="immersive__launch-label" data-countdown-label>PREPARANDO LANÇAMENTO</span>
        <strong class="immersive__countdown" data-countdown></strong>
      </div>
      <div class="immersive__playback" data-playback hidden>
        <button type="button" data-pause aria-pressed="false">Pausar</button>
        <button type="button" data-replay>Repetir lançamento</button>
      </div>
      <ExperimentalMenu />
      <a class="immersive__back" href="/sophia/" aria-label="Voltar à página da Sophia">← Voltar</a>
      <p class="immersive__status" data-status role="status" aria-live="polite">Carregando Sophia…</p>
      <button class="immersive__retry" type="button" data-retry hidden>Tentar novamente</button>
      <noscript><p class="immersive__nojs">Ative JavaScript para visualizar Sophia em 3D.</p></noscript>
    </main>
  </body>
</html>

<style>
  :global(html) { background: #000; color-scheme: dark; }
  :global(body) { margin: 0; min-height: 100svh; overflow: hidden; background: #000; font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  :global(*), :global(*::before), :global(*::after) { box-sizing: border-box; }
  .immersive { position: relative; isolation: isolate; width: 100%; min-height: 100vh; min-height: 100svh; background: #000; color: #e8e8e8; }
  .immersive__stage { position: absolute; inset: 0; background: #000; touch-action: none; outline: none; }
  .immersive__stage[inert] { pointer-events: none; }
  .immersive__stage:focus-visible { outline: 1px solid #8a9bc4; outline-offset: -5px; }
  .immersive__stage :global(canvas) { display: block; width: 100%; height: 100%; }
  .immersive__back, .immersive__retry { position: absolute; z-index: 65; padding: 10px 13px; border: 1px solid #ffffff30; border-radius: 999px; color: #e1e3e9; background: #101014a8; backdrop-filter: blur(8px); font-size: 12px; line-height: 1; text-decoration: none; transition: background 160ms ease; }
  .immersive__back { top: max(19px, env(safe-area-inset-top)); left: max(19px, env(safe-area-inset-left)); }
  .immersive__retry { right: max(19px, env(safe-area-inset-right)); bottom: max(19px, env(safe-area-inset-bottom)); cursor: pointer; }
  .immersive__back:hover, .immersive__retry:hover { background: #303038; }
  .immersive__back:focus-visible, .immersive__retry:focus-visible { outline: 2px solid #aabadd; outline-offset: 3px; }
  .immersive__retry[hidden] { display: none; }
  .immersive__status, .immersive__nojs { position: absolute; z-index: 24; top: 74%; left: 50%; transform: translate(-50%, -50%); margin: 0; color: #bdc5d2; font-size: 13px; text-align: center; max-width: min(80vw, 520px); line-height: 1.6; pointer-events: none; }
  .immersive__status[hidden] { display: none; }
  @font-face { font-family: "Sophia Roguepunk"; src: url("../../../assets/fonts/Roguepunk.ttf") format("truetype"); font-style: normal; font-weight: 400; font-display: swap; }
  :global(html), :global(body) { background: #000 !important; background-image: none !important; overflow: hidden; color-scheme: dark; }
  :global(.xm-header) { position: absolute; inset: 0 0 auto; z-index: 70; }
  :global(.xm-drawer) { z-index: 75; }
  .immersive__intro { position: absolute; inset: 0; z-index: 12; display: grid; place-items: center; overflow: hidden; background: #000; transition: opacity 780ms ease, visibility 780ms ease; }
  .immersive__intro::before { content: ""; position: absolute; inset: 0; pointer-events: none; opacity: 0.33; background: repeating-linear-gradient(to bottom, transparent 0 5px, rgba(125,165,205,0.052) 6px); }
  .immersive__intro::after { content: ""; position: absolute; top: 50%; left: 50%; width: min(88vw, 980px); height: 1px; background: linear-gradient(90deg, transparent, rgba(78,207,240,.22), transparent); transform: translate(-50%, 92px); pointer-events: none; }
  .immersive__intro.is-started { opacity: 0; visibility: hidden; pointer-events: none; }
  .immersive__intro-frame, .immersive__intro-footer { position: absolute; right: clamp(24px, 5vw, 74px); left: clamp(24px, 5vw, 74px); display: flex; justify-content: space-between; gap: 18px; color: #9da8b7; font: 600 10px/1.3 ui-monospace, Consolas, monospace; letter-spacing: .25em; }
  .immersive__intro-frame { top: max(45px, env(safe-area-inset-top)); padding-top: 10px; border-top: 1px solid #8792a23c; }
  .immersive__intro-footer { bottom: max(38px, env(safe-area-inset-bottom)); padding-bottom: 10px; border-bottom: 1px solid #8792a23c; }
  .immersive__start { position: relative; display: grid; gap: 5px; justify-items: center; width: min(88vw, 820px); padding: 25px 10px; border: 0; background: transparent; color: #f0ecdf; cursor: pointer; text-align: center; -webkit-tap-highlight-color: transparent; }
  .immersive__start-preface { font: 500 clamp(13px, 2vw, 22px)/1.4 "Sophia Roguepunk", Impact, sans-serif; letter-spacing: .31em; text-shadow: 0 0 22px #5ce0ff38; }
  .immersive__start-main { color: #f8ed37; font: 400 clamp(66px, 14vw, 158px)/.95 "Sophia Roguepunk", Impact, sans-serif; letter-spacing: -.025em; transform: skewX(-6deg); text-shadow: 3px 3px #111, -2px 0 #19d7e2; transition: text-shadow 180ms ease, transform 180ms ease; }
  .immersive__start:hover .immersive__start-main { text-shadow: 4px 4px #f73e8f, -3px -2px #19d7e2, 0 0 42px #f8ed3755; transform: skewX(-8deg) scale(1.025); }
  .immersive__start-cursor { color: #10d9eb; animation: sophia-cursor 1.12s steps(1, end) infinite; }
  .immersive__start-touch { margin-top: 32px; color: #8a98a5; font: 600 10px/1.4 ui-monospace, Consolas, monospace; letter-spacing: .28em; }
  .immersive__start:focus-visible { outline: 2px solid #f8ed37; outline-offset: 5px; }
  @keyframes sophia-cursor { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
  @media (max-width: 650px) { .immersive__intro-frame, .immersive__intro-footer { font-size: 8px; letter-spacing: .13em; } .immersive__intro-frame { top: 115px; } .immersive__start-preface { letter-spacing: .17em; } .immersive__start-touch { letter-spacing: .1em; } .immersive__status { top: 79%; font-size: 11px; } }
  @media (prefers-reduced-motion: reduce) { .immersive__back, .immersive__retry, .immersive__intro, .immersive__start-main { transition: none; } .immersive__start-cursor { animation: none; } }
  .immersive__launch-hud { position: absolute; z-index: 20; left: clamp(24px, 5vw, 74px); bottom: max(95px, 12vh); display: grid; gap: 10px; pointer-events: none; }
  .immersive__launch-hud[hidden], .immersive__playback[hidden] { display: none; }
  .immersive__launch-label { color: #96aaeb; font: 600 10px/1.5 ui-monospace, monospace; letter-spacing: .18em; }
  .immersive__countdown { min-height: 1em; color: #ebb047; font: 400 clamp(52px, 7vw, 90px)/1 "Sophia Roguepunk", sans-serif; text-shadow: 0 0 22px #ebb04720; }
  .immersive__playback { position: absolute; z-index: 30; left: max(20px, env(safe-area-inset-left)); bottom: max(20px, env(safe-area-inset-bottom)); display: flex; gap: 8px; }
  .immersive__playback button { border: 1px solid #ffffff25; border-radius: 99px; padding: 10px 13px; background: #101014a8; color: #e1e3e9; cursor: pointer; font: 500 11px/1 system-ui, sans-serif; }
  .immersive__playback button:focus-visible { outline: 2px solid #ebb047; outline-offset: 3px; }
  @media(max-width: 650px) { .immersive__launch-hud { bottom: max(88px, 11vh); } .immersive__launch-label { max-width: 150px; font-size: 8px; } .immersive__countdown { font-size: 48px; } }
</style>

<script>
  import * as THREE from 'three';
  import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
  import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
  import { createLaunchDirector } from '../../scripts/sophia-launch-director';
  import { ActiveSceneClock, getLaunchStateAt } from '../../scripts/sophia-launch-timeline.mjs';

  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const page = document.querySelector<HTMLElement>('[data-sophia-immersive]');
  const status = document.querySelector<HTMLElement>('[data-status]');
  const retryButton = document.querySelector<HTMLButtonElement>('[data-retry]');
  const intro = document.querySelector<HTMLElement>('[data-intro]');
  const introStart = document.querySelector<HTMLButtonElement>('[data-intro-start]');
  const hud = document.querySelector<HTMLElement>('[data-launch-hud]');
  const count = document.querySelector<HTMLElement>('[data-countdown]');
  const countLabel = document.querySelector<HTMLElement>('[data-countdown-label]');
  const playback = document.querySelector<HTMLElement>('[data-playback]');
  const pauseButton = document.querySelector<HTMLButtonElement>('[data-pause]');
  const replayButton = document.querySelector<HTMLButtonElement>('[data-replay]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const preferredUrl = page?.dataset.astronautUrl || '/api/sophia/rocket';

  if (stage && page && status && retryButton && intro && introStart && hud && count && countLabel && playback && pauseButton && replayButton) {
    const setStatus = (message: string) => { status.hidden = !message; status.textContent = message; };
    try {
      const scene = new THREE.Scene(); scene.background = new THREE.Color(0x000000);
      const camera = new THREE.PerspectiveCamera(38, 1, .005, 1000);
      const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false, powerPreference: 'high-performance' });
      renderer.setClearColor(0x000000, 1); renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.65));
      renderer.outputColorSpace = THREE.SRGBColorSpace; renderer.toneMapping = THREE.ACESFilmicToneMapping; renderer.toneMappingExposure = 1.1;
      stage.appendChild(renderer.domElement);
      scene.add(new THREE.AmbientLight(0xffffff, 1.15));
      const key = new THREE.DirectionalLight(0xf6ecd6, 2.6); key.position.set(-3, 5, 6); scene.add(key);
      const fill = new THREE.DirectionalLight(0x96aaeb, 1.2); fill.position.set(5, 2, -4); scene.add(fill);
      const rim = new THREE.DirectionalLight(0xffffff, 1.3); rim.position.set(1, 4, -5); scene.add(rim);
      const controls = new OrbitControls(camera, renderer.domElement);
      controls.enableDamping = !reduceMotion.matches; controls.dampingFactor = .07;
      controls.enablePan = false; controls.enableRotate = controls.enableZoom = false;
      controls.minPolarAngle = .13; controls.maxPolarAngle = Math.PI - .13; controls.rotateSpeed = .65; controls.zoomSpeed = .75;
      const loader = new GLTFLoader(), clock = new ActiveSceneClock();
      let director: ReturnType<typeof createLaunchDirector> | null = null;
      let phase: 'intro' | 'waiting' | 'launch' = 'intro';
      let loading = false, contextLost = false, loadIndex = 0, userPaused = false;
      let lastHud = '';
      const bindings = new AbortController();
      function resize() {
        renderer.setSize(Math.max(1, stage!.clientWidth), Math.max(1, stage!.clientHeight), false);
        camera.aspect = stage!.clientWidth / Math.max(1, stage!.clientHeight); camera.updateProjectionMatrix(); director?.resize();
      }
      const observer = new ResizeObserver(resize); observer.observe(stage);
      function beginLaunch() {
        if (!director || phase !== 'waiting') return;
        phase = 'launch'; intro!.classList.add('is-started'); stage!.inert = false; stage!.tabIndex = 0;
        director.reset(); clock.start(performance.now()); playback!.hidden = false;
        setStatus(director.supported ? '' : 'A hierarquia deste modelo difere da referência. Exibindo o voo original.');
      }
      function requestStart() { if (phase !== 'intro') return; phase = 'waiting'; if (director) beginLaunch(); else setStatus('Preparando a plataforma de lançamento…'); }
      function updateHud(t: number) {
        const s = getLaunchStateAt(t);
        hud!.hidden = !director?.supported || s.countdown === null;
        page!.dataset.launchPhase = s.phase;
        const next = String(s.countdown);
        if (next === lastHud) return; lastHud = next;
        count!.textContent = s.countdown === null ? '' : s.countdown === 0 ? '0' : String(s.countdown);
        countLabel!.textContent = s.countdown === 0 ? 'DECOLAGEM' : 'IGNIÇÃO · CONTAGEM REGRESSIVA';
      }
      async function loadAstronaut() {
        if (loading) return; loading = true; const current = ++loadIndex;
        retryButton!.hidden = true; setStatus('Carregando Sophia astronauta e foguete…');
        let modelReachable = false;
        try {
          const response = await fetch(preferredUrl, { method: 'HEAD', cache: 'no-store', credentials: 'omit', redirect: 'manual' });
          if (!response.ok) {
            if (response.status === 404) setStatus('O arquivo da Sophia astronauta não foi encontrado no armazenamento R2.');
            else if (response.status === 503) setStatus('O armazenamento R2 da Sophia não está disponível neste ambiente.');
            else if (response.status === 0 || (response.status >= 300 && response.status < 400) || response.status === 401 || response.status === 403) setStatus('O acesso público ao modelo foi bloqueado. Verifique o Cloudflare Access.');
            else setStatus('Falha ao consultar o modelo da Sophia (HTTP ' + response.status + ').');
            retryButton!.hidden = false; return;
          }
          const mime = response.headers.get('content-type') || '';
          if (!mime.toLowerCase().includes('model/gltf-binary')) { setStatus('O servidor não retornou um arquivo GLB válido.'); retryButton!.hidden = false; return; }
          modelReachable = true;
          const gltf = await loader.loadAsync(preferredUrl); // One GET, no second preflight download.
          if (current !== loadIndex) return;
          director?.dispose(); director = createLaunchDirector(gltf, scene, camera, controls, () => reduceMotion.matches);
          gltf.scene.visible = false; resize(); setStatus('');
          if (phase === 'waiting') beginLaunch();
          if (import.meta.env.DEV) {
            (window as unknown as Record<string, unknown>).__SOPHIA_LAUNCH_QA__ = {
              seek(t: number) { if (phase === 'intro') requestStart(); clock.seconds = Math.max(0, t); clock.anchor = performance.now(); clock.pause('qa', performance.now()); director!.apply(t); updateHud(t); renderer.render(scene, camera); },
              resume() { clock.resume('qa', performance.now()); },
              snapshot() { return { ...director!.snapshot(), render: { calls: renderer.info.render.calls, triangles: renderer.info.render.triangles }, countdown: count!.textContent, viewport: [stage!.clientWidth, stage!.clientHeight] }; },
            };
          }
        } catch (error) { console.error('Sophia: falha na cena de lançamento.', error); setStatus(modelReachable ? 'O GLB está acessível, mas a cena não pôde ser preparada. Tente novamente.' : 'Não foi possível conectar ao carregador público da Sophia.'); retryButton!.hidden = false; }
        finally { loading = false; }
      }
      introStart.addEventListener('click', requestStart, { signal: bindings.signal });
      window.addEventListener('keydown', event => {
        if (phase !== 'intro' || event.repeat || event.isComposing || event.ctrlKey || event.metaKey || event.altKey || event.key === 'Escape' || event.key === 'Tab') return;
        if (event.target instanceof Element && event.target.closest('a, button, input, select, textarea, [role="menu"], [data-xm]')) return;
        event.preventDefault(); requestStart();
      }, { signal: bindings.signal });
      retryButton.addEventListener('click', () => { void loadAstronaut(); }, { signal: bindings.signal });
      pauseButton.addEventListener('click', () => {
        userPaused = !userPaused;
        if (userPaused) clock.pause('user', performance.now()); else clock.resume('user', performance.now());
        pauseButton.textContent = userPaused ? 'Continuar' : 'Pausar'; pauseButton.setAttribute('aria-pressed', String(userPaused));
      }, { signal: bindings.signal });
      replayButton.addEventListener('click', () => {
        if (!director) return; director.reset(); clock.resume('user', performance.now()); clock.resume('qa', performance.now()); clock.start(performance.now()); userPaused = false;
        pauseButton.textContent = 'Pausar'; pauseButton.setAttribute('aria-pressed', 'false'); lastHud = ''; setStatus('');
      }, { signal: bindings.signal });
      document.addEventListener('visibilitychange', () => { if (document.hidden) clock.pause('hidden', performance.now()); else clock.resume('hidden', performance.now()); }, { signal: bindings.signal });
      renderer.domElement.addEventListener('webglcontextlost', event => { event.preventDefault(); contextLost = true; clock.pause('context', performance.now()); setStatus('A cena foi pausada enquanto o navegador recupera o contexto 3D.'); }, { signal: bindings.signal });
      renderer.domElement.addEventListener('webglcontextrestored', () => { contextLost = false; clock.resume('context', performance.now()); setStatus(''); }, { signal: bindings.signal });
      renderer.setAnimationLoop(() => {
        if (document.hidden || contextLost) return;
        if (phase === 'launch' && director) { const t = clock.read(performance.now()); director.apply(t); updateHud(t); }
        controls.update(); renderer.render(scene, camera);
      });
      window.addEventListener('pagehide', () => { renderer.setAnimationLoop(null); observer.disconnect(); bindings.abort(); director?.dispose(); controls.dispose(); renderer.dispose(); }, { once: true });
      resize(); void loadAstronaut();
    } catch (error) {
      console.error('Sophia: WebGL indisponível.', error);
      setStatus('Este navegador não conseguiu iniciar a cena 3D.');
      introStart.disabled = true; retryButton.hidden = false;
      retryButton.addEventListener('click', () => window.location.reload(), { once: true });
    }
  }
</script>
