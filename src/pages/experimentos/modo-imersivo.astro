---
import ExperimentalMenu from '../../components/ExperimentalMenu.astro';
import '../../styles/experimental.css';

const astronautAssetUrl = '/api/sophia/rocket';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content="Sophia em uma experiência tridimensional imersiva." />
    <title>Sophia · Modo Imersivo</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="immersive" data-sophia-immersive data-astronaut-url={astronautAssetUrl}>
      <div class="immersive__stage" data-stage role="img" tabindex="-1" inert aria-label="Sophia astronauta e foguete em três dimensões. Depois da decolagem, arraste para girar e use a roda ou pinça para aproximar."></div>
      <section class="immersive__intro" data-intro aria-label="Início da jornada da Sophia">
        <div class="immersive__intro-frame" aria-hidden="true"><span>PROJECT SOPHIA</span><span>CELESTIAL FLIGHT · 01</span></div>
        <button class="immersive__start" type="button" data-intro-start aria-label="Iniciar a jornada: Sophia vai ao encontro do foguete">
          <span class="immersive__start-preface">PRESS ANY KEY TO</span>
          <span class="immersive__start-main" aria-hidden="true">START<span class="immersive__start-cursor">_</span></span>
          <span class="immersive__start-touch">OU TOQUE PARA COMEÇAR</span>
        </button>
        <div class="immersive__intro-footer" aria-hidden="true"><span>EST. 2026</span><span>AN INTERACTIVE JOURNEY</span></div>
      </section>
      <ExperimentalMenu />
      <a class="immersive__back" href="/sophia/" aria-label="Voltar à página da Sophia">← Voltar</a>
      <p class="immersive__status" data-status role="status" aria-live="polite">Carregando Sophia…</p>
      <button class="immersive__retry" type="button" data-retry hidden>Tentar novamente</button>
      <noscript><p class="immersive__nojs">Ative JavaScript para visualizar Sophia em 3D.</p></noscript>
    </main>
  </body>
</html>

<style>
  :global(html) { background: #000; color-scheme: dark; }
  :global(body) { margin: 0; min-height: 100svh; overflow: hidden; background: #000; font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  :global(*), :global(*::before), :global(*::after) { box-sizing: border-box; }
  .immersive { position: relative; isolation: isolate; width: 100%; min-height: 100vh; min-height: 100svh; background: #000; color: #e8e8e8; }
  .immersive__stage { position: absolute; inset: 0; background: #000; touch-action: none; outline: none; }
  .immersive__stage[inert] { pointer-events: none; }
  .immersive__stage:focus-visible { outline: 1px solid #8a9bc4; outline-offset: -5px; }
  .immersive__stage :global(canvas) { display: block; width: 100%; height: 100%; }
  .immersive__back, .immersive__retry { position: absolute; z-index: 65; padding: 10px 13px; border: 1px solid #ffffff30; border-radius: 999px; color: #e1e3e9; background: #101014a8; backdrop-filter: blur(8px); font-size: 12px; line-height: 1; text-decoration: none; transition: background 160ms ease; }
  .immersive__back { top: max(19px, env(safe-area-inset-top)); left: max(19px, env(safe-area-inset-left)); }
  .immersive__retry { right: max(19px, env(safe-area-inset-right)); bottom: max(19px, env(safe-area-inset-bottom)); cursor: pointer; }
  .immersive__back:hover, .immersive__retry:hover { background: #303038; }
  .immersive__back:focus-visible, .immersive__retry:focus-visible { outline: 2px solid #aabadd; outline-offset: 3px; }
  .immersive__retry[hidden] { display: none; }
  .immersive__status, .immersive__nojs { position: absolute; z-index: 24; top: 74%; left: 50%; transform: translate(-50%, -50%); margin: 0; color: #bdc5d2; font-size: 13px; text-align: center; max-width: min(80vw, 520px); line-height: 1.6; pointer-events: none; }
  .immersive__status[hidden] { display: none; }
  @font-face { font-family: "Sophia Roguepunk"; src: url("../../../assets/fonts/Roguepunk.ttf") format("truetype"); font-style: normal; font-weight: 400; font-display: swap; }
  :global(html), :global(body) { background: #000 !important; background-image: none !important; overflow: hidden; color-scheme: dark; }
  :global(.xm-header) { position: absolute; inset: 0 0 auto; z-index: 70; }
  :global(.xm-drawer) { z-index: 75; }
  .immersive__intro { position: absolute; inset: 0; z-index: 12; display: grid; place-items: center; overflow: hidden; background: #000; transition: opacity 780ms ease, visibility 780ms ease; }
  .immersive__intro::before { content: ""; position: absolute; inset: 0; pointer-events: none; opacity: 0.33; background: repeating-linear-gradient(to bottom, transparent 0 5px, rgba(125,165,205,0.052) 6px); }
  .immersive__intro::after { content: ""; position: absolute; top: 50%; left: 50%; width: min(88vw, 980px); height: 1px; background: linear-gradient(90deg, transparent, rgba(78,207,240,.22), transparent); transform: translate(-50%, 92px); pointer-events: none; }
  .immersive__intro.is-started { opacity: 0; visibility: hidden; pointer-events: none; }
  .immersive__intro-frame, .immersive__intro-footer { position: absolute; right: clamp(24px, 5vw, 74px); left: clamp(24px, 5vw, 74px); display: flex; justify-content: space-between; gap: 18px; color: #9da8b7; font: 600 10px/1.3 ui-monospace, Consolas, monospace; letter-spacing: .25em; }
  .immersive__intro-frame { top: max(45px, env(safe-area-inset-top)); padding-top: 10px; border-top: 1px solid #8792a23c; }
  .immersive__intro-footer { bottom: max(38px, env(safe-area-inset-bottom)); padding-bottom: 10px; border-bottom: 1px solid #8792a23c; }
  .immersive__start { position: relative; display: grid; gap: 5px; justify-items: center; width: min(88vw, 820px); padding: 25px 10px; border: 0; background: transparent; color: #f0ecdf; cursor: pointer; text-align: center; -webkit-tap-highlight-color: transparent; }
  .immersive__start-preface { font: 500 clamp(13px, 2vw, 22px)/1.4 "Sophia Roguepunk", Impact, sans-serif; letter-spacing: .31em; text-shadow: 0 0 22px #5ce0ff38; }
  .immersive__start-main { color: #f8ed37; font: 400 clamp(66px, 14vw, 158px)/.95 "Sophia Roguepunk", Impact, sans-serif; letter-spacing: -.025em; transform: skewX(-6deg); text-shadow: 3px 3px #111, -2px 0 #19d7e2; transition: text-shadow 180ms ease, transform 180ms ease; }
  .immersive__start:hover .immersive__start-main { text-shadow: 4px 4px #f73e8f, -3px -2px #19d7e2, 0 0 42px #f8ed3755; transform: skewX(-8deg) scale(1.025); }
  .immersive__start-cursor { color: #10d9eb; animation: sophia-cursor 1.12s steps(1, end) infinite; }
  .immersive__start-touch { margin-top: 32px; color: #8a98a5; font: 600 10px/1.4 ui-monospace, Consolas, monospace; letter-spacing: .28em; }
  .immersive__start:focus-visible { outline: 2px solid #f8ed37; outline-offset: 5px; }
  @keyframes sophia-cursor { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
  @media (max-width: 650px) { .immersive__intro-frame, .immersive__intro-footer { font-size: 8px; letter-spacing: .13em; } .immersive__intro-frame { top: 115px; } .immersive__start-preface { letter-spacing: .17em; } .immersive__start-touch { letter-spacing: .1em; } .immersive__status { top: 79%; font-size: 11px; } }
  @media (prefers-reduced-motion: reduce) { .immersive__back, .immersive__retry, .immersive__intro, .immersive__start-main { transition: none; } .immersive__start-cursor { animation: none; } }
</style>

<script>
  import * as THREE from 'three';
  import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
  import type { GLTF } from 'three/addons/loaders/GLTFLoader.js';
  import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const page = document.querySelector<HTMLElement>('[data-sophia-immersive]');
  const status = document.querySelector<HTMLElement>('[data-status]');
  const retryButton = document.querySelector<HTMLButtonElement>('[data-retry]');
  const intro = document.querySelector<HTMLElement>('[data-intro]');
  const introStart = document.querySelector<HTMLButtonElement>('[data-intro-start]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const preferredUrl = page?.dataset.astronautUrl || '/api/sophia/rocket';

  if (stage && page && status && retryButton && intro && introStart) {
    const setStatus = (message: string) => {
      status.hidden = !message;
      status.textContent = message;
    };
    try {
      const scene = new THREE.Scene();
      scene.background = new THREE.Color(0x000000);
      const camera = new THREE.PerspectiveCamera(38, 1, 0.01, 1000);
      const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false, powerPreference: 'high-performance' });
      renderer.setClearColor(0x000000, 1);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.75));
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.22;
      stage.appendChild(renderer.domElement);

      scene.add(new THREE.AmbientLight(0xffffff, 1.4));
      const key = new THREE.DirectionalLight(0xf5f5ff, 2.6);
      key.position.set(-3, 5, 6);
      scene.add(key);
      const fill = new THREE.DirectionalLight(0x7695ff, 1.25);
      fill.position.set(5, 2, -4);
      scene.add(fill);
      const rim = new THREE.DirectionalLight(0xffffff, 1.3);
      rim.position.set(1, 4, -5);
      scene.add(rim);

      const controls = new OrbitControls(camera, renderer.domElement);
      controls.enableDamping = !reduceMotion.matches;
      controls.dampingFactor = 0.07;
      controls.enablePan = false;
      controls.enableRotate = false;
      controls.enableZoom = false;
      controls.minPolarAngle = 0.13;
      controls.maxPolarAngle = Math.PI - 0.13;
      controls.rotateSpeed = 0.65;
      controls.zoomSpeed = 0.75;

      const loader = new GLTFLoader();
      const clock = new THREE.Clock();
      let activeModel: THREE.Object3D | null = null;
      let mixer: THREE.AnimationMixer | null = null;
      let framing: { box: THREE.Box3; astronaut: boolean } | null = null;
      let loadIndex = 0;
      type ScenePhase = 'intro' | 'waiting' | 'approach' | 'ignite' | 'flight';
      let phase: ScenePhase = 'intro';
      let phaseTime = 0;
      let modelReady = false;
      let currentGltf: GLTF | null = null;
      let boarding: { rider: THREE.Object3D; seated: THREE.Vector3; entry: THREE.Vector3; exhaust: THREE.Object3D | null; ribbons: THREE.Object3D[]; flightBox: THREE.Box3 } | null = null;
      const approachDuration = 3.65;
      const igniteDuration = 0.72;
      const smooth = (value: number) => value * value * (3 - 2 * value);

      function getFramingBox(root: THREE.Object3D, astronaut: boolean) {
        const box = new THREE.Box3();
        if (astronaut) {
          // Ignore far-reaching exhaust and animated trails when centering Sophia and the rocket.
          for (const name of ['Fuselage', 'Helmet_Glass', 'Suit_Chest', 'tripo_mesh_315c0594.001']) {
            const part = root.getObjectByName(name);
            if (part) box.expandByObject(part);
          }
        }
        if (box.isEmpty()) box.setFromObject(root);
        if (box.isEmpty()) box.set(new THREE.Vector3(-0.5, 0, -0.5), new THREE.Vector3(0.5, 1, 0.5));
        return box;
      }

      function fitCamera(box: THREE.Box3, astronaut: boolean) {
        const size = box.getSize(new THREE.Vector3());
        const center = box.getCenter(new THREE.Vector3());
        const aspect = Math.max(0.4, stage.clientWidth / Math.max(1, stage.clientHeight));
        const halfFov = THREE.MathUtils.degToRad(camera.fov / 2);
        const widthDistance = size.x / (2 * Math.tan(halfFov) * aspect);
        const heightDistance = size.y / (2 * Math.tan(halfFov));
        const depthDistance = size.z * 1.3;
        const distance = Math.max(widthDistance, heightDistance, depthDistance, 0.55) * 1.38;
        const direction = astronaut
          ? new THREE.Vector3(-0.68, 0.22, 1)
          : new THREE.Vector3(0, 0.12, 1);
        direction.normalize();
        controls.target.copy(center);
        camera.position.copy(center).addScaledVector(direction, distance);
        controls.minDistance = Math.max(0.15, distance * 0.35);
        controls.maxDistance = Math.max(3, distance * 5);
        camera.near = Math.max(0.005, distance / 200);
        camera.far = Math.max(100, distance * 100);
        camera.updateProjectionMatrix();
        controls.update();
      }

      function resize() {
        const w = Math.max(1, stage.clientWidth);
        const h = Math.max(1, stage.clientHeight);
        renderer.setSize(w, h, false);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
      }

      const observer = new ResizeObserver(() => {
        resize();
        if (framing) fitCamera(framing.box, framing.astronaut);
      });
      observer.observe(stage);

      function playClip(name: string, loop: boolean) {
        if (!currentGltf || !mixer) return;
        const clip = currentGltf.animations.find((candidate) => candidate.name === name);
        if (!clip) return;
        mixer.stopAllAction();
        const action = mixer.clipAction(clip);
        action.reset();
        action.setLoop(loop ? THREE.LoopRepeat : THREE.LoopOnce, loop ? Infinity : 1);
        action.clampWhenFinished = !loop;
        action.play();
        if (reduceMotion.matches) mixer.setTime(0);
      }

      function beginFlight() {
        phase = 'flight';
        phaseTime = 0;
        if (boarding) {
          boarding.rider.position.copy(boarding.seated);
          boarding.ribbons.forEach((ribbon) => { ribbon.visible = true; });
          boarding.exhaust && (boarding.exhaust.visible = true);
          framing = { box: boarding.flightBox, astronaut: true };
          fitCamera(boarding.flightBox, true);
        }
        playClip('Sophia_Foguete_Voo_Esquerda_Ondas_R2', true);
        controls.enableRotate = true;
        controls.enableZoom = true;
        setStatus('');
      }

      function beginApproach() {
        if (!modelReady || phase !== 'waiting') return;
        intro.classList.add('is-started');
        stage.inert = false;
        stage.tabIndex = 0;
        phaseTime = 0;
        setStatus('');
        if (reduceMotion.matches || !boarding) {
          beginFlight();
          return;
        }
        phase = 'approach';
        playClip('Andar_R6', true);
      }

      function requestStart() {
        if (phase !== 'intro') return;
        phase = 'waiting';
        if (modelReady) beginApproach();
        else setStatus('Preparando a decolagem da Sophia…');
      }

      function install(gltf: GLTF, astronaut: boolean) {
        if (mixer) mixer.stopAllAction();
        if (activeModel) scene.remove(activeModel);
        mixer = null;
        currentGltf = gltf;
        boarding = null;
        const root = gltf.scene;
        activeModel = root;
        scene.add(root);
        root.updateMatrixWorld(true);
        const flightBox = getFramingBox(root, astronaut);
        let cameraBox = flightBox.clone();

        // The delivered GLB has separate parent nodes for its astronaut rider
        // and rocket. Move only the rider: the rocket remains on its launch mark.
        const rider = root.getObjectByName('Sophia_Astronauta_Rider_Mount');
        const rocket = root.getObjectByName('Rocket_Flight_Mount');
        if (astronaut && rider && rocket) {
          const size = flightBox.getSize(new THREE.Vector3());
          const seated = rider.position.clone();
          const entry = new THREE.Vector3(-Math.max(size.x * 0.88, 1.0), -Math.max(size.y * 0.16, 0.13), 0.12);
          const ribbons = Array.from({ length: 8 }, (_, i) => root.getObjectByName('SpeedRibbon_' + (i + 1))).filter((node): node is THREE.Object3D => !!node);
          const exhaust = root.getObjectByName('Plume_Root') || null;
          rider.position.copy(seated).add(entry);
          ribbons.forEach((ribbon) => { ribbon.visible = false; });
          if (exhaust) exhaust.visible = false;
          root.updateMatrixWorld(true);
          cameraBox = cameraBox.union(new THREE.Box3().setFromObject(rider));
          boarding = { rider, seated, entry, exhaust, ribbons, flightBox };
        }

        mixer = new THREE.AnimationMixer(root);
        const preferredClip = gltf.animations.find((clip) => clip.name === 'Sophia_Foguete_Voo_Esquerda_Ondas_R2');
        const fallbackClip = gltf.animations.find((clip) => /rocket|foguete/i.test(clip.name));
        if (!preferredClip && !fallbackClip) {
          console.warn('Sophia: o GLB não inclui a animação de voo esperada.');
        }
        framing = { box: cameraBox, astronaut };
        resize();
        fitCamera(cameraBox, astronaut);
        modelReady = true;
        setStatus('');
        if (phase === 'waiting') beginApproach();
      }

      async function loadUrl(url: string, astronaut: boolean) {
        const current = ++loadIndex;
        setStatus('Carregando Sophia…');
        const gltf = await loader.loadAsync(url);
        if (current === loadIndex) install(gltf, astronaut);
      }

      // This route exclusively displays the astronaut/rocket GLB. Never fall
      // back to the unrelated laboratory model or require visitor uploads.
      async function loadAstronaut() {
        retryButton.hidden = true;
        setStatus('Carregando Sophia astronauta e foguete…');
        let modelReachable = false;
        try {
          // A same-origin, unauthenticated HEAD distinguishes R2 404/503
          // from glTF parsing or WebGL errors without downloading 47 MB twice.
          const response = await fetch(preferredUrl, {
            method: 'HEAD',
            cache: 'no-store',
            credentials: 'omit',
            redirect: 'manual',
          });
          if (!response.ok) {
            if (response.status === 404) {
              setStatus('O arquivo da Sophia astronauta não foi encontrado no armazenamento R2.');
            } else if (response.status === 503) {
              setStatus('O armazenamento R2 da Sophia não está disponível neste ambiente.');
            } else if (response.status === 0 || (response.status >= 300 && response.status < 400) || response.status === 401 || response.status === 403) {
              setStatus('O acesso público ao modelo foi bloqueado. Verifique o Cloudflare Access.');
            } else {
              setStatus('Falha ao consultar o modelo da Sophia (HTTP ' + response.status + ').');
            }
            retryButton.hidden = false;
            return;
          }
          const mime = response.headers.get('content-type') || '';
          if (!mime.toLowerCase().includes('model/gltf-binary')) {
            setStatus('O servidor não retornou um arquivo GLB válido (tipo: ' + (mime || 'ausente') + ').');
            retryButton.hidden = false;
            return;
          }
          modelReachable = true;
          await loadUrl(preferredUrl, true);
        } catch (error) {
          console.error('Sophia: falha ao carregar astronauta/foguete.', error);
          setStatus(modelReachable
            ? 'O GLB está acessível, mas não pôde ser interpretado ou renderizado.'
            : 'Não foi possível conectar ao carregador público da Sophia.');
          retryButton.hidden = false;
        }
      }

      introStart.addEventListener('click', requestStart);
      window.addEventListener('keydown', (event) => {
        if (phase !== 'intro' || event.repeat || event.isComposing || event.ctrlKey || event.metaKey || event.altKey || event.key === 'Escape' || event.key === 'Tab') return;
        if (event.target instanceof Element && event.target.closest('a, button, input, select, textarea, [role="menu"], [data-xm]')) return;
        event.preventDefault();
        requestStart();
      });
      retryButton.addEventListener('click', () => { void loadAstronaut(); });
      void loadAstronaut();

      renderer.domElement.addEventListener('webglcontextlost', (event) => {
        event.preventDefault();
        setStatus('A visualização 3D foi interrompida pelo navegador. Atualize a página para reiniciar.');
      });

      renderer.setAnimationLoop(() => {
        const delta = Math.min(clock.getDelta(), 0.05);
        if (document.hidden) return;
        if (!reduceMotion.matches && phase === 'approach' && boarding) {
          phaseTime += delta;
          const t = Math.min(1, phaseTime / approachDuration);
          const ease = smooth(t);
          boarding.rider.position.copy(boarding.seated).addScaledVector(boarding.entry, 1 - ease);
          boarding.rider.position.y += Math.sin(t * Math.PI * 5) * 0.025 * (1 - t);
          if (mixer) mixer.update(delta);
          if (t >= 1) {
            boarding.rider.position.copy(boarding.seated);
            phase = 'ignite';
            phaseTime = 0;
            playClip('Engine_Idle', true);
            if (boarding.exhaust) boarding.exhaust.visible = true;
          }
        } else if (phase === 'ignite') {
          phaseTime += delta;
          if (mixer) mixer.update(delta);
          if (phaseTime >= igniteDuration) beginFlight();
        } else if (phase === 'flight') {
          if (mixer && !reduceMotion.matches) mixer.update(delta);
        }
        controls.update();
        renderer.render(scene, camera);
      });
      resize();
    } catch (error) {
      console.error('Sophia: inicialização WebGL indisponível.', error);
      setStatus('Este navegador não conseguiu iniciar a cena 3D.');
    }
  }
</script>
