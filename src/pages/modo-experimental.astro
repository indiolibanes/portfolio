---
// Protótipo do modo-experimental. Rota solta: sem link no site, fora do sitemap, noindex.
// Para publicar de verdade, o menu vira o cabeçalho de um modo novo em BaseLayout/SeriousModeToggle.
import ExperimentalMenu from '../components/ExperimentalMenu.astro';
import { PROFILE } from '../config';
import '../styles/global.css';
import '../styles/experimental.css';

const swatches = [
  ['Sol', 'linear-gradient(135deg, #f5df9c, #e6bb4a)'],
  ['Rosa', 'linear-gradient(135deg, #efb5a8, #cf6f60)'],
  ['Céu', 'linear-gradient(135deg, #cad4df, #6f88a7)'],
  ['Musgo', 'linear-gradient(135deg, #d7dfcc, #819d72)'],
  ['Pêssego', 'linear-gradient(135deg, #efc59f, #d58d4d)'],
  ['Violeta', 'linear-gradient(135deg, #d6d0e4, #8174a3)'],
];
---

<!doctype html>
<html lang="pt-BR" data-portfolio-mode="authorial" data-serious-mode="false" data-legacy-mode="false">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content="#f6efdc" />
    <title>Modo experimental — protótipo do menu</title>
    <meta name="description" content="Protótipo interno do menu orbital. Não faz parte do portfólio publicado." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body id="top">
    <ExperimentalMenu />

    <main id="conteudo" class="xm-stage">
      <p class="xm-stage__eyebrow">Modo-experimental · protótipo</p>
      <h1>{PROFILE.name}</h1>
      <p class="xm-stage__lead">
        Esta página só existe para avaliar o menu. Abra o botão no canto superior direito: a gaveta é de vidro,
        então as cores abaixo devem aparecer borradas por trás dela.
      </p>
      <ul class="xm-stage__swatches" aria-label="Cores de fundo para testar a translucidez">
        {swatches.map(([name, bg]) => <li style={`background:${bg}`}><span>{name}</span></li>)}
      </ul>
    </main>
  </body>
</html>

<style is:global>
  .xm-stage {
    width: min(var(--page, 1180px), calc(100% - 2rem));
    margin: 2.5rem auto 5rem;
  }
  .xm-stage__eyebrow {
    margin: 0 0 0.5rem;
    color: var(--ink-soft);
    font-family: var(--font-retro);
    font-size: 0.8rem;
  }
  .xm-stage h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 7vw, 4.6rem);
    line-height: 1;
  }
  .xm-stage__lead {
    max-width: 38rem;
    margin: 1rem 0 2rem;
    color: var(--ink-soft);
  }
  .xm-stage__swatches {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .xm-stage__swatches li {
    display: flex;
    align-items: flex-end;
    min-height: 220px;
    padding: 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg, 28px);
    font: 800 0.8rem/1 var(--font-ui);
    color: #2b2118;
  }
</style>
