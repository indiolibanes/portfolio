---
// RHEA: standalone project page. It deliberately does not use BaseLayout,
// so the portfolio's modes, cursor, sprites and share card stay out of it.
import { SITE } from '../../config';

const REPO = 'https://github.com/indiolibanes/RHEA';
const DOCS = REPO + '/blob/main/docs/';

const title = 'RHEA: Google Drive for MCP assistants, within one folder';
const description =
  'RHEA is an open-source, self-hosted workspace that connects Google Drive to MCP-compatible assistants through one dedicated folder, with revocable grants and reviewed changes.';
const canonicalUrl = new URL(Astro.url.pathname, SITE.url).toString();
const ogImageUrl = new URL('/rhea/og-rhea.jpg', SITE.url).toString();
const ogImageAlt =
  'RHEA mark, a gold diamond inside a gated ring, above the words "Your Drive, within reach of your assistants, and no further." on deep green.';

const components = [
  {
    name: 'Web workspace',
    text: 'Browse, preview, download and organize the files inside the workspace folder, and review what each assistant has asked to change.',
    href: REPO + '/tree/main/apps/web',
  },
  {
    name: 'Remote MCP gateway',
    text: 'A dedicated HTTPS endpoint where external assistants connect with OAuth. Every connection can be reviewed and revoked from the workspace.',
    href: DOCS + 'mcp-gateway.md',
  },
  {
    name: 'Local MCP server',
    text: 'Reads allowlisted project documentation over stdio, for assistants that run next to the code.',
    href: REPO + '/tree/main/apps/mcp',
  },
  {
    name: 'Android prototype',
    text: 'An early look at local file intake and browsing, built and tested with sample files.',
    href: REPO + '/tree/main/apps/android',
  },
];

const route = [
  { step: 'Assistant', check: 'Allowlisted client with an exact callback URL' },
  { step: 'MCP gateway', check: 'Its own OAuth grant; access tokens last five minutes at most' },
  { step: 'Drive service', check: 'Only the drive.file scope; ancestry verified on the server' },
  { step: 'RHEA folder', check: 'The one folder the app created in My Drive' },
];

const boundaries = [
  {
    term: 'One folder',
    text: 'RHEA asks Google only for the drive.file scope and checks, for every file and folder it returns, that it really lives under the app-created RHEA folder.',
  },
  {
    term: 'Separate permissions',
    text: 'Reading is the default. Proposing changes and organizing files are separate permissions, and each must be approved explicitly for each assistant.',
  },
  {
    term: 'Reviewed changes',
    text: 'An assistant may propose a new folder, a rename, a move, a reversible trash or an upload destination. Nothing happens until you confirm it in the workspace.',
  },
  {
    term: 'Revocable grants',
    text: 'Each assistant has its own grant, which you can revoke at any time. Google tokens and workspace cookies are never handed to an assistant.',
  },
  {
    term: 'Untrusted content',
    text: 'Text read from files is treated as untrusted input, and every tool response is bounded in size.',
  },
  {
    term: 'Your own instance',
    text: 'You run the website, the hosting, the Google OAuth application and the MCP endpoint. The guides use Cloudflare Pages, Access, Workers and D1.',
  },
];

const steps = [
  {
    title: 'Deploy the workspace',
    text: 'Publish the web workspace to your own Pages project behind Cloudflare Access, and register your own Google OAuth client.',
    href: DOCS + 'google-drive-oauth.md',
    link: 'Web and Drive setup',
  },
  {
    title: 'Deploy the gateway',
    text: 'Run the MCP gateway on its own HTTPS Worker, bind the same D1 database to both services and apply the migrations in order.',
    href: DOCS + 'mcp-gateway.md',
    link: 'MCP gateway setup',
  },
  {
    title: 'Connect, then authorize',
    text: 'Connect your Google account in the workspace, then register and authorize each assistant against your /mcp endpoint.',
    href: DOCS + 'assistant-connections.md',
    link: 'Assistant onboarding',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#0e2a21" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/rhea/rhea-icon.svg" />
    <link rel="preload" href="/rhea/fonts/eb-garamond-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RHEA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
  </head>

  <body class="rhea-site">
    <a class="rhea-skip" href="#rhea-main">Skip to content</a>

    <header class="rhea-bar">
      <a class="rhea-bar__brand" href="/rhea/" aria-label="RHEA, home">
        <img src="/rhea/rhea-wordmark.svg" alt="" width="242" height="96" />
      </a>
      <nav class="rhea-bar__nav" aria-label="RHEA">
        <a href="#overview">Overview</a>
        <a href="#boundaries">Boundaries</a>
        <a href="#start">Get started</a>
        <a href={REPO} rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main id="rhea-main">
      <section class="rhea-hero" aria-labelledby="rhea-hero-title">
        <img class="rhea-hero__mark" src="/rhea/rhea-mark.svg" alt="" width="132" height="132" />
        <p class="rhea-label"><span class="rhea-diamond" aria-hidden="true"></span> In development · Open source · MIT</p>
        <h1 id="rhea-hero-title">
          Your Drive, within reach of your assistants.
          <em>And no further.</em>
        </h1>
        <p class="rhea-hero__lead">
          RHEA connects Google Drive to MCP-compatible assistants through one dedicated folder.
          You run the instance, you approve each assistant, and every request is checked against
          the only folder it is allowed to reach.
        </p>
        <p class="rhea-hero__actions">
          <a class="rhea-button rhea-button--primary" href={REPO} rel="noopener noreferrer">
            View the repository <span aria-hidden="true">↗</span>
          </a>
          <a class="rhea-button" href={DOCS + 'google-drive-oauth.md'} rel="noopener noreferrer">
            Read the setup guide <span aria-hidden="true">↗</span>
          </a>
        </p>
      </section>

      <section id="overview" class="rhea-section rhea-section--ivory" aria-labelledby="overview-title">
        <div class="rhea-section__head">
          <p class="rhea-eyebrow">01 · Overview</p>
          <h2 id="overview-title">Four parts, one boundary.</h2>
          <p>
            The repository provides the workspace and the gateway source code. Each part can be read,
            run and audited on its own.
          </p>
        </div>
        <ul class="rhea-parts">
          {components.map((part) => (
            <li>
              <h3>{part.name}</h3>
              <p>{part.text}</p>
              <a href={part.href} rel="noopener noreferrer">Source <span aria-hidden="true">↗</span><span class="rhea-sr"> for {part.name}</span></a>
            </li>
          ))}
        </ul>
      </section>

      <section class="rhea-section rhea-section--white" aria-labelledby="route-title">
        <div class="rhea-section__head">
          <p class="rhea-eyebrow">02 · How a request travels</p>
          <h2 id="route-title">Every hop asks a question.</h2>
          <p>
            An assistant never talks to Google directly. Its request passes through checks it cannot
            skip, and the answer can only come from inside the RHEA folder.
          </p>
        </div>
        <ol class="rhea-route">
          {route.map((hop, index) => (
            <li style={`--i:${index}`}>
              <span class="rhea-route__node">{hop.step}</span>
              <span class="rhea-route__check">{hop.check}</span>
            </li>
          ))}
        </ol>
      </section>

      <section id="boundaries" class="rhea-section rhea-section--forest" aria-labelledby="boundaries-title">
        <div class="rhea-section__head">
          <p class="rhea-eyebrow">03 · Boundaries</p>
          <h2 id="boundaries-title">Access is narrow by design.</h2>
        </div>
        <dl class="rhea-boundaries">
          {boundaries.map((item) => (
            <div>
              <dt><span class="rhea-diamond" aria-hidden="true"></span>{item.term}</dt>
              <dd>{item.text}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section id="start" class="rhea-section rhea-section--ivory" aria-labelledby="start-title">
        <div class="rhea-section__head">
          <p class="rhea-eyebrow">04 · Get started</p>
          <h2 id="start-title">Run your own instance.</h2>
          <p>
            Clients such as Claude, ChatGPT and Gemini CLI can connect over remote MCP, subject to each
            client's own plans and eligibility.
          </p>
        </div>
        <ol class="rhea-steps">
          {steps.map((step) => (
            <li>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
              <a href={step.href} rel="noopener noreferrer">{step.link} <span aria-hidden="true">↗</span></a>
            </li>
          ))}
        </ol>
        <div class="rhea-code">
          <p class="rhea-code__label">Preview the interface locally · Node.js 24</p>
          <pre><code>git clone https://github.com/indiolibanes/RHEA.git
cd RHEA/apps/web
npm ci
npm test
npm run dev</code></pre>
          <p class="rhea-code__note">
            The Drive API, assistant grants and uploads need a deployment with Cloudflare Access and
            your own Google OAuth application.
          </p>
        </div>
      </section>
    </main>

    <footer class="rhea-footer">
      <img src="/rhea/rhea-mark.svg" alt="" width="56" height="56" />
      <p>
        RHEA is open source under the
        <a href={REPO + '/blob/main/LICENSE'} rel="noopener noreferrer">MIT License</a>.
        It is in development, so interfaces and setup may still change.
      </p>
      <p class="rhea-footer__by">
        A project by <a href="/">Kauê Alencar</a> · <a href={REPO} rel="noopener noreferrer">indiolibanes/RHEA</a>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'RHEA Garamond';
    src: url('/rhea/fonts/eb-garamond-latin-400-normal.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'RHEA Garamond';
    src: url('/rhea/fonts/eb-garamond-latin-400-italic.woff2') format('woff2');
    font-weight: 400;
    font-style: italic;
    font-display: swap;
  }
  @font-face {
    font-family: 'RHEA Atkinson';
    src: url('/rhea/fonts/atkinson-regular.woff') format('woff');
    font-weight: 400;
    font-display: swap;
  }
  @font-face {
    font-family: 'RHEA Atkinson';
    src: url('/rhea/fonts/atkinson-bold.woff') format('woff');
    font-weight: 700;
    font-display: swap;
  }
  @font-face {
    font-family: 'RHEA Mono';
    src: url('/rhea/fonts/ibm-plex-mono-latin-400-normal.woff2') format('woff2');
    font-weight: 400;
    font-display: swap;
  }

  .rhea-site {
    --forest: #0e2a21;
    --forest-2: #163b2e;
    --moss: #1f4a3a;
    --earth: #6a4329;
    --earth-deep: #4a2e1c;
    --ivory: #f1e8d2;
    --white: #faf7f0;
    --gold: #c9a13e;
    --gold-ink: #7a5b12;
    --yellow: #e9c75b;
    --ink: #1c2a24;
    --ink-muted: #4c5a52;
    --serif: 'RHEA Garamond', 'EB Garamond', Garamond, 'Times New Roman', serif;
    --sans: 'RHEA Atkinson', 'Atkinson Hyperlegible', system-ui, sans-serif;
    --mono: 'RHEA Mono', 'IBM Plex Mono', ui-monospace, monospace;
    --measure: 68ch;
    --gutter: clamp(1.25rem, 5vw, 4rem);

    margin: 0;
    background: var(--forest);
    color: var(--ivory);
    font-family: var(--sans);
    font-size: 1.0625rem;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }

  .rhea-site *,
  .rhea-site *::before,
  .rhea-site *::after { box-sizing: border-box; }

  :where(.rhea-site) a { color: inherit; text-underline-offset: 0.22em; text-decoration-thickness: 1px; }
  :where(.rhea-site) a:hover { text-decoration-thickness: 2px; }
  .rhea-site :focus-visible { outline: 2px solid var(--yellow); outline-offset: 3px; border-radius: 2px; }
  :where(.rhea-site) :is(h1, h2, h3) { font-family: var(--serif); font-weight: 400; margin: 0; text-wrap: balance; }
  :where(.rhea-site) p { margin: 0; text-wrap: pretty; }

  .rhea-sr {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap;
  }

  .rhea-skip {
    position: absolute; left: 1rem; top: -4rem; z-index: 10;
    padding: 0.6rem 1rem; background: var(--yellow); color: var(--forest);
  }
  .rhea-skip:focus { top: 1rem; }

  .rhea-diamond {
    display: inline-block; width: 0.5em; height: 0.5em; margin-right: 0.6em;
    background: var(--yellow); transform: rotate(45deg); vertical-align: 0.08em;
  }

  /* Bar */
  .rhea-bar {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    flex-wrap: wrap; padding: 1.1rem var(--gutter);
    border-bottom: 1px solid rgba(201, 161, 62, 0.22);
  }
  .rhea-bar__brand { display: inline-flex; }
  .rhea-bar__brand img { height: 40px; width: auto; }
  .rhea-bar__nav { display: flex; flex-wrap: wrap; gap: 0.35rem 1.6rem; font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .rhea-bar__nav a { text-decoration: none; color: rgba(241, 232, 210, 0.78); }
  .rhea-bar__nav a:hover { color: var(--yellow); }

  /* Hero */
  .rhea-hero {
    position: relative; display: grid; justify-items: center; text-align: center;
    padding: clamp(3.5rem, 9vw, 7rem) var(--gutter) clamp(4rem, 9vw, 7.5rem);
    background:
      radial-gradient(ellipse 70% 55% at 50% 0%, rgba(31, 74, 58, 0.9), transparent 70%),
      var(--forest);
    overflow: hidden;
  }
  .rhea-hero::after {
    content: ''; position: absolute; inset: auto 0 0; height: 14px; background: var(--earth);
  }
  .rhea-hero__mark { width: clamp(96px, 12vw, 132px); height: auto; margin-bottom: 1.8rem; }
  .rhea-label {
    font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: rgba(241, 232, 210, 0.75); margin-bottom: 1.4rem;
  }
  .rhea-hero h1 {
    max-width: 17ch; font-size: clamp(2.6rem, 6.4vw, 5.2rem); line-height: 1.04; color: var(--white);
    letter-spacing: -0.01em;
  }
  .rhea-hero h1 em { display: block; color: var(--yellow); font-style: italic; }
  .rhea-hero__lead { max-width: 58ch; margin-top: 1.8rem; font-size: clamp(1.05rem, 1.5vw, 1.2rem); color: rgba(250, 247, 240, 0.86); }
  .rhea-hero__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.9rem; margin-top: 2.4rem; }

  .rhea-button {
    display: inline-flex; align-items: center; gap: 0.5rem; min-height: 48px; padding: 0.7rem 1.3rem;
    border: 1px solid rgba(241, 232, 210, 0.45); border-radius: 4px;
    font-family: var(--mono); font-size: 0.82rem; letter-spacing: 0.06em; text-decoration: none;
    color: var(--ivory); transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease;
  }
  .rhea-button:hover { border-color: var(--yellow); color: var(--yellow); }
  .rhea-button--primary { background: var(--yellow); border-color: var(--yellow); color: var(--forest); }
  .rhea-button--primary:hover { background: var(--ivory); border-color: var(--ivory); color: var(--forest); }

  /* Sections */
  .rhea-section { padding: clamp(4rem, 9vw, 7rem) var(--gutter); }
  .rhea-section--ivory { background: var(--ivory); color: var(--ink); }
  .rhea-section--white { background: var(--white); color: var(--ink); }
  .rhea-section--forest { background: var(--forest-2); color: var(--ivory); }
  .rhea-section__head { max-width: 46rem; margin: 0 auto clamp(2.5rem, 5vw, 3.5rem); text-align: center; }
  .rhea-section__head h2 { font-size: clamp(2.1rem, 4.4vw, 3.4rem); line-height: 1.08; margin-bottom: 1rem; }
  .rhea-section__head p:not(.rhea-eyebrow) { color: var(--ink-muted); max-width: 58ch; margin-inline: auto; }
  .rhea-section--forest .rhea-section__head p:not(.rhea-eyebrow) { color: rgba(241, 232, 210, 0.8); }
  .rhea-eyebrow {
    font-family: var(--mono); font-size: 0.76rem; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--earth); margin-bottom: 0.9rem;
  }
  .rhea-section--forest .rhea-eyebrow { color: var(--yellow); }

  /* Overview: ruled grid, no cards */
  .rhea-parts {
    list-style: none; margin: 0 auto; padding: 0; max-width: 64rem;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid rgba(106, 67, 41, 0.35);
  }
  .rhea-parts li {
    display: grid; align-content: start; gap: 0.6rem;
    padding: 1.8rem clamp(1rem, 3vw, 2.2rem) 2rem;
    border-bottom: 1px solid rgba(106, 67, 41, 0.35);
  }
  .rhea-parts li:nth-child(odd) { border-right: 1px solid rgba(106, 67, 41, 0.35); }
  .rhea-parts h3 { font-size: 1.7rem; line-height: 1.15; color: var(--forest); }
  .rhea-parts p { color: var(--ink-muted); }
  .rhea-parts a { justify-self: start; font-family: var(--mono); font-size: 0.8rem; color: var(--gold-ink); }

  /* Route */
  .rhea-route {
    list-style: none; margin: 0 auto; padding: 0; max-width: 64rem;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0;
  }
  .rhea-route li { position: relative; display: grid; justify-items: center; gap: 0.9rem; padding: 0 0.6rem; text-align: center; }
  .rhea-route li:not(:last-child)::after {
    content: ''; position: absolute; top: 1.55rem; left: calc(50% + 4.2rem); right: calc(-50% + 4.2rem);
    height: 1px; background: linear-gradient(90deg, var(--gold), rgba(201, 161, 62, 0.35));
  }
  .rhea-route__node {
    display: grid; place-items: center; min-width: 8rem; min-height: 3.1rem; padding: 0.4rem 0.9rem;
    border: 1px solid rgba(14, 42, 33, 0.28); border-radius: 4px; background: var(--ivory);
    font-family: var(--serif); font-size: 1.25rem; color: var(--forest);
  }
  .rhea-route li:last-child .rhea-route__node { background: var(--forest); border-color: var(--forest); color: var(--yellow); }
  .rhea-route__check { max-width: 22ch; font-size: 0.93rem; line-height: 1.55; color: var(--ink-muted); }

  /* Boundaries */
  .rhea-boundaries {
    margin: 0 auto; max-width: 64rem;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.4rem clamp(1.5rem, 3.5vw, 3rem);
  }
  .rhea-boundaries > div { padding-top: 1.2rem; border-top: 1px solid rgba(201, 161, 62, 0.4); }
  .rhea-boundaries dt { font-family: var(--serif); font-size: 1.5rem; line-height: 1.2; color: var(--white); margin-bottom: 0.6rem; }
  .rhea-boundaries dd { margin: 0; color: rgba(241, 232, 210, 0.8); font-size: 0.98rem; }

  /* Steps */
  .rhea-steps {
    list-style: none; counter-reset: step; margin: 0 auto; padding: 0; max-width: 64rem;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.5rem, 3.5vw, 3rem);
  }
  .rhea-steps li { counter-increment: step; display: grid; align-content: start; gap: 0.6rem; }
  .rhea-steps li::before {
    content: counter(step, decimal-leading-zero); font-family: var(--mono); font-size: 0.8rem;
    letter-spacing: 0.12em; color: var(--earth); padding-bottom: 0.7rem; border-bottom: 2px solid var(--earth);
  }
  .rhea-steps h3 { font-size: 1.6rem; line-height: 1.15; color: var(--forest); }
  .rhea-steps p { color: var(--ink-muted); }
  .rhea-steps a { justify-self: start; font-family: var(--mono); font-size: 0.8rem; color: var(--gold-ink); }

  .rhea-code { max-width: 44rem; margin: clamp(3rem, 6vw, 4.5rem) auto 0; }
  .rhea-code__label { font-family: var(--mono); font-size: 0.76rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--earth); margin-bottom: 0.7rem; }
  .rhea-code pre {
    margin: 0; padding: 1.3rem 1.5rem; overflow-x: auto; border-radius: 6px;
    background: var(--forest); color: var(--ivory); border-left: 4px solid var(--yellow);
    font-family: var(--mono); font-size: 0.9rem; line-height: 1.75;
  }
  .rhea-code__note { margin-top: 0.9rem; font-size: 0.92rem; color: var(--ink-muted); }

  /* Footer */
  .rhea-footer {
    display: grid; justify-items: center; gap: 0.8rem; text-align: center;
    padding: 3.2rem var(--gutter) 3.6rem; background: var(--earth-deep); color: rgba(241, 232, 210, 0.85);
    border-top: 6px solid var(--earth); font-size: 0.95rem;
  }
  .rhea-footer p { max-width: 56ch; }
  .rhea-footer__by { font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.06em; color: rgba(241, 232, 210, 0.7); }

  @media (max-width: 860px) {
    .rhea-boundaries,
    .rhea-steps { grid-template-columns: minmax(0, 1fr); }
    .rhea-route { grid-template-columns: minmax(0, 1fr); gap: 1.6rem; max-width: 26rem; }
    .rhea-route li:not(:last-child)::after {
      top: auto; bottom: -1.3rem; left: 50%; right: auto; width: 1px; height: 1rem;
      background: var(--gold);
    }
  }
  @media (max-width: 640px) {
    .rhea-parts { grid-template-columns: minmax(0, 1fr); }
