---
// RHEA: standalone project page. It deliberately does not use BaseLayout,
// so the portfolio's modes, cursor, sprites and share card stay out of it.
import { SITE } from '../../config';
import RheaFace from '../../components/rhea/RheaFace.astro';
import '../../styles/rhea-lamps.css';
import '../../styles/rhea-kinetic.css';

const REPO = 'https://github.com/indiolibanes/RHEA';
const DOCS = REPO + '/blob/main/docs/';

const title = 'RHEA: Google Drive for MCP assistants, within one folder';
const description =
  'RHEA is an open-source, self-hosted workspace that connects Google Drive to MCP-compatible assistants through one dedicated folder, with revocable grants and reviewed changes.';
const canonicalUrl = new URL(Astro.url.pathname, SITE.url).toString();
const ogImageUrl = new URL('/rhea/og-rhea.jpg', SITE.url).toString();
const ogImageAlt =
  'Rhea, a face formed by small glowing lamps inside a gold ring, above the words "Your Drive, within reach of your assistants. And no further." on deep green.';

const tones = [
  { id: 'forest', label: 'Forest' },
  { id: 'earth', label: 'Earth' },
  { id: 'ivory', label: 'Ivory' },
];

const components = [
  {
    name: 'Web workspace',
    text: 'Browse, preview, download and organize the files inside the workspace folder, and review what each assistant has asked to change.',
    href: REPO + '/tree/main/apps/web',
  },
  {
    name: 'Remote MCP gateway',
    text: 'A dedicated HTTPS endpoint where external assistants connect with OAuth. Every connection can be reviewed and revoked from the workspace.',
    href: DOCS + 'mcp-gateway.md',
  },
  {
    name: 'Local MCP server',
    text: 'Reads allowlisted project documentation over stdio, for assistants that run next to the code.',
    href: REPO + '/tree/main/apps/mcp',
  },
  {
    name: 'Android prototype',
    text: 'An early look at local file intake and browsing, built and tested with sample files.',
    href: REPO + '/tree/main/apps/android',
  },
];

const route = [
  { step: 'Assistant', check: 'Allowlisted client with an exact callback URL' },
  { step: 'MCP gateway', check: 'Its own OAuth grant; access tokens last five minutes at most' },
  { step: 'Drive service', check: 'Only the drive.file scope; ancestry verified on the server' },
  { step: 'RHEA folder', check: 'The one folder the app created in My Drive' },
];

const boundaries = [
  {
    term: 'One folder',
    text: 'RHEA asks Google only for the drive.file scope and checks, for every file and folder it returns, that it really lives under the app-created RHEA folder.',
  },
  {
    term: 'Separate permissions',
    text: 'Reading is the default. Proposing changes and organizing files are separate permissions, and each must be approved explicitly for each assistant.',
  },
  {
    term: 'Reviewed changes',
    text: 'An assistant may propose a new folder, a rename, a move, a reversible trash or an upload destination. Nothing happens until you confirm it in the workspace.',
  },
  {
    term: 'Revocable grants',
    text: 'Each assistant has its own grant, which you can revoke at any time. Google tokens and workspace cookies are never handed to an assistant.',
  },
  {
    term: 'Untrusted content',
    text: 'Text read from files is treated as untrusted input, and every tool response is bounded in size.',
  },
  {
    term: 'Your own instance',
    text: 'You run the website, the hosting, the Google OAuth application and the MCP endpoint. The guides use Cloudflare Pages, Access, Workers and D1.',
  },
];

const steps = [
  {
    title: 'Deploy the workspace',
    text: 'Publish the web workspace to your own Pages project behind Cloudflare Access, and register your own Google OAuth client.',
    href: DOCS + 'google-drive-oauth.md',
    link: 'Web and Drive setup',
  },
  {
    title: 'Deploy the gateway',
    text: 'Run the MCP gateway on its own HTTPS Worker, bind the same D1 database to both services and apply the migrations in order.',
    href: DOCS + 'mcp-gateway.md',
    link: 'MCP gateway setup',
  },
  {
    title: 'Connect, then authorize',
    text: 'Connect your Google account in the workspace, then register and authorize each assistant against your /mcp endpoint.',
    href: DOCS + 'assistant-connections.md',
    link: 'Assistant onboarding',
  },
];
---

<!doctype html>
<html lang="en" data-tone="forest">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#0e2a21" />
    <script is:inline>
      {
        const html = document.documentElement;
        let tone = null;
        let motion = null;
        try {
          tone = localStorage.getItem('rhea.tone');
          motion = localStorage.getItem('rhea.motion');
        } catch {}
        if (['forest', 'earth', 'ivory'].includes(tone)) html.dataset.tone = tone;
        // Motion follows the visitor's choice, else the system's reduced-motion setting.
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const on = motion ? motion === 'on' : !reduce;
        html.dataset.motion = on ? 'on' : 'off';
        if (on) {
          html.classList.add('kx-pending');
          setTimeout(() => html.classList.remove('kx-pending'), 2500);
        }
      }
    </script>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/rhea/rhea-icon.svg" />
    <link rel="preload" href="/rhea/fonts/eb-garamond-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RHEA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
  </head>

  <body class="rhea-site">
    <a class="rhea-skip" href="#rhea-main">Skip to content</a>

    <header class="rhea-bar">
      <a class="rhea-bar__brand" href="/rhea/" aria-label="RHEA, home">
        <RheaFace size={40} />
        <span class="rhea-bar__name" aria-hidden="true">RHEA</span>
      </a>
      <nav class="rhea-bar__nav" aria-label="RHEA">
        <a href="#overview">Overview</a>
        <a href="#boundaries">Boundaries</a>
        <a href="#start">Get started</a>
        <a href={REPO} rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      </nav>
      <button type="button" class="rhea-motion" aria-pressed="true" hidden>Motion</button>
      <div class="rhea-tones" role="group" aria-label="Color tone" hidden>
        {tones.map((tone) => (
          <button type="button" class={`rhea-tone rhea-tone--${tone.id}`} data-tone-choice={tone.id} aria-pressed="false" title={tone.label}>
            <span class="rhea-sr">{tone.label} tone</span>
          </button>
        ))}
      </div>
    </header>

    <main id="rhea-main">
      <section class="rhea-hero" aria-labelledby="rhea-hero-title">
        <div class="rhea-hero__sky" aria-hidden="true">
          <span class="rhea-glow rhea-glow--a"></span>
          <span class="rhea-glow rhea-glow--b"></span>
          <span class="rhea-stars"></span>
        </div>
        <div class="rhea-hero__face" data-kx-reveal="zoom">
          <button class="rhea-hero__poke" type="button" aria-describedby="rhea-greet">
            <RheaFace size={210} label="Rhea, the RHEA assistant" />
          </button>
          <p class="rhea-greet" id="rhea-greet" data-kx="auto" data-kx-loop="off" data-kx-wait="500">Hi, I'm Rhea.</p>
          <p class="rhea-sr" id="rhea-greet-live" role="status"></p>
        </div>
        <p class="rhea-label" data-kx="neon" data-kx-wait="250"><span class="rhea-diamond kx-pulse" aria-hidden="true"></span> In development · Open source · MIT</p>
        <h1 id="rhea-hero-title" data-kx="atoms" data-kx-loop="off" data-kx-wait="450">
          Your Drive, within reach of your assistants.
          <em data-kx="neon" data-kx-wait="2100">And no further.</em>
        </h1>
        <p class="rhea-hero__lead" data-kx-reveal="up" data-kx-delay="900">
          RHEA connects Google Drive to MCP-compatible assistants through one dedicated folder.
          You run the instance, you approve each assistant, and every request is checked against
          the only folder it is allowed to reach.
        </p>
        <p class="rhea-hero__actions" data-kx-reveal="up" data-kx-delay="1300" data-kx-watch>
          <a class="rhea-button rhea-button--primary kx-rim kx-magnet kx-nudge" data-kx-magnet href={REPO} rel="noopener noreferrer">
            View the repository <span aria-hidden="true">↗</span>
          </a>
          <a class="rhea-button kx-glow kx-magnet kx-nudge" data-kx-magnet href={DOCS + 'google-drive-oauth.md'} rel="noopener noreferrer">
            Read the setup guide <span aria-hidden="true">↗</span>
          </a>
        </p>
      </section>

      <section id="overview" class="rhea-section rhea-section--ivory" aria-labelledby="overview-title">
        <div class="rhea-section__head">
          <p class="rhea-eyebrow" data-kx="neon">01 · Overview</p>
          <h2 id="overview-title" data-kx="flip">Four parts, one boundary.</h2>
          <p data-kx-reveal="up" data-kx-delay="500">
            The repository provides the workspace and the gateway source code. Each part can be read,
            run and audited on its own.
          </p>
        </div>
        <ul class="rhea-parts">
          {components.map((part) => (
            <li data-kx-reveal>
              <h3 data-kx="auto">{part.name}</h3>
              <p>{part.text}</p>
              <a href={part.href} rel="noopener noreferrer">Source <span aria-hidden="true">↗</span><span class="rhea-sr"> for {part.name}</span></a>
            </li>
          ))}
        </ul>
      </section>

      <section class="rhea-section rhea-section--white" aria-labelledby="route-title">
        <div class="rhea-section__head">
          <p class="rhea-eyebrow" data-kx="neon">02 · How a request travels</p>
          <h2 id="route-title" data-kx="run">Every hop asks a question.</h2>
          <p data-kx-reveal="up" data-kx-delay="500">
            An assistant never talks to Google directly. Its request passes through checks it cannot
            skip, and the answer can only come from inside the RHEA folder.
          </p>
        </div>
        <ol class="rhea-route" data-kx-watch>
          {route.map((hop, index) => (
            <li style={`--i:${index}`} data-kx-reveal>
              <span class="rhea-route__node">{hop.step}</span>
              <span class="rhea-route__check">{hop.check}</span>
            </li>
          ))}
        </ol>
      </section>

      <section id="boundaries" class="rhea-section rhea-section--forest" aria-labelledby="boundaries-title">
        <div class="rhea-section__head">
          <p class="rhea-eyebrow" data-kx="neon">03 · Boundaries</p>
          <h2 id="boundaries-title" data-kx="melt">Access is narrow by design.</h2>
        </div>
        <dl class="rhea-boundaries">
          {boundaries.map((item) => (
            <div data-kx-reveal>
              <dt data-kx="auto"><span class="rhea-diamond kx-pulse" aria-hidden="true"></span>{item.term}</dt>
              <dd>{item.text}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section id="start" class="rhea-section rhea-section--ivory" aria-labelledby="start-title">
        <div class="rhea-section__head">
          <p class="rhea-eyebrow" data-kx="neon">04 · Get started</p>
          <h2 id="start-title" data-kx="swap">Run your own instance.</h2>
          <p data-kx-reveal="up" data-kx-delay="500">
            Clients such as Claude, ChatGPT and Gemini CLI can connect over remote MCP, subject to each
            client's own plans and eligibility.
          </p>
        </div>
        <ol class="rhea-steps">
          {steps.map((step) => (
            <li data-kx-reveal>
              <h3 data-kx="auto">{step.title}</h3>
              <p>{step.text}</p>
              <a href={step.href} rel="noopener noreferrer">{step.link} <span aria-hidden="true">↗</span></a>
            </li>
          ))}
        </ol>
        <div class="rhea-code" data-kx-reveal="tilt">
          <p class="rhea-code__label" data-kx="neon">Preview the interface locally · Node.js 24</p>
          <pre><code>git clone https://github.com/indiolibanes/RHEA.git
cd RHEA/apps/web
npm ci
npm test
npm run dev</code></pre>
          <p class="rhea-code__note">
            The Drive API, assistant grants and uploads need a deployment with Cloudflare Access and
            your own Google OAuth application.
          </p>
        </div>
      </section>
    </main>

    <footer class="rhea-footer">
      <RheaFace size={56} />
      <p>
        RHEA is open source under the
        <a href={REPO + '/blob/main/LICENSE'} rel="noopener noreferrer">MIT License</a>.
        It is in development, so interfaces and setup may still change.
      </p>
      <p class="rhea-footer__by">
        A project by <a href="/">Kauê Alencar</a> · <a href={REPO} rel="noopener noreferrer">indiolibanes/RHEA</a>
      </p>
    </footer>
    <script>
      import { initRheaLamps } from '../../scripts/rhea-lamps.mjs';
      import { initRheaKinetic } from '../../scripts/rhea-kinetic.mjs';

      initRheaLamps();
      const kinetic = initRheaKinetic();

      const hero = document.querySelector('.rhea-hero');
      if (hero && 'IntersectionObserver' in window) {
        new IntersectionObserver(([entry]) => hero.classList.toggle('is-offscreen', !entry.isIntersecting)).observe(hero);
      }

      const root = document.documentElement;
      const picker = document.querySelector('.rhea-tones');
      const themeColor = document.querySelector('meta[name="theme-color"]');
      const themeColors = { forest: '#0e2a21', earth: '#2a1b11', ivory: '#faf7f0' };
      const reflect = () => {
        for (const button of document.querySelectorAll('[data-tone-choice]')) {
          button.setAttribute('aria-pressed', String(button.dataset.toneChoice === root.dataset.tone));
        }
        themeColor?.setAttribute('content', themeColors[root.dataset.tone] ?? themeColors.forest);
      };
      if (picker) {
        picker.hidden = false;
        picker.addEventListener('click', (event) => {
          const button = event.target.closest('[data-tone-choice]');
          if (!button) return;
          root.dataset.tone = button.dataset.toneChoice;
          try { localStorage.setItem('rhea.tone', root.dataset.tone); } catch {}
          reflect();
          // The tagline relights in the new tone.
          const tagline = document.querySelector('.rhea-hero h1 em');
          if (tagline && kinetic.motionOn()) kinetic.play(tagline, 'in', 'neon');
        });
        reflect();
      }

      // Rhea answers when poked, with the promises the project actually keeps.
      const lines = [
        'Only the RHEA folder. Nothing else in your Drive.',
        'I propose. You decide.',
        'Revoke me whenever you like.',
        'Your instance, your keys.',
        "Hi, I'm Rhea.",
      ];
      const motionButton = document.querySelector('.rhea-motion');
      if (motionButton) {
        motionButton.hidden = false;
        const sync = () => motionButton.setAttribute('aria-pressed', String(kinetic.motionOn()));
        sync();
        motionButton.addEventListener('click', () => {
          kinetic.setMotion(!kinetic.motionOn());
          sync();
        });
      }

      const greet = document.getElementById('rhea-greet');
      const greetLive = document.getElementById('rhea-greet-live');
      const poke = document.querySelector('.rhea-hero__poke');
      let line = 0;
      poke?.addEventListener('click', (event) => {
        if (event.detail === 0) poke.querySelector('[data-rhea-lamps]')?.dispatchEvent(new CustomEvent('rhea:poke'));
        const text = lines[line++ % lines.length];
        if (greet) kinetic.setText(greet, text);
        if (greetLive) greetLive.textContent = text;
      });
    </script>
  </body>
</html>



<style is:global>
  @font-face {
    font-family: 'RHEA Garamond';
    src: url('/rhea/fonts/eb-garamond-latin-400-normal.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'RHEA Garamond';
    src: url('/rhea/fonts/eb-garamond-latin-400-italic.woff2') format('woff2');
    font-weight: 400;
    font-style: italic;
    font-display: swap;
  }
  @font-face {
    font-family: 'RHEA Atkinson';
    src: url('/rhea/fonts/atkinson-regular.woff') format('woff');
    font-weight: 400;
    font-display: swap;
  }
  @font-face {
    font-family: 'RHEA Atkinson';
    src: url('/rhea/fonts/atkinson-bold.woff') format('woff');
    font-weight: 700;
    font-display: swap;
  }
  @font-face {
    font-family: 'RHEA Mono';
    src: url('/rhea/fonts/ibm-plex-mono-latin-400-normal.woff2') format('woff2');
    font-weight: 400;
    font-display: swap;
  }

  /* ---------- Tones: Forest (default), Earth, Ivory ---------- */

  :root {
    --deep: #0e2a21;
    --deep-2: #163b2e;
    --deep-glow: rgba(46, 104, 80, 0.7);
    --deep-glow-2: rgba(233, 199, 91, 0.14);
    --on-deep: #faf7f0;
    --on-deep-muted: rgba(241, 232, 210, 0.8);
    --on-deep-accent: #e9c75b;
    --rule-deep: rgba(201, 161, 62, 0.28);
    --paper: #f1e8d2;
    --paper-2: #faf7f0;
    --heading: #0e2a21;
    --ink: #1c2a24;
    --ink-muted: #4c5a52;
    --ink-accent: #7a5b12;
    --eyebrow: #6a4329;
    --rule-paper: rgba(106, 67, 41, 0.35);
    --node: #f1e8d2;
    --node-end: #0e2a21;
    --node-end-ink: #e9c75b;
    --band: #6a4329;
    --foot: #4a2e1c;
    --on-foot: rgba(241, 232, 210, 0.86);
    --code: #0e2a21;
    --primary: #e9c75b;
    --on-primary: #0e2a21;
    --diamond: #e9c75b;
  }

  :root[data-tone='earth'] {
    --deep: #2a1b11;
    --deep-2: #3a2617;
    --deep-glow: rgba(140, 90, 52, 0.55);
    --deep-glow-2: rgba(31, 74, 58, 0.45);
    --rule-deep: rgba(233, 199, 91, 0.26);
    --paper: #f3eadb;
    --paper-2: #fbf7f0;
    --heading: #3a2617;
    --ink: #2b2019;
    --ink-muted: #5e5045;
    --ink-accent: #7a5b12;
    --eyebrow: #1f4a3a;
    --rule-paper: rgba(58, 38, 23, 0.3);
    --node: #f3eadb;
    --node-end: #3a2617;
    --band: #1f4a3a;
    --foot: #1c120b;
    --code: #2a1b11;
  }

  :root[data-tone='ivory'] {
    color-scheme: light;
    --deep: #faf7f0;
    --deep-2: #ece2c8;
    --deep-glow: rgba(233, 199, 91, 0.32);
    --deep-glow-2: rgba(31, 74, 58, 0.12);
    --on-deep: #0e2a21;
    --on-deep-muted: #3f4d45;
    --on-deep-accent: #7a5b12;
    --rule-deep: rgba(106, 67, 41, 0.32);
    --paper: #f1e8d2;
    --paper-2: #faf7f0;
    --band: #6a4329;
    --foot: #e6d9ba;
    --on-foot: #2b2019;
    --code: #163b2e;
    --primary: #0e2a21;
    --on-primary: #faf7f0;
    --diamond: #c9a13e;
  }

  /* Kinetic colours: neon on deep surfaces is gold (emerald in Ivory); on paper it is emerald. */
  :root {
    --kx-neon-deep: #ffe08a;
    --kx-neon-deep-glow: rgba(233, 199, 91, 0.85);
    --kx-neon-paper: #0c8f62;
    --kx-neon-paper-glow: rgba(60, 214, 150, 0.6);
    --kx-rim-a: #fffaf0;
    --kx-rim-b: #6fe0b0;
  }
  :root[data-tone='earth'] { --kx-rim-b: #ffc46b; }
  :root[data-tone='ivory'] { --kx-neon-deep: #0c8f62; --kx-neon-deep-glow: rgba(60, 214, 150, 0.55); --kx-rim-a: #ffe08a; }

  .rhea-site {
    --serif: 'RHEA Garamond', 'EB Garamond', Garamond, 'Times New Roman', serif;
    --sans: 'RHEA Atkinson', 'Atkinson Hyperlegible', system-ui, sans-serif;
    --mono: 'RHEA Mono', 'IBM Plex Mono', ui-monospace, monospace;
    --gutter: clamp(1.25rem, 5vw, 4rem);
    --label: 0.78rem;
    --h3: 1.55rem;

    margin: 0;
    background: var(--deep);
    color: var(--on-deep);
    font-family: var(--sans);
    font-size: 1.0625rem;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    transition: background-color 240ms ease, color 240ms ease;
  }

  .rhea-site *,
  .rhea-site *::before,
  .rhea-site *::after { box-sizing: border-box; }

  :where(.rhea-site) a { color: inherit; text-underline-offset: 0.22em; text-decoration-thickness: 1px; }
  :where(.rhea-site) a:hover { text-decoration-thickness: 2px; }
  .rhea-site :focus-visible { outline: 2px solid var(--on-deep-accent); outline-offset: 3px; border-radius: 2px; }
  :where(.rhea-site) :is(h1, h2, h3) { font-family: var(--serif); font-weight: 400; margin: 0; text-wrap: balance; }
  :where(.rhea-site) :is(p, dl, dd) { margin: 0; text-wrap: pretty; }

  .rhea-sr {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap;
  }

  .rhea-skip {
    position: absolute; left: 1rem; top: -4rem; z-index: 10;
    padding: 0.6rem 1rem; background: var(--primary); color: var(--on-primary);
  }
  .rhea-skip:focus { top: 1rem; }

  .rhea-diamond {
    display: inline-block; width: 0.5em; height: 0.5em; margin-right: 0.6em;
    background: var(--diamond); transform: rotate(45deg); vertical-align: 0.08em;
  }

  /* Shared label style: eyebrows, nav, buttons and small metadata. */
  .rhea-label,
  .rhea-eyebrow,
  .rhea-bar__nav,
  .rhea-code__label,
  .rhea-footer__by,
  .rhea-greet {
    font-family: var(--mono);
    font-size: var(--label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* ---------- Bar ---------- */
  .rhea-bar {
    position: relative; z-index: 2;
    display: flex; align-items: center; gap: 0.8rem 1.6rem; flex-wrap: wrap;
    padding: 0.9rem var(--gutter);
