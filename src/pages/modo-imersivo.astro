---
import ExperimentalMenu from '../components/ExperimentalMenu.astro';
import '../styles/experimental.css';

const astronautAssetUrl = '/api/sophia/rocket';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content="Sophia em uma experiência tridimensional imersiva." />
    <title>Sophia · Modo Imersivo</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="immersive" data-sophia-immersive data-astronaut-url={astronautAssetUrl}>
      <div class="immersive__stage" data-stage role="img" tabindex="-1" inert aria-label="Sophia astronauta e foguete em três dimensões. Arraste para girar e use a roda ou pinça para aproximar."></div>
      <section class="immersive__intro" data-intro aria-label="Início da jornada da Sophia">
        <div class="immersive__intro-frame" aria-hidden="true"><span>PROJECT SOPHIA</span><span>CELESTIAL FLIGHT · 01</span></div>
        <button class="immersive__start" type="button" data-intro-start aria-label="Iniciar a jornada: Sophia vai ao encontro do foguete">
          <span class="immersive__start-preface">PRESS ANY KEY TO</span>
          <span class="immersive__start-main" aria-hidden="true">START<span class="immersive__start-cursor">_</span></span>
          <span class="immersive__start-touch">OU TOQUE PARA COMEÇAR</span>
        </button>
        <div class="immersive__intro-footer" aria-hidden="true"><span>EST. 2026</span><span>AN INTERACTIVE JOURNEY</span></div>
      </section>
      <div class="immersive__launch-hud" data-launch-hud hidden aria-live="polite" aria-atomic="true">
        <span class="immersive__launch-label" data-countdown-label>PREPARANDO LANÇAMENTO</span>
        <strong class="immersive__countdown" data-countdown></strong>
      </div>
      <div class="immersive__playback" data-playback hidden>
        <button type="button" data-pause aria-pressed="false">Pausar</button>
        <button type="button" data-replay>Repetir lançamento</button>
        <button type="button" data-camera-reset>Redefinir câmera / Auto</button>
      </div>
      <button class="immersive__mute" type="button" data-mute aria-pressed="false">Silenciar sons</button>
      <p class="immersive__audio-status" data-audio-status role="status"></p>
      <ExperimentalMenu />
      <a class="immersive__back" href="/sophia/" aria-label="Voltar à página da Sophia">← Voltar</a>
      <p class="immersive__status" data-status role="status" aria-live="polite">Carregando Sophia…</p>
      <button class="immersive__retry" type="button" data-retry hidden>Tentar novamente</button>
      <noscript><p class="immersive__nojs">Ative JavaScript para visualizar Sophia em 3D.</p></noscript>
    </main>
  </body>
</html>

<style>
  :global(html) { background: #000; color-scheme: dark; }
  :global(body) { margin: 0; min-height: 100svh; overflow: hidden; background: #000; font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  :global(*), :global(*::before), :global(*::after) { box-sizing: border-box; }
  .immersive { position: relative; isolation: isolate; width: 100%; min-height: 100vh; min-height: 100svh; background: #000; color: #e8e8e8; }
  .immersive__stage { position: absolute; inset: 0; background: #000; touch-action: none; outline: none; }
  .immersive__stage[inert] { pointer-events: none; }
  .immersive__stage:focus-visible { outline: 1px solid #8a9bc4; outline-offset: -5px; }
  .immersive__stage :global(canvas) { display: block; width: 100%; height: 100%; }
  .immersive__back, .immersive__retry { position: absolute; z-index: 65; padding: 10px 13px; border: 1px solid #ffffff30; border-radius: 999px; color: #e1e3e9; background: #101014a8; backdrop-filter: blur(8px); font-size: 12px; line-height: 1; text-decoration: none; transition: background 160ms ease; }
  .immersive__back { top: max(19px, env(safe-area-inset-top)); left: max(19px, env(safe-area-inset-left)); }
  .immersive__retry { right: max(19px, env(safe-area-inset-right)); bottom: max(19px, env(safe-area-inset-bottom)); cursor: pointer; }
  .immersive__back:hover, .immersive__retry:hover { background: #303038; }
  .immersive__back:focus-visible, .immersive__retry:focus-visible { outline: 2px solid #aabadd; outline-offset: 3px; }
  .immersive__retry[hidden] { display: none; }
  .immersive__status, .immersive__nojs { position: absolute; z-index: 24; top: 74%; left: 50%; transform: translate(-50%, -50%); margin: 0; color: #bdc5d2; font-size: 13px; text-align: center; max-width: min(80vw, 520px); line-height: 1.6; pointer-events: none; }
  .immersive__status[hidden] { display: none; }
  @font-face { font-family: "Sophia Roguepunk"; src: url("../../assets/fonts/Roguepunk.ttf") format("truetype"); font-style: normal; font-weight: 400; font-display: swap; }
  :global(html), :global(body) { background: #000 !important; background-image: none !important; overflow: hidden; color-scheme: dark; }
  :global(.xm-header) { position: absolute; inset: 0 0 auto; z-index: 70; }
  :global(.xm-drawer) { z-index: 75; }
  .immersive__intro { position: absolute; inset: 0; z-index: 12; display: grid; place-items: center; overflow: hidden; background: #000; transition: opacity 780ms ease, visibility 780ms ease; }
  .immersive__intro::before { content: ""; position: absolute; inset: 0; pointer-events: none; opacity: 0.33; background: repeating-linear-gradient(to bottom, transparent 0 5px, rgba(125,165,205,0.052) 6px); }
  .immersive__intro::after { content: ""; position: absolute; top: 50%; left: 50%; width: min(88vw, 980px); height: 1px; background: linear-gradient(90deg, transparent, rgba(78,207,240,.22), transparent); transform: translate(-50%, 92px); pointer-events: none; }
  .immersive__intro.is-started { opacity: 0; visibility: hidden; pointer-events: none; }
  .immersive__intro-frame, .immersive__intro-footer { position: absolute; right: clamp(24px, 5vw, 74px); left: clamp(24px, 5vw, 74px); display: flex; justify-content: space-between; gap: 18px; color: #9da8b7; font: 600 10px/1.3 ui-monospace, Consolas, monospace; letter-spacing: .25em; }
  .immersive__intro-frame { top: max(45px, env(safe-area-inset-top)); padding-top: 10px; border-top: 1px solid #8792a23c; }
  .immersive__intro-footer { bottom: max(38px, env(safe-area-inset-bottom)); padding-bottom: 10px; border-bottom: 1px solid #8792a23c; }
  .immersive__start { position: relative; display: grid; gap: 5px; justify-items: center; width: min(88vw, 820px); padding: 25px 10px; border: 0; background: transparent; color: #f0ecdf; cursor: pointer; text-align: center; -webkit-tap-highlight-color: transparent; }
  .immersive__start-preface { font: 500 clamp(13px, 2vw, 22px)/1.4 "Sophia Roguepunk", Impact, sans-serif; letter-spacing: .31em; text-shadow: 0 0 22px #5ce0ff38; }
  .immersive__start-main { color: #f8ed37; font: 400 clamp(66px, 14vw, 158px)/.95 "Sophia Roguepunk", Impact, sans-serif; letter-spacing: -.025em; transform: skewX(-6deg); text-shadow: 3px 3px #111, -2px 0 #19d7e2; transition: text-shadow 180ms ease, transform 180ms ease; }
  .immersive__start:hover .immersive__start-main { text-shadow: 4px 4px #f73e8f, -3px -2px #19d7e2, 0 0 42px #f8ed3755; transform: skewX(-8deg) scale(1.025); }
  .immersive__start-cursor { color: #10d9eb; animation: sophia-cursor 1.12s steps(1, end) infinite; }
  .immersive__start-touch { margin-top: 32px; color: #8a98a5; font: 600 10px/1.4 ui-monospace, Consolas, monospace; letter-spacing: .28em; }
  .immersive__start:focus-visible { outline: 2px solid #f8ed37; outline-offset: 5px; }
  @keyframes sophia-cursor { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
  @media (max-width: 650px) { .immersive__intro-frame, .immersive__intro-footer { font-size: 8px; letter-spacing: .13em; } .immersive__intro-frame { top: 115px; } .immersive__start-preface { letter-spacing: .17em; } .immersive__start-touch { letter-spacing: .1em; } .immersive__status { top: 79%; font-size: 11px; } }
  @media (prefers-reduced-motion: reduce) { .immersive__back, .immersive__retry, .immersive__intro, .immersive__start-main { transition: none; } .immersive__start-cursor { animation: none; } }
  .immersive__launch-hud { position: fixed; z-index: 20; left: 50%; top: 50%; transform: translate(-50%,-50%); display: grid; justify-items:center; text-align:center; gap: 10px; pointer-events: none; }
  .immersive__launch-hud[hidden], .immersive__playback[hidden] { display: none; }
  .immersive__launch-label { color: #96aaeb; font: 600 10px/1.5 ui-monospace, monospace; letter-spacing: .18em; }
  .immersive__countdown { min-height: 1em; color: #ebb047; font: 400 clamp(80px, 9vw, 128px)/1 "Sophia Roguepunk", sans-serif; text-shadow: 0 0 22px #ebb04720; }
  .immersive__playback { position: absolute; z-index: 30; left: max(20px, env(safe-area-inset-left)); bottom: max(20px, env(safe-area-inset-bottom)); display: flex; gap: 8px; }
  .immersive__playback button { border: 1px solid #ffffff25; border-radius: 99px; padding: 10px 13px; background: #101014a8; color: #e1e3e9; cursor: pointer; font: 500 11px/1 system-ui, sans-serif; }
  .immersive__playback button:focus-visible { outline: 2px solid #ebb047; outline-offset: 3px; }
  @media(max-width: 650px) { .immersive__launch-hud { max-width:85vw; } .immersive__launch-label { max-width: 150px; font-size: 8px; } .immersive__countdown { font-size: 80px; } }
  .immersive__intro.is-starting .immersive__start { opacity:0; transition:opacity 130ms; pointer-events:none; }
  .immersive__intro.is-starting .immersive__intro-frame, .immersive__intro.is-starting .immersive__intro-footer { opacity:0; }
  .immersive__mute { position:fixed; z-index:72; top:max(22px,env(safe-area-inset-top)); left:max(20px,env(safe-area-inset-left)); border:1px solid #ffffff30; color:#e8e8f0; background:#080a12c0; padding:13px; min-height:44px; border-radius:24px; cursor:pointer; }
  .immersive__mute:focus-visible {outline:2px solid #f8ed37;outline-offset:3px;}
  .immersive__audio-status {position:fixed;left:20px;bottom:66px;z-index:35;max-width:70vw;color:#aeb8ca;font-size:11px;pointer-events:none;}
  .immersive__playback {max-width:calc(100vw - 30px);flex-wrap:wrap;}
  .immersive__playback button {min-height:44px;}
  .immersive__status {z-index:50;}
  .immersive__retry {z-index:51;}
</style>

<script>
  import '../scripts/sophia-immersive-runtime';
</script>
