---
import ExperimentalMenu from '../components/ExperimentalMenu.astro';
import '../styles/experimental.css';

const astronautAssetUrl = '/api/sophia/rocket';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#000000" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content="Sophia em uma experiência tridimensional imersiva." />
    <title>Sophia · Modo Imersivo</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="immersive" data-sophia-immersive data-astronaut-url={astronautAssetUrl}>
      <div class="immersive__stage" data-stage role="region" tabindex="0"
        aria-label="Câmera 3D da plataforma da Sophia"
        aria-describedby="immersive-camera-help"></div>
      <section class="immersive__intro" data-intro aria-labelledby="immersive-question">
        <div class="immersive__intro-card">
          <h1 id="immersive-question" lang="en">ARE YOU READY TO START A NEW JOURNEY?</h1>
          <div class="immersive__decision">
            <button type="button" data-intro-start disabled lang="en">YES</button>
            <button type="button" data-intro-no lang="en">NO</button>
          </div>
          <p class="immersive__choice-status" data-choice-status role="status"></p>
        </div>
      </section>
      <p class="immersive__camera-help" id="immersive-camera-help" data-camera-help>Arraste ou use as setas para girar em 360°</p>
      <div class="immersive__launch-hud" data-launch-hud hidden aria-live="polite" aria-atomic="true" role="status">
        <span class="immersive__launch-label" data-countdown-label lang="en">COUNTDOWN</span>
        <strong class="immersive__countdown" data-countdown></strong>
      </div>
      <div class="immersive__flight-tools">
        <p class="immersive__audio-status" data-audio-status role="status"></p>
        <div class="immersive__playback" data-playback hidden>
          <button type="button" data-pause aria-pressed="false">Pausar</button>
          <button type="button" data-replay>Repetir lançamento</button>
          <button type="button" data-camera-reset>Redefinir câmera / Auto</button>
        </div>
      </div>
      <div class="immersive__navigation">
        <a class="immersive__back" href="/sophia/" aria-label="Voltar à página da Sophia">← Voltar</a>
        <button class="immersive__mute" type="button" data-mute aria-pressed="false">Silenciar sons</button>
      </div>
      <ExperimentalMenu />
      <p class="immersive__status" data-status role="status">Carregando Sophia…</p>
      <button class="immersive__retry" type="button" data-retry hidden>Tentar novamente</button>
      <noscript><p class="immersive__nojs">Ative JavaScript para visualizar Sophia em 3D.</p></noscript>
    </main>
  </body>
</html>

<style>
  :global(html) { background: #000; color-scheme: dark; }
  :global(body) { margin: 0; min-height: 100svh; overflow: hidden; background: #000; font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  :global(*), :global(*::before), :global(*::after) { box-sizing: border-box; }
  .immersive { position: relative; isolation: isolate; width: 100%; min-height: 100vh; min-height: 100svh; background: #000; color: #e8e8e8; }
  .immersive__stage {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 67%, #231b1f 0%, #101017 42%, #06070a 81%);
    touch-action: none;
    outline: none;
  }
  .immersive__stage:not([data-scene-ready]) {
    background: radial-gradient(ellipse at 50% 42%, #262134, #09080f 69%);
  }
  .immersive__stage:not([data-scene-ready])::before {
    content: "";
    position: absolute;
    inset: 12% 4% 25%;
    background: url("/assets/immersive-banner/sophia-rocket-still.webp") center / contain no-repeat;
    opacity: .62;
  }
  .immersive__stage:not([data-scene-ready]) :global(canvas) { visibility: hidden; }
  .immersive__stage:focus-visible { outline: 1px solid #8a9bc4; outline-offset: -5px; }
  .immersive__stage :global(canvas) { display: block; width: 100%; height: 100%; }
  .immersive__back, .immersive__retry { position: absolute; z-index: 65; padding: 10px 13px; border: 1px solid #ffffff30; border-radius: 999px; color: #e1e3e9; background: #101014a8; backdrop-filter: blur(8px); font-size: 12px; line-height: 1; text-decoration: none; transition: background 160ms ease; }
  .immersive__navigation {
    position: absolute;
    z-index: 65;
    top: max(19px, env(safe-area-inset-top));
    left: max(12px, env(safe-area-inset-left));
    right: max(108px, calc(env(safe-area-inset-right) + 100px));
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    pointer-events: none;
  }
  .immersive__back, .immersive__mute {
    position: static;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    pointer-events: auto;
  }
  .immersive__retry { left: 50%; transform: translateX(-50%); top: max(168px, calc(env(safe-area-inset-top) + 155px)); cursor: pointer; }
  .immersive__back:hover, .immersive__retry:hover { background: #303038; }
  .immersive__back:focus-visible, .immersive__retry:focus-visible { outline: 2px solid #aabadd; outline-offset: 3px; }
  .immersive__retry[hidden] { display: none; }
  .immersive__status, .immersive__nojs {
    position: absolute;
    z-index: 50;
    top: max(76px, calc(env(safe-area-inset-top) + 62px));
    left: 50%;
    transform: translateX(-50%);
    width: min(88vw, 420px);
    margin: 0;
    padding: 8px 14px;
    border-radius: 12px;
    color: #f2ebdd;
    background: #171421e8;
    font-size: .875rem;
    text-align: center;
    pointer-events: none;
  }
  .immersive__status[hidden], .immersive__intro[hidden],
  .immersive__camera-help[hidden], .immersive__launch-hud[hidden], .immersive__playback[hidden] { display: none; }
  .immersive__intro {
    position: absolute;
    z-index: 32;
    right: max(12px, env(safe-area-inset-right));
    bottom: max(14px, env(safe-area-inset-bottom));
    left: max(12px, env(safe-area-inset-left));
    display: grid;
    justify-items: center;
    pointer-events: none;
  }
  .immersive__intro-card {
    display: grid;
    justify-items: center;
    gap: 12px;
    width: min(100%, 550px);
    padding: clamp(15px, 3vmin, 27px) clamp(15px, 4vmin, 36px);
    border: 1px solid #d9b67e58;
    border-radius: 20px;
    background: linear-gradient(155deg, #24202cea, #100e16f5 75%);
    box-shadow: 0 18px 70px #0009;
    text-align: center;
  }
  .immersive__intro h1 {
    max-width: 19ch;
    margin: 0;
    color: #fff1d1;
    font: 500 clamp(1.3rem, 4vmin, 2.25rem)/1.02 Georgia, serif;
    letter-spacing: .035em;
    text-wrap: balance;
  }
  .immersive__decision { display: grid; grid-template-columns: repeat(2, minmax(98px, 1fr)); gap: 10px; }
  .immersive__decision button {
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid #d9b67e80;
    border-radius: 10px;
    background: #28222d;
    color: #fff1d7;
    font: 700 .85rem/1 system-ui, sans-serif;
    letter-spacing: .12em;
    pointer-events: auto;
    cursor: pointer;
  }
  .immersive__decision [data-intro-start] { background: #f2cd8e; color: #231812; border-color: #f2cd8e; }
  .immersive__decision button:hover:not(:disabled) { filter: brightness(1.15); }
  .immersive__decision button:focus-visible { outline: 2px solid #fff4d7; outline-offset: 3px; }
  .immersive__decision button:disabled { opacity: .55; cursor: wait; }
  .immersive__choice-status { margin: 0; color: #e6d9c9; font-size: .875rem; }
  .immersive__choice-status:empty { display: none; }
  .immersive__camera-help {
    position: fixed;
    z-index: 13;
    top: max(22px, env(safe-area-inset-top));
    left: 50%;
    width: max-content;
    max-width: calc(100% - 40px);
    transform: translateX(-50%);
    margin: 0;
    padding: 7px 12px;
    border-radius: 999px;
    background: #16121ddd;
    color: #eee5d6;
    font-size: .875rem;
    pointer-events: none;
  }
  .immersive__launch-hud {
    position: fixed;
    z-index: 25;
    top: max(75px, calc(env(safe-area-inset-top) + 66px));
    left: 50%;
    transform: translateX(-50%);
    display: grid;
    justify-items: center;
    gap: 6px;
    min-width: 120px;
    padding: 10px 16px;
    border: 1px solid #eac98a6b;
    border-radius: 16px;
    color: #fff3d6;
    background: #1a121bd9;
    box-shadow: 0 15px 35px #0005;
    pointer-events: none;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .immersive__launch-label { font: 700 .875rem/1.3 system-ui, sans-serif; letter-spacing: .065em; }
  .immersive__countdown { font: 500 clamp(2.75rem, 9vmin, 5rem)/.95 Georgia, serif; }
  @media (max-width: 850px) {
    .immersive__camera-help { top: max(88px, calc(env(safe-area-inset-top) + 76px)); }
    .immersive__status { top: max(118px, calc(env(safe-area-inset-top) + 106px)); }
  }
  @media (max-height: 480px) and (orientation: landscape) {
    .immersive__intro { justify-items: end; }
    .immersive__intro-card { width: min(36vw, 330px); }
  }
  .immersive__flight-tools {
    position: absolute;
    z-index: 30;
    left: max(12px, env(safe-area-inset-left));
    right: max(12px, env(safe-area-inset-right));
    bottom: max(12px, env(safe-area-inset-bottom));
    display: grid;
    gap: 6px;
    pointer-events: none;
  }
  .immersive__playback { display: flex; flex-wrap: wrap; gap: 6px; }
  .immersive__playback button { pointer-events: auto; }
  .immersive__playback button { border: 1px solid #ffffff25; border-radius: 99px; padding: 10px 13px; background: #101014a8; color: #e1e3e9; cursor: pointer; font: 500 11px/1 system-ui, sans-serif; }
  .immersive__playback button:focus-visible { outline: 2px solid #ebb047; outline-offset: 3px; }
  .immersive__mute { border:1px solid #ffffff30; color:#e8e8f0; background:#080a12c0; padding: 0 12px; font: 500 12px/1 system-ui, sans-serif; border-radius:24px; cursor:pointer; }
  .immersive__mute:focus-visible {outline:2px solid #f8ed37;outline-offset:3px;}
  .immersive__audio-status { margin: 0; max-width: 40ch; color: #aeb8ca; font-size: 12px; }
  .immersive__audio-status:empty { display: none; }
  .immersive__playback button {min-height:44px;}
  .immersive__status {z-index:50;}
  .immersive__retry {z-index:51;}
</style>

<script>
  import '../scripts/sophia-immersive-runtime';
</script>
