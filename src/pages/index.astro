---
import BaseLayout from '../layouts/BaseLayout.astro';
import MusicShelf from '../components/MusicShelf.astro';
import { PROFILE, SOCIALS } from '../config';

const lab = [
  [
    'Escrita & edição',
    'Pesquisar, sintetizar e revisar com atenção à clareza, ao ritmo e à precisão conceitual.',
  ],
  [
    'Documentação',
    'Transformar conhecimento disperso em informação legível, rastreável e reutilizável.',
  ],
  [
    'Organização',
    'Criar estruturas, taxonomias e fluxos que reduzam a dependência de memória individual.',
  ],
  [
    'Publicação digital',
    'Usar tecnologia como meio para manter conteúdo consistente entre escrita, versão e entrega.',
  ],
];

const background = [
  {
    title: 'Formação',
    text: 'Curso técnico em Automação Industrial, experiência anterior em suporte e TI e formação complementar em UX Design.',
  },
  {
    title: 'Direção atual',
    text: 'Escrita, documentação técnica, gestão da informação, pesquisa e organização do conhecimento.',
  },
  {
    title: 'Método',
    text: 'Aprendizado autodidata, engenharia reversa e o esforço de tornar explícitas as relações que fundamentam um sistema.',
  },
];
---

<BaseLayout>
  <main class="portfolio-main">

    <section
      class="hero"
      id="sobre"
      aria-labelledby="hero-title"
    >
      <div class="hero-intro">

        <p class="hello">
          <span
            class="pixel-mushroom"
            aria-hidden="true"
          >
            <svg viewBox="0 0 16 16">
              <rect x="5" y="1" width="6" height="1"></rect>
              <rect x="3" y="2" width="10" height="1"></rect>
              <rect x="2" y="3" width="12" height="1"></rect>
              <rect x="1" y="4" width="14" height="3"></rect>

              <rect
                class="mushroom-spot"
                x="4"
                y="4"
                width="2"
                height="2"
              ></rect>

              <rect
                class="mushroom-spot"
                x="10"
                y="5"
                width="2"
                height="2"
              ></rect>

              <rect
                x="3"
                y="7"
                width="10"
                height="1"
              ></rect>

              <rect
                class="mushroom-stem"
                x="5"
                y="8"
                width="6"
                height="1"
              ></rect>

              <rect
                class="mushroom-stem"
                x="4"
                y="9"
                width="8"
                height="4"
              ></rect>

              <rect
                class="mushroom-stem"
                x="5"
                y="13"
                width="6"
                height="1"
              ></rect>
            </svg>
          </span>

          <span>Hello, it's me</span>
        </p>

        <div class="identity-cluster">

          <div
            class="prism-stage"
            aria-hidden="true"
          >
            <span class="prism-stage-glow"></span>

            <svg
              class="prism-mark"
              viewBox="0 0 600 260"
              preserveAspectRatio="xMidYMid meet"
            >
              <defs>
                <linearGradient
                  id="prism-glass"
                  x1="0"
                  x2="1"
                  y1="0"
                  y2="1"
                >
                  <stop
                    offset="0%"
                    stop-color="#f5f1e9"
                    stop-opacity="0.10"
                  />

                  <stop
                    offset="55%"
                    stop-color="#9cabb5"
                    stop-opacity="0.035"
                  />

                  <stop
                    offset="100%"
                    stop-color="#ffffff"
                    stop-opacity="0.015"
                  />
                </linearGradient>
              </defs>

              <line
                class="beam-in"
                x1="18"
                y1="130"
                x2="248"
                y2="130"
              ></line>

              <polygon
                class="prism-body"
                points="250,42 366,130 250,218"
                fill="url(#prism-glass)"
              ></polygon>

              <line
                class="beam-out beam-red"
                x1="366"
                y1="130"
                x2="582"
                y2="62"
              ></line>

              <line
                class="beam-out beam-orange"
                x1="366"
                y1="130"
                x2="582"
                y2="84"
              ></line>

              <line
                class="beam-out beam-yellow"
                x1="366"
                y1="130"
                x2="582"
                y2="106"
              ></line>

              <line
                class="beam-out beam-green"
                x1="366"
                y1="130"
                x2="582"
                y2="130"
              ></line>

              <line
                class="beam-out beam-blue"
                x1="366"
                y1="130"
                x2="582"
                y2="154"
              ></line>

              <line
                class="beam-out beam-violet"
                x1="366"
                y1="130"
                x2="582"
                y2="178"
              ></line>
            </svg>
          </div>

          <div class="name-brick-plate">
            <span
              class="gold-block"
              aria-hidden="true"
            ></span>

            <h1
              id="hero-title"
              class="block-name"
            >
              {PROFILE.name}
            </h1>
          </div>

          <p class="role">
            Escrita · Documentação · Informação
          </p>

        </div>
      </div>

      <div class="hero-statement">
        <p class="eyebrow">
          Sobre
        </p>

        <h2>
          Escrevo para dar forma às ideias — e documento para que elas permaneçam úteis depois.
        </h2>

        <p>
          Meu interesse reside no intervalo entre uma ideia ainda difusa e uma forma
          que possa ser lida, encontrada e reutilizada: pesquisar, escrever,
          estruturar, documentar e revisar.
          A escrita é o ponto de partida; a documentação permite que o conhecimento
          permaneça compreensível, verificável e atualizável para outras pessoas.
        </p>

        <div class="hero-actions">
          <a
            class="button primary-button"
            href="#projetos"
          >
            Ver projetos ↓
          </a>

          <a
            class="button soft-button"
            href={PROFILE.linkedin}
            target="_blank"
            rel="noreferrer"
          >
            LinkedIn ↗
          </a>
        </div>
      </div>

      <aside
        class="hero-note"
        aria-label="Resumo profissional"
      >
        <span
          class="tape"
          aria-hidden="true"
        ></span>

        <p class="note-label">
          Em uma simples soma
        </p>

        <p class="note-big">
          linguagem + estrutura + contexto
        </p>

        <p class="note-small">
          Tecnologia é bem-vinda quando auxilia na preservação,
          organização e publicação desses três.
        </p>
      </aside>
    </section>

    <section
      class="projects section github-showcase"
      id="projetos"
      aria-labelledby="projects-title"
    >
      <div class="section-heading github-heading">
        <div>
          <p class="eyebrow">
            GitHub
          </p>

          <h2 id="projects-title">
            O trabalho também está no código.
          </h2>
        </div>

        <p>
          Este próprio portfólio é um projeto aberto: arquitetura de conteúdo,
          identidade visual, documentação e integrações construídas em público.
          O repositório registra não apenas o resultado, mas também as decisões.
        </p>
      </div>

      <a
        class="github-feature"
        href={SOCIALS.portfolioRepo}
        target="_blank"
        rel="noreferrer"
        aria-label="Abrir o repositório público deste portfólio no GitHub"
      >
        <div class="github-feature-copy">
          <div class="github-feature-owner">
            <img
              src={SOCIALS.githubAvatar}
              alt=""
              width="58"
              height="58"
              loading="lazy"
            />

            <div>
              <span class="github-overline">
                repositório público
              </span>

              <strong>
                @indiolibanes / portfolio
              </strong>
            </div>
          </div>

          <h3>
            Um portfólio que documenta a própria construção.
          </h3>

          <p>
            Astro, Cloudflare Pages, Git, integrações externas e uma interface
            editorial tratada como sistema — não como template.
          </p>

          <div class="github-tags" aria-label="Tecnologias e temas">
            <span>Astro</span>
            <span>Cloudflare</span>
            <span>Git</span>
            <span>Documentação</span>
          </div>

          <span class="github-cta">
            Ver código e histórico de commits
            <span aria-hidden="true">↗</span>
          </span>
        </div>

        <div
          class="github-visual"
          aria-hidden="true"
        >
          <div class="github-window">
            <div class="github-window-bar">
              <span></span>
              <span></span>
              <span></span>

              <div class="github-window-title">
                indiolibanes/portfolio
              </div>
            </div>

            <div class="github-code">
              <span class="code-line code-line-1"></span>
              <span class="code-line code-line-2"></span>
              <span class="code-line code-line-3"></span>
              <span class="code-line code-line-4"></span>
              <span class="code-line code-line-5"></span>
              <span class="code-line code-line-6"></span>
            </div>

            <svg
              class="github-mark-large"
              viewBox="0 0 24 24"
            >
              <path
                fill="currentColor"
                d="M12 .297C5.373.297 0 5.67 0 12.297c0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.334-1.756-1.334-1.756-1.09-.745.083-.729.083-.729 1.205.084 1.84 1.237 1.84 1.237 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.303-5.466-1.332-5.466-5.93 0-1.31.468-2.381 1.235-3.221-.123-.303-.535-1.523.117-3.176 0 0 1.008-.322 3.301 1.23a11.51 11.51 0 0 1 3.003-.404c1.018.005 2.044.138 3.003.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.873.119 3.176.77.84 1.233 1.911 1.233 3.221 0 4.61-2.805 5.624-5.475 5.921.43.371.823 1.102.823 2.222 0 1.606-.015 2.898-.015 3.293 0 .322.216.694.825.576C20.565 22.093 24 17.598 24 12.297 24 5.67 18.627.297 12 .297Z"
              ></path>
            </svg>

            <div class="github-commit-note">
              <span class="commit-dot"></span>
              <span>main</span>
              <span>public</span>
            </div>
          </div>
        </div>
      </a>
    </section>

    <section
      class="lab section"
      id="lab"
      aria-labelledby="lab-title"
    >
      <div class="lab-heading">
        <p class="eyebrow">
          Laboratório
        </p>

        <h2 id="lab-title">
          O que faço
        </h2>

        <p>
          Quatro práticas se entrelaçam:
          compreender, escrever, estruturar
          e manter o resultado utilizável.
        </p>
      </div>

      <div class="lab-grid">
        {lab.map(([title, text], index) => (
          <article
            class:list={[
              'lab-card',
              `lab-${index + 1}`,
            ]}
          >
            <span>
              {String(index + 1).padStart(2, '0')}
            </span>

            <h3>
              {title}
            </h3>

            <p>
              {text}
            </p>
          </article>
        ))}
      </div>
    </section>

    <section
      class="background section"
      id="percurso"
      aria-labelledby="background-title"
    >
      <div class="background-title">
        <p class="eyebrow">
          Percurso
        </p>

        <h2 id="background-title">
          Base técnica; vocação editorial.
        </h2>
      </div>

      <div class="background-list">
        {background.map((item, index) => (
          <article>
            <span class="background-number">
              {String(index + 1).padStart(2, '0')}
            </span>

            <div>
              <h3>
                {item.title}
              </h3>

              <p>
                {item.text}
              </p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <MusicShelf />

    <section
      class="closing section"
      aria-labelledby="closing-title"
    >
      <div class="closing-copy">
        <p class="eyebrow">
          Contato
        </p>

        <h2 id="closing-title">
          ✒️ Toda boa página tem origem em uma boa estrutura imaginativa.
        </h2>

        <p>
          Posso detalhar qualquer texto, projeto,
          decisão de estrutura ou processo apresentado aqui.
        </p>

        <a
          class="button primary-button"
          href={PROFILE.linkedin}
          target="_blank"
          rel="noreferrer"
        >
          Entrar em contato pelo LinkedIn ↗
        </a>
      </div>

      <div
        class="triforce-stage"
        aria-hidden="true"
      >
        <span class="triforce-glow"></span>

        <svg
          class="triforce-mark"
          viewBox="0 0 240 210"
          role="presentation"
        >
          <polygon
            class="triforce-piece triforce-top"
            points="120,16 70,102 170,102"
          ></polygon>

          <polygon
            class="triforce-piece triforce-left"
            points="70,102 20,188 120,188"
          ></polygon>

          <polygon
            class="triforce-piece triforce-right"
            points="170,102 120,188 220,188"
          ></polygon>
        </svg>
      </div>
    </section>

  </main>
</BaseLayout>
