---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROFILE } from '../config';

const projects = [
  {
    number: '01',
    label: 'Arquitetura de conteúdo',
    title: 'Sistema editorial independente',
    text: 'Estrutura de conteúdo, metadados e publicação estática para um arquivo autoral de longa duração.',
    tags: ['Astro', 'Markdown', 'Taxonomia'],
    tone: 'sun',
  },
  {
    number: '02',
    label: 'Workflow',
    title: 'Craft → Git → Web',
    text: 'Separação entre ambiente de escrita, fonte canônica, versionamento e camada de apresentação.',
    tags: ['Craft', 'Git', 'Automação'],
    tone: 'mint',
  },
  {
    number: '03',
    label: 'Gestão da informação',
    title: 'Biblioteca de leituras e notas',
    text: 'Organização de referências, citações e notas para reduzir duplicação e explicitar relações entre conteúdos.',
    tags: ['Metadados', 'Pesquisa', 'Curadoria'],
    tone: 'rose',
  },
];

const lab = [
  ['Documentação', 'Transformar conhecimento disperso em informação legível, rastreável e reutilizável.'],
  ['Organização', 'Criar estruturas, taxonomias e fluxos que reduzam dependência de memória individual.'],
  ['Escrita & edição', 'Pesquisar, sintetizar e revisar com atenção à clareza e à precisão conceitual.'],
  ['Publicação digital', 'Usar tecnologia como meio para manter conteúdo consistente entre escrita, versão e entrega.'],
];

const background = [
  {
    title: 'Base técnica',
    text: 'Formação em Automação Industrial e experiência anterior em ambientes de suporte e TI.',
  },
  {
    title: 'Direção atual',
    text: 'Documentação técnica, gestão da informação, escrita, pesquisa e organização do conhecimento.',
  },
  {
    title: 'Método',
    text: 'Aprender por conta própria, decompor problemas e tornar explícitas as relações que sustentam um sistema.',
  },
];
---

<BaseLayout>
  <main class="portfolio-main">
    <section class="hero" id="sobre" aria-labelledby="hero-title">
      <div class="hero-intro">
        <p class="hello">👋 Olá, eu sou</p>
        <h1 id="hero-title">{PROFILE.name}</h1>
        <p class="role">Documentação · Informação · Escrita</p>
      </div>

      <div class="hero-statement">
        <p class="eyebrow">Sobre</p>
        <h2>Organizo conhecimento para que ele continue útil depois de sair da cabeça de quem o criou.</h2>
        <p>
          Meu interesse está no intervalo entre uma ideia e sua forma final: pesquisar, estruturar,
          documentar, revisar e construir sistemas em que outras pessoas consigam encontrar e compreender
          o que precisam.
        </p>
        <div class="hero-actions">
          <a class="button primary-button" href="#projetos">Ver projetos ↓</a>
          <a class="button soft-button" href={PROFILE.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>
        </div>
      </div>

      <aside class="hero-note" aria-label="Resumo profissional">
        <span class="tape" aria-hidden="true"></span>
        <p class="note-label">Em poucas palavras</p>
        <p class="note-big">clareza + estrutura + contexto</p>
        <p class="note-small">Tecnologia entra quando ajuda a preservar esses três.</p>
      </aside>
    </section>

    <section class="projects section" id="projetos" aria-labelledby="projects-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Projetos</p>
          <h2 id="projects-title">Trabalho selecionado</h2>
        </div>
        <p>
          Projetos autorais usados como laboratório para documentação, organização do conhecimento e publicação.
          O foco é mostrar processo e critério, não fabricar senioridade.
        </p>
      </div>

      <div class="project-list">
        {projects.map((project) => (
          <article class:list={['project-card', `tone-${project.tone}`]}>
            <div class="project-number">{project.number}</div>
            <div class="project-copy">
              <p class="project-label">{project.label}</p>
              <h3>{project.title}</h3>
              <p>{project.text}</p>
              <div class="tag-row">
                {project.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </div>
            <div class="project-arrow" aria-hidden="true">↗</div>
          </article>
        ))}
      </div>
    </section>

    <section class="lab section" id="lab" aria-labelledby="lab-title">
      <div class="lab-heading">
        <p class="eyebrow">Laboratório</p>
        <h2 id="lab-title">O que eu faço</h2>
        <p>
          Quatro capacidades que se sobrepõem: compreender o material, dar-lhe estrutura,
          comunicá-lo e manter o resultado utilizável.
        </p>
      </div>

      <div class="lab-grid">
        {lab.map(([title, text], index) => (
          <article class:list={['lab-card', `lab-${index + 1}`]}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="background section" id="percurso" aria-labelledby="background-title">
      <div class="background-title">
        <p class="eyebrow">Percurso</p>
        <h2 id="background-title">Perfil técnico; inclinação editorial.</h2>
      </div>

      <div class="background-list">
        {background.map((item, index) => (
          <article>
            <span class="background-number">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="closing section" aria-labelledby="closing-title">
      <p class="eyebrow">Contato</p>
      <h2 id="closing-title">Um portfólio também é uma conversa.</h2>
      <p>Posso detalhar qualquer projeto, decisão de estrutura ou processo apresentado aqui.</p>
      <a class="button primary-button" href={PROFILE.linkedin} target="_blank" rel="noreferrer">Conversar pelo LinkedIn ↗</a>
    </section>
  </main>
</BaseLayout>
