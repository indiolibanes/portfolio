---
import BaseLayout from '../layouts/BaseLayout.astro';
import MusicShelf from '../components/MusicShelf.astro';
import ExperimentalShowcase from '../components/ExperimentalShowcase.astro';
import TriforceSystem from '../components/TriforceSystem.astro';
import CosmicStarfield from '../components/CosmicStarfield.astro';
import HeroMicroInteractions from '../components/HeroMicroInteractions.astro';
import SophiaSigil from '../components/SophiaSigil.astro';
import MotionImage from '../components/MotionImage.astro';
import SophiaAnimation from '../components/SophiaAnimation.astro';
import MethodPresenter from '../components/MethodPresenter.astro';
import MarioNameTiles from '../components/MarioNameTiles.astro';
import SophiaCorrida from '../components/SophiaCorrida.astro';
import { PROFILE, SOCIALS } from '../config';
import { sectionNumber } from '../section-order';

const background = [
  {
    meta: '2020–2021 · Awari',
    title: 'UX Design',
    text: 'Curso intensivo complementar concluído com méritos, com prática em pesquisa, experiência do usuário, arquitetura de informação e construção de interfaces.',
    mark: '/assets/percurso-awari-oficial.svg',
    markAlt: 'Awari',
    projectUrl: 'https://www.behance.net/gallery/119235467/My-Debut-UX-Project',
  },
  {
    meta: 'Formação técnica · SENAI',
    title: 'Automação Industrial',
    text: 'Base em processos, lógica e documentação técnica — repertório que ainda informa a forma como organizo sistemas.',
    mark: '/assets/percurso-senai-oficial.svg',
    markAlt: 'SENAI',
  },
  {
    meta: 'Fev/2020–Fev/2022 · MPF/RO',
    title: 'Procuradoria da República em Rondônia',
    text: 'Estágio de nível superior em suporte de TI durante a graduação em Ciência da Computação na Universidade Federal de Rondônia, com atendimento a servidores, rotinas técnicas e resolução de problemas.',
    mark: '/assets/percurso-mpf-oficial.svg',
    markAlt: 'Ministério Público Federal',
  },
  {
    meta: 'Direção atual',
    title: 'Escrita e documentação',
    text: 'Technical Writing, gestão da informação, pesquisa e organização do conhecimento como eixo principal do trabalho.',
    mark: '/assets/percurso-writer.svg',
    markAlt: '',
  },
];

// Etapas do método como fluxogramas “à mão”: três passos, uma decisão (com laço de retorno) e a entrega.
const METHOD_FLOWS = [
  { colors: ['#f6cf5b', '#f4a85f', '#efe08a', '#b9d98a'], decision: '#fff1b8', stroke: '#8a6414',
    nodes: ['Objetivo', 'Referências', 'Linguagem e tom'], ask: 'Critérios claros?', end: 'Arquitetura da informação', back: 'não: refinar',
    label: 'Objetivo, referências e linguagem e tom; decisão: critérios claros? Se não, refinar; se sim, arquitetura da informação.' },
  { colors: ['#8cc8ee', '#6fd0d6', '#a9bdf0', '#8ee0b4'], decision: '#d8eefb', stroke: '#2a6f98',
    nodes: ['Prompt e restrições', 'IA prototipa', 'Eu reviso o código'], ask: 'Dentro das regras?', end: 'Versão candidata', back: 'não: reescrever',
    label: 'Prompt e restrições, IA prototipa, eu reviso o código; decisão: dentro das regras? Se não, reescrever; se sim, versão candidata.' },
  { colors: ['#f2a1bb', '#f6b58f', '#e9a0d8', '#f2d27a'], decision: '#fde3ec', stroke: '#9a3d5e',
    nodes: ['Hierarquia', 'Legibilidade', 'Comportamento'], ask: 'Passou no teste?', end: 'Limites registrados', back: 'não: corrigir',
    label: 'Hierarquia, legibilidade e comportamento; decisão: passou no teste? Se não, corrigir; se sim, limites registrados.' },
  { colors: ['#b9a2ee', '#9fb0f2', '#d3a4ea', '#e8c4f0'], decision: '#ece3fb', stroke: '#5f469c',
    nodes: ['Decisão registrada', 'Fluxo mapeado', 'Commit e docs'], ask: 'Alguém retoma?', end: 'Conhecimento transferido', back: 'não: detalhar',
    label: 'Decisão registrada, fluxo mapeado, commit e documentação; decisão: alguém consegue retomar? Se não, detalhar; se sim, conhecimento transferido.' },
];
---

<BaseLayout>
  <main class="portfolio-main" id="conteudo">
      <div class="editorial-masthead" aria-label="Apresentação"><span>Portfólio pessoal</span><span>Escrita · estrutura · curiosidade</span></div>

    <section
      class="hero"
      id="sobre"
      aria-labelledby="hero-title"
    >
      <div class="hero-intro" data-reveal>

        <p class="hello">
          <span
            class="pixel-mushroom"
            aria-hidden="true"
          >
            <svg viewBox="0 0 16 16">
              <rect x="5" y="1" width="6" height="1"></rect>
              <rect x="3" y="2" width="10" height="1"></rect>
              <rect x="2" y="3" width="12" height="1"></rect>
              <rect x="1" y="4" width="14" height="3"></rect>

              <rect
                class="mushroom-spot"
                x="4"
                y="4"
                width="2"
                height="2"
              ></rect>

              <rect
                class="mushroom-spot"
                x="10"
                y="5"
                width="2"
                height="2"
              ></rect>

              <rect
                x="3"
                y="7"
                width="10"
                height="1"
              ></rect>

              <rect
                class="mushroom-stem"
                x="5"
                y="8"
                width="6"
                height="1"
              ></rect>

              <rect
                class="mushroom-stem"
                x="4"
                y="9"
                width="8"
                height="4"
              ></rect>

              <rect
                class="mushroom-stem"
                x="5"
                y="13"
                width="6"
                height="1"
              ></rect>
            </svg>
          </span>

          <span lang="en">Hello, it's me</span>
        </p>

        <div class="identity-cluster">
          <div class="hero-cover-art" data-decorative-motion data-reveal="iris" aria-hidden="true">
            <img
              src="/dark-side-prism.jpg"
              alt=""
              width="1536"
              height="864"
              loading="eager"
              decoding="async"
            />
            <svg class="prism-spectrum" viewBox="0 0 1200 750" preserveAspectRatio="none" aria-hidden="true">
              <defs>
                <filter id="prism-pulse-glow" x="-20%" y="-200%" width="140%" height="500%"><feGaussianBlur stdDeviation="5" /></filter>
                <linearGradient id="prism-core-light" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#fff" stop-opacity=".55" /><stop offset="1" stop-color="#fff" stop-opacity="0" /></linearGradient>
              </defs>
              <polygon points="675,283 1200,379 1200,507 731,367" fill="#000" />
              <path class="prism-beam-pulse prism-beam-pulse--glow" d="M0 447 L513 317" pathLength="100" filter="url(#prism-pulse-glow)" />
              <path class="prism-beam-pulse" d="M0 447 L513 317" pathLength="100" />
              <polygon class="prism-core" points="513,317 675,283 731,367" fill="url(#prism-core-light)" />
              {['#ef284b','#ff9636','#fff34e','#78cd57','#22bce8','#a061cf'].map((color, i) => (
                <path class="prism-ray" style={`--ray:${i};stroke:${color}`} d={`M ${686+i*7} ${296+i*13} L 1200 ${389+i*20}`} />
              ))}
            </svg>
          </div>

          <div class="name-brick-plate">
            <MarioNameTiles />

            <h1
              id="hero-title"
              class="block-name"
            >
              {PROFILE.name}
            </h1>
          </div>

          <p class="role">
            <i lang="en">Technical Writing</i> · Documentação · Informação
          </p>

        </div>
      </div>

      <div class="hero-statement" data-reveal>
        <p class="eyebrow">
          {sectionNumber('sobre')} / Sobre · Uma forma de pensar
        </p>

        <div class="hero-question">
          <p>Como fazer um conhecimento espalhado poder ser encontrado e reaproveitado?</p>
        </div>

        <h2>
          Escrevo para dar forma às ideias — e documento para que elas permaneçam compreensíveis depois.
        </h2>

        <p>
          Meu interesse reside no intervalo entre uma ideia ainda difusa e uma forma que possa ser lida, encontrada e reaproveitada:
          pesquisar, escrever, estruturar, documentar e revisar. A escrita é o ponto de partida; a documentação permite que o
          conhecimento permaneça compreensível, verificável e compartilhável, enquanto a revisão possibilita ao conteúdo estar
          sempre atualizado.
        </p>
        <p class="hero-current">
          <strong>Agora:</strong> traduzindo <cite lang="en">The Big Picture</cite> e documentando fluxos de publicação.
        </p>

        <div class="hero-actions">
          <a class="button editorial-primary" href="#lab">
            Explorar trabalhos <span aria-hidden="true">↘</span>
          </a>
          <a class="editorial-text-link" href="#contato">Vamos conversar <span aria-hidden="true">↘</span></a>
          <a
            class="cv-download-button"
            href={PROFILE.resumePdf}
            download="Kaue-Alencar-Curriculo.pdf"
          >
            Currículo PDF <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>

      <div class="hero-ornaments" aria-hidden="true">
        <HeroMicroInteractions />
      </div>

      <aside
        class="hero-note"
        data-reveal
        aria-label="Resumo profissional"
      >
        <span
          class="tape"
          aria-hidden="true"
        ></span>

        <p class="note-label">
          Em uma simples soma
        </p>

        <p class="note-big">
          linguagem + estrutura + contexto
        </p>

        <p class="note-small">
          A tecnologia é uma aliada quando facilita a preservação, organização e publicação.
        </p>
      </aside>
    </section>

    <section
      class="lab section"
      id="lab"
      data-scene="collider"
      aria-labelledby="lab-title"
    >
      <div class="lab-heading" data-reveal>
        <div class="lab-heading-copy">
          <p class="eyebrow">{sectionNumber('lab')} / Laboratório</p>
          <div class="lab-title-with-sophia">
            <h2 id="lab-title">
              <b>5W2H</b>: <i>O que, por quê, onde, quando e com quem faço? Como e quanto custa?</i>
            </h2>
          </div>
          <p class="lab-note">
            Trabalhos objetiva e estruturalmente diferentes, embora interligados pelo mesmo processo:
            transformar informação dispersa em conteúdo conciso, estruturado e sempre disponível para consulta.
          </p>
        </div>

        <div class="lab-companion">
          <SophiaAnimation variant="lab" linked={false} />
          <a class="lab-sophia-guide" href="/sophia/" aria-label="Sophia percorre o laboratório — conhecer Sophia">
            <SophiaSigil className="lab-sophia-guide__sigil" />
            <span>
              <strong>Sophia percorre o laboratório.</strong>
              <small>Ela costuma aparecer onde ainda existe alguma coisa a compreender.</small>
            </span>
            <i aria-hidden="true">→</i>
          </a>
        </div>
      </div>

      <nav class="work-index" aria-label="Índice dos trabalhos" data-reveal>
        <a href="#traducao"><span>01</span> Tradução ↘</a>
        <a href="#reflexao"><span>02</span> Reflexão ↘</a>
        <a href="#arquitetura"><span>03</span> Arquitetura ↘</a>
        <a href="#curadoria"><span>04</span> Projeto Integrador ↘</a>
        <a href="#documentacao"><span>05</span> Documentação ↘</a>
      </nav>

      <article
        id="traducao"
        class="lab-project-card"
        data-scene="supernova"
        data-reveal
        aria-labelledby="translation-title"
      >
        <div class="lab-project-copy">
          <div class="lab-project-meta">
            <span class="lab-project-index">
              01
            </span>

            <span class="lab-project-status" data-status="progress">
              Em andamento
            </span>
          </div>

          <p
            class="lab-project-kicker lab-project-tags"
            aria-label="Temas da tradução"
          >
            <span>EN → PT-BR</span>
            <span>seleção</span>
            <span>tradução</span>
            <span>revisão</span>
          </p>

          <h3 id="translation-title">
            TRADUÇÃO
          </h3>

          <span class="lab-sophia-presence" title="Sophia encontrou aqui um texto ainda em travessia.">
            <SophiaSigil className="lab-sophia-presence__sigil" />
            Sophia encontrou aqui um texto ainda em travessia.
          </span>

          <div class="lab-project-book">
            <p>
              <cite>The Big Picture</cite>
            </p>

            <span>
              Sean Carroll
            </span>
          </div>

          <p class="lab-project-description">
            Tradução em português brasileiro de uma obra que cruza física,
            filosofia, cosmologia e as perguntas fundamentais sobre significado,
            vida e universo: <i>Filosofia da ciência</i> para os familiarizados.
          </p>

          <div class="lab-project-footer">
            <span>
              projeto em desenvolvimento
            </span>
          </div>
        </div>

        <div class="lab-project-cover">
          <div class="lab-project-cover-frame">
            <img
              src="/assets/the-big-picture-cover.jpg"
              alt="Capa de The Big Picture, de Sean Carroll"
              width="299"
              height="450"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </article>

      <article
        id="reflexao"
        class="lab-project-card lab-project-card-essay"
        data-scene="spacetime"
        data-reveal
        aria-labelledby="essay-title"
      >
        <div class="lab-project-copy">
          <div class="lab-project-meta">
            <span class="lab-project-index">
              02
            </span>

            <span class="lab-project-status" data-status="published">
              Publicado
            </span>
          </div>

          <p
            class="lab-project-kicker lab-project-tags"
            aria-label="Temas da reflexão"
          >
            <span>ensaio</span>
            <span>metafísica</span>
            <span>ética</span>
            <span>filosofia da ciência</span>
          </p>
          <h3 id="essay-title">
            REFLEXÃO
          </h3>

          <span class="lab-sophia-presence" title="Algumas ideias preferem surgir como constelações.">
            <SophiaSigil className="lab-sophia-presence__sigil" />
            Algumas ideias preferem surgir como constelações.
          </span>


          <div class="lab-project-book">
            <p>
              <cite>E se</cite>
            </p>

            <span>
              <i>Reflexões sobre a viagem no tempo e relações interpessoais segundo Aristóteles</i>
            </span>
          </div>

          <p class="lab-project-description">
            Memória, causalidade, livre-arbítrio e amizade virtuosa se encontram
            numa reflexão sobre o desejo de reescrever o passado e a tarefa de
            ordenar o presente.
          </p>
        </div>

        <div class="lab-project-cover lab-project-cover-essay">
          <div class="lab-project-cover-frame lab-project-cover-frame-essay">
            <img
              src="/assets/e-se-paris.jpg"
              alt="Torre Eiffel sob céu dramático"
              width="1280"
              height="853"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </article>

      <article
        id="arquitetura"
        class="lab-project-card lab-project-card-architecture"
        data-scene="network"
        data-reveal
        aria-labelledby="architecture-title"
      >
        <div class="lab-project-copy">
          <div class="lab-project-meta">
            <span class="lab-project-index">
              03
            </span>

            <span class="lab-project-status" data-status="published">
              Publicado
            </span>
          </div>

          <p
            class="lab-project-kicker lab-project-tags"
            aria-label="Temas da arquitetura"
          >
            <span>arquitetura da informação</span>
            <span>taxonomia</span>
            <span>publicação</span>
          </p>
          <h3 id="architecture-title">
            ARQUITETURA
          </h3>
          <span class="lab-sophia-presence">
            <SophiaSigil className="lab-sophia-presence__sigil" />
            Sophia procura caminhos entre os textos.
          </span>

          <div class="lab-project-book">
            <p>
              <cite>Sistema editorial</cite>
            </p>

            <span>
              Do conteúdo disperso a um sistema editorial navegável.
            </span>
          </div>

          <p class="lab-project-description">
            Textos, notas e leituras foram organizados por função, assunto,
            estado editorial e metadados. O resultado é um acervo encontrável,
            consistente e reutilizável — sem depender da memória de quem o mantém.
          </p>
        </div>

        <div
          class="lab-project-system lab-project-system-architecture"
          data-scene="clockwork"
          aria-hidden="true"
        >
          <div class="architecture-map">
            <span class="architecture-root">
              Conteúdo
            </span>

            <div class="architecture-branches">
              <span class="architecture-node architecture-node-essays">Ensaios</span>
              <span class="architecture-node architecture-node-notes">Notas</span>
              <span class="architecture-node architecture-node-readings">Leituras</span>
            </div>

            <div class="architecture-meta">
              <span class="architecture-meta-node">assunto</span>
              <span class="architecture-meta-node">status</span>
              <span class="architecture-meta-node">idioma</span>
              <span class="architecture-meta-node">série</span>
            </div>

            <span class="architecture-output">
              Publicação
            </span>
          </div>
        </div>
      </article>

      <article
        id="curadoria"
        class="lab-project-card lab-project-card-knowledge"
        data-reveal
        aria-labelledby="knowledge-title"
      >
        <div class="pi-leaf-field" aria-hidden="true"><span style="--x:4%;--s:22px;--t:15s;--delay:0s"></span><span style="--x:11%;--s:30px;--t:18s;--delay:-6s"></span><span style="--x:19%;--s:20px;--t:13s;--delay:-3s"></span><span style="--x:27%;--s:26px;--t:16s;--delay:-11s"></span><span style="--x:35%;--s:18px;--t:12s;--delay:-8s"></span><span style="--x:43%;--s:32px;--t:19s;--delay:-14s"></span><span style="--x:51%;--s:22px;--t:14s;--delay:-2s"></span><span style="--x:58%;--s:28px;--t:17s;--delay:-9s"></span><span style="--x:66%;--s:20px;--t:13s;--delay:-5s"></span><span style="--x:73%;--s:34px;--t:20s;--delay:-16s"></span><span style="--x:81%;--s:24px;--t:15s;--delay:-12s"></span><span style="--x:88%;--s:19px;--t:12s;--delay:-7s"></span><span style="--x:94%;--s:27px;--t:18s;--delay:-1s"></span><span style="--x:47%;--s:16px;--t:11s;--delay:-10s"></span></div>
        <div class="lab-project-copy">
          <div class="lab-project-meta">
            <span class="lab-project-index">
              04
            </span>

            <span class="lab-project-status" data-status="progress">
              Em andamento
            </span>
          </div>

          <p
            class="lab-project-kicker lab-project-tags"
            aria-label="Temas do projeto"
          >
            <span>espectroscopia NIR</span>
            <span>número kappa</span>
            <span>tempo real</span>
            <span>relatório técnico</span>
          </p>

          <div class="lab-project-brand">
            <img
              src="/assets/spectrumlab-mark.svg"
              alt=""
              width="72"
              height="72"
              loading="lazy"
              decoding="async"
            />
            <span>
              <strong>SpectrumLab Pro</strong>
              <small>Supervisório espectrométrico NIR · v4.16.2 · protótipo de Davi Baracat, Kauê Alencar e Mateus Ferreira</small>
            </span>
          </div>

          <h3 id="knowledge-title">
            TECNOLOGIA NIR
          </h3>

          <span class="lab-sophia-presence" title="Há sempre algo à espera de ser reencontrado.">
            <SophiaSigil className="lab-sophia-presence__sigil" />
            Há sempre algo à espera de ser reencontrado.
          </span>

          <div class="lab-project-book">
            <p>
              <cite>Aplicação da tecnologia NIR na medição em tempo real do número kappa</cite>
            </p>

            <span>
              Projeto Integrador · SENAI Três Lagoas.
            </span>
          </div>

          <p class="lab-project-lead">
            Um supervisório que lê a polpa celulósica com <mark class="pi-mark pi-mark-1">luz infravermelha</mark> e acompanha <mark class="pi-mark pi-mark-2">o ensaio do começo ao fim</mark>.
          </p>

          <p class="lab-project-description">
            <strong>Minha parte:</strong> revisar e reescrever o relatório técnico e apresentar o projeto em <mark class="pi-mark pi-mark-3">30 de novembro</mark>.
          </p>

          <p class="cellulose-legacy-text">Processo simplificado: cavacos de madeira, cozimento kraft, lavagem da polpa, número kappa (medição NIR), branqueamento e secagem em folhas.</p>
          <div class="pi-stages"><div
            class="knowledge-flow"
            role="group"
            aria-label="Etapas do projeto. Selecione uma etapa para destacá-la."
          >
            <button
              type="button"
              class="knowledge-stage"
              data-stage="pesquisa"
              aria-pressed="false"
              disabled
            >
              Pesquisa
            </button>

            <i aria-hidden="true">→</i>

            <button
              type="button"
              class="knowledge-stage"
              data-stage="revisao"
              aria-pressed="false"
              disabled
            >
              Revisão
            </button>

            <i aria-hidden="true">→</i>

            <button
              type="button"
              class="knowledge-stage"
              data-stage="reescrita"
              aria-pressed="false"
              disabled
            >
              Reescrita
            </button>

            <i aria-hidden="true">→</i>

            <button
              type="button"
              class="knowledge-stage"
              data-stage="apresentacao"
              aria-pressed="false"
              disabled
            >
              Apresentação
            </button>
          </div></div>

          <div class="lab-project-footer">
            <span>
              Versão 4.16.2 · build 1263 · 20/10/2026 · apresentação em 30 de novembro
            </span>
            <span class="lab-project-links">
              <a
                class="lab-project-repo"
                href="https://github.com/yosemate/spectrum"
                target="_blank"
                rel="noopener noreferrer"
              >
                Repositório ↗<span class="sr-only"> (abre em nova aba)</span>
              </a>
              <a
                class="lab-project-repo"
                href="https://github.com/yosemate/spectrum/blob/main/SPECTRUM-LAB_PRO_Documentacao_Tecnica.pdf"
                target="_blank"
                rel="noopener noreferrer"
              >
                Documentação técnica (PDF) ↗<span class="sr-only"> (abre em nova aba)</span>
              </a>
            </span>
          </div>
        </div>

        <div class="lab-project-system lab-project-system-process">
          <p class="cellulose-flow-title">Do cavaco à folha · processo kraft simplificado</p>
          <ol class="cellulose-flow" aria-label="Fluxograma simplificado do processo kraft, com o ponto em que o PI busca medir o número kappa">
