---
import DecorativeMotion from '../components/DecorativeMotion.astro';
import AtomCursor from '../components/AtomCursor.astro';
import BaseHead from '../components/BaseHead.astro';
import PortfolioFooter from '../components/PortfolioFooter.astro';
import PortfolioHeader from '../components/PortfolioHeader.astro';
import RandomEasterSprites from '../components/RandomEasterSprites.astro';
import '../styles/global.css';
import '../styles/editorial.css';
import '../styles/serious.css';
import '../styles/legacy.css';
import '../styles/music-gallery.css';
import '../styles/music-scene.css';
import '../styles/music-scene-motion.css';
import '../styles/music-player.css';
import '../styles/typography.css';
import '../styles/section-refinements.css';
import '../styles/contact-orbits.css';
import '../styles/method-scene.css';
import '../styles/mode-tokens.css';
import '../styles/mono-modes.css';
import '../styles/curiosidades.css';
import '../styles/mobile.css';
import '../styles/hero-autoral.css';
import '../styles/pi-card.css';
import '../styles/type-hierarchy.css';
import '../styles/legacy-win98.css';
import '../styles/reveal.css';
import '../styles/section-scenes.css';
import '../styles/attention.css';
import '../styles/eink.css';
import '../styles/gavetas.css';

interface Props {
  title?: string;
  description?: string;
  robots?: string;
}

const { title, description, robots } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead title={title} description={description} robots={robots} />
  </head>
  <body id="top">
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <div class="ambient ambient-one" aria-hidden="true"></div>
    <div class="ambient ambient-two" aria-hidden="true"></div>
    <AtomCursor />
    <PortfolioHeader />
    <slot />
    <PortfolioFooter />
    <RandomEasterSprites />
    <DecorativeMotion />
    <script>
      import '../scripts/typewriter.ts';
    </script>
  </body>
</html>
