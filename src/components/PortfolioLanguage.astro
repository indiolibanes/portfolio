---
interface Props {
  placement?: 'floating' | 'stage' | 'inline';
}

const { placement = 'floating' } = Astro.props;
---
<button
  type="button"
  class="portfolio-language-button"
  data-portfolio-language={placement}
  lang="en"
  aria-label="Read in English"
  hidden
>EN</button>

<script>
  import { initPortfolioLanguage } from '../scripts/portfolio-language.mjs';

  // Wait for initial text effects to create their nodes before storing translations.
  document.addEventListener('DOMContentLoaded', () => {
    const button = document.querySelector<HTMLButtonElement>('[data-portfolio-language]');
    if (button) initPortfolioLanguage(button);
  }, { once: true });
</script>

<style is:global>
  body:has([data-portfolio-language]) {
    touch-action: manipulation;
  }

  button.portfolio-language-button {
    --language-button-bg: #151c2d;
    --language-button-fg: #fff8e8;
    display: inline-grid;
    place-items: center;
    flex: none;
    min-width: var(--target-min, 44px);
    min-height: var(--target-min, 44px);
    margin: 0;
    padding: 0 .5rem;
    border: 1px solid #8190ab;
    border-radius: var(--radius-pill, 999px);
    background: var(--language-button-bg);
    color: var(--language-button-fg);
    font: 700 .75rem/1 system-ui, sans-serif;
    cursor: pointer;
    pointer-events: auto;
  }

  html[data-documentation-mode="true"] .portfolio-language-button {
    --language-button-bg: #f5f4f0;
    --language-button-fg: #202533;
  }

  button.portfolio-language-button[hidden] { display: none; }

  button.portfolio-language-button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .portfolio-language-button[data-portfolio-language="floating"] {
    position: fixed;
    z-index: 70;
    inset-inline-start: max(12px, env(safe-area-inset-left));
    inset-block-end: max(12px, env(safe-area-inset-bottom));
  }

  .portfolio-language-button[data-portfolio-language="stage"] {
    position: fixed;
    z-index: 70;
    inset-inline-end: max(80px, calc(56px + env(safe-area-inset-right)));
    inset-block-start: max(20px, env(safe-area-inset-top));
  }

  .portfolio-language-particles {
    position: fixed;
    z-index: 9999;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
