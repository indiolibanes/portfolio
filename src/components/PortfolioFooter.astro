---
import { PROFILE, SOCIALS } from '../config';
const today = new Date();
---

<footer class="portfolio-footer">
  <div class="footer-shell">
    <div>
      <p class="footer-mark">{PROFILE.name}</p>
      <p class="footer-copy">Documentação, organização da informação, escrita e publicação digital.</p>
      <p class="footer-legal">© {today.getFullYear()} {PROFILE.name}. Todos os direitos reservados™.</p>
    </div>

    <div class="footer-actions" aria-label="Contato, perfis e navegação">
      {PROFILE.email && (
        <a href={`mailto:${PROFILE.email}`}>E-mail</a>
      )}

      <a
        href={PROFILE.linkedin}
        target="_blank"
        rel="noreferrer"
      >
        LinkedIn ↗
      </a>

      <a
        href={SOCIALS.github}
        target="_blank"
        rel="noreferrer"
        aria-label={`GitHub ${SOCIALS.handle}`}
      >
        GitHub {SOCIALS.handle} ↗
      </a>

      <a
        href={SOCIALS.lastfm}
        target="_blank"
        rel="noreferrer"
        aria-label={`Last.fm ${SOCIALS.handle}`}
      >
        Last.fm {SOCIALS.handle} ↗
      </a>

      {SOCIALS.appleMusic && (
        <a
          href={SOCIALS.appleMusic}
          target="_blank"
          rel="noreferrer"
        >
          Apple Music {SOCIALS.handle} ↗
        </a>
      )}

      {SOCIALS.spotify && (
        <a
          href={SOCIALS.spotify}
          target="_blank"
          rel="noreferrer"
        >
          Spotify {SOCIALS.handle} ↗
        </a>
      )}

      <a href="#top">Voltar ao topo ↑</a>
    </div>
  </div>
</footer>
