---
import { PROFILE, SOCIALS } from '../config';
const today = new Date();
---

<footer class="portfolio-footer">
  <div class="footer-shell">
    <div>
      <p class="footer-mark">{PROFILE.name}</p>
      <p class="footer-copy">Documentação, organização da informação, escrita e publicação digital.</p>
      <p class="footer-legal">© {today.getFullYear()} {PROFILE.name}. Todos os direitos reservados™.</p>
    </div>

    <div class="social-links" aria-label="Contato, perfis e navegação">
      {PROFILE.email && (
        <a
          href={`mailto:${PROFILE.email}`}
          aria-label="Enviar e-mail"
          title="E-mail"
        >
          <span class="sr-only">Enviar e-mail</span>
          <svg viewBox="0 0 16 16" aria-hidden="true" width="23" height="23">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10.67 8a2.67 2.67 0 1 0-5.33 0 2.67 2.67 0 0 0 5.33 0zm0 0v1a1 1 0 0 0 2 0V8a4.67 4.67 0 1 0-4.67 4.67H10.67"
            ></path>
          </svg>
        </a>
      )}

      {PROFILE.whatsapp && (
        <a
          href={PROFILE.whatsapp}
          target="_blank"
          rel="noreferrer"
          aria-label="WhatsApp Business"
          title="WhatsApp Business · +55 (47) 98910-5443"
        >
          <span class="sr-only">WhatsApp Business · +55 (47) 98910-5443</span>
          <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22">
            <path
              fill="currentColor"
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.198.297-.767.966-.94 1.164-.173.198-.347.223-.644.074-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.372-.025-.521-.075-.149-.669-1.612-.916-2.207-.242-.58-.487-.501-.669-.51-.173-.009-.372-.011-.57-.011-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.693.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.045 21.35h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.981.998-3.648-.235-.374A9.86 9.86 0 0 1 2.152 11.45c.002-5.447 4.435-9.88 9.892-9.88a9.82 9.82 0 0 1 6.988 2.895A9.82 9.82 0 0 1 21.92 11.45c-.002 5.447-4.435 9.9-9.875 9.9m8.413-18.297A11.82 11.82 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.89a11.84 11.84 0 0 0 1.588 5.93L.057 24l6.329-1.66a11.9 11.9 0 0 0 5.658 1.44h.005c6.554 0 11.89-5.335 11.893-11.89a11.82 11.82 0 0 0-3.484-8.837Z"
            ></path>
          </svg>
        </a>
      )}

      <a
        href={PROFILE.linkedin}
        target="_blank"
        rel="noreferrer"
        aria-label="LinkedIn"
        title="LinkedIn"
      >
        <span class="sr-only">LinkedIn</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" width="21" height="21">
          <path
            fill="currentColor"
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065ZM7.119 20.452H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003Z"
          ></path>
        </svg>
      </a>

      <a
        href={SOCIALS.github}
        target="_blank"
        rel="noreferrer"
        aria-label={`GitHub ${SOCIALS.handle}`}
        title={`GitHub ${SOCIALS.handle}`}
      >
        <span class="sr-only">GitHub {SOCIALS.handle}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22">
          <path
            fill="currentColor"
            d="M12 .297C5.373.297 0 5.67 0 12.297c0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.334-1.756-1.334-1.756-1.09-.745.083-.729.083-.729 1.205.084 1.84 1.237 1.84 1.237 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.303-5.466-1.332-5.466-5.93 0-1.31.468-2.381 1.235-3.221-.123-.303-.535-1.523.117-3.176 0 0 1.008-.322 3.301 1.23a11.51 11.51 0 0 1 3.003-.404c1.018.005 2.044.138 3.003.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.873.119 3.176.77.84 1.233 1.911 1.233 3.221 0 4.61-2.805 5.624-5.475 5.921.43.371.823 1.102.823 2.222 0 1.606-.015 2.898-.015 3.293 0 .322.216.694.825.576C20.565 22.093 24 17.598 24 12.297 24 5.67 18.627.297 12 .297Z"
          ></path>
        </svg>
      </a>

      <a
        href={SOCIALS.lastfm}
        target="_blank"
        rel="noreferrer"
        aria-label={`Last.fm ${SOCIALS.handle}`}
        title={`Last.fm ${SOCIALS.handle}`}
      >
        <span class="sr-only">Last.fm {SOCIALS.handle}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" width="23" height="23">
          <path
            fill="currentColor"
            d="M10.584 17.21l-.88-2.392s-1.43 1.594-3.573 1.594c-1.897 0-3.244-1.649-3.244-4.288 0-3.382 1.704-4.591 3.381-4.591 2.42 0 3.189 1.567 3.849 3.574l.88 2.749c.88 2.666 2.529 4.81 7.285 4.81 3.409 0 5.718-1.044 5.718-3.793 0-2.227-1.265-3.381-3.63-3.931l-1.758-.385c-1.21-.275-1.567-.77-1.567-1.595 0-.934.742-1.484 1.952-1.484 1.32 0 2.034.495 2.144 1.677l2.749-.33c-.22-2.474-1.924-3.492-4.729-3.492-2.474 0-4.893.935-4.893 3.932 0 1.87.907 3.051 3.189 3.601l1.87.44c1.402.33 1.869.907 1.869 1.704 0 1.017-.99 1.43-2.86 1.43-2.776 0-3.93-1.457-4.59-3.464l-.907-2.75c-1.155-3.573-2.997-4.893-6.653-4.893C2.144 5.333 0 7.89 0 12.233c0 4.18 2.144 6.434 5.993 6.434 3.106 0 4.591-1.457 4.591-1.457Z"
          ></path>
        </svg>
      </a>

      {SOCIALS.appleMusic && (
        <a
          href={SOCIALS.appleMusic}
          target="_blank"
          rel="noreferrer"
          aria-label={`Apple Music ${SOCIALS.handle}`}
          title={`Apple Music ${SOCIALS.handle}`}
        >
          <span class="sr-only">Apple Music {SOCIALS.handle}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22">
            <path
              fill="currentColor"
              d="M21.42 3.52c-.12-.45-.36-.84-.72-1.16-.37-.33-.79-.53-1.26-.61-.35-.06-.86-.09-1.55-.09H6.11c-.69 0-1.2.03-1.55.09-.47.08-.89.28-1.26.61-.36.32-.6.71-.72 1.16-.09.36-.14.88-.14 1.55v13.86c0 .67.05 1.19.14 1.55.12.45.36.84.72 1.16.37.33.79.53 1.26.61.35.06.86.09 1.55.09h11.78c.69 0 1.2-.03 1.55-.09.47-.08.89-.28 1.26-.61.36-.32.6-.71.72-1.16.09-.36.14-.88.14-1.55V5.07c0-.67-.05-1.19-.14-1.55Zm-4.19 13.52c-.1.49-.34.91-.72 1.25-.38.35-.83.56-1.34.64-.57.09-1.09.03-1.56-.17-.47-.21-.83-.53-1.07-.96-.24-.43-.31-.89-.21-1.38.1-.5.35-.91.73-1.26.38-.34.83-.56 1.35-.64.67-.1 1.26.01 1.77.34V8.02l-7.08 1.43v8.03c-.1.49-.34.91-.72 1.25-.38.35-.83.56-1.34.64-.57.09-1.09.03-1.56-.17-.47-.21-.83-.53-1.07-.96-.24-.43-.31-.89-.21-1.38.1-.5.35-.91.73-1.26.38-.34.83-.56 1.35-.64.67-.1 1.26.01 1.77.34V7.04c0-.38.22-.61.65-.7l8.58-1.73v12.43Z"
            ></path>
          </svg>
        </a>
      )}

      {SOCIALS.spotify && (
        <a
          href={SOCIALS.spotify}
          target="_blank"
          rel="noreferrer"
          aria-label={`Spotify ${SOCIALS.handle}`}
          title={`Spotify ${SOCIALS.handle}`}
        >
          <span class="sr-only">Spotify {SOCIALS.handle}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22">
            <path
              fill="currentColor"
              d="M12 0a12 12 0 1 0 0 24 12 12 0 0 0 0-24Zm5.5 17.31a.75.75 0 0 1-1.03.25c-2.82-1.72-6.37-2.11-10.55-1.16a.75.75 0 1 1-.33-1.46c4.57-1.04 8.5-.59 11.66 1.34.35.21.46.67.25 1.03Zm1.47-3.28a.94.94 0 0 1-1.29.31c-3.23-1.98-8.15-2.55-11.97-1.39a.94.94 0 1 1-.54-1.8c4.37-1.32 9.79-.69 13.49 1.58.44.27.58.85.31 1.28Zm.13-3.42C15.23 8.31 8.84 8.1 5.14 9.22a1.12 1.12 0 1 1-.65-2.14c4.25-1.29 11.31-1.04 15.76 1.6a1.12 1.12 0 0 1-1.15 1.93Z"
            ></path>
          </svg>
        </a>
      )}

      <a
        href="#top"
        aria-label="Voltar ao topo"
        title="Voltar ao topo"
      >
        <span class="sr-only">Voltar ao topo</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22">
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 19V5m-6 6 6-6 6 6"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</footer>
