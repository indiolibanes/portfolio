    <canvas class="footer-math" aria-hidden="true" data-footer-math></canvas>
    <div>
      <p class="footer-mark">{PROFILE.name}</p>
      <p class="footer-copy">Documentação, organização da informação, escrita e publicação digital.</p>
      <p class="footer-legal">
        © {today.getFullYear()} {PROFILE.name}. Todos os direitos reservados.
      </p>
    </div>

    <div class="social-links" aria-label="Contato, perfis e navegação">
