<script is:inline>
  (() => {
    const elements = [...document.querySelectorAll('[data-decorative-motion]')];
    const visible = new Set();
    const preference = window.matchMedia('(prefers-reduced-motion: reduce)');
    const update = () => {
      // Only two decorative loops run at once, and only inside the viewport.
      const active = document.hidden || preference.matches ? [] : [...visible].slice(0, 2);
      elements.forEach((element) => {
        const playing = active.includes(element);
        element.dataset.motionPlaying = String(playing);
        if (element.dataset.motionSrc) {
          const source = playing ? element.dataset.motionSrc : element.dataset.motionStill;
          if (element.getAttribute('src') !== source) element.setAttribute('src', source);
        }
      });
    };
    update();
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(({ target, isIntersecting }) => {
          if (isIntersecting) visible.add(target);
          else visible.delete(target);
        });
        update();
      }, { threshold: 0.1 });
      elements.forEach((element) => observer.observe(element));
    }
    preference.addEventListener('change', update);
    document.addEventListener('visibilitychange', update);
  })();
</script>
