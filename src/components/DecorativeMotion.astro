<script is:inline>
  (() => {
    const elements = [...document.querySelectorAll('[data-decorative-motion]')];
    const visible = new Set();
    const preference = window.matchMedia('(prefers-reduced-motion: reduce)');
    const update = () => {
      const canPlay =
        !document.hidden &&
        !preference.matches;

      const visibleElements = [...visible];

      // Bastidores is intentionally a motion tableau: when the section is
      // visible, all of its animated assets may play together. Outside that
      // section we keep the previous two-loop cap for performance.
      const bastidores = canPlay
        ? visibleElements.filter((element) =>
            element.closest('#bastidores'),
          )
        : [];

      const elsewhere = canPlay
        ? visibleElements
            .filter((element) =>
              !element.closest('#bastidores'),
            )
            .slice(0, 2)
        : [];

      const active =
        new Set([
          ...bastidores,
          ...elsewhere,
        ]);

      elements.forEach((element) => {
        const playing = active.has(element);
        element.dataset.motionPlaying = String(playing);

        if (element.dataset.motionSrc) {
          const source =
            playing
              ? element.dataset.motionSrc
              : element.dataset.motionStill;

          if (
            element.getAttribute('src') !==
            source
          ) {
            element.setAttribute('src', source);
          }
        }
      });
    };
    update();
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(({ target, isIntersecting }) => {
          if (isIntersecting) visible.add(target);
          else visible.delete(target);
        });
        update();
      }, { threshold: 0.1 });
      elements.forEach((element) => observer.observe(element));
    }
    preference.addEventListener('change', update);
    document.addEventListener('visibilitychange', update);
  })();
</script>
