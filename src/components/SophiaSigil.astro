---
interface Props {
  className?: string;
  title?: string;
  labelled?: boolean;
}

const {
  className = '',
  title = 'Sophia',
  labelled = false,
} = Astro.props;
---

<svg
  class={`sophia-sigil ${className}`}
  viewBox="0 0 120 120"
  role={labelled ? 'img' : 'presentation'}
  aria-label={labelled ? title : undefined}
  aria-hidden={labelled ? undefined : 'true'}
>
  {labelled && <title>{title}</title>}
  <path
    class="sophia-sigil__halo"
    d="M60 10a50 50 0 1 1 0 100 50 50 0 0 1 0-100Z"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-dasharray="2 8"
    opacity=".38"
  />
  <path
    class="sophia-sigil__ears"
    d="M27 42 34 17l20 16h12l20-16 7 25-10 14H37L27 42Z"
    fill="none"
    stroke="currentColor"
    stroke-width="4"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <path
    class="sophia-sigil__face"
    d="M38 53c2 23 12 34 22 34s20-11 22-34M46 61l7 2m21-2-7 2M55 73h10l-5 6-5-6Z"
    fill="none"
    stroke="currentColor"
    stroke-width="4"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <path
    class="sophia-sigil__tail"
    d="M84 78c15 1 21 12 17 22-4 9-17 12-30 5 10-1 17-5 18-11 1-5-2-10-5-16Z"
    fill="none"
    stroke="currentColor"
    stroke-width="4"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <path
    class="sophia-sigil__star"
    d="m60 20 2.3 5.7L68 28l-5.7 2.3L60 36l-2.3-5.7L52 28l5.7-2.3L60 20Z"
    fill="currentColor"
  />
</svg>
