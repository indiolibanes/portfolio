---
---

<section
  class="music-shelf section"
  id="musica"
  aria-labelledby="music-title"
  data-music-shelf
  hidden
>
  <div class="music-heading">
    <div>
      <p class="eyebrow">Apple Music</p>
      <h2 id="music-title">O que anda tocando.</h2>
    </div>

    <p>
      Uma pequena janela para minhas audições recentes e para as playlists
      que escolhi deixar públicas no Apple Music.
    </p>
  </div>

  <div class="music-grid">
    <article class="recent-track-card" data-recent-card hidden>
      <div class="recent-artwork-shell">
        <img
          class="recent-artwork"
          data-track-artwork
          alt=""
          loading="lazy"
        />
      </div>

      <div class="recent-track-copy">
        <p class="music-kicker">
          <span class="music-kicker-dot" aria-hidden="true"></span>
          ouvido recentemente
        </p>

        <h3 data-track-title></h3>
        <p class="recent-artist" data-track-artist></p>
        <p class="recent-album" data-track-album></p>

        <a
          class="apple-music-link"
          data-track-link
          target="_blank"
          rel="noreferrer"
        >
          Abrir no Apple Music ↗
        </a>
      </div>
    </article>

    <div class="public-playlists" data-playlists-wrap hidden>
      <div class="playlists-heading">
        <div>
          <p class="project-label">Playlists públicas</p>
          <h3>Seleções que resolvi compartilhar.</h3>
        </div>

        <p>
          O próprio Apple Music permanece como fonte canônica:
          qualquer alteração feita lá se reflete aqui.
        </p>
      </div>

      <div class="playlist-grid" data-playlist-grid></div>
    </div>
  </div>
</section>

<script is:inline>
  const shelf = document.querySelector('[data-music-shelf]');
  const recentCard = document.querySelector('[data-recent-card]');
  const playlistWrap = document.querySelector('[data-playlists-wrap]');
  const playlistGrid = document.querySelector('[data-playlist-grid]');

  const art = document.querySelector('[data-track-artwork]');
  const title = document.querySelector('[data-track-title]');
  const artist = document.querySelector('[data-track-artist]');
  const album = document.querySelector('[data-track-album]');
  const link = document.querySelector('[data-track-link]');

  function playlistCard(item) {
    const anchor = document.createElement('a');
    anchor.className = 'playlist-card';
    anchor.href = item.url || '#';
    anchor.target = '_blank';
    anchor.rel = 'noreferrer';

    if (item.artwork) {
      const image = document.createElement('img');
      image.src = item.artwork;
      image.alt = '';
      image.loading = 'lazy';
      anchor.appendChild(image);
    }

    const copy = document.createElement('span');
    copy.className = 'playlist-card-copy';

    const name = document.createElement('strong');
    name.textContent = item.name || 'Playlist';

    const curator = document.createElement('small');
    curator.textContent = item.curator || 'Apple Music';

    copy.append(name, curator);
    anchor.appendChild(copy);

    const arrow = document.createElement('span');
    arrow.className = 'playlist-card-arrow';
    arrow.setAttribute('aria-hidden', 'true');
    arrow.textContent = '↗';
    anchor.appendChild(arrow);

    return anchor;
  }

  async function hydrateMusic() {
    let hasContent = false;

    try {
      const response = await fetch('/api/music/recent', { cache: 'no-store' });
      if (response.ok) {
        const data = await response.json();
        const track = data.track;

        if (track) {
          title.textContent = track.name || '';
          artist.textContent = track.artist || '';
          album.textContent = track.album || '';

          if (track.artwork) {
            art.src = track.artwork;
            art.alt = `Capa de ${track.album || track.name}`;
          }

          if (track.url) {
            link.href = track.url;
            link.hidden = false;
          } else {
            link.hidden = true;
          }

          recentCard.hidden = false;
          hasContent = true;
        }
      }
    } catch (error) {
      console.debug('Apple Music recent track unavailable.', error);
    }

    try {
      const response = await fetch('/api/music/playlists', { cache: 'no-store' });
      if (response.ok) {
        const data = await response.json();
        const playlists = Array.isArray(data.playlists) ? data.playlists : [];

        if (playlists.length) {
          playlistGrid.replaceChildren(...playlists.map(playlistCard));
          playlistWrap.hidden = false;
          hasContent = true;
        }
      }
    } catch (error) {
      console.debug('Apple Music playlists unavailable.', error);
    }

    shelf.hidden = !hasContent;
  }

  hydrateMusic();

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    window.setInterval(hydrateMusic, 120000);
  }
</script>
