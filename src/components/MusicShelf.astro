---
import { MUSIC, SOCIALS } from '../config';
import { sectionNumber } from '../section-order';

const hasPlaylists = MUSIC.publicPlaylists.length > 0;
---

<section
  class="music-shelf music-shelf--gallery section"
  id="musica"
  aria-labelledby="music-title"
  data-music-shelf
  data-has-playlists={String(hasPlaylists)}
  aria-busy="false"
  data-music-state="idle"
>
  <div class="music-heading music-heading--gallery">
    <div class="music-heading-copy">
      <p class="eyebrow music-source-label">
        {sectionNumber('musica')} / Música
        <span>Last.fm · atividade recente</span>
      </p>
      <h2 id="music-title">O que anda tocando.</h2>
      <p class="music-heading-description">
        Uma pequena janela para as audições registradas no Last.fm,
        independentemente do player usado.
      </p>
    </div>

    <div class="music-listening-panel" aria-label="Atividade musical recente">
      <noscript><p class="music-no-script">As audições recentes precisam de JavaScript. <a href={SOCIALS.lastfm} target="_blank" rel="noopener noreferrer">Abrir Last.fm <span aria-hidden="true">↗</span></a></p></noscript>
      <div class="music-grid music-grid--stage">
      <p class="music-loading" data-music-loading role="status" aria-live="polite" hidden></p>
      <a class="music-status-profile" href={SOCIALS.lastfm} target="_blank" rel="noopener noreferrer" data-music-profile hidden>Abrir Last.fm <span aria-hidden="true">↗</span><span class="sr-only"> (abre em nova aba)</span></a>

      <article
        class="recent-track-card"
        data-recent-card
        hidden
      >
        <div class="recent-artwork-shell">
          <div
            class="recent-artwork-fallback"
            data-artwork-fallback
            aria-hidden="true"
          >
            ♪
          </div>

          <img
            class="recent-artwork"
            data-track-artwork
            alt=""
            loading="lazy"
            hidden
          />
        </div>

        <div class="recent-track-copy">
          <p class="music-kicker">
            <span
              class="music-kicker-dot"
              data-status-dot
              aria-hidden="true"
            ></span>

            <span data-track-status>
              ouvido recentemente
            </span>

            <span
              class="music-track-age"
              data-track-age
            ></span>
          </p>

          <h3 data-track-title></h3>

          <p
            class="recent-artist"
            data-track-artist
          ></p>

          <p
            class="recent-album"
            data-track-album
          ></p>

          <div class="music-meta-row">
            <a
              class="apple-music-link"
              data-track-link
              target="_blank"
              rel="noopener noreferrer"
              hidden
            >
              Ver no Last.fm ↗
            </a>

            <span class="music-provenance">
              scrobble via Last.fm
            </span>
          </div>
        </div>
      </article>
      </div>
    </div>

    <aside class="listening-note listening-note--moonlight" aria-label="Fragmento do ensaio Moonlight Sonata">
      <i class="listening-note-sheet listening-note-sheet--a" aria-hidden="true"></i>
      <i class="listening-note-sheet listening-note-sheet--b" aria-hidden="true"></i>
      <i class="listening-note-paper" aria-hidden="true"></i>
      <span class="listening-note-tape" aria-hidden="true"></span>
      <div class="listening-note-top">
        <span>Fragmento / 01</span>
        <span>Memória &amp; música</span>
      </div>
      <div class="listening-note-score" data-decorative-motion aria-hidden="true"><span>♪</span><span>♫</span><span>♩</span><span>♬</span><span>♪</span></div>
      <blockquote class="listening-note-quote listening-note-typewriter">
        <span class="music-quote-assistive">Diante da grande arte, a conclusão é que a música não apenas deleita, mas ordena a substância do caráter.</span>
        <span class="music-quote-typed" aria-hidden="true" data-sonata-typing>Diante da grande arte, a conclusão é que a música não apenas deleita, mas ordena a substância do caráter.</span>
      </blockquote>
      <p class="listening-note-footer"><cite>Moonlight Sonata</cite> <span aria-hidden="true">—</span> A harmonia do pretérito imperfeito</p>
    </aside>

    <figure class="music-panorama" aria-labelledby="music-panorama-caption" data-music-panorama>
      <picture class="music-scene-art">
        <source type="image/avif" srcset="/assets/music-moonlit-terrace-v3.avif" />
        <img src="/assets/music-moonlit-terrace-v3.webp" alt="" width="1264" height="848" loading="lazy" decoding="async" />
      </picture>
      <div class="music-panorama-sky" aria-hidden="true">
        <span class="music-moonglow"></span>
        <span class="music-star"></span><span class="music-star"></span><span class="music-star"></span><span class="music-star"></span><span class="music-star"></span><span class="music-star"></span><span class="music-star"></span><span class="music-star"></span>
        <span class="music-sky-lantern"></span><span class="music-sky-lantern"></span><span class="music-sky-lantern"></span><span class="music-sky-lantern"></span><span class="music-sky-lantern"></span><span class="music-sky-lantern"></span><span class="music-sky-lantern"></span>
      </div>
      <div class="music-panorama-glows" aria-hidden="true">
        <span class="music-glow music-glow--lantern"></span>
        <span class="music-glow music-glow--lily"></span>
        <span class="music-glow music-glow--wing"></span><span class="music-glow music-glow--wing"></span><span class="music-glow music-glow--wing"></span><span class="music-glow music-glow--wing"></span>
        <span class="music-glow music-glow--tail"></span><span class="music-glow music-glow--tail"></span><span class="music-glow music-glow--tail"></span><span class="music-glow music-glow--tail"></span>
      </div>
      <div class="music-panorama-glint" aria-hidden="true"></div>
      <div class="music-panorama-shimmer" aria-hidden="true"></div>
      <div class="music-panorama-motes" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span></div>
      <div class="music-panorama-effects" data-music-effects aria-hidden="true"></div>
      <span class="music-panorama-hint" aria-hidden="true"><span class="music-panorama-hint__touch">✦ Toque na cena</span><span class="music-panorama-hint__click">✦ Clique na cena</span></span>
      <button
        class="music-panorama-action"
        data-music-effect-toggle
        type="button"
        aria-label="Animar a ilustração: alternar borboletas celestiais e o bastonete carmesim que se desfaz em pétalas"
        hidden
      ></button>
      <figcaption id="music-panorama-caption" class="music-panorama-caption">
        Em um terraço de pedra sobre um lago ao luar, sob uma lua dourada, a Via Láctea e lanternas flutuantes, Phrolova à esquerda e Shorekeeper à direita se contrapõem em carmesim e azul. Hsin, apoiada na balaustrada, e sua forma de raposa ocupam o centro. Em primeiro plano, Sophia, de marfim, azul noturno e ouro, escuta música com fones de ouvido e apoia o livro aberto na grade, com uma pequena raposa branca de detalhes vermelhos a seu lado.
      </figcaption>
    </figure>
  </div>

  <div class="music-playlist-region">
    {hasPlaylists && (
      <div class="public-playlists">
        <div class="playlists-heading">
          <div>
            <p class="project-label">
              Playlists públicas
            </p>

            <h3>
              Seleções que resolvi compartilhar.
            </h3>
          </div>

          <p>
            As playlists continuam hospedadas no próprio Apple Music;
            aqui ficam apenas atalhos para as seleções públicas.
          </p>
        </div>

        <div class="playlist-grid">
          {MUSIC.publicPlaylists.map((playlist) => (
            <a
              class="playlist-card"
              href={playlist.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {playlist.artwork ? (
                <img
                  src={playlist.artwork}
                  alt=""
                  loading="lazy"
                />
              ) : (
                <span
                  class="playlist-artwork-fallback"
                  aria-hidden="true"
                >
                  ♫
                </span>
              )}

              <span class="playlist-card-copy">
                <strong>{playlist.name}</strong>

                <small>
                  {playlist.note || 'Apple Music'}
                </small>
              </span>

              <span
                class="playlist-card-arrow"
                aria-hidden="true"
              >
                ↗
              </span>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<script is:inline>
  const shelf = document.querySelector('[data-music-shelf]');
  const recentCard = document.querySelector('[data-recent-card]');

  const artwork = document.querySelector('[data-track-artwork]');
  const artworkFallback = document.querySelector('[data-artwork-fallback]');
  const title = document.querySelector('[data-track-title]');
  const artist = document.querySelector('[data-track-artist]');
  const album = document.querySelector('[data-track-album]');
  const link = document.querySelector('[data-track-link]');
  const statusText = document.querySelector('[data-track-status]');
  const ageText = document.querySelector('[data-track-age]');
  const statusDot = document.querySelector('[data-status-dot]');
  const loadingState = document.querySelector('[data-music-loading]');
  const profileFallback = document.querySelector('[data-music-profile]');

  const hasPlaylists =
    shelf?.dataset.hasPlaylists === 'true';

  function relativeTime(timestamp) {
    if (!timestamp) return '';

    const seconds = Math.max(
      0,
      Math.floor((Date.now() - timestamp) / 1000),
    );

    if (seconds < 60) return 'agora';
    if (seconds < 3600) {
      const minutes = Math.floor(seconds / 60);
      return `há ${minutes} min`;
    }

    if (seconds < 86400) {
      const hours = Math.floor(seconds / 3600);
      return `há ${hours} h`;
    }

    const days = Math.floor(seconds / 86400);
    return `há ${days} d`;
  }

  function settleShelf(message = '', state = 'recent') {
    shelf?.setAttribute('aria-busy', 'false');
    if (shelf) shelf.dataset.musicState = state;
    if (profileFallback) profileFallback.hidden = !message;

    if (loadingState) {
      loadingState.textContent = message;
      loadingState.hidden = !message;
    }
  }

  let lastTrackKey = '';
  const announcement = document.createElement('p');
  announcement.className = 'sr-only';
  announcement.setAttribute('aria-live', 'polite');
  shelf?.appendChild(announcement);

  function renderTrack(track) {
    if (!track) {
      recentCard.hidden = true;
      settleShelf(
        hasPlaylists
          ? 'Nenhuma audição recente. As playlists públicas continuam disponíveis.'
          : 'Nenhuma audição recente registrada.',
        'empty',
      );
      return;
    }

    const trackKey = [track.name, track.artist, track.nowPlaying].join('|');
    if (trackKey !== lastTrackKey) {
      announcement.textContent = `${track.nowPlaying ? 'Agora tocando' : 'Ouvido recentemente'}: ${track.name}, ${track.artist}.`;
      lastTrackKey = trackKey;
    }
    title.textContent = track.name || '';
    title.title = track.name || '';
    artist.textContent = track.artist || '';
    artist.title = track.artist || '';
    album.textContent = track.album || '';
    album.title = track.album || '';

    if (track.artwork) {
      artwork.src = track.artwork;
      artwork.alt = track.album
        ? `Capa de ${track.album}`
        : `Capa de ${track.name}`;
      artwork.hidden = false;
      artworkFallback.hidden = true;
    } else {
      artwork.removeAttribute('src');
      artwork.hidden = true;
      artworkFallback.hidden = false;
    }

    if (track.url) {
      link.href = track.url;
      link.hidden = false;
    } else {
      link.hidden = true;
    }

    if (track.nowPlaying) {
      recentCard.dataset.nowPlaying = 'true';
      statusText.textContent = 'agora tocando';
      ageText.textContent = '';
      statusDot.classList.add('is-live');
    } else {
      recentCard.dataset.nowPlaying = 'false';
      statusText.textContent = 'ouvido recentemente';
      ageText.textContent = relativeTime(track.playedAt);
      statusDot.classList.remove('is-live');
    }

    recentCard.hidden = false;
    settleShelf('', track.nowPlaying ? 'playing' : 'recent');
  }

  function showMusicError() {
    // Never leave a stale “agora tocando” card on an API failure.
    if (recentCard) recentCard.hidden = true;
    settleShelf('Last.fm indisponível por ora. Consulte o perfil para ver as audições.', 'error');
  }

  let musicRequestPending = false;
  async function hydrateMusic() {
    if (document.hidden || musicRequestPending) return;
    musicRequestPending = true;
    try {
      const response = await fetch(
        '/api/music/recent',
        { cache: 'default', signal: AbortSignal.timeout(10000) },
      );

      if (!response.ok) {
        showMusicError();
        return;
      }

      const data = await response.json();
      renderTrack(data.track);
    } catch (error) {
      console.debug(
        'Last.fm listening data unavailable.',
        error,
      );

      showMusicError();
    } finally {
      musicRequestPending = false;
    }
  }

  // A citação permanece disponível por inteiro sem JavaScript ou com movimento reduzido.
  const sonataQuote = shelf?.querySelector('[data-sonata-typing]');

  if (
    sonataQuote &&
    'IntersectionObserver' in window &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    const originalQuote = sonataQuote.textContent.trim();
    let started = false;

    const observer = new IntersectionObserver((entries) => {
      if (started || !entries.some((entry) => entry.isIntersecting)) return;
      started = true;
      observer.disconnect();
      // O post-it é colado uma vez, junto com o início da digitação.
      (sonataQuote.closest('.listening-note') || sonataQuote).classList.add('is-sticking');

      let position = 0;
      sonataQuote.textContent = '';
      sonataQuote.classList.add('music-quote-typing');

      const typeNext = () => {
        position = Math.min(position + 1, originalQuote.length);
        sonataQuote.textContent = originalQuote.slice(0, position);
        if (position < originalQuote.length) {
          window.setTimeout(typeNext, 38);
        } else {
          sonataQuote.classList.remove('music-quote-typing');
        }
      };

      typeNext();
    }, { threshold: 0.35 });

    observer.observe(sonataQuote.closest('.listening-note') || sonataQuote);
  }


  // Cada clique alterna o recorte real de uma borboleta e o bastonete que se desfaz em pétalas.
  // O botão ocupa a imagem e não apresenta controle visual, mas mantém suporte ao teclado.
  const panorama = shelf?.querySelector('[data-music-panorama]');
  const effectToggle = panorama?.querySelector('[data-music-effect-toggle]');
  const effectLayer = panorama?.querySelector('[data-music-effects]');
  if (panorama && effectToggle && effectLayer) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const hoverPointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    let nextEffect = 'butterfly';
    const effectsQuiet = () => reducedMotion.matches
      || document.documentElement.dataset.seriousMode === 'true'
      || document.documentElement.dataset.legacyMode === 'true';
    // Only expose the control when it can actually animate; otherwise it is a
    // focusable button that does nothing (Editorial, Legacy, reduced motion).
    const syncEffectToggle = () => { effectToggle.hidden = effectsQuiet(); };
    syncEffectToggle();
    window.addEventListener('portfolio:mode', syncEffectToggle);
    reducedMotion.addEventListener('change', syncEffectToggle);

    // Pointer: the moonlight glint follows the cursor and the whole painting
    // leans a few pixels toward it (parallax). Off on touch and in quiet modes.
    let parallaxFrame = 0;
    if (hoverPointer.matches) {
      effectToggle.addEventListener('pointermove', (event) => {
        const bounds = panorama.getBoundingClientRect();
        const fx = (event.clientX - bounds.left) / bounds.width;
        const fy = (event.clientY - bounds.top) / bounds.height;
        panorama.style.setProperty('--music-glint-x', (fx * 100) + '%');
        panorama.style.setProperty('--music-glint-y', (fy * 100) + '%');
        if (!parallaxFrame && !effectsQuiet()) {
          parallaxFrame = requestAnimationFrame(() => {
            parallaxFrame = 0;
            panorama.style.setProperty('--music-px', ((fx - .5) * -12).toFixed(2) + 'px');
            panorama.style.setProperty('--music-py', ((fy - .5) * -8).toFixed(2) + 'px');
          });
        }
      }, { passive: true });
      effectToggle.addEventListener('pointerleave', () => {
        panorama.style.setProperty('--music-px', '0px');
        panorama.style.setProperty('--music-py', '0px');
      });
    }

    // A ripple of moonlight where the reader clicks, shown before the effect bursts.
    const ripple = (x, y) => {
      const ring = document.createElement('span');
      ring.className = 'music-ripple';
      ring.style.setProperty('--rx', x + '%');
      ring.style.setProperty('--ry', y + '%');
      effectLayer.appendChild(ring);
      window.setTimeout(() => ring.remove(), 1100);
    };

    const sprites = {
      butterfly: '/assets/shorekeeper-butterfly.webp',
    };
    Object.values(sprites).forEach((src) => {
      const preload = new Image();
      preload.src = src;
    });

    const rand = (min, max) => min + Math.random() * (max - min);
    const scale = () => Math.min(1, Math.max(.55, panorama.getBoundingClientRect().width / 760));
    const svgNS = 'http://www.w3.org/2000/svg';

    const release = (particle, life) => {
      effectLayer.appendChild(particle);
      window.setTimeout(() => particle.remove(), life + 400);
    };

    // Shorekeeper's butterflies: each one flutters along its own wavering
    // path, so a burst reads as a small flight rather than a single puff.
    const spawnButterfly = (x, y, delay = 0) => {
      const k = scale();
      const particle = document.createElement('span');
      const life = Math.round(rand(2300, 3100));
      const dx = rand(-170, 170) * k;
      const dy = -rand(95, 200) * k;
      particle.className = 'music-effect-particle music-effect-particle--butterfly';
      particle.style.setProperty('--fx-x', x + '%');
      particle.style.setProperty('--fx-y', y + '%');
      particle.style.setProperty('--fx-a-x', (dx * .28 + rand(-34, 34) * k) + 'px');
      particle.style.setProperty('--fx-a-y', (dy * .3) + 'px');
      particle.style.setProperty('--fx-b-x', (dx * .62 - rand(-40, 40) * k) + 'px');
      particle.style.setProperty('--fx-b-y', (dy * .66) + 'px');
      particle.style.setProperty('--fx-dx', dx + 'px');
      particle.style.setProperty('--fx-dy', dy + 'px');
      particle.style.setProperty('--fx-rotate', (dx > 0 ? 1 : -1) * rand(8, 22) + 'deg');
      particle.style.setProperty('--fx-size', rand(.72, 1.12).toFixed(2));
      particle.style.setProperty('--fx-life', life + 'ms');
      particle.style.setProperty('--fx-delay', delay + 'ms');
      const sprite = document.createElement('img');
      sprite.className = 'music-butterfly-sprite';
      sprite.src = sprites.butterfly;
      sprite.alt = '';
      sprite.width = 231;
      sprite.height = 143;
      // Uma rajada de três batidas e um planeio por ciclo; cada borboleta tem o seu compasso.
      sprite.style.setProperty('--fx-beat', Math.round(rand(860, 1080)) + 'ms');
      sprite.style.animationDelay = -Math.round(rand(0, 600)) + 'ms';
      particle.appendChild(sprite);
      release(particle, life + delay);
    };

    // O bastonete carmesim da Phrolova (vetor aprovado em /assets/phrolova)
    // aparece, flutua e se desfaz devagar: a flor é corroída do centro para
    // fora enquanto solta pétalas de higanbana, uma a uma, que caem
    // balançando. Dura cerca de nove segundos, de propósito.
    const batonSrc = '/assets/phrolova/crimson-baton.svg';
    const canErode = Boolean(window.CSS?.registerProperty);
    const petalMarkup = '<path class="music-petal-body" d="M8 68C1 42 7 14 31 3C26 21 22 46 14 68C12 70 9 70 8 68Z" /><path class="music-petal-vein" d="M10 64C11 44 16 22 28 8" />';

    const spawnPetal = (x, y, ox, oy, delay, size) => {
      const k = scale();
      const particle = document.createElement('span');
      const life = Math.round(rand(3600, 5400));
      const dir = Math.random() < .5 ? -1 : 1;
      particle.className = 'music-effect-particle music-effect-particle--petal';
      particle.style.setProperty('--fx-x', x + '%');
      particle.style.setProperty('--fx-y', y + '%');
      particle.style.setProperty('--ox', ox + 'px');
      particle.style.setProperty('--oy', oy + 'px');
      particle.style.setProperty('--r0', Math.round(rand(-70, 70)) + 'deg');
      particle.style.setProperty('--sway', Math.round(dir * rand(26, 70) * k) + 'px');
      particle.style.setProperty('--sway2', Math.round(-dir * rand(18, 52) * k) + 'px');
      particle.style.setProperty('--fall', Math.round(rand(110, 210) * k) + 'px');
      particle.style.setProperty('--turn', Math.round(dir * rand(140, 320)) + 'deg');
      particle.style.setProperty('--fx-size', size.toFixed(2));
      particle.style.setProperty('--fx-life', life + 'ms');
      particle.style.setProperty('--fx-delay', Math.round(delay) + 'ms');
      const petal = document.createElementNS(svgNS, 'svg');
      petal.setAttribute('class', 'music-petal');
      petal.setAttribute('viewBox', '0 0 40 72');
      petal.setAttribute('aria-hidden', 'true');
      petal.innerHTML = petalMarkup;
      particle.appendChild(petal);
      release(particle, life + delay);
    };

    const spawnBaton = (x, y) => {
      const k = scale();
      const width = Math.round(Math.min(170, Math.max(96, panorama.getBoundingClientRect().width * .17)));
      const life = 9000;
      const particle = document.createElement('span');
      particle.className = 'music-effect-particle music-effect-particle--baton' + (canErode ? ' has-erode' : '');
      particle.style.setProperty('--fx-x', x + '%');
      particle.style.setProperty('--fx-y', y + '%');
      particle.style.setProperty('--fx-w', width + 'px');
      particle.style.setProperty('--fx-life', life + 'ms');
      particle.style.setProperty('--fx-tilt', rand(-5, 5).toFixed(1) + 'deg');
      const art = document.createElement('img');
      art.className = 'music-baton-sprite';
      art.src = batonSrc;
      art.alt = '';
      art.width = 448;
      art.height = 448;
      particle.appendChild(art);
      release(particle, life);

      // Pétalas saem da coroa da flor (≈ 48 % × 33 % da arte), em ritmo lento,
      // e algumas poucas das notas da pauta, mais embaixo.
      const count = k < .7 ? 11 : 17;
      for (let i = 0; i < count; i += 1) {
        const fromStaff = i % 6 === 5;
        const ox = fromStaff ? rand(-.36, -.04) * width : rand(-.26, .24) * width;
        const oy = fromStaff ? rand(.02, .16) * width : rand(-.36, -.03) * width;
        const delay = 700 + (i / count) * 4300 + rand(-120, 160);
        spawnPetal(x, y, ox, oy, delay, rand(.7, 1.25));
      }
    };

    const burst = (effect, x, y) => {
      if (effect === 'butterfly') {
        for (let i = 0; i < 5; i += 1) spawnButterfly(x + rand(-3, 3), y + rand(-3, 3), i * 90);
      } else {
        spawnBaton(x, y);
      }
    };

    effectToggle.addEventListener('click', (event) => {
      const effect = nextEffect;
      nextEffect = effect === 'butterfly' ? 'baton' : 'butterfly';
      if (effectsQuiet()) return;
      panorama.dataset.effectsUsed = 'true';

      const bounds = panorama.getBoundingClientRect();
      const keyboard = event.detail === 0;
      const originX = keyboard ? (effect === 'butterfly' ? 77 : 25) : Math.min(90, Math.max(10, (event.clientX - bounds.left) / bounds.width * 100));
      const originY = keyboard ? 36 : Math.min(87, Math.max(13, (event.clientY - bounds.top) / bounds.height * 100));
      if (!keyboard) ripple(originX, originY);
      burst(effect, originX, originY);
    });

    // Ambient life while the scene is on screen: now and then one butterfly
    // leaves Shorekeeper's hand, and every third time a baton dissolves
    // into petals on Phrolova's side. Nothing runs off-screen, in a hidden tab or when quiet.
    let ambientTimer = 0;
    let ambientCount = 0;
    let sceneVisible = false;
    const scheduleAmbient = () => {
      window.clearTimeout(ambientTimer);
      if (!sceneVisible || document.hidden || effectsQuiet()) return;
      ambientTimer = window.setTimeout(() => {
        ambientCount += 1;
        if (ambientCount % 3 === 0) spawnBaton(rand(21, 27), rand(34, 42));
        else spawnButterfly(rand(74, 80), rand(31, 39));
        scheduleAmbient();
      }, rand(7000, 12000));
    };
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        sceneVisible = Boolean(entry?.isIntersecting);
        scheduleAmbient();
      }, { threshold: .45 }).observe(panorama);
    }
    document.addEventListener('visibilitychange', scheduleAmbient);
    window.addEventListener('portfolio:mode', scheduleAmbient);
    reducedMotion.addEventListener('change', scheduleAmbient);
  }

  shelf?.setAttribute('aria-busy', 'true');
  if (shelf) shelf.dataset.musicState = 'loading';
  if (loadingState) { loadingState.hidden = false; loadingState.textContent = 'Consultando atividade recente…'; }
  document.addEventListener('visibilitychange', () => { if (!document.hidden) hydrateMusic(); });
  hydrateMusic();

  window.setInterval(
    hydrateMusic,
    90000,
  );
</script>
