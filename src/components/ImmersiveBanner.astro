---
// Banner do Modo Imersivo. Faixa escura e autocontida: não depende do tema claro/sério da página.
// O clipe é decorativo (5 s, WebM com canal alfa, ~540 KB) e só carrega quando visível.
// O texto carrega todo o sentido; sem o vídeo, o pôster estático ocupa o mesmo lugar.
// O brilho do propulsor é uma camada CSS sobreposta ao bocal (posição medida no quadro do clipe).
---
<aside class="immersive-banner" aria-labelledby="immersive-banner-title" data-immersive-banner>
  <div class="immersive-banner__copy">
    <p class="immersive-banner__eyebrow">Modo imersivo · experimento</p>
    <h2 id="immersive-banner-title" class="immersive-banner__title">
      Uma raposa, um foguete e uma <span class="immersive-banner__count">contagem regressiva</span>.
    </h2>
    <p class="immersive-banner__lede">
      Tecnologia criativa com o processo à vista: roteiro, animação 3D e engenharia por trás de dez segundos de lançamento.
    </p>
    <p class="immersive-banner__actions">
      <a class="immersive-banner__cta" href="/modo-imersivo/">
        <span class="immersive-banner__cta-label">Entrar no modo imersivo</span>
        <svg class="immersive-banner__cta-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path class="immersive-banner__cta-flame" d="M2 12h7" />
          <path class="immersive-banner__cta-arrow" d="M12 5l7 7-7 7M12 5v0" />
        </svg>
      </a>
      <a class="immersive-banner__link" href="/curiosidades/#creative-process-title">Ver como foi feito</a>
    </p>
    <p class="immersive-banner__note" data-immersive-note>Experiência 3D de cerca de 46&nbsp;MB. Melhor no desktop.</p>
  </div>

  <div class="immersive-banner__stage" aria-hidden="true">
    <video
      class="immersive-banner__video"
      muted
      loop
      playsinline
      preload="none"
      tabindex="-1"
      disablepictureinpicture
      width="960"
      height="540"
      poster="/assets/immersive-banner/sophia-rocket-still.webp"
      data-src="/assets/immersive-banner/sophia-rocket.webm"
    ></video>
    <span class="immersive-banner__thrust" data-thrust></span>
  </div>
</aside>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-immersive-banner]');
    const video = root && root.querySelector('video');
    if (!video) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const connection = navigator.connection || {};
    const saveData = connection.saveData === true;
    if (saveData) {
      const note = root.querySelector('[data-immersive-note]');
      if (note) note.textContent = 'Economia de dados ativa: a experiência 3D baixa cerca de 46 MB.';
    }
    const serious = () => document.documentElement.dataset.seriousMode === 'true';
    let onScreen = false;
    const sync = () => {
      const allowed = onScreen && !document.hidden && !reduce.matches && !saveData && !serious();
      if (!allowed) { video.pause(); return; }
      if (!video.getAttribute('src')) video.setAttribute('src', video.dataset.src);
      const p = video.play();
      if (p && p.catch) p.catch(() => {}); // sem autoplay ou sem alfa: o pôster continua no lugar
    };
    if (!('IntersectionObserver' in window)) return;
    new IntersectionObserver((entries) => {
      onScreen = entries.some((e) => e.isIntersecting);
      sync();
    }, { rootMargin: '120px 0px' }).observe(root);
    document.addEventListener('visibilitychange', sync);
    reduce.addEventListener?.('change', sync);
    new MutationObserver(sync).observe(document.documentElement, { attributes: true, attributeFilter: ['data-serious-mode'] });
  })();
</script>

<style>
  .immersive-banner {
    --ib-ink: #fffaf0;
    --ib-soft: #b9bdd9;
    --ib-bg: #000;
    /* bocal do foguete no quadro do clipe (16:9): 50,1% × 68,9% */
    --ib-nozzle-x: 50.1%;
    --ib-nozzle-y: 68.9%;
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
    margin: clamp(32px, 6vw, 72px) auto;
    width: min(1120px, calc(100% - 32px));
    overflow: hidden;
    border-radius: 22px;
    border: 1px solid #ffffff1a;
    color: var(--ib-ink);
    background: var(--ib-bg);
  }
  .immersive-banner__copy { padding: clamp(24px, 4vw, 48px); padding-bottom: 8px; position: relative; z-index: 2; }

  /* hierarquia: rótulo → título (o protagonista) → apoio → ação → nota */
  .immersive-banner__eyebrow {
    margin: 0 0 14px; font-family: var(--font-ui, system-ui, sans-serif); font-size: .72rem; font-weight: 600;
    letter-spacing: .22em; text-transform: uppercase; color: #f0b45a;
  }
  .immersive-banner__title {
    margin: 0; font-family: var(--font-display, Georgia, serif); font-weight: 600;
    font-size: clamp(2.05rem, 4.9vw, 3.2rem); line-height: 1.04; letter-spacing: -.012em;
    color: var(--ib-ink); text-wrap: balance;
  }
  /* mesmo degradê do cronômetro do modo imersivo (creme → dourado → vermelho) */
  .immersive-banner__count {
    background-image: linear-gradient(180deg, #fffaf0 0%, #fff1b8 28%, #f0b45a 62%, #d6453d 100%);
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  }
  .immersive-banner__lede {
    margin: 16px 0 0; max-width: 42ch; color: var(--ib-soft);
    font-family: var(--font-ui, system-ui, sans-serif); font-size: clamp(.98rem, 1.5vw, 1.08rem); line-height: 1.55;
  }
  .immersive-banner__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 24px; margin: 24px 0 0; }

  /* botão: a seta "decola" para a frente e a chama atrás dela acende ao passar o mouse ou o foco */
  .immersive-banner__cta {
    position: relative; overflow: hidden;
    display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 22px 0 24px; border-radius: 999px;
    background: #fff1b8; color: #140e02; font-family: var(--font-ui, system-ui, sans-serif);
    font-weight: 700; font-size: .98rem; text-decoration: none;
    box-shadow: 0 0 0 0 #f0b45a00;
    transition: background-color .2s ease, box-shadow .3s ease, transform .2s ease;
  }
  .immersive-banner__cta::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(100deg, transparent 30%, #fff8 50%, transparent 70%);
    transform: translateX(-120%); transition: transform .7s cubic-bezier(.2,.7,.2,1);
  }
  .immersive-banner__cta-icon { width: 22px; height: 22px; flex: none; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .immersive-banner__cta-flame { stroke: #d6453d; stroke-width: 2.4; opacity: 0; transform-box: fill-box; transform-origin: right center; transform: scaleX(.2); transition: opacity .2s ease, transform .3s ease; }
  .immersive-banner__cta-arrow { transition: transform .3s cubic-bezier(.2,.8,.2,1); }
  .immersive-banner__cta:hover, .immersive-banner__cta:focus-visible {
    background: #ffe58a; transform: translateY(-2px);
    box-shadow: 0 10px 28px -8px #f0b45acc;
  }
  .immersive-banner__cta:hover::before, .immersive-banner__cta:focus-visible::before { transform: translateX(120%); }
  .immersive-banner__cta:hover .immersive-banner__cta-arrow, .immersive-banner__cta:focus-visible .immersive-banner__cta-arrow { transform: translateX(4px); }
  .immersive-banner__cta:hover .immersive-banner__cta-flame, .immersive-banner__cta:focus-visible .immersive-banner__cta-flame {
    opacity: 1; transform: scaleX(1); animation: ib-ignite .5s steps(3, end) infinite alternate;
  }
  .immersive-banner__cta:active { transform: translateY(0) scale(.98); }
  .immersive-banner__cta:focus-visible { outline: 3px solid #fff1b8; outline-offset: 4px; }

  .immersive-banner__link {
    color: var(--ib-ink); text-underline-offset: 5px; min-height: 48px; display: inline-flex; align-items: center;
    font-family: var(--font-ui, system-ui, sans-serif); font-size: .98rem;
  }
  .immersive-banner__link:focus-visible { outline: 3px solid #fff1b8; outline-offset: 3px; }
  .immersive-banner__note { margin: 16px 0 0; font-family: var(--font-ui, system-ui, sans-serif); font-size: .8rem; color: #8f95bd; }

  .immersive-banner__stage { position: relative; z-index: 1; aspect-ratio: 4 / 3; width: 100%; }
  .immersive-banner__video { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 20% 50%; background: transparent; }

  /* propulsor: um brilho quente que pulsa de forma irregular sobre o bocal. Só transform e opacity. */
  .immersive-banner__thrust {
    position: absolute; left: var(--ib-nozzle-x); top: var(--ib-nozzle-y); z-index: 2;
    width: 22%; aspect-ratio: 1; translate: -18% -50%; pointer-events: none;
    border-radius: 50%; mix-blend-mode: screen;
    background: radial-gradient(closest-side, #fff7d6 0%, #ffc26b 24%, #ff7a3d 52%, #ff3d2e33 74%, transparent 100%);
    animation: ib-thrust 1.3s linear infinite;
    transform-origin: 18% 50%;
  }
  @keyframes ib-thrust {
    0%   { opacity: .72; transform: scale(.92, .9); }
    14%  { opacity: 1;   transform: scale(1.12, 1.08); }
    31%  { opacity: .66; transform: scale(.96, .94); }
    47%  { opacity: .94; transform: scale(1.06, 1.1); }
    63%  { opacity: .6;  transform: scale(.9, .88); }
    79%  { opacity: 1;   transform: scale(1.14, 1.12); }
    100% { opacity: .72; transform: scale(.92, .9); }
  }
  @keyframes ib-ignite {
    from { transform: scaleX(.85); }
    to   { transform: scaleX(1.12); }
  }

  /* tablet estreito (600–859px): quadro 16:9 como no desktop, sem vazio abaixo do foguete */
  @media (min-width: 600px) and (max-width: 859px) {
    .immersive-banner__stage { aspect-ratio: 16 / 9; }
    .immersive-banner__video { object-fit: contain; }
    .immersive-banner__thrust { width: 18%; }
  }
  /* celular: o recorte 4:3 mostra o bocal a 69% × 67% do quadro */
  @media (max-width: 599px) {
    .immersive-banner { --ib-nozzle-x: 69%; --ib-nozzle-y: 67%; }
    .immersive-banner__thrust { width: 24%; }
  }
  @media (min-width: 860px) {
    .immersive-banner { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); align-items: center; gap: 0; }
    .immersive-banner__copy { padding-bottom: clamp(24px, 4vw, 48px); }
    .immersive-banner__stage { margin-left: -4%; aspect-ratio: 16 / 9; }
    .immersive-banner__video { object-fit: contain; }
    .immersive-banner__thrust { width: 15%; }
  }

  /* Modo sério: fundo sóbrio, sem brilho, sem texto em degradê; o pôster fica parado */
  :global(html[data-serious-mode='true']) .immersive-banner { --ib-bg: #04061a; border-radius: 6px; }
  :global(html[data-serious-mode='true']) .immersive-banner__count {
    background: none; -webkit-text-fill-color: currentColor; color: var(--ib-ink);
  }
  :global(html[data-serious-mode='true']) .immersive-banner__thrust { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .immersive-banner__cta, .immersive-banner__cta::before, .immersive-banner__cta-arrow, .immersive-banner__cta-flame { transition: none; animation: none; }
    .immersive-banner__cta:hover, .immersive-banner__cta:focus-visible { transform: none; }
    .immersive-banner__cta:hover .immersive-banner__cta-arrow, .immersive-banner__cta:focus-visible .immersive-banner__cta-arrow { transform: none; }
    .immersive-banner__thrust { animation: none; opacity: .8; }
  }
</style>
