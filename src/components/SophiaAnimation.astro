---
interface Props {
  variant: 'music' | 'lab';
  linked?: boolean;
}
const { variant, linked = true } = Astro.props;
const Tag = linked ? 'a' : 'div';
const description = variant === 'music'
  ? 'Sophia, raposa lunar com fones, acompanha o ritmo da música.'
  : 'Sophia de jaleco branco, anotando suas descobertas no caderno.';
---

<Tag data-decorative-motion class={`sophia-animation sophia-animation--${variant}`} href={linked ? "/sophia/" : undefined} aria-label={linked ? `${description} Conhecer Sophia.` : undefined} aria-hidden={linked ? undefined : "true"}>
  <span class="sophia-animation__frame" aria-hidden="true"></span>
</Tag>
