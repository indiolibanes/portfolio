<figure
  class="method-presenter"
  data-decorative-motion
  role="img"
  aria-label="Sophia de terninho apresenta um fluxograma em ciclo com projetor: concepção, execução assistida, avaliação e documentação, e a documentação volta a orientar a concepção. O destaque percorre as quatro etapas em sequência."
>
  <svg class="method-presenter__projection" viewBox="0 0 500 360" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="method-projector-light" x1="0" y1="1" x2="0" y2="0">
        <stop offset="0" stop-color="#f5edb5" stop-opacity=".24" />
        <stop offset="1" stop-color="#f5edb5" stop-opacity="0" />
      </linearGradient>
      <marker id="method-flow-arrow" markerWidth="7" markerHeight="7" refX="5.5" refY="3.5" orient="auto" markerUnits="userSpaceOnUse">
        <path d="M0 .5 6.5 3.5 0 6.5Z" fill="#426651" />
      </marker>
      <marker id="method-flow-arrow-on" markerWidth="7" markerHeight="7" refX="5.5" refY="3.5" orient="auto" markerUnits="userSpaceOnUse">
        <path d="M0 .5 6.5 3.5 0 6.5Z" fill="#1f5a45" />
      </marker>
    </defs>
    <path class="method-presenter__beam" d="M110 302 24 40 286 216Z" fill="url(#method-projector-light)" />
    <path d="M155 226V306M126 313l29-7 29 7" fill="none" stroke="#375441" stroke-width="5" stroke-linecap="round" />
    <rect x="14" y="26" width="282" height="200" rx="10" fill="#f2f5e7" stroke="#375441" stroke-width="3" />
    <path d="M20 28H290" stroke="#375441" stroke-width="7" stroke-linecap="round" />
    <text x="30" y="52" class="method-presenter__screen-title">DA IDEIA À ESTRUTURA</text>
    <text x="280" y="52" class="method-presenter__screen-title method-presenter__cycle-mark" text-anchor="end">CICLO</text>

    <!-- Conexões: A→B, B→C, C→D e a volta D→A que fecha o ciclo. -->
    <g class="method-presenter__links" fill="none" stroke="#426651" stroke-width="2" stroke-linecap="round" marker-end="url(#method-flow-arrow)">
      <path class="method-presenter__link method-presenter__link--1" d="M144 92H167" />
      <path class="method-presenter__link method-presenter__link--2" d="M227 118V139" />
      <path class="method-presenter__link method-presenter__link--3" d="M168 164H145" />
      <path class="method-presenter__link method-presenter__link--4 method-presenter__link--return" d="M85 138V120" />
    </g>
    <text x="156" y="132" class="method-presenter__loop-mark" text-anchor="middle">↻</text>

    <!-- Etapas: mesma ordem e nomes da lista abaixo da cena. -->
    <g class="method-presenter__nodes">
      <rect class="method-presenter__node method-presenter__node--conception" x="30" y="68" width="112" height="48" rx="8" />
      <rect class="method-presenter__node method-presenter__node--execution" x="170" y="68" width="112" height="48" rx="8" />
      <rect class="method-presenter__node method-presenter__node--evaluation" x="170" y="140" width="112" height="48" rx="8" />
      <rect class="method-presenter__node method-presenter__node--record" x="30" y="140" width="112" height="48" rx="8" />
    </g>
    <g class="method-presenter__badges">
      <circle cx="43" cy="81" r="7.5" /><text x="43" y="84.4" text-anchor="middle">1</text>
      <circle cx="183" cy="81" r="7.5" /><text x="183" y="84.4" text-anchor="middle">2</text>
      <circle cx="183" cy="153" r="7.5" /><text x="183" y="156.4" text-anchor="middle">3</text>
      <circle cx="43" cy="153" r="7.5" /><text x="43" y="156.4" text-anchor="middle">4</text>
    </g>
    <g class="method-presenter__node-label">
      <text x="56" y="88">Concepção</text>
      <text x="196" y="88">Execução</text>
      <text x="196" y="160">Avaliação</text>
      <text x="55" y="160" textLength="80" lengthAdjust="spacingAndGlyphs">Documentação</text>
    </g>
    <g class="method-presenter__node-hint">
      <text x="56" y="104">dar forma à ideia</text>
      <text x="196" y="104">IA com restrições</text>
      <text x="196" y="176">checar o resultado</text>
      <text x="56" y="176">deixar um caminho</text>
    </g>
    <text x="155" y="212" class="method-presenter__screen-note" text-anchor="middle">Revisar orienta o próximo passo.</text>

    <g stroke="#375441" stroke-width="2">
      <path d="M45 325v9m42-9v9" stroke-linecap="round" />
      <rect x="26" y="290" width="83" height="35" rx="8" fill="#e0e8da" />
      <rect x="99" y="298" width="18" height="20" rx="5" fill="#375441" />
      <circle cx="109" cy="308" r="6" fill="#f0cf78" stroke="none" />
      <path d="M37 299H58M37 305H58M37 311H58" stroke="#8aa28d" />
      <circle cx="84" cy="299" r="2" fill="#6a946e" stroke="none" />
    </g>
  </svg>
  <span class="method-presenter__sophia" aria-hidden="true"></span>
</figure>
