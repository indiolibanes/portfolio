<div class="random-easter-layer" aria-hidden="true">
  <img
    class="random-easter-sprite"
    data-random-easter-sprite
    alt=""
    decoding="async"
  />
</div>

<script is:inline>
  // Aemeath peeks in from an edge of the screen now and then, looks around
  // and leaves. She never lands over the middle of the text column, never
  // runs in Editorial, with reduced motion or in a hidden tab.
  (() => {
    const sprite = document.querySelector('[data-random-easter-sprite]');
    if (!sprite) return;

    // aemeath-pixel-05.webp is a truncated upload (RIFF size 6712 B, file
    // 5802 B) that decodes to an empty frame, so it stays out of rotation.
    const assets = [
      '/assets/easter/aemeath-pixel-01.webp',
      '/assets/easter/aemeath-pixel-02.webp',
      '/assets/easter/aemeath-pixel-03.webp',
      '/assets/easter/aemeath-pixel-04.webp',
    ];

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const randomBetween = (min, max) => min + Math.random() * (max - min);
    const randomInteger = (min, max) => Math.round(randomBetween(min, max));

    let scheduleTimer = 0;
    let hideTimer = 0;
    let cleanupTimer = 0;
    let active = false;
    let lastIndex = -1;
    let lastEdge = '';
    let firstAppearance = true;

    const canAppear = () =>
      !document.hidden &&
      !reducedMotion.matches &&
      document.documentElement.dataset.seriousMode !== 'true';

    const clearTimers = () => {
      window.clearTimeout(scheduleTimer);
      window.clearTimeout(hideTimer);
      window.clearTimeout(cleanupTimer);
      scheduleTimer = 0;
      hideTimer = 0;
      cleanupTimer = 0;
    };

    const chooseAsset = () => {
      let next = lastIndex;
      while (next === lastIndex) next = Math.floor(Math.random() * assets.length);
      lastIndex = next;
      return assets[next];
    };

    const chooseEdge = () => {
      const edges = ['left', 'right', 'bottom'].filter((edge) => edge !== lastEdge);
      lastEdge = edges[Math.floor(Math.random() * edges.length)];
      return lastEdge;
    };

    const place = () => {
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const compact = vw < 640;
      const width = compact ? randomInteger(72, 96) : randomInteger(104, 144);
      const edge = chooseEdge();
      const header = compact ? 96 : 110;

      sprite.style.width = `${width}px`;
      sprite.dataset.edge = edge;

      if (edge === 'bottom') {
        sprite.style.left = `${randomInteger(Math.round(vw * 0.12), Math.max(12, Math.round(vw * 0.88 - width)))}px`;
        sprite.style.top = `${Math.round(vh - width * 0.82)}px`;
      } else {
        const top = randomInteger(Math.max(header, Math.round(vh * 0.3)), Math.max(header, Math.round(vh * 0.78 - width)));
        sprite.style.top = `${top}px`;
        sprite.style.left = edge === 'left' ? `${Math.round(-width * 0.16)}px` : `${Math.round(vw - width * 0.84)}px`;
      }
    };

    const hide = (reschedule = true) => {
      window.clearTimeout(hideTimer);
      hideTimer = 0;
      sprite.dataset.visible = 'false';
      active = false;
      cleanupTimer = window.setTimeout(() => {
        sprite.removeAttribute('src');
        cleanupTimer = 0;
        if (reschedule) schedule(false);
      }, 520);
    };

    const show = () => {
      scheduleTimer = 0;
      if (!canAppear() || active) {
        schedule(false);
        return;
      }

      active = true;
      place();
      sprite.dataset.visible = 'false';
      sprite.src = chooseAsset();

      const reveal = () => {
        if (!canAppear()) {
          hide(false);
          return;
        }
        requestAnimationFrame(() => {
          sprite.dataset.visible = 'true';
          hideTimer = window.setTimeout(() => hide(true), randomInteger(2600, 3600));
        });
      };

      if (sprite.complete && sprite.naturalWidth) reveal();
      else {
        sprite.addEventListener('load', reveal, { once: true });
        sprite.addEventListener('error', () => hide(true), { once: true });
      }
    };

    function schedule(initial = false) {
      window.clearTimeout(scheduleTimer);
      if (!canAppear()) return;
      const delay = initial ? randomInteger(12000, 30000) : randomInteger(40000, 110000);
      scheduleTimer = window.setTimeout(show, delay);
      firstAppearance = false;
    }

    const suspend = () => {
      clearTimers();
      if (active) hide(false);
      else {
        sprite.dataset.visible = 'false';
        sprite.removeAttribute('src');
      }
    };

    const resume = () => {
      if (canAppear() && !active && !scheduleTimer) schedule(firstAppearance);
    };

    const sync = () => (canAppear() ? resume() : suspend());
    reducedMotion.addEventListener('change', sync);
    document.addEventListener('visibilitychange', sync);
    window.addEventListener('portfolio:mode', sync);

    schedule(true);
  })();
</script>

<style is:global>
  .random-easter-layer {
    position: fixed;
    inset: 0;
    z-index: 46;
    overflow: hidden;
    pointer-events: none;
  }

  .random-easter-sprite {
    position: fixed;
    width: 120px;
    height: auto;
    display: block;
    opacity: 0;
    transform: var(--peek-from);
    transform-origin: 50% 90%;
    image-rendering: pixelated;
    filter: drop-shadow(0 7px 10px rgba(45, 35, 42, 0.18));
    transition:
      opacity 220ms ease,
      transform 520ms cubic-bezier(.34, 1.36, .5, 1);
    will-change: opacity, transform;
  }

  .random-easter-sprite[data-edge='left'] { --peek-from: translateX(-105%) rotate(-10deg); --peek-to: translateX(0) rotate(7deg); }
  .random-easter-sprite[data-edge='right'] { --peek-from: translateX(105%) rotate(10deg); --peek-to: translateX(0) rotate(-7deg); }
  .random-easter-sprite[data-edge='bottom'] { --peek-from: translateY(110%); --peek-to: translateY(0); }

  .random-easter-sprite[data-visible='true'] {
    opacity: 0.98;
    transform: var(--peek-to);
    animation: aemeath-peek-bob 1.4s 520ms ease-in-out infinite;
  }

  @keyframes aemeath-peek-bob {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -4px; }
  }

  html[data-serious-mode='true'] .random-easter-layer {
    display: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .random-easter-layer {
      display: none !important;
    }
  }
</style>
