<Fragment set:html={defs} />
<nav class="xm-mode-nav" aria-label="Outros modos de leitura" data-xm-mode-nav>
  {choices.map(choice => (
    <a class="xm-mode-choice" href={choice.href} aria-label={`Abrir modo ${choice.name}`} title={choice.name} data-xm-mode={choice.id}>
      <Fragment set:html={choice.markup} />
    </a>
  ))}
</nav>
<script is:inline>
// Original α (solar), β (neutron star) and γ (quasar) WAAPI choreographies
// copied from SeriousModeToggle.astro; this copy NEVER changes reading mode on
// the immersive page. They stop when the drawer closes or the tab is hidden.
(() => {
  const root = document.querySelector('[data-xm-mode-nav]');
  if (!root) return;
  const drawer = root.closest('[data-xm-drawer]');
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const rnd = (lo, hi) => lo + Math.random() * (hi - lo);
    const loopsOf = {
      authorial: (q, all) => {
        const out = [];
        // Imprevisível: cada camada segue uma sequência irregular de valores.
        const walk = (n, make) => Array.from({ length: n }, make);
        out.push(
          // Anel: gira aos arrancos, com velocidades desiguais.
          q('.serious-ring__spin')?.animate(
            [0, 140, 175, 420, 470, 640, 720].map((d) => ({ transform: 'rotate(' + d + 'deg)' })),
            { duration: 2600, iterations: Infinity },
          ),
          q('.serious-rays__spin')?.animate(
            [0, 70, 30, 190, 160, 300, 360].map((d) => ({ transform: 'rotate(' + -d + 'deg)' })),
            { duration: 4400, iterations: Infinity },
          ),
          q('.serious-halo__pulse')?.animate(
            walk(8, (_, i) => ({
              transform: 'translate(' + rnd(-2.5, 2.5) + 'px,' + rnd(-2.5, 2.5) + 'px) scale(' + rnd(0.82, 1.24) + ')',
              opacity: rnd(0.65, 1),
              filter: 'hue-rotate(' + i * rnd(40, 70) + 'deg) brightness(' + rnd(1, 1.35) + ')',
            })),
            { duration: 2600, iterations: Infinity, easing: 'ease-in-out' },
          ),
          q('.serious-flare__pulse')?.animate(
            walk(7, () => ({ transform: 'scaleX(' + rnd(0.3, 1.25) + ')', opacity: rnd(0.35, 1), filter: 'hue-rotate(' + rnd(0, 120) + 'deg)' })),
            { duration: 2100, iterations: Infinity, easing: 'ease-in-out' },
          ),
          q('.serious-flare2__pulse')?.animate(
            walk(6, () => ({ transform: 'scale(' + rnd(0.4, 1.2) + ')', opacity: rnd(0, 1) })),
            { duration: 1700, iterations: Infinity, easing: 'ease-in-out' },
          ),
        );
        all('.serious-ray').forEach((el) => {
          out.push(
            el.animate(
              walk(5, () => ({ transform: 'scale(' + rnd(0.55, 1.3) + ')', opacity: rnd(0.2, 1) })),
              { duration: rnd(500, 1700), delay: -rnd(0, 1200), iterations: Infinity, easing: 'ease-in-out' },
            ),
          );
        });
        // Faíscas: nascem em lugares e instantes aleatórios.
        const sparks = all('.serious-spark');
        let timer = 0;
        const fire = () => {
          const spark = sparks[(Math.random() * sparks.length) | 0];
          if (spark) {
            const ang = Math.random() * Math.PI * 2;
            const rad = rnd(24, 50);
            spark.parentNode.setAttribute('transform', 'translate(' + (32 + rad * Math.cos(ang)) + ' ' + (32 + rad * Math.sin(ang)) + ')');
            spark.animate(
              [
                { opacity: 0, transform: 'scale(0.2) rotate(0deg)' },
                { opacity: 1, transform: 'scale(' + rnd(1.2, 2.4) + ') rotate(45deg)', offset: 0.3 },
                { opacity: 0, transform: 'scale(0.3) rotate(90deg)' },
              ],
              { duration: rnd(320, 900), easing: 'ease-out' },
            );
          }
          timer = setTimeout(fire, rnd(90, 380));
        };
        fire();
        out.push({ cancel: () => clearTimeout(timer) });
        return out;
      },
      editorial: (q) => {
        const walk = (n, make) => Array.from({ length: n }, make);
        const out = [
          // Estrela de nêutrons: giro furioso, com picos e freadas irregulares.
          q('.serious-beams__spin')?.animate(
            [0, 120, 150, 330, 400, 560, 600, 720].map((d) => ({ transform: 'rotate(' + d + 'deg)' })),
            { duration: 190, iterations: Infinity },
          ),
          // Segundo par de jatos gira ao contrário, em outro ritmo.
          q('.serious-beams2__spin')?.animate(
            [0, 200, 250, 430, 700, 1080].map((d) => ({ transform: 'rotate(' + -d + 'deg)' })),
            { duration: 330, iterations: Infinity },
          ),
          // O eixo oscila e se alonga de forma caótica.
          q('.serious-beams__tilt')?.animate(
            walk(9, () => ({ transform: 'rotate(' + rnd(-24, 24) + 'deg) scale(' + rnd(0.8, 1.3) + ')', opacity: rnd(0.6, 1) })),
            { duration: 620, iterations: Infinity, easing: 'ease-in-out' },
          ),
          q('.serious-shock__ring')?.animate(
            [
              { transform: 'scale(0.6)', opacity: 0.9 },
              { transform: 'scale(1.7)', opacity: 0 },
            ],
            { duration: 380, iterations: Infinity, easing: 'cubic-bezier(0.1, 0.7, 0.3, 1)' },
          ),
          q('.serious-halo__pulse')?.animate(
            walk(8, () => ({ transform: 'scale(' + rnd(0.8, 1.2) + ')', opacity: rnd(0.55, 1) })),
            { duration: 420, iterations: Infinity, easing: 'ease-in-out' },
          ),
          // Espaguetificação: a letra estica, treme e se desfaz em fios.
          q('.serious-glyph')?.animate(
            walk(8, () => ({ transform: 'scale(' + rnd(0.82, 1.05) + ',' + rnd(0.95, 1.3) + ') skewX(' + rnd(-6, 6) + 'deg)' })),
            { duration: 480, iterations: Infinity, easing: 'ease-in-out' },
          ),
        ];
        const ghosts = [
          [{ transform: 'scale(1, 1)', opacity: 0 }, { transform: 'scale(0.5, 2.1)', opacity: 0.9, offset: 0.5 }, { transform: 'scale(0.15, 3.2)', opacity: 0 }],
          [{ transform: 'scale(1, 1)', opacity: 0 }, { transform: 'scale(1.35, 0.35)', opacity: 0.8, offset: 0.5 }, { transform: 'scale(1.9, 0.08)', opacity: 0 }],
        ];
        ['1', '2'].forEach((n, k) => {
          out.push(
            q('.serious-ghost--' + n)?.animate(ghosts[k], {
              duration: 420,
              delay: k * 210,
              iterations: Infinity,
              easing: 'ease-in',
            }),
          );
        });
        return out;
      },
      legacy: (q, all) => {
        // Quasar: jatos grossos na diagonal, caóticos e furiosos; grumos de raios
        // gama disparam pelos dois lados e um clarão explode sem avisar.
        const walk = (n, make) => Array.from({ length: n }, make);
        const out = [
          q('.serious-jets__tilt')?.animate(
            walk(9, () => ({ transform: 'rotate(' + (32 + rnd(-11, 11)) + 'deg)' })),
            { duration: 1100, iterations: Infinity, easing: 'ease-in-out' },
          ),
          q('.serious-jets__pulse')?.animate(
            walk(10, () => ({ transform: 'scaleY(' + rnd(0.5, 1.25) + ') scaleX(' + rnd(0.8, 1.5) + ')', opacity: rnd(0.65, 1) })),
            { duration: 460, iterations: Infinity, easing: 'ease-in-out' },
          ),
          q('.serious-jets2__pulse')?.animate(
            walk(10, () => ({ transform: 'rotate(' + rnd(-16, 16) + 'deg) scaleY(' + rnd(0.4, 1.2) + ')', opacity: rnd(0.3, 1) })),
            { duration: 700, iterations: Infinity, easing: 'ease-in-out' },
          ),
          q('.serious-halo__pulse')?.animate(
            walk(8, () => ({ transform: 'scale(' + rnd(0.8, 1.3) + ')', opacity: rnd(0.55, 1) })),
            { duration: 520, iterations: Infinity, easing: 'ease-in-out' },
          ),
          q('.serious-accretion__ring')?.animate(
            walk(7, () => ({ transform: 'scaleX(' + rnd(0.7, 1.12) + ') scaleY(' + rnd(0.7, 1.6) + ')', opacity: rnd(0.4, 1) })),
            { duration: 640, iterations: Infinity, easing: 'ease-in-out' },
          ),
          q('.serious-gamma__flash')?.animate(
            [
              { transform: 'scale(0.1, 0.2)', opacity: 0 },
              { transform: 'scale(1.3, 1.1)', opacity: 1, offset: 0.14 },
              { transform: 'scale(0.9, 1.2)', opacity: 0.4, offset: 0.4 },
              { transform: 'scale(0.4, 1.3)', opacity: 0 },
            ],
            { duration: 1000, iterations: Infinity, easing: 'cubic-bezier(0.1, 0.8, 0.2, 1)' },
          ),
        ];
        all('.serious-jet__flow').forEach((el) => {
          out.push(
            el.animate([{ strokeDashoffset: 0 }, { strokeDashoffset: -24 }], {
              duration: 180,
              iterations: Infinity,
            }),
          );
        });
        // Grumos de gama: nascem no núcleo e disparam até a ponta, cada um no seu ritmo.
        all('.serious-gamma__blob').forEach((el, k) => {
          const dir = el.getAttribute('class').includes('--d') ? 1 : -1;
          const reach = rnd(46, 66) * dir;
          out.push(
            el.animate(
              [
                { transform: 'translate(0,0) scale(0.3)', opacity: 0 },
                { transform: 'translate(' + rnd(-4, 4) + 'px,' + reach * 0.3 + 'px) scale(' + rnd(1.2, 2) + ')', opacity: 1, offset: 0.2 },
                { transform: 'translate(' + rnd(-6, 6) + 'px,' + reach + 'px) scale(0.4)', opacity: 0 },
              ],
              { duration: rnd(380, 720), delay: -rnd(0, 700) + k * 40, iterations: Infinity, easing: 'cubic-bezier(0.3, 0, 0.7, 1)' },
            ),
          );
        });
        return out;
      },
    };

  const active = new Map();
  const stop = () => {
    for (const animations of active.values()) {
      animations.forEach(animation => animation?.cancel?.());
    }
    active.clear();
  };
  const sync = () => {
    const open = drawer?.dataset.state === 'open' && !document.hidden && !reducedMotion.matches;
    if (!open) { stop(); return; }
    root.querySelectorAll('[data-xm-mode]').forEach(node => {
      if (active.has(node)) return;
      const q = selector => node.querySelector(selector);
      const all = selector => [...node.querySelectorAll(selector)];
      active.set(node, (loopsOf[node.dataset.xmMode]?.(q, all) || []).filter(Boolean));
    });
  };
  const observer = new MutationObserver(sync);
  if (drawer) observer.observe(drawer, {attributes: true, attributeFilter: ['data-state']});
  reducedMotion.addEventListener('change', sync);
  document.addEventListener('visibilitychange', sync);
  sync();
})();
</script>
<style is:global>
/* These are the exact structural classes, SVG effects, and animation targets
   from SeriousModeToggle.astro. The WAAPI choreography above is copied
   unchanged; the Immersivo variant is navigation only (no theme mutation). */
.xm-mode-defs {position:absolute;width:0;height:0;overflow:hidden;pointer-events:none;}
.xm-mode-choice { overflow: visible; }
.xm-mode-choice .serious-art {display:block;width:100%;height:100%;overflow:visible;filter:saturate(1.12) brightness(1.08);}
.xm-mode-choice .serious-fx {opacity:1;transform:scale(1);}
.xm-mode-choice .serious-halo {transform:scale(1.25);}
.xm-mode-choice .serious-ring {opacity:.72;}
.xm-mode-choice .serious-spark {
  transform-box: fill-box;transform-origin:center;fill:#fff3c4;opacity:0;
}
.xm-mode-choice .serious-rays line {stroke:url(#serious-rainbow-us);stroke-linecap:round;}
.xm-mode-choice .serious-shock__ring {stroke:#8f86d8;}
.xm-mode-choice .serious-ghost {opacity:0;}
.xm-mode-choice .serious-jet__core {stroke:#fff;stroke-width:2.4;stroke-linecap:round;}
.xm-mode-choice .serious-jet__flow {stroke:#bfe6ff;stroke-width:2.2;stroke-linecap:round;stroke-dasharray:4 8;}
.xm-mode-choice .serious-accretion__ring {stroke:#9fd4ff;stroke-width:1.2;}
.xm-mode-choice .serious-gamma__blob,.xm-mode-choice .serious-gamma__flash {opacity:0;}
.xm-mode-choice .serious-ornament {stroke:rgba(255,216,130,.5);}
.xm-mode-choice .serious-ornament--authorial {stroke-width:1;stroke-dasharray:.1 10.5;stroke-linecap:round;}
.xm-mode-choice .serious-ornament--editorial {stroke-width:.8;}
.xm-mode-choice .serious-ornament--legacy {stroke-width:1.1;stroke-dasharray:1.6 2.1;}
.xm-mode-choice .serious-disc {stroke:rgba(255,220,140,.35);stroke-width:1;}
.xm-mode-choice .serious-fx,
.xm-mode-choice .serious-halo__pulse,
.xm-mode-choice .serious-ring__spin,
.xm-mode-choice .serious-rays__spin,
.xm-mode-choice .serious-flare__pulse,
.xm-mode-choice .serious-beams__spin,
.xm-mode-choice .serious-beams__pulse,
.xm-mode-choice .serious-shock__ring,
.xm-mode-choice .serious-ghost,
.xm-mode-choice .serious-glyph,
.xm-mode-choice .serious-jets__pulse,
.xm-mode-choice .serious-beams__tilt,
.xm-mode-choice .serious-beams2__spin,
.xm-mode-choice .serious-jets__tilt,
.xm-mode-choice .serious-jets2__pulse,
.xm-mode-choice .serious-flare2__pulse,
.xm-mode-choice .serious-ray,
.xm-mode-choice .serious-accretion__ring,
.xm-mode-choice .serious-gamma__flash,
.xm-mode-choice .serious-gamma__blob {
  transform-box:view-box;transform-origin:32px 32px;
