---
import { PROFILE, PUBLIC_PAGES, SITE, SOCIALS, isCreativePath } from '../config';
import DiscoveryLinks from './DiscoveryLinks.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
} = Astro.props;

const pathname = Astro.url.pathname;
const isNotFound = pathname.replace(/\/$/, '') === '/404';
const isCreativeLanding = isCreativePath(pathname);
const creativePath = PUBLIC_PAGES.creative.path;
const canonicalUrl = new URL(isCreativeLanding ? creativePath : pathname, SITE.url).toString();
const ogImageUrl = new URL(SITE.ogImage, SITE.url).toString();
// A página do palco experimental é acessível por URL direta, mas não é indexável.
const isUnlistedStage = Astro.url.pathname.replace(/\/$/, '') === '/experimentos';
// Canvas 2D scenes exist only on the landing page; omit their runtime elsewhere.
const hasLandingScenes = pathname === '/' || isCreativeLanding;
// Stable, public identity data for the portfolio's main page only.
const personId = new URL('/#person', SITE.url).toString();
const websiteId = new URL('/#website', SITE.url).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: PROFILE.name,
      url: new URL('/', SITE.url).toString(),
      sameAs: [PROFILE.linkedin, SOCIALS.github],
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: SITE.title,
      description: SITE.description,
      url: new URL('/', SITE.url).toString(),
      inLanguage: 'pt-BR',
      author: { '@id': personId },
    },
  ],
};
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={isNotFound || isUnlistedStage ? 'noindex, nofollow, noarchive' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
<meta name="theme-color" content="#f6efdc" />

<script is:inline define:vars={{ creativePath, isCreativeLanding, hasLandingScenes }}>
  (() => {
    const params = new URLSearchParams(window.location.search);
    const requested = params.get('mode');
    const seriousParam = params.get('serious');
    const supportedModes = ['authorial', 'editorial', 'documentation'];
    let mode = supportedModes.includes(requested) ? requested : null;

    if (['creative', 'criativo', 'experimental'].includes(requested)) mode = 'authorial';
    if (['legacy', '1998', 'neumorfismo', 'neumorphism', 'documentacao'].includes(requested)) mode = 'documentation';
    if (!mode && ['1', 'true'].includes(seriousParam)) mode = 'editorial';
    if (!mode && ['0', 'false'].includes(seriousParam)) mode = 'authorial';

    // The landing URL determines both the rendered content and its visual mode.
    if (hasLandingScenes && mode && (mode === 'authorial') !== isCreativeLanding) {
      const destination = new URL(window.location.href);
      destination.pathname = mode === 'authorial' ? creativePath : '/';
      destination.searchParams.delete('serious');
      if (mode === 'editorial') destination.searchParams.set('mode', 'editorial');
      else destination.searchParams.delete('mode');
      window.location.replace(destination.pathname + destination.search + destination.hash);
      return;
    }

    if (hasLandingScenes) {
      mode ??= isCreativeLanding ? 'authorial' : 'documentation';
    } else if (!mode) {
      try {
        const stored = localStorage.getItem('portfolio-mode-v2');
        if (supportedModes.includes(stored) || stored === 'legacy') {
          mode = stored === 'legacy' ? 'documentation' : stored;
        }
      } catch {}
    }

    mode ??= 'documentation';
    document.documentElement.dataset.portfolioMode = mode;
    document.documentElement.dataset.seriousMode = mode === 'editorial' ? 'true' : 'false';
    document.documentElement.dataset.documentationMode = mode === 'documentation' ? 'true' : 'false';
  })();
</script>
<script is:inline src="/scripts/reveal.js"></script>
{hasLandingScenes && <script is:inline src="/scripts/scenes.js" defer></script>}

{!isNotFound && <link rel="canonical" href={canonicalUrl} />}
{!isNotFound && !isUnlistedStage && <DiscoveryLinks />}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
{!pathname.startsWith('/experimentos') && (
  <>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400..700&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400..700&display=swap" /></noscript>
  </>
)}
{pathname === '/' && (
  <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
)}

<meta property="og:locale" content="pt_BR" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Portfólio de Kauê Alencar" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!isNotFound && <meta property="og:url" content={canonicalUrl} />}
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta
  property="og:image:alt"
  content={SITE.ogImageAlt}
/>

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta
  name="twitter:image:alt"
  content={SITE.ogImageAlt}
/>
