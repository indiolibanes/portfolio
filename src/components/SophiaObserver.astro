---
/**
 * Sophia espiando por cima do tabuleiro: olha o jogo, volta à inclinação
 * inicial, abre um sorrisão e olha de novo. Decorativa; o CSS alterna os quadros.
 */
import PixelPaths from './PixelPaths.astro';
import { OBSERVER_H, OBSERVER_W, observer, type ObserverPose } from '../sophia-art';

const poses: ObserverPose[] = ['rest', 'blink', 'down', 'grin'];
---

<div class="sophia-observer" data-px-anim aria-hidden="true">
  <svg
    class="sophia-px sophia-px--observer"
    viewBox={`0 0 ${OBSERVER_W} ${OBSERVER_H}`}
    shape-rendering="crispEdges"
    focusable="false"
  >
    {poses.map((pose) => (
      <g class={`px-frame px-frame--${pose}`}><PixelPaths px={observer(pose)} /></g>
    ))}
  </svg>
</div>
