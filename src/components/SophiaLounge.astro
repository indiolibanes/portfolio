---
/** Sala gamer da Sophia, de perfil, num quarto escuro. Ilustração vetorial gerada no build. */
import { loungeMarkup } from '../sophia-lounge';

const svg = loungeMarkup();
---

<figure
  class="sophia-lounge"
  data-art-anim
  role="img"
  aria-label="Sophia, de óculos 3D e vestido lunar azul-noite com sobretudo vermelho, joga videogame animada sentada no tapete de um quarto escuro, com um sofá vermelho atrás dela e, do outro lado da sala, uma TV de tubo gigante virada para ela, vista de lado e com o brilho da tela espalhando cores pela sala, um videogame no chão e um rack cheio de equipamentos."
>
  <Fragment set:html={svg} />
</figure>
