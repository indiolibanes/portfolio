---
/** Sala gamer da Sophia, de perfil, num quarto escuro. Ilustração vetorial gerada no build. */
import { loungeMarkup } from '../sophia-lounge';

const svg = loungeMarkup();
---

<figure
  class="sophia-lounge"
  data-art-anim
  role="img"
  aria-label="Sophia, de óculos 3D, joga videogame sentada no tapete de um quarto escuro, com um sofá vermelho atrás dela e, do outro lado da sala, vários monitores e um rack cheio de equipamentos."
>
  <Fragment set:html={svg} />
</figure>
