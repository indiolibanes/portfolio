---
/** Sala gamer da Sophia, de perfil, num quarto escuro. Ilustração vetorial gerada no build. */
import { loungeMarkup } from '../sophia-lounge';

const svg = loungeMarkup();
---

<figure
  class="sophia-lounge"
  data-art-anim
  data-sophia-stage="lounge"
  data-sophia-mood="idle"
  role="img"
  aria-label="Sala gamer noturna: Sophia joga videogame diante de uma televisão de tubo, com sofá vermelho, tapete, equipamentos e luzes da tela. A personagem pode aparecer em versão tridimensional animada nos dispositivos compatíveis."
>
  <Fragment set:html={svg} />
  <canvas class="sophia-stage__canvas" data-sophia-canvas aria-hidden="true"></canvas>
</figure>
