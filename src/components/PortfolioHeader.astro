---
import { PROFILE } from '../config';
import SeriousModeToggle from './SeriousModeToggle.astro';

const onCuriosities = Astro.url.pathname.replace(/\/$/, '') === '/curiosidades';

// Tabela periódica do menu: cada destino é escrito com símbolos de elementos (Sobre = S·O·B·Re).
// As letras que não existem na tabela ficam soltas, ao lado dos azulejos, como no logotipo de Breaking Bad.
const ELEMENTS = 'H:Hidrogênio,He:Hélio,Li:Lítio,Be:Berílio,B:Boro,C:Carbono,N:Nitrogênio,O:Oxigênio,F:Flúor,Ne:Neônio,Na:Sódio,Mg:Magnésio,Al:Alumínio,Si:Silício,P:Fósforo,S:Enxofre,Cl:Cloro,Ar:Argônio,K:Potássio,Ca:Cálcio,Sc:Escândio,Ti:Titânio,V:Vanádio,Cr:Cromo,Mn:Manganês,Fe:Ferro,Co:Cobalto,Ni:Níquel,Cu:Cobre,Zn:Zinco,Ga:Gálio,Ge:Germânio,As:Arsênio,Se:Selênio,Br:Bromo,Kr:Criptônio,Rb:Rubídio,Sr:Estrôncio,Y:Ítrio,Zr:Zircônio,Nb:Nióbio,Mo:Molibdênio,Tc:Tecnécio,Ru:Rutênio,Rh:Ródio,Pd:Paládio,Ag:Prata,Cd:Cádmio,In:Índio,Sn:Estanho,Sb:Antimônio,Te:Telúrio,I:Iodo,Xe:Xenônio,Cs:Césio,Ba:Bário,La:Lantânio,Ce:Cério,Pr:Praseodímio,Nd:Neodímio,Pm:Promécio,Sm:Samário,Eu:Európio,Gd:Gadolínio,Tb:Térbio,Dy:Disprósio,Ho:Hólmio,Er:Érbio,Tm:Túlio,Yb:Itérbio,Lu:Lutécio,Hf:Háfnio,Ta:Tântalo,W:Tungstênio,Re:Rênio,Os:Ósmio,Ir:Irídio,Pt:Platina,Au:Ouro,Hg:Mercúrio,Tl:Tálio,Pb:Chumbo,Bi:Bismuto,Po:Polônio,At:Astato,Rn:Radônio,Fr:Frâncio,Ra:Rádio,Ac:Actínio,Th:Tório,Pa:Protactínio,U:Urânio,Np:Netúnio,Pu:Plutônio,Am:Amerício,Cm:Cúrio,Bk:Berquélio,Cf:Califórnio,Es:Einstênio,Fm:Férmio,Md:Mendelévio,No:Nobélio,Lr:Laurêncio,Rf:Rutherfórdio,Db:Dúbnio,Sg:Seabórgio,Bh:Bóhrio,Hs:Hássio,Mt:Meitnério,Ds:Darmstádio,Rg:Roentgênio,Cn:Copernício,Nh:Nihônio,Fl:Fleróvio,Mc:Moscóvio,Lv:Livermório,Ts:Tenesso,Og:Oganessônio';
const TABLE = new Map<string, { z: number; name: string; cat: string }>();
const group = (sym: string, z: number) =>
  ['H', 'C', 'N', 'O', 'P', 'S', 'Se'].includes(sym) ? 'nm'
  : ['F', 'Cl', 'Br', 'I', 'At', 'Ts'].includes(sym) ? 'hl'
  : ['He', 'Ne', 'Ar', 'Kr', 'Xe', 'Rn', 'Og'].includes(sym) ? 'ng'
  : ['Li', 'Na', 'K', 'Rb', 'Cs', 'Fr'].includes(sym) ? 'alk'
  : ['Be', 'Mg', 'Ca', 'Sr', 'Ba', 'Ra'].includes(sym) ? 'ae'
  : ['B', 'Si', 'Ge', 'As', 'Sb', 'Te'].includes(sym) ? 'md'
  : z >= 57 && z <= 71 ? 'ln'
  : z >= 89 && z <= 103 ? 'ac'
  : ['Al', 'Ga', 'In', 'Sn', 'Tl', 'Pb', 'Bi', 'Po', 'Nh', 'Fl', 'Mc', 'Lv'].includes(sym) ? 'pt'
  : 'tm';
ELEMENTS.split(',').forEach((entry, idx) => {
  const [sym, name] = entry.split(':');
  TABLE.set(sym.toLowerCase(), { z: idx + 1, name, cat: group(sym, idx + 1) });
});
// Segmenta a palavra maximizando as letras cobertas por símbolos reais.
type Seg = { sym: string; z: number; name: string; cat: string } | { ch: string };
function spell(word: string): Seg[] {
  const low = word.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  const n = low.length;
  const best: { score: number; segs: Seg[] }[] = Array.from({ length: n + 1 }, () => ({ score: -1, segs: [] }));
  best[n] = { score: 0, segs: [] };
  for (let i = n - 1; i >= 0; i -= 1) {
    let pick = { score: best[i + 1].score, segs: [{ ch: word[i].toUpperCase() } as Seg, ...best[i + 1].segs] };
    for (const len of [1, 2]) {
      const key = low.slice(i, i + len);
      const el = key.length === len ? TABLE.get(key) : undefined;
      if (!el) continue;
      const score = best[i + len].score + len;
      if (score > pick.score) pick = { score, segs: [{ sym: key[0].toUpperCase() + key.slice(1), ...el } as Seg, ...best[i + len].segs] };
    }
    best[i] = pick;
  }
  return best[0].segs;
}
// Normas e padrões que correm por dentro da gaveta do cabeçalho (decorativo).
const STANDARDS_A = ['ISO 9001', 'NBR 6023', 'ISO 690', 'ISA-88', 'ISO 8601', 'NBR 10520', 'IEC 61131-3', 'ISO 15489', 'NBR 14724', 'ISO/IEC 27001', 'NBR 6022', 'ISA-95', 'ISO 26324', 'NBR 6024', 'ISO 14001', 'IEEE 830', 'NBR 6027', 'ISO 31000', 'ISO 302', 'NBR 6028'];
const STANDARDS_B = ['ISA-5.1', 'ISO 19650', 'NBR 15287', 'IEC 62443', 'ISO 2108', 'NBR 5410', 'ISO/IEC 25010', 'ISA-101', 'TAPPI T 236', 'ISO 15836', 'NR-10', 'ISO/IEC/IEEE 82079-1', 'NBR ISO 9001', 'ISA-18.2', 'ISO 12207', 'NR-12', 'ABNT NBR 6034', 'ISO 3166', 'IEC 60617', 'ISO 80000'];
const NAV = [
  { href: '/#sobre', id: 'sobre', label: 'Sobre' },
  { href: '/#lab', id: 'lab', label: 'Laboratório' },
  { href: '/#percurso', id: 'percurso', label: 'Percurso' },
  { href: '/#metodo', id: 'metodo', label: 'Método' },
  { href: '/#bastidores', id: 'bastidores', label: 'Bastidores' },
  { href: '/#musica', id: 'musica', label: 'Música' },
  { href: '/curiosidades/', id: '', label: 'Curiosidades' },
  { href: '/#contato', id: 'contato', label: 'Contato', cta: true },
].map((item) => ({ ...item, segs: spell(item.label) }));
---

<header class="site-header">
  <nav class="nav-shell" aria-label="Navegação principal">
    <div class="nav-standards" aria-hidden="true" data-nav-standards>
      <div class="nav-standards__row" data-standards-row="a">
        {[0, 1].map(() => STANDARDS_A.map((t) => <span>{t}</span>))}
      </div>
      <div class="nav-standards__row" data-standards-row="b">
        {[0, 1].map(() => STANDARDS_B.map((t) => <span>{t}</span>))}
      </div>
    </div>
    <a class="brand" href="/#top" aria-label={`${PROFILE.name}, início`}>
      <span class="brand-mark" aria-hidden="true" data-brand-mark><svg viewBox="0 0 100 100" focusable="false"><text x="50" y="68" text-anchor="middle" font-size="56" font-weight="700" font-family="serif" fill="currentColor">K</text></svg></span>
      <span class="brand-copy">
        <strong>{PROFILE.name}</strong>
        <small>{PROFILE.tagline}</small>
      </span>
    </a>

    <div class="nav-links">
      <button
        class="nav-menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="nav-sections"
        data-nav-menu-toggle
        hidden
      >
        <svg class="nav-plasma" data-nav-plasma viewBox="0 0 80 44" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <defs>
            <radialGradient id="nav-plasma-a"><stop offset="0" stop-color="#ff6fa8"></stop><stop offset="0.55" stop-color="#ff6fa8" stop-opacity="0.7"></stop><stop offset="1" stop-color="#ff6fa8" stop-opacity="0"></stop></radialGradient>
            <radialGradient id="nav-plasma-b"><stop offset="0" stop-color="#ffd15a"></stop><stop offset="0.55" stop-color="#ffd15a" stop-opacity="0.7"></stop><stop offset="1" stop-color="#ffd15a" stop-opacity="0"></stop></radialGradient>
            <radialGradient id="nav-plasma-c"><stop offset="0" stop-color="#5cc3ff"></stop><stop offset="0.55" stop-color="#5cc3ff" stop-opacity="0.7"></stop><stop offset="1" stop-color="#5cc3ff" stop-opacity="0"></stop></radialGradient>
            <radialGradient id="nav-plasma-d"><stop offset="0" stop-color="#a98bff"></stop><stop offset="0.55" stop-color="#a98bff" stop-opacity="0.7"></stop><stop offset="1" stop-color="#a98bff" stop-opacity="0"></stop></radialGradient>
            <radialGradient id="nav-plasma-e"><stop offset="0" stop-color="#7be3a0"></stop><stop offset="0.55" stop-color="#7be3a0" stop-opacity="0.7"></stop><stop offset="1" stop-color="#7be3a0" stop-opacity="0"></stop></radialGradient>
          </defs>
          <g class="nav-plasma__blobs">
            <circle cx="16" cy="12" r="17" fill="url(#nav-plasma-a)"></circle>
            <circle cx="40" cy="30" r="18" fill="url(#nav-plasma-b)"></circle>
            <circle cx="64" cy="14" r="17" fill="url(#nav-plasma-c)"></circle>
            <circle cx="26" cy="34" r="16" fill="url(#nav-plasma-d)"></circle>
            <circle cx="54" cy="22" r="15" fill="url(#nav-plasma-e)"></circle>
            <circle cx="40" cy="10" r="14" fill="url(#nav-plasma-a)"></circle>
          </g>
        </svg>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M4 7h16M4 12h16M4 17h10"></path>
        </svg>
        <span>Menu</span>
      </button>
      <div class="nav-sections" id="nav-sections" data-nav-sections>
        {NAV.map((item) => (
          <a
            class={item.cta ? 'nav-cta' : undefined}
            href={item.href}
            data-nav-section={item.id || undefined}
            aria-current={item.id === '' && onCuriosities ? 'page' : undefined}
          >
            <span class="nav-label">{item.label}</span>
            <span class="nav-elements" aria-hidden="true">
              {item.segs.map((e) => 'sym' in e
                ? <span class="el" data-cat={e.cat}><i>{e.z}</i><b>{e.sym}</b><u>{e.name}</u></span>
                : <span class="ch">{e.ch}</span>)}
            </span>
          </a>
        ))}
      </div>
      <SeriousModeToggle />
    </div>
  </nav>
</header>


<script is:inline>
  (() => {
    if (window.location.pathname !== '/') return;

    const links = [...document.querySelectorAll('[data-nav-section]')];
    const sections = links
      .map((link) => document.getElementById(link.dataset.navSection))
      .filter(Boolean);

    if (!sections.length || !('IntersectionObserver' in window)) return;

    const setCurrent = (id) => {
      links.forEach((link) => {
        const active = link.dataset.navSection === id;
        if (active) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio);

        if (visible[0]) setCurrent(visible[0].target.id);
      },
      { rootMargin: '-40% 0px -55% 0px', threshold: [0, 0.01, 0.15] },
    );

    sections.forEach((section) => observer.observe(section));
  })();
</script>

<script is:inline>
  (() => {
    const chips = [...document.querySelectorAll('.work-index a')];
    const targets = chips.map((chip) => document.querySelector(chip.getAttribute('href'))).filter(Boolean);
    if (!targets.length) return;
    const update = () => {
      const position = window.innerHeight * 0.4;
      const current = targets.find((target) => {
        const box = target.getBoundingClientRect();
        return box.top <= position && box.bottom > position;
      });
      chips.forEach((chip) => {
        if (current && chip.hash === '#' + current.id) chip.setAttribute('aria-current', 'true');
        else chip.removeAttribute('aria-current');
      });
    };
    let queued = false;
    window.addEventListener('scroll', () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { update(); queued = false; });
    }, { passive: true });
    update();
  })();
</script>

<script is:inline>
  // Compact navigation (<= 1180 px). Without JavaScript the sections stay
  // visible as a wrapping row; with it they collapse behind a disclosure.
  (() => {
    const button = document.querySelector('[data-nav-menu-toggle]');
    const panel = document.querySelector('[data-nav-sections]');
    if (!button || !panel) return;

    document.documentElement.dataset.navJs = 'true';
    button.hidden = false;

    // Plasma do botão Menu: gás condensado, frenético e contido no botão. Mais
    // intenso ao passar, segurar ou abrir; ao soltar, a energia se dispersa e
    // volta ao ponto inicial.
    (() => {
      const plasma = button.querySelector('[data-nav-plasma]');
      const still = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (!plasma || still.matches) return;
      const rnd = (a, b) => a + Math.random() * (b - a);
      const drift = Array.from(plasma.querySelectorAll('circle')).map((c) => {
        const frames = Array.from({ length: 6 }, () => ({
          transform: 'translate(' + rnd(-34, 34) + 'px,' + rnd(-16, 16) + 'px) scale(' + rnd(0.7, 1.6) + ')',
        }));
        frames.push(frames[0]);
        return c.animate(frames, {
          duration: rnd(900, 1700),
          iterations: Infinity,
          easing: 'ease-in-out',
          delay: -rnd(0, 1200),
        });
      });
      const tint = plasma.animate(
        [{ filter: 'hue-rotate(0deg)' }, { filter: 'hue-rotate(360deg)' }],
        { duration: 3200, iterations: Infinity },
      );
      let level = 0;
      let target = 0;
      let ramp = 0;
      const apply = () => {
        const rate = 1 + level * 2.6;
        drift.forEach((a) => a.updatePlaybackRate(rate));
        tint.updatePlaybackRate(1 + level * 3);
        plasma.style.opacity = String(0.5 + level * 0.5);
      };
      const step = () => {
        const speed = target > level ? 0.12 : 0.025;
        level += (target - level) * speed;
        if (Math.abs(target - level) < 0.01) level = target;
        apply();
        ramp = level === target ? 0 : requestAnimationFrame(step);
      };
      const set = (value) => {
        target = value;
        if (!ramp) ramp = requestAnimationFrame(step);
      };
      const hot = () => button.matches(':hover, :active, :focus-visible') || button.getAttribute('aria-expanded') === 'true';
      const settle = () => set(hot() ? 1 : 0);
      apply();
      ['pointerenter', 'focus'].forEach((t) => button.addEventListener(t, () => set(1)));
      button.addEventListener('pointerdown', () => set(1));
      ['pointerleave', 'pointerup', 'pointercancel', 'blur'].forEach((t) => button.addEventListener(t, () => setTimeout(settle, 0)));
      new MutationObserver(settle).observe(button, { attributes: true, attributeFilter: ['aria-expanded'] });
    })();

    // Normas passando depressa por dentro do cabeçalho. WAAPI, porque os modos
    // planos zeram animation do CSS; os modos reduzidos ficam parados.
    (() => {
      const rows = document.querySelectorAll('[data-standards-row]');
      if (!rows.length || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      rows.forEach((row, i) => {
        const frames = i === 0
          ? [{ transform: 'translateX(0)' }, { transform: 'translateX(-50%)' }]
          : [{ transform: 'translateX(-50%)' }, { transform: 'translateX(0)' }];
        row.animate(frames, { duration: i === 0 ? 7000 : 5200, iterations: Infinity });
      });
    })();

    const compact = window.matchMedia('(max-width: 1180px)');
    const FX = ['el-flip', 'el-drop', 'el-zoom', 'el-blur', 'el-spin', 'el-slide'];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let pulse = 0;
    const reveal = () => {
      const tiles = [...panel.querySelectorAll('.el, .ch')];
      tiles.forEach((el) => {
        el.style.setProperty('--fx', FX[(Math.random() * FX.length) | 0]);
        el.style.setProperty('--d', `${Math.round(Math.random() * 520)}ms`);
        el.classList.remove('is-pulse');
      });
      clearInterval(pulse);
      if (reduce.matches) return;
      // enquanto a gaveta está aberta, um elemento aleatório se “reacende” de tempos em tempos
      pulse = setInterval(() => {
        const el = tiles[(Math.random() * tiles.length) | 0];
        if (!el) return;
        el.style.setProperty('--fx', FX[(Math.random() * FX.length) | 0]);
        el.style.setProperty('--d', '0ms');
        el.classList.remove('is-pulse'); void el.offsetWidth; el.classList.add('is-pulse');
      }, 900);
    };
    const setOpen = (open, restoreFocus = false) => {
      button.setAttribute('aria-expanded', String(open));
      panel.dataset.open = String(open);
      if (open) reveal(); else clearInterval(pulse);
      if (!open && restoreFocus) button.focus();
    };

    button.addEventListener('click', () => {
      setOpen(button.getAttribute('aria-expanded') !== 'true');
    });
    panel.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && panel.dataset.open === 'true') setOpen(false, true);
    });
    document.addEventListener('click', (event) => {
      if (panel.dataset.open !== 'true') return;
      if (event.target instanceof Node && (panel.contains(event.target) || button.contains(event.target))) return;
      setOpen(false);
    });
    compact.addEventListener('change', () => setOpen(false));
  })();
</script>

<script is:inline>
  // Marca do cabeçalho: autorretrato em traço de mangá cru (nanquim áspero,
  // linhas que tremem, assimetria), desenhado em ~3,4 s ao carregar e de novo ao
  // passar o mouse. Depois do impacto as linhas "fervem" por um instante e
  // assentam. Tudo é gerado aqui com uma semente fixa; o "K" fica de reserva.
  (() => {
    const mark = document.querySelector('[data-brand-mark]');
    const svg = mark && mark.querySelector('svg');
    if (!svg) return;
    const NS = 'http://www.w3.org/2000/svg';
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    const prng = (seed) => {
      let s = seed >>> 0;
      return () => {
        s = (Math.imul(s, 1664525) + 1013904223) >>> 0;
        return s / 4294967296;
      };
    };

    // Traços-base em coordenadas 0..100. g = grupo de animação, w = espessura.
    const base = [];
    const add = (g, pts, w) => base.push({ g, pts, w });
    const curl = (rand, cx, cy, r0, turns) => {
      const pts = [];
      const a0 = rand() * Math.PI * 2;
      const n = 22;
      for (let i = 0; i <= n; i += 1) {
        const t = i / n;
        const a = a0 + t * Math.PI * 2 * turns;
        const r = r0 * (1 - 0.55 * t);
        pts.push([cx + r * Math.cos(a), cy + r * Math.sin(a) * 0.9]);
      }
      return pts;
    };

    // Cabelo: cachos de espiral, mais densos no alto e nas laterais.
    {
      const rand = prng(7);
      const spots = [];
      // Dois anéis de cachos em volta da cabeça, de ponta a ponta.
      for (let ring = 0; ring < 2; ring += 1) {
        const count = ring === 0 ? 15 : 11;
        for (let i = 0; i < count; i += 1) {
          const a = Math.PI * (1.0 + ((i + rand() * 0.7) / count) * 1.0);
          const k = ring === 0 ? 0.98 + rand() * 0.12 : 0.6 + rand() * 0.2;
          const x = 50 + 34 * k * Math.cos(a);
          const y = 44 + 29 * k * Math.sin(a);
          if (y < 50) spots.push([x, y, 5.5 + rand() * 4.5]);
        }
      }
      spots.forEach(([x, y, r]) => add('hair', curl(rand, x, y, r, 1.6 + rand() * 0.9), 1.5 + rand() * 1));
      // Miolo escuro do cabelo: rabiscos curtos.
      for (let i = 0; i < 14; i += 1) {
        const x = 34 + rand() * 32;
        const y = 22 + rand() * 18;
        add('hair', [[x, y], [x + 4 + rand() * 4, y + 3 + rand() * 4], [x + 1, y + 6 + rand() * 3]], 1.4);
      }
    }
    // Rosto: mandíbula em linhas quebradas, orelhas, sobrancelhas.
    add('face', [[29, 43], [30.5, 58], [36, 72], [45, 81], [50, 82.5]], 2);
    add('face', [[71, 42], [69.5, 59], [64, 73], [56, 81], [50, 82.5]], 2);
    add('face', [[27.5, 47], [25.5, 52], [28, 57]], 1.4);
    add('face', [[72.5, 46], [75, 51], [72, 56]], 1.4);
    add('brow', [[29, 36.5], [37, 34.5], [46, 35.5]], 2.4);
    add('brow', [[55, 35], [63, 33.5], [71, 36]], 2.6);
    // Óculos grossos e retangulares, um pouco desalinhados.
    add('glass', [[28, 41], [47.5, 40.2], [47.8, 55], [28.6, 55.6], [28, 41]], 3.8);
    add('glass', [[52.5, 39.6], [72, 40.6], [71.4, 55.4], [52.2, 54.6], [52.5, 39.6]], 3.8);
    add('glass', [[47.5, 44.5], [52.5, 44]], 3);
    add('glass', [[28, 43], [23.5, 41.5]], 2.6);
    add('glass', [[72, 43], [76.5, 42]], 2.6);
    // Olhos sorridentes e reflexos.
    add('eye', [[33, 50.5], [37.5, 46.8], [43, 50]], 2);
    add('eye', [[57, 50], [62, 46.5], [67, 50.5]], 2);
    // Nariz, bigode e sorriso de lado.
    add('nose', [[50.5, 50.5], [48.5, 58], [52.5, 60]], 1.8);
    add('mouth', [[37, 63.5], [44, 61.5], [50, 63], [56, 61.5], [63, 63.5]], 2.2);
    add('mouth', [[41, 69.5], [48, 72.5], [56, 71.5], [62, 67]], 2.4);
    add('mouth', [[62, 67], [64, 65.6]], 1.6);
    // Barba: hachuras cerradas, mais densas no queixo.
    {
      const rand = prng(23);
      for (let i = 0; i < 46; i += 1) {
        const t = i / 45;
        const x = 32 + t * 36;
        const edge = 82 - 20 * Math.pow(Math.abs(t - 0.5) * 2, 1.7);
        const y0 = 62 + rand() * 6 + (Math.abs(t - 0.5) < 0.18 ? 9 : 0);
        const len = 5 + rand() * 7;
        const y1 = Math.min(edge - 0.5, y0 + len);
        if (y1 - y0 > 2) add('beard', [[x, y0], [x + rand() * 3 - 1.5, y1]], 1.2 + rand() * 0.7);
      }
    }
    // Pescoço, gola, cordão e hachura da camiseta.
    add('shirt', [[43, 82], [41.5, 91]], 1.8);
    add('shirt', [[57, 82], [58.5, 91]], 1.8);
    add('shirt', [[24, 100], [38, 93], [50, 96.5], [62, 93], [76, 100]], 2.2);
    add('shirt', [[45, 93], [37, 101]], 1.1);
    add('shirt', [[55, 93], [64, 101]], 1.1);
    {
      const rand = prng(41);
      for (let i = 0; i < 12; i += 1) {
        const x = 20 + rand() * 60;
        add('shirt', [[x, 97 + rand() * 2], [x - 4 - rand() * 3, 102]], 1.3);
      }
    }
    // Linhas cinéticas do impacto (aparecem no fim).
    const burst = [];
    {
      const rand = prng(5);
      for (let i = 0; i < 26; i += 1) {
        const a = (i / 26) * Math.PI * 2 + rand() * 0.2;
        const r0 = 46 + rand() * 3;
        const r1 = 54 + rand() * 8;
        burst.push([[50 + r0 * Math.cos(a), 50 + r0 * Math.sin(a)], [50 + r1 * Math.cos(a), 50 + r1 * Math.sin(a)]]);
      }
    }

    // Uma versão tremida de um traço: segmentos curtos com ruído de mão.
    const wobble = (pts, rand, amp) => {
      let d = '';
      let first = true;
      for (let i = 0; i < pts.length - 1; i += 1) {
        const [x0, y0] = pts[i];
        const [x1, y1] = pts[i + 1];
        const len = Math.hypot(x1 - x0, y1 - y0);
        const steps = Math.max(1, Math.round(len / 4));
        for (let k = first ? 0 : 1; k <= steps; k += 1) {
          const t = k / steps;
          const x = x0 + (x1 - x0) * t + (rand() - 0.5) * amp;
          const y = y0 + (y1 - y0) * t + (rand() - 0.5) * amp;
          d += (first ? 'M' : 'L') + x.toFixed(1) + ' ' + y.toFixed(1);
          first = false;
        }
      }
      return d;
    };

    while (svg.firstChild) svg.removeChild(svg.firstChild);
    const make = (name, attrs, parent) => {
      const el = document.createElementNS(NS, name);
      Object.keys(attrs).forEach((k) => el.setAttribute(k, attrs[k]));
      parent.appendChild(el);
      return el;
    };
    const variants = [0, 1, 2].map((v) => {
      const group = make('g', { 'data-variant': String(v) }, svg);
      const rand = prng(1000 + v * 77);
      const paths = base.map((s) => {
        const amp = s.g === 'glass' ? 0.7 : 1.1;
        const el = make('path', { d: wobble(s.pts, rand, amp), 'stroke-width': String(s.w), pathLength: '1', 'data-g': s.g }, group);
        el.setAttribute('class', 'brand-ink');
        return el;
      });
      if (v > 0) group.style.display = 'none';
      return { group, paths };
    });
    const burstGroup = make('g', { 'data-burst': '' }, svg);
    burstGroup.style.opacity = '0';
    burst.forEach((pts, i) => {
      const el = make('path', { d: wobble(pts, prng(300 + i), 0.8), 'stroke-width': String(1.2 + (i % 3) * 0.5) }, burstGroup);
      el.setAttribute('class', 'brand-ink');
    });

    const TIMING = {
      hair: [0, 1000, 260],
      face: [900, 1300, 380],
      brow: [1250, 1450, 200],
      glass: [1400, 1900, 260],
      eye: [1900, 2050, 150],
      nose: [2000, 2100, 200],
      mouth: [2100, 2400, 220],
      beard: [2250, 2850, 130],
      shirt: [2800, 3050, 220],
    };
    const groups = {};
    variants[0].paths.forEach((p) => {
      const g = p.getAttribute('data-g');
      (groups[g] = groups[g] || []).push(p);
    });

    let running = [];
    let boil = 0;
    const stop = () => {
      running.forEach((a) => a.cancel());
      running = [];
      clearInterval(boil);
      variants.forEach((v, i) => {
        v.group.style.display = i === 0 ? '' : 'none';
      });
      burstGroup.style.opacity = '0';
      svg.style.transform = '';
    };
    const play = () => {
      stop();
      if (reduce.matches || document.documentElement.dataset.legacyMode === 'true') return;
      Object.keys(groups).forEach((g) => {
        const [from, to, dur] = TIMING[g];
        const list = groups[g];
        list.forEach((p, i) => {
          const delay = from + ((to - from - dur) * i) / Math.max(1, list.length - 1);
          running.push(
            p.animate(
              [
                { strokeDashoffset: 1, opacity: 0 },
                { strokeDashoffset: 1, opacity: 1, offset: 0.03 },
                { strokeDashoffset: 0, opacity: 1 },
              ],
              { duration: dur, delay, easing: g === 'glass' ? 'cubic-bezier(0.2, 0.9, 0.1, 1)' : 'ease-out', fill: 'backwards' },
            ),
          );
        });
      });
      // Impacto: o desenho dá um tranco e as linhas cinéticas estouram.
      running.push(
        svg.animate(
          [
            { transform: 'translate(0,0) scale(1)' },
            { transform: 'translate(-2px,1px) scale(1.06)', offset: 0.2 },
            { transform: 'translate(2px,-1px) scale(0.97)', offset: 0.45 },
            { transform: 'translate(-1px,0) scale(1.02)', offset: 0.7 },
            { transform: 'translate(0,0) scale(1)' },
          ],
          { duration: 360, delay: 3050, easing: 'steps(6, end)' },
        ),
        burstGroup.animate(
          [{ opacity: 0, transform: 'scale(0.82)' }, { opacity: 1, transform: 'scale(1)', offset: 0.18 }, { opacity: 0, transform: 'scale(1.12)' }],
          { duration: 520, delay: 3050, easing: 'ease-out', fill: 'backwards' },
        ),
      );
      // Depois do impacto as linhas fervem em três quadros, como no mangá animado.
      setTimeout(() => {
        let n = 0;
        boil = setInterval(() => {
          n += 1;
          const order = [1, 2, 0, 2, 1, 0];
          const at = order[n % order.length];
          variants.forEach((v, i) => {
            v.group.style.display = i === at ? '' : 'none';
          });
          if (n > 9) {
            clearInterval(boil);
            variants.forEach((v, i) => {
              v.group.style.display = i === 0 ? '' : 'none';
            });
          }
        }, 120);
      }, 3300);
    };

    play();
    const link = mark.closest('a');
    if (link) {
      let cooling = false;
      link.addEventListener('pointerenter', () => {
        if (cooling) return;
        cooling = true;
        play();
        setTimeout(() => {
          cooling = false;
        }, 4200);
      });
    }
    window.addEventListener('portfolio:mode', () => {
      if (document.documentElement.dataset.legacyMode === 'true') stop();
    });
  })();
</script>

