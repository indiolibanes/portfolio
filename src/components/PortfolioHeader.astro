---
import { PROFILE } from '../config';
import SeriousModeToggle from './SeriousModeToggle.astro';

const onCuriosities = Astro.url.pathname.replace(/\/$/, '') === '/curiosidades';

// Tabela periódica do menu: cada destino é escrito com símbolos de elementos (Sobre = S·O·B·Re).
// As letras que não existem na tabela ficam soltas, ao lado dos azulejos, como no logotipo de Breaking Bad.
const ELEMENTS = 'H:Hidrogênio,He:Hélio,Li:Lítio,Be:Berílio,B:Boro,C:Carbono,N:Nitrogênio,O:Oxigênio,F:Flúor,Ne:Neônio,Na:Sódio,Mg:Magnésio,Al:Alumínio,Si:Silício,P:Fósforo,S:Enxofre,Cl:Cloro,Ar:Argônio,K:Potássio,Ca:Cálcio,Sc:Escândio,Ti:Titânio,V:Vanádio,Cr:Cromo,Mn:Manganês,Fe:Ferro,Co:Cobalto,Ni:Níquel,Cu:Cobre,Zn:Zinco,Ga:Gálio,Ge:Germânio,As:Arsênio,Se:Selênio,Br:Bromo,Kr:Criptônio,Rb:Rubídio,Sr:Estrôncio,Y:Ítrio,Zr:Zircônio,Nb:Nióbio,Mo:Molibdênio,Tc:Tecnécio,Ru:Rutênio,Rh:Ródio,Pd:Paládio,Ag:Prata,Cd:Cádmio,In:Índio,Sn:Estanho,Sb:Antimônio,Te:Telúrio,I:Iodo,Xe:Xenônio,Cs:Césio,Ba:Bário,La:Lantânio,Ce:Cério,Pr:Praseodímio,Nd:Neodímio,Pm:Promécio,Sm:Samário,Eu:Európio,Gd:Gadolínio,Tb:Térbio,Dy:Disprósio,Ho:Hólmio,Er:Érbio,Tm:Túlio,Yb:Itérbio,Lu:Lutécio,Hf:Háfnio,Ta:Tântalo,W:Tungstênio,Re:Rênio,Os:Ósmio,Ir:Irídio,Pt:Platina,Au:Ouro,Hg:Mercúrio,Tl:Tálio,Pb:Chumbo,Bi:Bismuto,Po:Polônio,At:Astato,Rn:Radônio,Fr:Frâncio,Ra:Rádio,Ac:Actínio,Th:Tório,Pa:Protactínio,U:Urânio,Np:Netúnio,Pu:Plutônio,Am:Amerício,Cm:Cúrio,Bk:Berquélio,Cf:Califórnio,Es:Einstênio,Fm:Férmio,Md:Mendelévio,No:Nobélio,Lr:Laurêncio,Rf:Rutherfórdio,Db:Dúbnio,Sg:Seabórgio,Bh:Bóhrio,Hs:Hássio,Mt:Meitnério,Ds:Darmstádio,Rg:Roentgênio,Cn:Copernício,Nh:Nihônio,Fl:Fleróvio,Mc:Moscóvio,Lv:Livermório,Ts:Tenesso,Og:Oganessônio';
const TABLE = new Map<string, { z: number; name: string; cat: string }>();
const group = (sym: string, z: number) =>
  ['H', 'C', 'N', 'O', 'P', 'S', 'Se'].includes(sym) ? 'nm'
  : ['F', 'Cl', 'Br', 'I', 'At', 'Ts'].includes(sym) ? 'hl'
  : ['He', 'Ne', 'Ar', 'Kr', 'Xe', 'Rn', 'Og'].includes(sym) ? 'ng'
  : ['Li', 'Na', 'K', 'Rb', 'Cs', 'Fr'].includes(sym) ? 'alk'
  : ['Be', 'Mg', 'Ca', 'Sr', 'Ba', 'Ra'].includes(sym) ? 'ae'
  : ['B', 'Si', 'Ge', 'As', 'Sb', 'Te'].includes(sym) ? 'md'
  : z >= 57 && z <= 71 ? 'ln'
  : z >= 89 && z <= 103 ? 'ac'
  : ['Al', 'Ga', 'In', 'Sn', 'Tl', 'Pb', 'Bi', 'Po', 'Nh', 'Fl', 'Mc', 'Lv'].includes(sym) ? 'pt'
  : 'tm';
ELEMENTS.split(',').forEach((entry, idx) => {
  const [sym, name] = entry.split(':');
  TABLE.set(sym.toLowerCase(), { z: idx + 1, name, cat: group(sym, idx + 1) });
});
// Segmenta a palavra maximizando as letras cobertas por símbolos reais.
type Seg = { sym: string; z: number; name: string; cat: string } | { ch: string };
function spell(word: string): Seg[] {
  const low = word.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  const n = low.length;
  const best: { score: number; segs: Seg[] }[] = Array.from({ length: n + 1 }, () => ({ score: -1, segs: [] }));
  best[n] = { score: 0, segs: [] };
  for (let i = n - 1; i >= 0; i -= 1) {
    let pick = { score: best[i + 1].score, segs: [{ ch: word[i].toUpperCase() } as Seg, ...best[i + 1].segs] };
    for (const len of [1, 2]) {
      const key = low.slice(i, i + len);
      const el = key.length === len ? TABLE.get(key) : undefined;
      if (!el) continue;
      const score = best[i + len].score + len;
      if (score > pick.score) pick = { score, segs: [{ sym: key[0].toUpperCase() + key.slice(1), ...el } as Seg, ...best[i + len].segs] };
    }
    best[i] = pick;
  }
  return best[0].segs;
}
const NAV = [
  { href: '/#sobre', id: 'sobre', label: 'Sobre' },
  { href: '/#lab', id: 'lab', label: 'Laboratório' },
  { href: '/#metodo', id: 'metodo', label: 'Método' },
  { href: '/#bastidores', id: 'bastidores', label: 'Bastidores' },
  { href: '/#percurso', id: 'percurso', label: 'Percurso' },
  { href: '/#musica', id: 'musica', label: 'Música' },
  { href: '/curiosidades/', id: '', label: 'Curiosidades' },
  { href: '/#contato', id: 'contato', label: 'Contato', cta: true },
].map((item) => ({ ...item, segs: spell(item.label) }));
---

<header class="site-header">
  <nav class="nav-shell" aria-label="Navegação principal">
    <a class="brand" href="/#top" aria-label={`${PROFILE.name}, início`}>
      <span class="brand-mark" aria-hidden="true">K</span>
      <span class="brand-copy">
        <strong>{PROFILE.name}</strong>
        <small>{PROFILE.tagline}</small>
      </span>
    </a>

    <div class="nav-links">
      <button
        class="nav-menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="nav-sections"
        data-nav-menu-toggle
        hidden
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M4 7h16M4 12h16M4 17h10"></path>
        </svg>
        <span>Menu</span>
      </button>
      <div class="nav-sections" id="nav-sections" data-nav-sections>
        {NAV.map((item) => (
          <a
            class={item.cta ? 'nav-cta' : undefined}
            href={item.href}
            data-nav-section={item.id || undefined}
            aria-current={item.id === '' && onCuriosities ? 'page' : undefined}
          >
            <span class="nav-label">{item.label}</span>
            <span class="nav-elements" aria-hidden="true">
              {item.segs.map((e) => 'sym' in e
                ? <span class="el" data-cat={e.cat}><i>{e.z}</i><b>{e.sym}</b><u>{e.name}</u></span>
                : <span class="ch">{e.ch}</span>)}
            </span>
          </a>
        ))}
      </div>
      <SeriousModeToggle />
    </div>
  </nav>
</header>


<script is:inline>
  (() => {
    if (window.location.pathname !== '/') return;

    const links = [...document.querySelectorAll('[data-nav-section]')];
    const sections = links
      .map((link) => document.getElementById(link.dataset.navSection))
      .filter(Boolean);

    if (!sections.length || !('IntersectionObserver' in window)) return;

    const setCurrent = (id) => {
      links.forEach((link) => {
        const active = link.dataset.navSection === id;
        if (active) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio);

        if (visible[0]) setCurrent(visible[0].target.id);
      },
      { rootMargin: '-40% 0px -55% 0px', threshold: [0, 0.01, 0.15] },
    );

    sections.forEach((section) => observer.observe(section));
  })();
</script>

<script is:inline>
  (() => {
    const chips = [...document.querySelectorAll('.work-index a')];
    const targets = chips.map((chip) => document.querySelector(chip.getAttribute('href'))).filter(Boolean);
    if (!targets.length) return;
    const update = () => {
      const position = window.innerHeight * 0.4;
      const current = targets.find((target) => {
        const box = target.getBoundingClientRect();
        return box.top <= position && box.bottom > position;
      });
      chips.forEach((chip) => {
        if (current && chip.hash === '#' + current.id) chip.setAttribute('aria-current', 'true');
        else chip.removeAttribute('aria-current');
      });
    };
    let queued = false;
    window.addEventListener('scroll', () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { update(); queued = false; });
    }, { passive: true });
    update();
  })();
</script>

<script is:inline>
  // Compact navigation (<= 1180 px). Without JavaScript the sections stay
  // visible as a wrapping row; with it they collapse behind a disclosure.
  (() => {
    const button = document.querySelector('[data-nav-menu-toggle]');
    const panel = document.querySelector('[data-nav-sections]');
    if (!button || !panel) return;

    document.documentElement.dataset.navJs = 'true';
    button.hidden = false;

    const compact = window.matchMedia('(max-width: 1180px)');
    const FX = ['el-flip', 'el-drop', 'el-zoom', 'el-blur', 'el-spin', 'el-slide'];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let pulse = 0;
    const reveal = () => {
      const tiles = [...panel.querySelectorAll('.el, .ch')];
      tiles.forEach((el) => {
        el.style.setProperty('--fx', FX[(Math.random() * FX.length) | 0]);
        el.style.setProperty('--d', `${Math.round(Math.random() * 520)}ms`);
        el.classList.remove('is-pulse');
      });
      clearInterval(pulse);
      if (reduce.matches) return;
      // enquanto a gaveta está aberta, um elemento aleatório se “reacende” de tempos em tempos
      pulse = setInterval(() => {
        const el = tiles[(Math.random() * tiles.length) | 0];
        if (!el) return;
        el.style.setProperty('--fx', FX[(Math.random() * FX.length) | 0]);
        el.style.setProperty('--d', '0ms');
        el.classList.remove('is-pulse'); void el.offsetWidth; el.classList.add('is-pulse');
      }, 900);
    };
    const setOpen = (open, restoreFocus = false) => {
      button.setAttribute('aria-expanded', String(open));
      panel.dataset.open = String(open);
      if (open) reveal(); else clearInterval(pulse);
      if (!open && restoreFocus) button.focus();
    };

    button.addEventListener('click', () => {
      setOpen(button.getAttribute('aria-expanded') !== 'true');
    });
    panel.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && panel.dataset.open === 'true') setOpen(false, true);
    });
    document.addEventListener('click', (event) => {
      if (panel.dataset.open !== 'true') return;
      if (event.target instanceof Node && (panel.contains(event.target) || button.contains(event.target))) return;
      setOpen(false);
    });
    compact.addEventListener('change', () => setOpen(false));
  })();
</script>

<style is:global>
  .site-header .nav-menu-toggle { display: none; }
  .site-header .nav-sections { display: contents; }

  @media (max-width: 1180px) {
    html:not([data-legacy-mode='true']) .site-header .nav-shell { position: relative; }

    html:not([data-legacy-mode='true']) .site-header .nav-menu-toggle:not([hidden]) {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      padding: .5rem .8rem;
      border: 1px solid rgba(205, 188, 165, .92);
      border-radius: var(--radius-full);
      background: rgba(255, 250, 240, .76);
      color: var(--ink);
      font-family: var(--font-ui);
      font-size: .78rem;
      font-weight: 800;
      cursor: pointer;
    }

    html:not([data-legacy-mode='true']) .site-header .nav-menu-toggle[aria-expanded='true'] {
      background: var(--surface-soft);
    }

    html[data-nav-js='true']:not([data-legacy-mode='true']) .site-header .nav-sections {
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      right: 0;
      z-index: 60;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: .15rem;
      padding: .55rem;
      border: 1px solid rgba(205, 188, 165, .92);
      border-radius: 22px;
      background: #fffaf0;
      box-shadow: 0 14px 34px rgba(94, 72, 49, .16);
    }

    html[data-nav-js='true']:not([data-legacy-mode='true']) .site-header .nav-sections[data-open='true'] {
      display: flex;
    }

    /* No JavaScript: every destination stays reachable in a wrapping row. */
    html:not([data-nav-js='true']):not([data-legacy-mode='true']) .site-header .nav-sections {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: .15rem;
    }

    html:not([data-legacy-mode='true']) .site-header .nav-sections a {
      min-height: 44px;
      display: flex !important;
      align-items: center;
      padding: .6rem 1rem;
    }

    html[data-nav-js='true']:not([data-legacy-mode='true']) .site-header .nav-sections a {
      border-radius: 14px;
    }

    html[data-serious-mode='true'] .site-header .nav-menu-toggle:not([hidden]) {
      border-color: var(--line);
      background: var(--surface-soft);
    }

    html[data-serious-mode='true'][data-nav-js='true'] .site-header .nav-sections {
      border-color: var(--line);
      border-radius: 16px;
      background: #ffffff;
      box-shadow: none;
    }
  }

  @media (max-width: 420px) {
    html:not([data-legacy-mode='true']) .site-header .nav-shell { gap: .5rem; }
    html:not([data-legacy-mode='true']) .site-header .brand-copy { display: none; }
    html:not([data-legacy-mode='true']) .site-header .nav-menu-toggle:not([hidden]) { padding: .5rem .7rem; }
  }


  /* ===== Autoral: a gaveta é uma tabela periódica, em qualquer largura ===== */
  .site-header .nav-elements { display: none; }
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .nav-shell { position: relative; }
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .nav-menu-toggle:not([hidden]) {
    min-height: 44px; display: inline-flex; align-items: center; gap: .4rem; padding: .5rem .85rem;
    border: 1px solid rgba(205, 188, 165, .92); border-radius: var(--radius-full);
    background: rgba(255, 250, 240, .8); color: var(--ink); font-family: var(--font-ui);
    font-size: .78rem; font-weight: 800; cursor: pointer;
  }
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .nav-menu-toggle[aria-expanded='true'] { background: #2b2118; color: #f6e9c8; border-color: #2b2118; }
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .nav-sections {
    position: absolute; top: calc(100% + 10px); right: 0; left: auto; z-index: 60;
    width: min(640px, calc(100vw - 2rem));
    display: none; flex-direction: column; align-items: stretch; gap: .1rem; padding: .7rem;
    border: 1px solid #2b2118; border-radius: 20px;
    background: linear-gradient(160deg, #fbf4e3, #f1e6cc);
    box-shadow: 0 22px 50px rgba(43, 33, 24, .28), inset 0 1px 0 #ffffffaa;
  }
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .nav-sections[data-open='true'] { display: flex; }
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .nav-sections a {
    display: grid !important; grid-template-columns: 7.4rem minmax(0, 1fr); align-items: center; gap: .6rem;
    min-height: 0; padding: .4rem .55rem; border-radius: 14px; background: transparent; color: #2b2118;
    border: 1px solid transparent;
  }
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .nav-sections a::after { display: none; }
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .nav-sections a:hover,
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .nav-sections a:focus-visible { background: #ffffff99; border-color: #2b211833; }
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .nav-sections a[aria-current='true'],
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .nav-sections a[aria-current='page'] { background: #2b21180f; border-color: #2b211840; }
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .nav-sections a.nav-cta { background: transparent; color: #2b2118; }
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .nav-label { font-family: var(--font-ui); font-size: .84rem; font-weight: 800; letter-spacing: .01em; }
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .nav-elements { display: flex; flex-wrap: wrap; gap: 3px; }
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .el {
    position: relative; width: 42px; height: 52px; flex: 0 0 auto; display: block; text-align: center;
    border: 1.5px solid #2b2118; border-radius: 6px; box-shadow: 2px 2px 0 #2b211833;
    background: var(--el-bg, #e7dcc0); color: #2b2118; transition: transform .25s cubic-bezier(.2,.8,.2,1.2), box-shadow .25s;
  }
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .el i { position: absolute; top: 3px; left: 5px; font: 700 8.5px/1 var(--font-ui); font-style: normal; opacity: .75; }
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .el b { position: absolute; inset: 14px 0 12px; display: flex; align-items: center; justify-content: center; font: 800 1.45rem/1 Georgia, 'Times New Roman', serif; }
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .el u { position: absolute; left: 0; right: 0; bottom: 3px; font: 600 6.4px/1 var(--font-ui); text-decoration: none; letter-spacing: .01em; opacity: .8; white-space: nowrap; overflow: hidden; text-overflow: clip; }
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .el[data-cat='nm'] { --el-bg: #c6e6c3; }
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .el[data-cat='md'] { --el-bg: #dfe6a6; }
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .el[data-cat='tm'] { --el-bg: #f2cc9d; }
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .el[data-cat='ae'] { --el-bg: #f4e0a0; }
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .el[data-cat='ln'] { --el-bg: #e4c6ec; }
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .el[data-cat='hl'] { --el-bg: #bfe0f2; }
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .el[data-cat='ng'] { --el-bg: #dccdf2; }
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .el[data-cat='alk'] { --el-bg: #f6bfa8; }
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .el[data-cat='pt'] { --el-bg: #d3d9df; }
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .el[data-cat='ac'] { --el-bg: #f2c0d8; }
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .ch { display: inline-flex; align-items: center; height: 52px; padding: 0 2px; font: 800 1.9rem/1 Georgia, 'Times New Roman', serif; color: #2b2118; animation: var(--fx, el-zoom) 560ms cubic-bezier(.2,.8,.2,1.1) var(--d, 0ms) both; }
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .nav-sections a:hover .el { transform: translateY(-2px); box-shadow: 2px 4px 0 #2b211844; }
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .nav-sections a:hover .el:nth-child(odd) { transform: translateY(-3px) rotate(-3deg); }
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .nav-sections a:hover .el:nth-child(even) { transform: translateY(-3px) rotate(3deg); }

  /* revelação aleatória (o script sorteia --fx e --d a cada abertura) */
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .nav-sections[data-open='true'] .el { animation: var(--fx, el-zoom) 560ms cubic-bezier(.2, .8, .2, 1.1) var(--d, 0ms) both; }
  html[data-nav-js='true']:not([data-serious-mode='true']):not([data-legacy-mode='true']) .site-header .nav-sections[data-open='true'] .el.is-pulse { animation: var(--fx, el-zoom) 560ms cubic-bezier(.2, .8, .2, 1.1) 0ms both; }
  @keyframes el-flip { from { transform: perspective(300px) rotateY(95deg) scale(.7); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes el-drop { from { transform: translateY(-22px) rotate(-8deg); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes el-zoom { from { transform: scale(0); opacity: 0; } to { transform: none; opacity: 1; } }
