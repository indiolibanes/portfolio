---
import { PROFILE } from '../config';
import SeriousModeToggle from './SeriousModeToggle.astro';

const onCuriosities = Astro.url.pathname.replace(/\/$/, '') === '/curiosidades';

// Tabela periódica do menu: cada destino é escrito com símbolos de elementos (Sobre = S·O·B·Re).
// As letras que não existem na tabela ficam soltas, ao lado dos azulejos, como no logotipo de Breaking Bad.
const ELEMENTS = 'H:Hidrogênio,He:Hélio,Li:Lítio,Be:Berílio,B:Boro,C:Carbono,N:Nitrogênio,O:Oxigênio,F:Flúor,Ne:Neônio,Na:Sódio,Mg:Magnésio,Al:Alumínio,Si:Silício,P:Fósforo,S:Enxofre,Cl:Cloro,Ar:Argônio,K:Potássio,Ca:Cálcio,Sc:Escândio,Ti:Titânio,V:Vanádio,Cr:Cromo,Mn:Manganês,Fe:Ferro,Co:Cobalto,Ni:Níquel,Cu:Cobre,Zn:Zinco,Ga:Gálio,Ge:Germânio,As:Arsênio,Se:Selênio,Br:Bromo,Kr:Criptônio,Rb:Rubídio,Sr:Estrôncio,Y:Ítrio,Zr:Zircônio,Nb:Nióbio,Mo:Molibdênio,Tc:Tecnécio,Ru:Rutênio,Rh:Ródio,Pd:Paládio,Ag:Prata,Cd:Cádmio,In:Índio,Sn:Estanho,Sb:Antimônio,Te:Telúrio,I:Iodo,Xe:Xenônio,Cs:Césio,Ba:Bário,La:Lantânio,Ce:Cério,Pr:Praseodímio,Nd:Neodímio,Pm:Promécio,Sm:Samário,Eu:Európio,Gd:Gadolínio,Tb:Térbio,Dy:Disprósio,Ho:Hólmio,Er:Érbio,Tm:Túlio,Yb:Itérbio,Lu:Lutécio,Hf:Háfnio,Ta:Tântalo,W:Tungstênio,Re:Rênio,Os:Ósmio,Ir:Irídio,Pt:Platina,Au:Ouro,Hg:Mercúrio,Tl:Tálio,Pb:Chumbo,Bi:Bismuto,Po:Polônio,At:Astato,Rn:Radônio,Fr:Frâncio,Ra:Rádio,Ac:Actínio,Th:Tório,Pa:Protactínio,U:Urânio,Np:Netúnio,Pu:Plutônio,Am:Amerício,Cm:Cúrio,Bk:Berquélio,Cf:Califórnio,Es:Einstênio,Fm:Férmio,Md:Mendelévio,No:Nobélio,Lr:Laurêncio,Rf:Rutherfórdio,Db:Dúbnio,Sg:Seabórgio,Bh:Bóhrio,Hs:Hássio,Mt:Meitnério,Ds:Darmstádio,Rg:Roentgênio,Cn:Copernício,Nh:Nihônio,Fl:Fleróvio,Mc:Moscóvio,Lv:Livermório,Ts:Tenesso,Og:Oganessônio';
const TABLE = new Map<string, { z: number; name: string; cat: string }>();
const group = (sym: string, z: number) =>
  ['H', 'C', 'N', 'O', 'P', 'S', 'Se'].includes(sym) ? 'nm'
  : ['F', 'Cl', 'Br', 'I', 'At', 'Ts'].includes(sym) ? 'hl'
  : ['He', 'Ne', 'Ar', 'Kr', 'Xe', 'Rn', 'Og'].includes(sym) ? 'ng'
  : ['Li', 'Na', 'K', 'Rb', 'Cs', 'Fr'].includes(sym) ? 'alk'
  : ['Be', 'Mg', 'Ca', 'Sr', 'Ba', 'Ra'].includes(sym) ? 'ae'
  : ['B', 'Si', 'Ge', 'As', 'Sb', 'Te'].includes(sym) ? 'md'
  : z >= 57 && z <= 71 ? 'ln'
  : z >= 89 && z <= 103 ? 'ac'
  : ['Al', 'Ga', 'In', 'Sn', 'Tl', 'Pb', 'Bi', 'Po', 'Nh', 'Fl', 'Mc', 'Lv'].includes(sym) ? 'pt'
  : 'tm';
ELEMENTS.split(',').forEach((entry, idx) => {
  const [sym, name] = entry.split(':');
  TABLE.set(sym.toLowerCase(), { z: idx + 1, name, cat: group(sym, idx + 1) });
});
// Segmenta a palavra maximizando as letras cobertas por símbolos reais.
type Seg = { sym: string; z: number; name: string; cat: string } | { ch: string };
function spell(word: string): Seg[] {
  const low = word.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  const n = low.length;
  const best: { score: number; segs: Seg[] }[] = Array.from({ length: n + 1 }, () => ({ score: -1, segs: [] }));
  best[n] = { score: 0, segs: [] };
  for (let i = n - 1; i >= 0; i -= 1) {
    let pick = { score: best[i + 1].score, segs: [{ ch: word[i].toUpperCase() } as Seg, ...best[i + 1].segs] };
    for (const len of [1, 2]) {
      const key = low.slice(i, i + len);
      const el = key.length === len ? TABLE.get(key) : undefined;
      if (!el) continue;
      const score = best[i + len].score + len;
      if (score > pick.score) pick = { score, segs: [{ sym: key[0].toUpperCase() + key.slice(1), ...el } as Seg, ...best[i + len].segs] };
    }
    best[i] = pick;
  }
  return best[0].segs;
}
// Normas e padrões que correm por dentro da gaveta do cabeçalho (decorativo).
const STANDARDS_A = ['ISO 9001', 'NBR 6023', 'ISO 690', 'ISA-88', 'ISO 8601', 'NBR 10520', 'IEC 61131-3', 'ISO 15489', 'NBR 14724', 'ISO/IEC 27001', 'NBR 6022', 'ISA-95', 'ISO 26324', 'NBR 6024', 'ISO 14001', 'IEEE 830', 'NBR 6027', 'ISO 31000', 'ISO 302', 'NBR 6028'];
const STANDARDS_B = ['ISA-5.1', 'ISO 19650', 'NBR 15287', 'IEC 62443', 'ISO 2108', 'NBR 5410', 'ISO/IEC 25010', 'ISA-101', 'TAPPI T 236', 'ISO 15836', 'NR-10', 'ISO/IEC/IEEE 82079-1', 'NBR ISO 9001', 'ISA-18.2', 'ISO 12207', 'NR-12', 'ABNT NBR 6034', 'ISO 3166', 'IEC 60617', 'ISO 80000'];
const NAV = [
  { href: '/#sobre', id: 'sobre', label: 'Sobre' },
  { href: '/#lab', id: 'lab', label: 'Laboratório' },
  { href: '/#percurso', id: 'percurso', label: 'Percurso' },
  { href: '/#metodo', id: 'metodo', label: 'Método' },
  { href: '/#bastidores', id: 'bastidores', label: 'Bastidores' },
  { href: '/#musica', id: 'musica', label: 'Música' },
  { href: '/curiosidades/', id: '', label: 'Curiosidades' },
  { href: '/#contato', id: 'contato', label: 'Contato', cta: true },
].map((item) => ({ ...item, segs: spell(item.label) }));
---

<header class="site-header">
  <nav class="nav-shell" aria-label="Navegação principal">
    <div class="nav-standards" aria-hidden="true" data-nav-standards>
      <div class="nav-standards__row" data-standards-row="a">
        {[0, 1].map(() => STANDARDS_A.map((t) => <span>{t}</span>))}
      </div>
      <div class="nav-standards__row" data-standards-row="b">
        {[0, 1].map(() => STANDARDS_B.map((t) => <span>{t}</span>))}
      </div>
    </div>
    <a class="brand" href="/#top" aria-label={`${PROFILE.name}, início`}>
      <span class="brand-mark" aria-hidden="true" data-brand-mark><svg viewBox="0 0 100 100" focusable="false"><text x="50" y="68" text-anchor="middle" font-size="56" font-weight="700" font-family="serif" fill="currentColor">K</text></svg></span>
      <span class="brand-copy">
        <strong>{PROFILE.name}</strong>
        <small>{PROFILE.tagline}</small>
      </span>
    </a>

    <div class="nav-links">
      <button
        class="nav-menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="nav-sections"
        data-nav-menu-toggle
        hidden
      >
        <svg class="nav-plasma" data-nav-plasma viewBox="0 0 80 44" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <defs>
            <radialGradient id="nav-plasma-a"><stop offset="0" stop-color="#ff6fa8"></stop><stop offset="0.55" stop-color="#ff6fa8" stop-opacity="0.7"></stop><stop offset="1" stop-color="#ff6fa8" stop-opacity="0"></stop></radialGradient>
            <radialGradient id="nav-plasma-b"><stop offset="0" stop-color="#ffd15a"></stop><stop offset="0.55" stop-color="#ffd15a" stop-opacity="0.7"></stop><stop offset="1" stop-color="#ffd15a" stop-opacity="0"></stop></radialGradient>
            <radialGradient id="nav-plasma-c"><stop offset="0" stop-color="#5cc3ff"></stop><stop offset="0.55" stop-color="#5cc3ff" stop-opacity="0.7"></stop><stop offset="1" stop-color="#5cc3ff" stop-opacity="0"></stop></radialGradient>
            <radialGradient id="nav-plasma-d"><stop offset="0" stop-color="#a98bff"></stop><stop offset="0.55" stop-color="#a98bff" stop-opacity="0.7"></stop><stop offset="1" stop-color="#a98bff" stop-opacity="0"></stop></radialGradient>
            <radialGradient id="nav-plasma-e"><stop offset="0" stop-color="#7be3a0"></stop><stop offset="0.55" stop-color="#7be3a0" stop-opacity="0.7"></stop><stop offset="1" stop-color="#7be3a0" stop-opacity="0"></stop></radialGradient>
          </defs>
          <g class="nav-plasma__blobs">
            <circle cx="16" cy="12" r="17" fill="url(#nav-plasma-a)"></circle>
            <circle cx="40" cy="30" r="18" fill="url(#nav-plasma-b)"></circle>
            <circle cx="64" cy="14" r="17" fill="url(#nav-plasma-c)"></circle>
            <circle cx="26" cy="34" r="16" fill="url(#nav-plasma-d)"></circle>
            <circle cx="54" cy="22" r="15" fill="url(#nav-plasma-e)"></circle>
            <circle cx="40" cy="10" r="14" fill="url(#nav-plasma-a)"></circle>
          </g>
        </svg>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M4 7h16M4 12h16M4 17h10"></path>
        </svg>
        <span>Menu</span>
      </button>
      <div class="nav-sections" id="nav-sections" data-nav-sections>
        {NAV.map((item) => (
          <a
            class={item.cta ? 'nav-cta' : undefined}
            href={item.href}
            data-nav-section={item.id || undefined}
            aria-current={item.id === '' && onCuriosities ? 'page' : undefined}
          >
            <span class="nav-label">{item.label}</span>
            <span class="nav-elements" aria-hidden="true">
              {item.segs.map((e) => 'sym' in e
                ? <span class="el" data-cat={e.cat}><i>{e.z}</i><b>{e.sym}</b><u>{e.name}</u></span>
                : <span class="ch">{e.ch}</span>)}
            </span>
          </a>
        ))}
      </div>
      <SeriousModeToggle />
    </div>
  </nav>
</header>


<script is:inline>
  (() => {
    if (window.location.pathname !== '/') return;

    const links = [...document.querySelectorAll('[data-nav-section]')];
    const sections = links
      .map((link) => document.getElementById(link.dataset.navSection))
      .filter(Boolean);

    if (!sections.length || !('IntersectionObserver' in window)) return;

    const setCurrent = (id) => {
      links.forEach((link) => {
        const active = link.dataset.navSection === id;
        if (active) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio);

        if (visible[0]) setCurrent(visible[0].target.id);
      },
      { rootMargin: '-40% 0px -55% 0px', threshold: [0, 0.01, 0.15] },
    );

    sections.forEach((section) => observer.observe(section));
  })();
</script>

<script is:inline>
  (() => {
    const chips = [...document.querySelectorAll('.work-index a')];
    const targets = chips.map((chip) => document.querySelector(chip.getAttribute('href'))).filter(Boolean);
    if (!targets.length) return;
    const update = () => {
      const position = window.innerHeight * 0.4;
      const current = targets.find((target) => {
        const box = target.getBoundingClientRect();
        return box.top <= position && box.bottom > position;
      });
      chips.forEach((chip) => {
        if (current && chip.hash === '#' + current.id) chip.setAttribute('aria-current', 'true');
        else chip.removeAttribute('aria-current');
      });
    };
    let queued = false;
    window.addEventListener('scroll', () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { update(); queued = false; });
    }, { passive: true });
    update();
  })();
</script>

<script is:inline>
  // Compact navigation (<= 1180 px). Without JavaScript the sections stay
  // visible as a wrapping row; with it they collapse behind a disclosure.
  (() => {
    const button = document.querySelector('[data-nav-menu-toggle]');
    const panel = document.querySelector('[data-nav-sections]');
    if (!button || !panel) return;

    document.documentElement.dataset.navJs = 'true';
    button.hidden = false;

    // Plasma do botão Menu: gás condensado, frenético e contido no botão. Mais
    // intenso ao passar, segurar ou abrir; ao soltar, a energia se dispersa e
    // volta ao ponto inicial.
    (() => {
      const plasma = button.querySelector('[data-nav-plasma]');
      const still = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (!plasma || still.matches) return;
      const rnd = (a, b) => a + Math.random() * (b - a);
      const drift = Array.from(plasma.querySelectorAll('circle')).map((c) => {
        const frames = Array.from({ length: 6 }, () => ({
          transform: 'translate(' + rnd(-34, 34) + 'px,' + rnd(-16, 16) + 'px) scale(' + rnd(0.7, 1.6) + ')',
        }));
        frames.push(frames[0]);
        return c.animate(frames, {
          duration: rnd(900, 1700),
          iterations: Infinity,
          easing: 'ease-in-out',
          delay: -rnd(0, 1200),
        });
      });
      const tint = plasma.animate(
        [{ filter: 'hue-rotate(0deg)' }, { filter: 'hue-rotate(360deg)' }],
        { duration: 3200, iterations: Infinity },
      );
      let level = 0;
      let target = 0;
      let ramp = 0;
      const apply = () => {
        const rate = 1 + level * 2.6;
        drift.forEach((a) => a.updatePlaybackRate(rate));
        tint.updatePlaybackRate(1 + level * 3);
        plasma.style.opacity = String(0.5 + level * 0.5);
      };
      const step = () => {
        const speed = target > level ? 0.12 : 0.025;
        level += (target - level) * speed;
        if (Math.abs(target - level) < 0.01) level = target;
        apply();
        ramp = level === target ? 0 : requestAnimationFrame(step);
      };
      const set = (value) => {
        target = value;
        if (!ramp) ramp = requestAnimationFrame(step);
      };
      const hot = () => button.matches(':hover, :active, :focus-visible') || button.getAttribute('aria-expanded') === 'true';
      const settle = () => set(hot() ? 1 : 0);
      apply();
      ['pointerenter', 'focus'].forEach((t) => button.addEventListener(t, () => set(1)));
      button.addEventListener('pointerdown', () => set(1));
      ['pointerleave', 'pointerup', 'pointercancel', 'blur'].forEach((t) => button.addEventListener(t, () => setTimeout(settle, 0)));
      new MutationObserver(settle).observe(button, { attributes: true, attributeFilter: ['aria-expanded'] });
    })();

    // Normas passando depressa por dentro do cabeçalho. WAAPI, porque os modos
    // planos zeram animation do CSS; os modos reduzidos ficam parados.
    (() => {
      const rows = document.querySelectorAll('[data-standards-row]');
      if (!rows.length || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      rows.forEach((row, i) => {
        const frames = i === 0
          ? [{ transform: 'translateX(0)' }, { transform: 'translateX(-50%)' }]
          : [{ transform: 'translateX(-50%)' }, { transform: 'translateX(0)' }];
        row.animate(frames, { duration: i === 0 ? 7000 : 5200, iterations: Infinity });
      });
    })();

    const compact = window.matchMedia('(max-width: 1180px)');
    const FX = ['el-flip', 'el-drop', 'el-zoom', 'el-blur', 'el-spin', 'el-slide'];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let pulse = 0;
    const reveal = () => {
      const tiles = [...panel.querySelectorAll('.el, .ch')];
      tiles.forEach((el) => {
        el.style.setProperty('--fx', FX[(Math.random() * FX.length) | 0]);
        el.style.setProperty('--d', `${Math.round(Math.random() * 520)}ms`);
        el.classList.remove('is-pulse');
      });
      clearInterval(pulse);
      if (reduce.matches) return;
      // enquanto a gaveta está aberta, um elemento aleatório se “reacende” de tempos em tempos
      pulse = setInterval(() => {
        const el = tiles[(Math.random() * tiles.length) | 0];
        if (!el) return;
        el.style.setProperty('--fx', FX[(Math.random() * FX.length) | 0]);
        el.style.setProperty('--d', '0ms');
        el.classList.remove('is-pulse'); void el.offsetWidth; el.classList.add('is-pulse');
      }, 900);
    };
    const setOpen = (open, restoreFocus = false) => {
      button.setAttribute('aria-expanded', String(open));
      panel.dataset.open = String(open);
      if (open) reveal(); else clearInterval(pulse);
      if (!open && restoreFocus) button.focus();
    };

    button.addEventListener('click', () => {
      setOpen(button.getAttribute('aria-expanded') !== 'true');
    });
    panel.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && panel.dataset.open === 'true') setOpen(false, true);
    });
    document.addEventListener('click', (event) => {
      if (panel.dataset.open !== 'true') return;
      if (event.target instanceof Node && (panel.contains(event.target) || button.contains(event.target))) return;
      setOpen(false);
    });
    compact.addEventListener('change', () => setOpen(false));
  })();
</script>

<script is:inline>
  // Marca do cabeçalho: uma pequena animação de anime (≈4,8 s). Kauê gira 360°
  // sob o céu de Kimi no Na wa — do sol de meio-dia de Mato Grosso do Sul, que
  // o faz apertar os olhos cor de avelã, ao crepúsculo (kataware-doki) com
  // cometa, estrelas e brilho de contraluz nos cachos. Há um quadro de impacto
  // em nanquim, em homenagem a Fujimoto, quando ele vira de costas. A cabeça é
  // modelada em 3D simples (elipsoide) e desenhada em cel-shading no canvas.
  // O "K" fica de reserva sem JavaScript; reduced-motion e Legacy ficam no
  // último quadro.
  (() => {
    const mark = document.querySelector('[data-brand-mark]');
    if (!mark) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const canvas = document.createElement('canvas');
    canvas.className = 'brand-canvas';
    canvas.setAttribute('aria-hidden', 'true');
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const old = mark.querySelector('svg');
    if (old) old.remove();
    mark.appendChild(canvas);

    const SIZE = 100;
    const DURATION = 4800;
    const TAU = Math.PI * 2;
    const clamp = (v, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    const lerp = (a, b, t) => a + (b - a) * t;
    const smooth = (a, b, t) => {
      const x = clamp((t - a) / (b - a));
      return x * x * (3 - 2 * x);
    };
    const inOut = (t) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const hex = (h) => [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)];
    const mixRGB = (a, b, t) => a.map((v, i) => Math.round(lerp(v, b[i], t)));
    const css = (c, a = 1) => 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',' + a + ')';
    const prng = (seed) => {
      let s = seed >>> 0;
      return () => {
        s = (Math.imul(s, 1664525) + 1013904223) >>> 0;
        return s / 4294967296;
      };
    };

    // Céus, do chão ao topo: sol forte → pôr do sol → crepúsculo.
    const SKY = [
      ['#fff0b8', '#ffe39a', '#ffd08a', '#cfe6ff', '#9fd0ff'].map(hex),
      ['#ffb45e', '#ff7a6a', '#d8508a', '#8a4fb4', '#3a3a8a'].map(hex),
      ['#ff9a73', '#e2568f', '#8a4fbf', '#3b3a9e', '#121850'].map(hex),
    ];
    const skyAt = (s) => {
      const a = Math.min(1, Math.floor(s));
      const t = clamp(s - a);
      return SKY[a].map((c, i) => mixRGB(c, SKY[a + 1][i], t));
    };

    // Geometria da cabeça (elipsoide) e do cabelo.
    const CX = 50;
    const CY = 51;
    const RX = 20.5;
    const RY = 24;
    const hairRand = prng(31);
    const CURLS = [];
    for (let i = 0; i < 150; i += 1) {
      const lon = (hairRand() - 0.5) * TAU;
      const u = Math.abs(lon) / Math.PI;
      // Latitude: o alto da cabeça sempre; as laterais e a nuca descem mais.
      const low = -8 - 44 * Math.pow(u, 1.6);
      const alt = low + hairRand() * (86 - low);
      CURLS.push({ lon, alt: (alt * Math.PI) / 180, r: 3.6 + hairRand() * 3.4, ph: hairRand() * TAU });
    }

    const STARS = Array.from({ length: 34 }, (_, i) => {
      const r = prng(90 + i);
      return { x: r() * 100, y: r() * 62, s: 0.25 + r() * 0.5, p: r() * TAU, sp: r() > 0.8 };
    });

    const thetaAt = (t) => {
      // Quase parado a olhar de frente, gira 360° e volta de frente.
      const k = smooth(0.5, 3.5, t / 1000);
      return inOut(k) * TAU;
    };

    // --------------------------------------------------------------- cena
    const sky = (t, theta) => {
      const sec = t / 1000;
      const s = smooth(0.35, 1.9, sec) + smooth(1.9, 3.5, sec);
      const pal = skyAt(Math.min(1.999, s));
      const g = ctx.createLinearGradient(0, 100, 0, 0);
      pal.forEach((c, i) => g.addColorStop(i / 4, css(c)));
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, 100, 100);
      const night = smooth(1.4, 3.4, sec);
      // Estrelas.
      STARS.forEach((st) => {
        const tw = 0.55 + 0.45 * Math.sin(sec * 3 + st.p);
        const x = (((st.x - Math.sin(theta) * 6) % 100) + 100) % 100;
        ctx.fillStyle = 'rgba(255,248,235,' + night * tw + ')';
        if (st.sp && night > 0.4) {
          ctx.beginPath();
          ctx.moveTo(x, st.y - st.s * 3);
          ctx.lineTo(x + st.s * 0.7, st.y);
          ctx.lineTo(x, st.y + st.s * 3);
          ctx.lineTo(x - st.s * 0.7, st.y);
          ctx.closePath();
          ctx.fill();
        } else {
          ctx.beginPath();
          ctx.arc(x, st.y, st.s, 0, TAU);
          ctx.fill();
        }
      });
      // Nuvens iluminadas por baixo, derivando contra a rotação.
      for (let i = 0; i < 4; i += 1) {
        const cx = (((20 + i * 30 - Math.sin(theta) * 14 * (0.6 + i * 0.2)) % 140) + 140) % 140 - 20;
        const cy = 58 + (i % 2) * 8 - i * 3;
        const lit = smooth(0.4, 1.8, sec) * (1 - night * 0.45);
        const cg = ctx.createLinearGradient(0, cy - 6, 0, cy + 6);
        cg.addColorStop(0, 'rgba(180,120,210,' + 0.45 * lit + ')');
        cg.addColorStop(1, 'rgba(255,150,100,' + 0.7 * lit + ')');
        ctx.fillStyle = cg;
        ctx.beginPath();
        ctx.ellipse(cx, cy, 20, 4.2, 0, 0, TAU);
        ctx.ellipse(cx + 9, cy - 2.6, 12, 3.4, 0, 0, TAU);
        ctx.fill();
      }
      // Sol baixo atrás do ombro direito: brilho que esfria para o crepúsculo.
      const sunY = lerp(48, 74, smooth(0.2, 2.6, sec));
      const sg = ctx.createRadialGradient(76, sunY, 0, 76, sunY, 46);
      const glow = 1 - night * 0.65;
      sg.addColorStop(0, 'rgba(255,248,214,' + 0.95 * glow + ')');
      sg.addColorStop(0.25, 'rgba(255,196,110,' + 0.55 * glow + ')');
      sg.addColorStop(1, 'rgba(255,120,80,0)');
      ctx.globalCompositeOperation = 'screen';
      ctx.fillStyle = sg;
      ctx.fillRect(0, 0, 100, 100);
      // Raios de luz.
      ctx.save();
      ctx.translate(76, sunY);
      for (let i = 0; i < 9; i += 1) {
        const a = -2.9 + i * 0.35 + Math.sin(sec * 0.8 + i) * 0.05;
        ctx.fillStyle = 'rgba(255,214,150,' + 0.1 * glow + ')';
        ctx.beginPath();
        ctx.moveTo(0, 0);
        ctx.lineTo(Math.cos(a - 0.06) * 120, Math.sin(a - 0.06) * 120);
        ctx.lineTo(Math.cos(a + 0.06) * 120, Math.sin(a + 0.06) * 120);
        ctx.fill();
      }
      ctx.restore();
      ctx.globalCompositeOperation = 'source-over';
      // Cometa de duas pontas, como o de Itomori.
      const c = clamp((sec - 1.7) / 1.5);
      if (c > 0 && c < 1) {
        const hx = lerp(-12, 108, c);
        const hy = lerp(8, 46, c) + Math.sin(c * 6) * 1.2;
        const tail = (len, col, w) => {
          const tg = ctx.createLinearGradient(hx, hy, hx - len, hy - len * 0.32);
          tg.addColorStop(0, col);
          tg.addColorStop(1, 'rgba(255,255,255,0)');
          ctx.fillStyle = tg;
          ctx.beginPath();
          ctx.moveTo(hx, hy - w);
          ctx.lineTo(hx - len, hy - len * 0.32);
          ctx.lineTo(hx, hy + w);
          ctx.fill();
        };
        ctx.globalCompositeOperation = 'screen';
        tail(46, 'rgba(255,214,130,0.9)', 2.2);
        tail(34, 'rgba(120,200,255,0.8)', 1.6);
        const hg = ctx.createRadialGradient(hx, hy, 0, hx, hy, 9);
        hg.addColorStop(0, 'rgba(255,255,255,1)');
        hg.addColorStop(0.3, 'rgba(255,230,170,0.8)');
        hg.addColorStop(1, 'rgba(255,170,90,0)');
        ctx.fillStyle = hg;
        ctx.fillRect(hx - 10, hy - 10, 20, 20);
        ctx.globalCompositeOperation = 'source-over';
      }
    };

    const SKIN = hex('#c98f5f');
    const SKIN_SH = hex('#9c613b');
    const SKIN_LT = hex('#e6ae7c');
    const INK = '#0d0a0f';
    const HAIR = '#1d1824';

    const project = (theta, lon, y, r = 1) => {
      const a = lon - theta;
      const dy = (y - CY) / RY;
      const k = Math.sqrt(Math.max(0, 1 - dy * dy));
      return { x: CX + RX * r * k * Math.sin(a), y, d: Math.cos(a) };
    };
    const hairline = (lon) => {
      const u = Math.abs(((lon + Math.PI) % TAU + TAU) % TAU - Math.PI) / Math.PI;
      return 37 + 31 * u;
    };

    const curl = (cx, cy, r, ph, rim, sec) => {
      ctx.fillStyle = HAIR;
      ctx.beginPath();
      ctx.arc(cx, cy, r, 0, TAU);
      ctx.fill();
      ctx.strokeStyle = 'rgba(8,6,12,0.9)';
      ctx.lineWidth = 0.55;
      ctx.stroke();
      // Espiral de brilho do cacho.
      ctx.strokeStyle = 'rgba(70,58,100,0.85)';
      ctx.lineWidth = 0.45;
      ctx.beginPath();
      for (let k = 0; k <= 14; k += 1) {
        const a = ph + k * 0.5;
        const rr = r * (0.8 - k * 0.045);
        const x = cx + rr * Math.cos(a);
        const y = cy + rr * Math.sin(a);
        if (k === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.stroke();
      // Contraluz: filete de luz do lado do sol.
      ctx.strokeStyle = css(rim, 0.9);
      ctx.lineWidth = 0.75;
      ctx.beginPath();
      ctx.arc(cx, cy, r * 0.92, -1.15, 0.55);
      ctx.stroke();
    };

    const head = (t, theta, rim, openness, squint) => {
      const sec = t / 1000;
      const front = [];
      const behind = [];
      CURLS.forEach((c) => {
        const a = c.lon - theta;
        const ca = Math.cos(c.alt);
        const d = ca * Math.cos(a);
        const x = CX + RX * 1.1 * ca * Math.sin(a);
        const y = CY - RY * 1.02 * Math.sin(c.alt) - 2;
        // Na frente, cachos baixos escondem o rosto: só ficam acima da linha do cabelo.
        if (d > 0.18 && y > hairline(c.lon) - 2) return;
        (d < 0.05 ? behind : front).push({ x, y, d, r: c.r * (0.9 + 0.12 * d), ph: c.ph });
      });
      behind.sort((p, q) => p.d - q.d);
      front.sort((p, q) => p.d - q.d);
      // Massa de cabelo atrás.
      ctx.fillStyle = HAIR;
      ctx.beginPath();
      ctx.ellipse(CX, CY - 6, RX + 3, RY - 1, 0, Math.PI, TAU);
      ctx.fill();
      behind.forEach((c) => curl(c.x, c.y, c.r, c.ph, rim, sec));

      // Pescoço.
      ctx.fillStyle = css(SKIN_SH);
      ctx.fillRect(CX - 7, CY + 14, 14, 20);

      // Crânio: pele com cel-shading (sombra do lado oposto ao sol).
      const skin = ctx.createRadialGradient(CX + 6, CY - 6, 2, CX, CY, RX + 6);
      skin.addColorStop(0, css(SKIN_LT));
      skin.addColorStop(0.55, css(SKIN));
      skin.addColorStop(1, css(SKIN_SH));
      ctx.fillStyle = skin;
      ctx.beginPath();
      ctx.ellipse(CX, CY, RX, RY, 0, 0, TAU);
      ctx.fill();
      ctx.save();
      ctx.beginPath();
      ctx.ellipse(CX, CY, RX, RY, 0, 0, TAU);
      ctx.clip();
      ctx.fillStyle = css(SKIN_SH, 0.55);
      ctx.beginPath();
      ctx.rect(0, 0, 100, 100);
      ctx.ellipse(CX + 5, CY - 2, RX * 0.95, RY * 1.05, 0, 0, TAU);
      ctx.fill('evenodd');
      ctx.restore();

      const vis = (lon) => Math.cos(lon - theta);
      // Orelhas.
      [-1, 1].forEach((side) => {
        const p = project(theta, side * (Math.PI / 2 + 0.06), CY + 1.5, 1.02);
        if (p.d < -0.35) return;
        const w = 1.4 + 1.9 * Math.max(0, 1 - Math.abs(p.d));
        ctx.fillStyle = css(SKIN_SH);
        ctx.strokeStyle = INK;
        ctx.lineWidth = 0.5;
        ctx.beginPath();
        ctx.ellipse(p.x, p.y, w, 3.6, 0, 0, TAU);
        ctx.fill();
        ctx.stroke();
      });

      // Barba: uma casca na superfície do crânio (latitude × longitude),
      // do bigode à ponta do queixo, subindo pelas costeletas.
      const rad = Math.PI / 180;
      const surf = (lon, lat, r) => {
        const aa = lon - theta;
        return { x: CX + RX * r * Math.cos(lat * rad) * Math.sin(aa), y: CY - RY * r * Math.sin(lat * rad) + 1, d: Math.cos(aa) };
      };
      const lo = Math.max(-1.75, theta - Math.PI / 2);
      const hi = Math.min(1.75, theta + Math.PI / 2);
      // theta é módulo 2π: também cobre as costeletas quando ele já deu a volta.
      const th = ((theta + Math.PI) % TAU + TAU) % TAU - Math.PI;
      const lo2 = Math.max(-1.75, th - Math.PI / 2);
      const hi2 = Math.min(1.75, th + Math.PI / 2);
      if (hi2 - lo2 > 0.05) {
        const topLat = (k) => -24 + 34 * smooth(0.5, 1.6, k);
        const botLat = (k) => -78 + 36 * smooth(0.2, 1.75, k);
        const pts = [];
        for (let lon = lo2; lon <= hi2 + 1e-6; lon += 0.06) pts.push(surf(lon, topLat(Math.abs(lon)), 1.045));
        for (let lon = hi2; lon >= lo2 - 1e-6; lon -= 0.06) pts.push(surf(lon, botLat(Math.abs(lon)), 1.07));
        ctx.beginPath();
        pts.forEach((p, i) => (i ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y)));
        ctx.closePath();
        ctx.fillStyle = '#231712';
        ctx.fill();
        ctx.strokeStyle = INK;
        ctx.lineWidth = 0.55;
        ctx.stroke();
        // Hachuras de luz (do lado do sol) e fios secos.
        ctx.lineWidth = 0.35;
        for (let i = 0; i < 30; i += 1) {
          const lon = lo2 + ((i + 0.5) / 30) * (hi2 - lo2);
          const lat = botLat(Math.abs(lon)) + 8 + (i % 5) * 6;
          const p = surf(lon, lat, 1.07);
          ctx.strokeStyle = p.x > CX ? css(rim, 0.6) : 'rgba(90,70,60,0.55)';
          ctx.beginPath();
          ctx.moveTo(p.x, p.y);
          ctx.lineTo(p.x + 0.5, p.y + 2.1);
          ctx.stroke();
        }
      }
      // Boca e bigode.
      if (vis(0) > 0.1) {
        const m0 = project(theta, -0.3, 66.4, 1.02);
        const m1 = project(theta, 0, 67.6, 1.03);
        const m2 = project(theta, 0.34, 65.2, 1.02);
        ctx.strokeStyle = '#6a2f27';
        ctx.lineWidth = 0.9;
        ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.moveTo(m0.x, m0.y);
        ctx.quadraticCurveTo(m1.x, m1.y + 1.2, m2.x, m2.y);
        ctx.stroke();
        ctx.strokeStyle = 'rgba(255,200,170,0.5)';
        ctx.lineWidth = 0.5;
        ctx.beginPath();
        ctx.moveTo(m0.x + 1, m0.y + 1.6);
        ctx.quadraticCurveTo(m1.x, m1.y + 2.6, m2.x - 1, m2.y + 1.2);
        ctx.stroke();
      }
      // Nariz: a ponta salta da silhueta quando ele está de perfil.
      if (vis(0) > -0.3) {
        const b = project(theta, 0, 49, 1.0);
        const tip = project(theta, 0, 58.5, 1.17);
        const base = project(theta, 0, 61, 1.0);
        ctx.fillStyle = css(SKIN_LT);
        ctx.strokeStyle = 'rgba(70,30,20,0.85)';
        ctx.lineWidth = 0.55;
        ctx.beginPath();
        ctx.moveTo(b.x, b.y);
        ctx.quadraticCurveTo(tip.x + (tip.x - b.x) * 0.3, tip.y - 2.5, tip.x, tip.y);
        ctx.quadraticCurveTo(tip.x - 0.4, tip.y + 2, base.x, base.y);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();
        if (vis(0) > 0.3) {
          const nl = project(theta, -0.12, 60.4, 1.05);
          const nr = project(theta, 0.12, 60.4, 1.05);
          ctx.fillStyle = 'rgba(60,25,20,0.8)';
          ctx.beginPath();
          ctx.ellipse(nl.x, nl.y, 0.7, 0.45, 0, 0, TAU);
          ctx.ellipse(nr.x, nr.y, 0.7, 0.45, 0, 0, TAU);
          ctx.fill();
        }
      }
      // Olhos avelã e óculos de armação grossa.
      const lens = (lc) => {
        const pts = [];
        for (let s = 0; s <= 40; s += 1) {
          const a = (s / 40) * TAU;
          const ca = Math.cos(a);
          const sa = Math.sin(a);
          const lon = lc + 0.33 * Math.sign(ca) * Math.pow(Math.abs(ca), 0.42);
          const y = 50.3 + 5.4 * Math.sign(sa) * Math.pow(Math.abs(sa), 0.42);
          pts.push(project(theta, lon, y, 1.02));
        }
        return pts;
      };
      [-0.46, 0.46].forEach((lc) => {
        const c = project(theta, lc, 50.4, 1.0);
        if (c.d > 0.05) {
          const sx = Math.max(0.12, c.d);
          const w = 4.6 * sx;
          const h = 3.6 * Math.max(0.1, openness);
          // Esclera, íris avelã com anel dourado, pupila e brilhos.
          ctx.fillStyle = '#f2ebde';
          ctx.beginPath();
          ctx.ellipse(c.x, c.y, w, h, 0, 0, TAU);
          ctx.fill();
          ctx.save();
          ctx.beginPath();
          ctx.ellipse(c.x, c.y, w, h, 0, 0, TAU);
          ctx.clip();
          const ir = ctx.createRadialGradient(c.x, c.y, 0.2, c.x, c.y, 2.4 * sx + 0.6);
          ir.addColorStop(0, '#caa23c');
          ir.addColorStop(0.55, '#9a7428');
          ir.addColorStop(1, '#5a3d17');
          ctx.fillStyle = ir;
          ctx.beginPath();
          ctx.ellipse(c.x + (lc > 0 ? -0.2 : 0.2) * sx, c.y + 0.1, 2.3 * sx + 0.2, 2.3, 0, 0, TAU);
          ctx.fill();
          ctx.fillStyle = '#160f08';
          ctx.beginPath();
          ctx.ellipse(c.x, c.y + 0.1, 0.95 * sx + 0.1, 1.0, 0, 0, TAU);
          ctx.fill();
          ctx.fillStyle = 'rgba(255,255,255,0.95)';
          ctx.beginPath();
          ctx.arc(c.x + 0.8 * sx, c.y - 0.9, 0.55, 0, TAU);
          ctx.fill();
          ctx.restore();
          // Pálpebras: linha grossa de nanquim por cima.
          ctx.strokeStyle = INK;
          ctx.lineCap = 'round';
          ctx.lineWidth = 0.9 + squint * 0.6;
          ctx.beginPath();
          ctx.moveTo(c.x - w - 0.4, c.y + 0.3);
          ctx.quadraticCurveTo(c.x, c.y - h * 1.5 - 0.6 * (1 - squint), c.x + w + 0.4, c.y + 0.3);
          ctx.stroke();
          ctx.lineWidth = 0.5;
          ctx.beginPath();
          ctx.moveTo(c.x - w, c.y + 0.4);
          ctx.quadraticCurveTo(c.x, c.y + h * 1.1 + 0.4, c.x + w, c.y + 0.4);
          ctx.stroke();
          // Sobrancelha.
          const bp = project(theta, lc, 44.6 + squint * 1.8, 1.03);
          ctx.lineWidth = 1.1;
          ctx.beginPath();
          ctx.moveTo(bp.x - 5 * sx, bp.y + 0.5 + (lc > 0 ? 0.6 : -0.2) * squint);
          ctx.quadraticCurveTo(bp.x, bp.y - 1.4, bp.x + 5 * sx, bp.y + 0.6 - (lc > 0 ? 0.4 : -0.5) * squint);
          ctx.stroke();
        }
      });
      // Armação: aros, ponte e hastes que contornam a cabeça.
      ctx.strokeStyle = INK;
      ctx.lineJoin = 'round';
      ctx.lineCap = 'round';
      [-0.46, 0.46].forEach((lc) => {
        const pts = lens(lc);
        for (let i = 0; i < pts.length - 1; i += 1) {
          if (pts[i].d < 0.02 || pts[i + 1].d < 0.02) continue;
          ctx.lineWidth = 1.9 * Math.max(0.5, pts[i].d) + 0.5;
          ctx.beginPath();
          ctx.moveTo(pts[i].x, pts[i].y);
          ctx.lineTo(pts[i + 1].x, pts[i + 1].y);
          ctx.stroke();
        }
        // Reflexo na lente.
        const g1 = project(theta, lc - 0.12, 47.6, 1.02);
        const g2 = project(theta, lc + 0.02, 53, 1.02);
        if (g1.d > 0.2) {
          ctx.strokeStyle = 'rgba(255,255,255,0.55)';
          ctx.lineWidth = 0.5;
          ctx.beginPath();
          ctx.moveTo(g1.x, g1.y);
          ctx.lineTo(g2.x, g2.y);
          ctx.stroke();
          ctx.strokeStyle = INK;
        }
      });
      const bl = project(theta, -0.14, 48, 1.03);
      const br = project(theta, 0.14, 48, 1.03);
      if (bl.d > 0.1) {
        ctx.lineWidth = 1.4;
        ctx.beginPath();
        ctx.moveTo(bl.x, bl.y);
        ctx.lineTo(br.x, br.y);
        ctx.stroke();
      }
      [-1, 1].forEach((side) => {
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        let started = false;
        for (let lon = 0.8; lon <= 1.55; lon += 0.05) {
          const p = project(theta, side * lon, 47.2, 1.05);
          if (p.d < -0.05) {
            started = false;
            continue;
          }
          if (!started) {
            ctx.moveTo(p.x, p.y);
            started = true;
          } else ctx.lineTo(p.x, p.y);
        }
        ctx.stroke();
      });

      // Cabelo da frente: faixa acima da linha do cabelo + cachos.
      ctx.save();
      ctx.beginPath();
      ctx.ellipse(CX, CY, RX + 0.5, RY + 0.5, 0, 0, TAU);
      ctx.clip();
      ctx.fillStyle = HAIR;
      ctx.beginPath();
      const steps = 24;
      for (let i = 0; i <= steps; i += 1) {
        const a = -Math.PI / 2 + (i / steps) * Math.PI;
        const lon = theta + a;
        const y = hairline(lon) + 1.5 * Math.sin(i * 1.7);
        const x = CX + RX * 1.02 * Math.sin(a);
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.lineTo(CX + RX + 4, -10);
      ctx.lineTo(CX - RX - 4, -10);
      ctx.closePath();
      ctx.fill();
      ctx.restore();
      front.forEach((c) => curl(c.x, c.y, c.r, c.ph, rim, sec));
    };

    const body = (theta, rim) => {
      const k = 0.62 + 0.38 * Math.abs(Math.cos(theta));
      const w = 38 * k;
      const g = ctx.createLinearGradient(CX - w, 80, CX + w, 100);
      g.addColorStop(0, '#2a3220');
      g.addColorStop(0.55, '#47552e');
      g.addColorStop(1, '#5e6e3a');
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.ellipse(CX, 104, w, 26, 0, Math.PI, TAU);
      ctx.fill();
      ctx.strokeStyle = INK;
      ctx.lineWidth = 0.6;
      ctx.stroke();
      // Gola.
      ctx.strokeStyle = '#1e2616';
      ctx.lineWidth = 1.6;
      ctx.beginPath();
      ctx.ellipse(CX, 79.5, 9 * (0.55 + 0.45 * Math.abs(Math.cos(theta))), 3.4, 0, 0, Math.PI);
      ctx.stroke();
      // Cordão branco.
      const c = Math.cos(theta);
      if (c > 0.1) {
        ctx.strokeStyle = 'rgba(245,242,232,0.95)';
        ctx.lineWidth = 0.7;
        [-1, 1].forEach((s) => {
          ctx.beginPath();
          ctx.moveTo(CX + s * 6.5 * c, 80.6);
          ctx.quadraticCurveTo(CX + s * 3.5 * c, 90, CX + s * 1.2 * c, 99);
          ctx.stroke();
        });
      }
      // Hachura de sombra, traço seco.
      ctx.strokeStyle = 'rgba(8,12,6,0.55)';
      ctx.lineWidth = 0.4;
      for (let i = 0; i < 9; i += 1) {
        const x = CX - w + 4 + i * (w / 4.2);
        ctx.beginPath();
        ctx.moveTo(x, 90 + (i % 2) * 3);
        ctx.lineTo(x - 3, 99);
        ctx.stroke();
      }
    };

    const impact = (sec) => {
      // Quadro de impacto: nanquim e linhas de velocidade, só por um instante.
      ctx.fillStyle = '#0a070c';
      ctx.fillRect(0, 0, 100, 100);
      const r = prng(Math.floor(sec * 40));
      ctx.strokeStyle = '#fdf6e8';
      for (let i = 0; i < 46; i += 1) {
        const a = r() * TAU;
        const r0 = 14 + r() * 18;
        const r1 = r0 + 18 + r() * 40;
        ctx.lineWidth = 0.4 + r() * 1.6;
        ctx.beginPath();
        ctx.moveTo(50 + r0 * Math.cos(a), 52 + r0 * Math.sin(a));
        ctx.lineTo(50 + r1 * Math.cos(a), 52 + r1 * Math.sin(a));
        ctx.stroke();
      }
      ctx.fillStyle = '#fdf6e8';
      ctx.beginPath();
      ctx.ellipse(CX, CY - 2, RX + 3, RY + 3, 0, 0, TAU);
      ctx.fill();
    };

    const render = (t) => {
      const sec = t / 1000;
      const theta = thetaAt(t);
      const night = smooth(1.4, 3.4, sec);
      const sunset = smooth(0.35, 1.9, sec);
      const rim = mixRGB(mixRGB(hex('#fff2c4'), hex('#ffb070'), sunset), hex('#b99cff'), night);
      const squint = 1 - 0.55 * smooth(3.5, 4.1, sec);
      const openness = lerp(0.1, 0.62, smooth(3.45, 4.15, sec));
      ctx.setTransform(canvas.width / SIZE, 0, 0, canvas.height / SIZE, 0, 0);
      ctx.clearRect(0, 0, SIZE, SIZE);
      if (sec > 1.78 && sec < 1.86) {
        impact(sec);
        return;
      }
      sky(t, theta);
      body(theta, rim);
      head(t, theta, rim, openness, squint);
      // Cor do ar: tinge a cena com a luz do céu e abre bloom no alto.
      ctx.globalCompositeOperation = 'soft-light';
      const tint = ctx.createLinearGradient(0, 0, 100, 100);
      tint.addColorStop(0, css(mixRGB(hex('#ffffff'), hex('#6a4fb8'), night), 0.35));
      tint.addColorStop(1, css(mixRGB(hex('#ffd9a0'), hex('#ff8f6a'), sunset), 0.5));
      ctx.fillStyle = tint;
      ctx.fillRect(0, 0, 100, 100);
      ctx.globalCompositeOperation = 'source-over';
      // Brilho do olho que abre ao fim (um "ting").
      const ting = smooth(3.9, 4.15, sec) * (1 - smooth(4.3, 4.75, sec));
      if (ting > 0.01) {
        const ex = project(thetaAt(t), 0.46, 50.4, 1).x;
        ctx.globalCompositeOperation = 'screen';
        ctx.fillStyle = 'rgba(255,240,200,' + ting + ')';
        const s = 7 * ting;
        ctx.beginPath();
        ctx.moveTo(ex + 1, 50 - s);
        ctx.lineTo(ex + 1.9, 50);
        ctx.lineTo(ex + 1, 50 + s);
        ctx.lineTo(ex + 0.1, 50);
        ctx.closePath();
        ctx.moveTo(ex - s, 50);
        ctx.lineTo(ex + 1, 50.8);
        ctx.lineTo(ex + 1 + s, 50);
        ctx.lineTo(ex + 1, 49.2);
        ctx.closePath();
        ctx.fill();
        ctx.globalCompositeOperation = 'source-over';
      }
      // Grão de filme.
      const gr = prng(Math.floor(sec * 24) + 7);
      ctx.fillStyle = 'rgba(255,255,255,0.09)';
      for (let i = 0; i < 70; i += 1) ctx.fillRect(gr() * 100, gr() * 100, 0.7, 0.7);
      ctx.fillStyle = 'rgba(0,0,0,0.07)';
      for (let i = 0; i < 70; i += 1) ctx.fillRect(gr() * 100, gr() * 100, 0.7, 0.7);
    };

    const fit = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 3);
      const size = Math.max(32, Math.round(mark.clientWidth || 56));
      canvas.width = size * dpr;
      canvas.height = size * dpr;
    };
    let raf = 0;
    let started = 0;
    const still = () => {
      cancelAnimationFrame(raf);
      raf = 0;
      render(DURATION);
    };
    const frame = (now) => {
      const t = now - started;
      if (t >= DURATION) {
        still();
        return;
      }
      render(t);
      raf = requestAnimationFrame(frame);
    };
    const play = () => {
      if (reduce.matches || document.documentElement.dataset.legacyMode === 'true') {
        still();
        return;
      }
      cancelAnimationFrame(raf);
      started = performance.now();
      raf = requestAnimationFrame(frame);
    };

    fit();
    mark._render = render;
    mark._stop = () => { cancelAnimationFrame(raf); raf = 0; };
    window.addEventListener('resize', () => {
      fit();
      if (!raf) still();
    });
    play();
    const link = mark.closest('a');
    if (link) {
      let cooling = false;
      link.addEventListener('pointerenter', () => {
        if (cooling) return;
        cooling = true;
        play();
        setTimeout(() => {
          cooling = false;
        }, DURATION + 400);
      });
    }
    window.addEventListener('portfolio:mode', () => {
      if (document.documentElement.dataset.legacyMode === 'true') still();
    });
  })();
</script>

