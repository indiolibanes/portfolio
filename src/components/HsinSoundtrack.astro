---
import '../styles/hsin-soundtrack.css';
---

<aside class="hsin-soundtrack" data-hsin-soundtrack aria-label="Trilha sonora da Hsin">
  <button
    class="hsin-soundtrack__toggle"
    type="button"
    data-soundtrack-toggle
    aria-controls="hsin-soundtrack-panel"
    aria-expanded="false"
  ><span aria-hidden="true">♫</span> Trilha sonora</button>

  <section id="hsin-soundtrack-panel" class="hsin-soundtrack__panel" aria-label="Seleção musical" hidden>
    <header class="hsin-soundtrack__heading">
      <div>
        <p class="hsin-soundtrack__eyebrow">Wuthering Waves · Hsin</p>
        <h2>Ode to Hsin and Moon</h2>
      </div>
      <button class="hsin-soundtrack__close" type="button" data-soundtrack-close aria-label="Fechar player de música">×</button>
    </header>

    <p class="hsin-soundtrack__description">
      Escolha como ouvir a gravação oficial. O vídeo só será carregado após sua escolha;
      a reprodução começa pelo controle do próprio YouTube.
    </p>

    <div class="hsin-soundtrack__choices" role="group" aria-label="Ponto de início da faixa oficial">
      <button type="button" data-soundtrack-start="66" aria-pressed="false">Refrão <small>≈ 1:06</small></button>
      <button type="button" data-soundtrack-start="0" aria-pressed="false">Faixa completa</button>
      <button type="button" data-soundtrack-silence>Silêncio</button>
    </div>

    <div class="hsin-soundtrack__player" data-soundtrack-player>
      <p class="hsin-soundtrack__placeholder" data-soundtrack-placeholder>
        Escolha «Refrão» ou «Faixa completa» para abrir o player oficial.
      </p>
    </div>
    <p class="hsin-soundtrack__state" data-soundtrack-status role="status" aria-live="polite">
      Sem reprodução automática.
    </p>

    <div class="hsin-soundtrack__links">
      <a href="https://www.youtube.com/watch?v=Yhf9ur3xPQA" target="_blank" rel="noopener noreferrer">Vídeo oficial no YouTube ↗</a>
      <a href="https://music.apple.com/us/album/ode-to-hsin-and-moon-original-game-soundtrack/6812959103" target="_blank" rel="noopener noreferrer">Álbum / instrumentais no Apple Music ↗</a>
    </div>

    <p class="hsin-soundtrack__attribution">
      © 2026 <strong>KURO GAMES</strong> · Wuthering Waves. Produção: Wuthering Waves.
      Composição: Jin Dazhou; voz: Jaime Arin; letras: SmileL e Kat Kennedy; arranjo: He Shan.
      Incorporação do vídeo publicado pelo canal oficial, sem cópia ou redistribuição do áudio.
      Portfólio independente, não afiliado à KURO GAMES.
    </p>
  </section>
</aside>

<script>
  import { mountHsinSoundtrack } from '../scripts/hsin-soundtrack';
  document.querySelectorAll<HTMLElement>('[data-hsin-soundtrack]').forEach(mountHsinSoundtrack);
</script>
