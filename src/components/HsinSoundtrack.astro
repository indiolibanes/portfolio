---
import '../styles/hsin-soundtrack.css';
---

<aside
  class="hsin-soundtrack"
  data-hsin-soundtrack
  data-soundtrack-mode="closed"
  data-soundtrack-side="right"
  aria-label="Trilha sonora oficial da Hsin"
>
  <button
    class="hsin-soundtrack__toggle"
    type="button"
    data-soundtrack-toggle
    aria-controls="hsin-soundtrack-panel"
    aria-expanded="false"
  ><span aria-hidden="true">♫</span> Trilha sonora</button>

  <section id="hsin-soundtrack-panel" class="hsin-soundtrack__panel" aria-label="Player da Hsin" hidden>
    <header class="hsin-soundtrack__heading">
      <div class="hsin-soundtrack__identity">
        <p class="hsin-soundtrack__eyebrow">Wuthering Waves · Trilha oficial</p>
        <h2>Ode to Hsin and Moon</h2>
      </div>
      <div class="hsin-soundtrack__actions" aria-label="Controles do player">
        <button type="button" data-soundtrack-side-toggle hidden
          aria-label="Mover player para a esquerda" title="Alternar lado do player">⇄</button>
        <button type="button" data-soundtrack-options-toggle hidden
          aria-controls="hsin-soundtrack-options" aria-expanded="false"
          aria-label="Mostrar opções da música" title="Opções e créditos">☷</button>
        <button class="hsin-soundtrack__close" type="button" data-soundtrack-close
          aria-label="Parar música e fechar player" title="Parar e fechar">×</button>
      </div>
    </header>

    <!-- O player nunca é ocultado, reduzido ou deslocado para fora da tela enquanto ativo. -->
    <div class="hsin-soundtrack__player" data-soundtrack-player hidden>
      <p class="hsin-soundtrack__placeholder" data-soundtrack-placeholder>Player ainda não iniciado.</p>
    </div>

    <div class="hsin-soundtrack__options" id="hsin-soundtrack-options" data-soundtrack-options>
      <p class="hsin-soundtrack__description">
        Escolha uma versão para abrir o vídeo oficial. Depois, use o Play do YouTube.
        O player ficará visível em um canto para você explorar a Hsin.
      </p>

      <div class="hsin-soundtrack__choices" role="group" aria-label="Ponto de início da faixa oficial">
        <button type="button" data-soundtrack-start="66" aria-pressed="false">Refrão <small>≈ 1:06</small></button>
        <button type="button" data-soundtrack-start="0" aria-pressed="false">Faixa completa</button>
        <button type="button" data-soundtrack-silence>Silêncio</button>
      </div>

      <div class="hsin-soundtrack__links">
        <a href="https://www.youtube.com/watch?v=Yhf9ur3xPQA" target="_blank" rel="noopener noreferrer">YouTube oficial ↗</a>
        <a href="https://music.apple.com/us/album/ode-to-hsin-and-moon-original-game-soundtrack/6812959103" target="_blank" rel="noopener noreferrer">Instrumentais no Apple Music ↗</a>
      </div>

      <p class="hsin-soundtrack__attribution">
        © 2026 <strong>KURO GAMES</strong> · Wuthering Waves. Produção: Wuthering Waves.
        Composição: Jin Dazhou; voz: Jaime Arin; letras: SmileL e Kat Kennedy; arranjo: He Shan.
        Player oficial sem cópia do áudio. Portfólio independente, não afiliado à KURO GAMES.
      </p>
    </div>

    <p class="hsin-soundtrack__state" data-soundtrack-status role="status" aria-live="polite">
      Sem reprodução automática.
    </p>
  </section>
</aside>

<script>
  import { mountHsinSoundtrack } from '../scripts/hsin-soundtrack';
  document.querySelectorAll<HTMLElement>('[data-hsin-soundtrack]').forEach(mountHsinSoundtrack);
</script>
