---
/** Avatar de Sophia ao lado da mensagem; o script do jogo troca `data-mood`. */
import PixelPaths from './PixelPaths.astro';
import { HEAD_H, HEAD_W, mascot, type Mood } from '../sophia-art';

const moods: Mood[] = ['calm', 'play', 'cheer', 'sleep'];
---

<span
  class="sophia-mascot-3d"
  data-sophia-actor="mascot"
  data-sophia-cam="head"
  data-sophia-mood="idle"
  data-sophia-reacts
  data-sophia-yaw="0.25"
  aria-hidden="true"
>
<svg
  class="sophia-px sophia-mascot"
  data-tetris-mascot
  data-mood="calm"
  viewBox={`0 0 ${HEAD_W} ${HEAD_H}`}
  shape-rendering="crispEdges"
  aria-hidden="true"
  focusable="false"
>
  {moods.map((mood) => (
    <g class={`px-frame px-frame--${mood}`}><PixelPaths px={mascot(mood)} /></g>
  ))}
</svg>
</span>
<script is:inline type="module" src="/experimental/sophia-actor.js"></script>
