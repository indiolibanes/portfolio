  .serious-node[data-state='active'] .serious-disc {
    stroke: #ffe39a;
    stroke-width: 1.4;
  }

  .serious-burst {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--side);
    height: var(--side);
    border: 2px solid var(--sun);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
    z-index: 3;
  }

  .serious-comet {
    position: absolute;
    top: calc(var(--side) / 2 - 10px);
    left: 0;
    width: 88px;
    height: 20px;
    opacity: 0;
    transform-origin: 0 50%;
    pointer-events: none;
    z-index: 4;
  }

  /* Etiqueta do modo vigente; clicar abre a legenda. */
  .serious-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 36px;
    padding: 0 0.95rem 0 0.75rem;
    border: 1px solid rgba(205, 188, 165, 0.92);
    border-radius: 999px;
    background: rgba(255, 250, 240, 0.7);
    color: var(--ink);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    cursor: pointer;
  }

  .serious-tag__dot {
    flex: 0 0 auto;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff3c4, #f2a93b 70%);
    box-shadow: 0 0 8px 1px rgba(255, 190, 80, 0.85);
  }

  .serious-control[data-portfolio-mode-current='editorial'] .serious-tag__dot {
    background: radial-gradient(circle at 35% 30%, #ffffff, #a99cf0 70%);
    box-shadow: 0 0 8px 1px rgba(170, 150, 255, 0.85);
  }

  .serious-control[data-portfolio-mode-current='legacy'] .serious-tag__dot {
    background: radial-gradient(circle at 35% 30%, #ffffff, #5fb4ff 70%);
    box-shadow: 0 0 8px 1px rgba(95, 180, 255, 0.85);
  }

  .serious-tag__text {
    display: inline-block;
    min-width: 4.4em;
    text-align: left;
  }

  .serious-tag:focus-visible,
  .serious-help:focus-visible {
    outline: 2px solid var(--sun);
    outline-offset: 3px;
  }

  /* Botão "?": a energia nasce por dentro e fica contida no círculo. */
  .serious-help {
    position: relative;
    width: 40px;
    height: 40px;
    min-height: 40px;
    padding: 0;
    overflow: hidden;
    border: 1px solid rgba(205, 188, 165, 0.92);
    border-radius: 50%;
    background: rgba(255, 250, 240, 0.76);
    color: var(--ink-soft);
    font-family: var(--font-ui);
    font-size: 0.95rem;
    font-weight: 800;
    cursor: pointer;
    touch-action: manipulation;
  }

  .serious-help__energy {
