  <button class="serious-tag" type="button" data-mode-tag aria-expanded="false" aria-controls="serious-help-panel" aria-label="Modo de leitura atual: Autoral. Abrir legenda dos modos" title="Legenda dos modos de leitura">
    <span class="serious-tag__dot" aria-hidden="true"></span>
    <span class="serious-tag__text" data-mode-tag-text>Autoral</span>
  </button>

  <div class="serious-help-panel" id="serious-help-panel" data-mode-help-panel hidden>
    <p data-help-row="authorial"><strong>α · Autoral</strong>: a versão completa, com Sophia, cor e movimento. É o padrão.</p>
    <p data-help-row="editorial"><strong>β · Editorial</strong>: sóbria, em tons de cinza, com o texto em primeiro plano.</p>
    <p data-help-row="legacy"><strong>γ · Legacy · 1998</strong>: só texto, no estilo dos sites antigos.</p>
  </div>

  <span class="sr-only" role="status" aria-live="polite" data-mode-status></span>
</div>

<script is:inline>
  (() => {
    const key = 'portfolio-mode-v2';
    const oldKey = 'portfolio-mode';
    const legacyKey = 'portfolio-serious-mode';
    // Ordem fixa dos emblemas, da esquerda para a direita: α · β · γ.
    const modes = ['authorial', 'editorial', 'legacy'];
    const names = {
      authorial: 'Autoral',
      editorial: 'Editorial',
      legacy: 'Legacy',
    };
    const themeColors = {
      authorial: '#f6efdc',
      editorial: '#ffffff',
      legacy: '#ffffff',
    };

    // Cada modo tem a sua personalidade de movimento. Tudo usa a Web Animations
    // API: o Editorial e o Legacy zeram animation e transition do CSS
    // (mono-modes.css), e este controle precisa continuar mostrando a troca.
    const profiles = {
      authorial: {
        travel: 720,
        travelEase: 'cubic-bezier(0.5, 0, 0.2, 1)',
        igniteAt: 0.7,
        ignite: 560,
        igniteEase: 'cubic-bezier(0.34, 1.56, 0.64, 1)',
        out: 360,
        outEase: 'ease-out',
        flare: true,
        tag: true,
      },
      editorial: {
        travel: 260,
        travelEase: 'cubic-bezier(0.4, 0, 0.2, 1)',
        igniteAt: 0.6,
        ignite: 220,
        igniteEase: 'cubic-bezier(0.4, 0, 0.2, 1)',
        out: 200,
        outEase: 'linear',
        flare: false,
        tag: true,
      },
      legacy: {
        travel: 360,
        travelEase: 'steps(6, end)',
        igniteAt: 0.6,
        ignite: 240,
        igniteEase: 'steps(4, end)',
        out: 240,
        outEase: 'steps(4, end)',
        flare: false,
        tag: true,
      },
    };

    const group = document.querySelector('[data-mode-group]');
    if (!group) return;
    const stage = group.querySelector('[data-mode-stage]');
    const burst = group.querySelector('[data-mode-burst]');
    const comet = group.querySelector('[data-mode-comet]');
    const status = group.querySelector('[data-mode-status]');
    const tag = group.querySelector('[data-mode-tag]');
    const tagText = group.querySelector('[data-mode-tag-text]');
    const helpPanel = group.querySelector('[data-mode-help-panel]');
    const nodes = modes.map((id) =>
      group.querySelector('[data-mode-node="' + id + '"]'),
    );
    const links = Array.from(group.querySelectorAll('[data-mode-link]'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const normalizeMode = (mode) => (modes.includes(mode) ? mode : 'authorial');
    const nodeFor = (id) => nodes[modes.indexOf(id)];
    const buttonFor = (node) => node.querySelector('[data-mode-option]');
    const px = (value) => value + 'px';
    const partsOf = (node) => Array.from(node.querySelectorAll('[data-part]'));

    let current = null;

    // Etiqueta poliglota: de tempos em tempos ela percorre rapidamente outras
    // línguas e sempre volta ao português. Um clique mostra outra língua por um
    // momento e devolve ao português.
    const LANGS = {
      authorial: [['pt', 'Autoral'], ['en', 'Authorial'], ['it', "D'autore"], ['es', 'De autor'], ['fr', "D'auteur"], ['la', 'Auctoris']],
      editorial: [['pt', 'Editorial'], ['en', 'Editorial'], ['it', 'Editoriale'], ['es', 'Editorial'], ['fr', 'Éditorial'], ['la', 'Editorialis']],
      legacy: [['pt', 'Legacy'], ['en', 'Legacy'], ['it', 'Retaggio'], ['es', 'Legado'], ['fr', 'Héritage'], ['la', 'Hereditas']],
    };
    let tagTimers = [];
    let tagClicks = 0;
    const clearTagTimers = () => {
      tagTimers.forEach(clearTimeout);
      tagTimers = [];
    };
    const paintTag = (lang, text) => {
      if (!tagText) return;
      tagText.textContent = text;
      if (lang === 'pt') tagText.removeAttribute('lang');
      else tagText.setAttribute('lang', lang);
      // O ● muda de cor junto com a língua.
      if (tag) tag.dataset.lang = lang;
    };
    const GARBLE = '▓▒░█▌▐#@%&*/<>?!01';
    const garble = (length) =>
      Array.from({ length }, () => GARBLE[(Math.random() * GARBLE.length) | 0]).join('');
    // Defeito de sinal: separação RGB, fatias deslocadas e caracteres corrompidos.
    const glitchTag = () => {
      if (!tagText || reducedMotion.matches) return;
      tagText.animate(
        [
          { transform: 'translate(0,0) skewX(0deg)', textShadow: '0 0 0 transparent', clipPath: 'inset(0 0 0 0)' },
          { transform: 'translate(-3px,1px) skewX(-14deg)', textShadow: '2px 0 #ff2a6d, -2px 0 #05d9e8', clipPath: 'inset(8% 0 55% 0)', offset: 0.2 },
          { transform: 'translate(4px,-1px) skewX(12deg)', textShadow: '-2px 0 #ff2a6d, 2px 0 #05d9e8', clipPath: 'inset(52% 0 6% 0)', offset: 0.4 },
          { transform: 'translate(-2px,0) skewX(-6deg)', textShadow: '1px 0 #ff2a6d, -1px 0 #05d9e8', clipPath: 'inset(0 0 30% 0)', offset: 0.6 },
          { transform: 'translate(1px,0) skewX(3deg)', textShadow: '-1px 0 #ff2a6d, 1px 0 #05d9e8', clipPath: 'inset(20% 0 0 0)', offset: 0.8 },
          { transform: 'translate(0,0) skewX(0deg)', textShadow: '0 0 0 transparent', clipPath: 'inset(0 0 0 0)' },
        ],
        { duration: 240, easing: 'steps(6, end)' },
      );
      tag.querySelector('.serious-tag__dot')?.animate(
        [
          { transform: 'translate(0,0) scale(1)' },
          { transform: 'translate(-2px,1px) scale(1.5)', offset: 0.3 },
          { transform: 'translate(2px,-1px) scale(0.6)', offset: 0.6 },
          { transform: 'translate(0,0) scale(1)' },
        ],
        { duration: 240, easing: 'steps(5, end)' },
      );
    };
    // Troca de língua com bug: lixo de sinal por um instante e então o texto.
    const paintGlitch = (lang, text) => {
      if (reducedMotion.matches) {
        paintTag(lang, text);
        return;
      }
      paintTag(lang, garble(text.length));
      glitchTag();
      tagTimers.push(setTimeout(() => paintTag(lang, text), 70));
    };
    const flashTag = () => {
      if (!tag || reducedMotion.matches) return;
      tag.animate(
        [
          { boxShadow: '0 0 0 0 rgba(255,200,90,0)' },
          { boxShadow: '0 0 16px 3px rgba(255,200,90,0.85)', offset: 0.35 },
          { boxShadow: '0 0 0 0 rgba(255,200,90,0)' },
        ],
        { duration: 700, easing: 'ease-out' },
      );
    };
    const homeTag = () => {
      const pt = LANGS[current || 'authorial'][0];
      paintTag(pt[0], pt[1]);
    };
    // Percorre as línguas depressa e pousa no português.
    const scrambleTag = () => {
      if (!tagText) return;
      if (reducedMotion.matches || document.hidden) {
        homeTag();
        return;
      }
      clearTagTimers();
      const list = LANGS[current || 'authorial'];
      const seq = list.slice(1).concat([list[0]]);
      seq.forEach((entry, k) => {
        tagTimers.push(setTimeout(() => paintGlitch(entry[0], entry[1]), k * 140));
      });
      flashTag();
    };
    const showOtherLanguage = () => {
      clearTagTimers();
      const list = LANGS[current || 'authorial'];
      const others = list.slice(1).filter((e, i, all) => e[1] !== list[0][1] || all.length === 1);
      const entry = others[tagClicks % others.length] || list[1];
      tagClicks += 1;
      paintGlitch(entry[0], entry[1]);
      flashTag();
      tagTimers.push(setTimeout(scrambleTag, 2400));
      if (reducedMotion.matches) {
        tagTimers.push(setTimeout(homeTag, 2400));
      }
    };
    let ambientTimer = 0;
    const scheduleTagAmbient = () => {
      clearTimeout(ambientTimer);
      ambientTimer = setTimeout(() => {
        scrambleTag();
        scheduleTagAmbient();
      }, 5200 + Math.random() * 3200);
    };

    const syncUrl = (mode) => {
      try {
        const url = new URL(window.location.href);
        url.searchParams.delete('serious');
        if (mode === 'authorial') {
          url.searchParams.delete('mode');
        } else {
          url.searchParams.set('mode', mode);
        }
        history.replaceState(
          history.state,
          '',
          url.pathname + url.search + url.hash,
        );
      } catch {}
    };

    // Estado final de cada emblema (CSS faz o resto): aceso ou apagado.
    const setState = (mode) => {
      const at = modes.indexOf(mode);
      nodes.forEach((node, i) => {
        const id = modes[i];
        const button = buttonFor(node);
        const on = id === mode;
        node.dataset.state = on ? 'active' : 'idle';
        button.setAttribute('aria-pressed', on ? 'true' : 'false');
        if (on) {
          button.setAttribute('aria-current', 'true');
          button.setAttribute('aria-label', names[id] + ', modo atual');
          button.title = 'Modo atual: ' + names[id];
        } else {
          button.removeAttribute('aria-current');
          button.setAttribute('aria-label', 'Mudar para ' + names[id]);
          button.title = 'Mudar para ' + names[id];
        }
      });
      links.forEach((link, i) => {
        link.dataset.lit = i === at || i + 1 === at ? 'true' : 'false';
      });
      stage.style.setProperty('--i', String(at));
      clearTagTimers();
      if (tagText) paintTag('pt', names[mode]);
      if (tag) {
        tag.setAttribute(
          'aria-label',
          'Modo de leitura atual: ' + names[mode] + '. Abrir legenda dos modos',
        );
      }
      group.querySelectorAll('[data-help-row]').forEach((row) => {
        row.dataset.current = row.dataset.helpRow === mode ? 'true' : 'false';
      });
      group.dataset.portfolioModeCurrent = mode;
      group.setAttribute('aria-label', 'Modo de leitura: ' + names[mode]);
    };

    const read = (el) => {
      const s = getComputedStyle(el);
      return { opacity: s.opacity, transform: s.transform, filter: s.filter };
    };

    // Fotografia do que está aceso/apagado agora, antes da troca.
    const snapshot = () => ({
      parts: nodes.map((node) => partsOf(node).map(read)),
      links: links.map((l) => ({ opacity: getComputedStyle(l).opacity })),
      centers: nodes.map((n) => n.offsetLeft + n.offsetWidth / 2),
    });

    // Vida contínua: cada letra tem a sua assinatura. Tudo em WAAPI, para seguir
    // viva nos modos planos (mono-modes.css zera animation do CSS).
    const rnd = (lo, hi) => lo + Math.random() * (hi - lo);
    const loopsOf = {
      authorial: (q, all) => {
        const out = [];
        // Imprevisível: cada camada segue uma sequência irregular de valores.
        const walk = (n, make) => Array.from({ length: n }, make);
        out.push(
          // Anel: gira aos arrancos, com velocidades desiguais.
          q('.serious-ring__spin')?.animate(
            [0, 140, 175, 420, 470, 640, 720].map((d) => ({ transform: 'rotate(' + d + 'deg)' })),
            { duration: 2600, iterations: Infinity },
          ),
          q('.serious-rays__spin')?.animate(
            [0, 70, 30, 190, 160, 300, 360].map((d) => ({ transform: 'rotate(' + -d + 'deg)' })),
            { duration: 4400, iterations: Infinity },
          ),
          q('.serious-halo__pulse')?.animate(
            walk(8, (_, i) => ({
              transform: 'translate(' + rnd(-2.5, 2.5) + 'px,' + rnd(-2.5, 2.5) + 'px) scale(' + rnd(0.82, 1.24) + ')',
              opacity: rnd(0.65, 1),
              filter: 'hue-rotate(' + i * rnd(40, 70) + 'deg) brightness(' + rnd(1, 1.35) + ')',
            })),
            { duration: 2600, iterations: Infinity, easing: 'ease-in-out' },
          ),
          q('.serious-flare__pulse')?.animate(
            walk(7, () => ({ transform: 'scaleX(' + rnd(0.3, 1.25) + ')', opacity: rnd(0.35, 1), filter: 'hue-rotate(' + rnd(0, 120) + 'deg)' })),
            { duration: 2100, iterations: Infinity, easing: 'ease-in-out' },
          ),
          q('.serious-flare2__pulse')?.animate(
            walk(6, () => ({ transform: 'scale(' + rnd(0.4, 1.2) + ')', opacity: rnd(0, 1) })),
            { duration: 1700, iterations: Infinity, easing: 'ease-in-out' },
          ),
        );
        all('.serious-ray').forEach((el) => {
          out.push(
            el.animate(
              walk(5, () => ({ transform: 'scale(' + rnd(0.55, 1.3) + ')', opacity: rnd(0.2, 1) })),
              { duration: rnd(500, 1700), delay: -rnd(0, 1200), iterations: Infinity, easing: 'ease-in-out' },
            ),
          );
        });
        // Faíscas: nascem em lugares e instantes aleatórios.
        const sparks = all('.serious-spark');
        let timer = 0;
        const fire = () => {
          const spark = sparks[(Math.random() * sparks.length) | 0];
          if (spark) {
            const ang = Math.random() * Math.PI * 2;
            const rad = rnd(24, 50);
            spark.parentNode.setAttribute('transform', 'translate(' + (32 + rad * Math.cos(ang)) + ' ' + (32 + rad * Math.sin(ang)) + ')');
            spark.animate(
              [
                { opacity: 0, transform: 'scale(0.2) rotate(0deg)' },
                { opacity: 1, transform: 'scale(' + rnd(1.2, 2.4) + ') rotate(45deg)', offset: 0.3 },
                { opacity: 0, transform: 'scale(0.3) rotate(90deg)' },
              ],
              { duration: rnd(320, 900), easing: 'ease-out' },
            );
          }
          timer = setTimeout(fire, rnd(90, 380));
        };
        fire();
        out.push({ cancel: () => clearTimeout(timer) });
        return out;
      },
      editorial: (q) => {
        const walk = (n, make) => Array.from({ length: n }, make);
        const out = [
          // Estrela de nêutrons: giro furioso, com picos e freadas irregulares.
          q('.serious-beams__spin')?.animate(
            [0, 120, 150, 330, 400, 560, 600, 720].map((d) => ({ transform: 'rotate(' + d + 'deg)' })),
            { duration: 190, iterations: Infinity },
          ),
          // Segundo par de jatos gira ao contrário, em outro ritmo.
          q('.serious-beams2__spin')?.animate(
            [0, 200, 250, 430, 700, 1080].map((d) => ({ transform: 'rotate(' + -d + 'deg)' })),
            { duration: 330, iterations: Infinity },
          ),
          // O eixo oscila e se alonga de forma caótica.
          q('.serious-beams__tilt')?.animate(
            walk(9, () => ({ transform: 'rotate(' + rnd(-24, 24) + 'deg) scale(' + rnd(0.8, 1.3) + ')', opacity: rnd(0.6, 1) })),
            { duration: 620, iterations: Infinity, easing: 'ease-in-out' },
          ),
          q('.serious-shock__ring')?.animate(
            [
              { transform: 'scale(0.6)', opacity: 0.9 },
              { transform: 'scale(1.7)', opacity: 0 },
            ],
            { duration: 380, iterations: Infinity, easing: 'cubic-bezier(0.1, 0.7, 0.3, 1)' },
          ),
          q('.serious-halo__pulse')?.animate(
            walk(8, () => ({ transform: 'scale(' + rnd(0.8, 1.2) + ')', opacity: rnd(0.55, 1) })),
            { duration: 420, iterations: Infinity, easing: 'ease-in-out' },
          ),
          // Espaguetificação: a letra estica, treme e se desfaz em fios.
          q('.serious-glyph')?.animate(
            walk(8, () => ({ transform: 'scale(' + rnd(0.82, 1.05) + ',' + rnd(0.95, 1.3) + ') skewX(' + rnd(-6, 6) + 'deg)' })),
            { duration: 480, iterations: Infinity, easing: 'ease-in-out' },
          ),
        ];
        const ghosts = [
          [{ transform: 'scale(1, 1)', opacity: 0 }, { transform: 'scale(0.5, 2.1)', opacity: 0.9, offset: 0.5 }, { transform: 'scale(0.15, 3.2)', opacity: 0 }],
          [{ transform: 'scale(1, 1)', opacity: 0 }, { transform: 'scale(1.35, 0.35)', opacity: 0.8, offset: 0.5 }, { transform: 'scale(1.9, 0.08)', opacity: 0 }],
        ];
        ['1', '2'].forEach((n, k) => {
          out.push(
            q('.serious-ghost--' + n)?.animate(ghosts[k], {
              duration: 420,
              delay: k * 210,
              iterations: Infinity,
              easing: 'ease-in',
            }),
          );
        });
        return out;
      },
      legacy: (q, all) => {
        // Quasar: jatos grossos na diagonal, caóticos e furiosos; grumos de raios
        // gama disparam pelos dois lados e um clarão explode sem avisar.
        const walk = (n, make) => Array.from({ length: n }, make);
        const out = [
          q('.serious-jets__tilt')?.animate(
            walk(9, () => ({ transform: 'rotate(' + (32 + rnd(-11, 11)) + 'deg)' })),
            { duration: 1100, iterations: Infinity, easing: 'ease-in-out' },
          ),
          q('.serious-jets__pulse')?.animate(
            walk(10, () => ({ transform: 'scaleY(' + rnd(0.5, 1.25) + ') scaleX(' + rnd(0.8, 1.5) + ')', opacity: rnd(0.65, 1) })),
            { duration: 460, iterations: Infinity, easing: 'ease-in-out' },
          ),
          q('.serious-jets2__pulse')?.animate(
            walk(10, () => ({ transform: 'rotate(' + rnd(-16, 16) + 'deg) scaleY(' + rnd(0.4, 1.2) + ')', opacity: rnd(0.3, 1) })),
            { duration: 700, iterations: Infinity, easing: 'ease-in-out' },
          ),
          q('.serious-halo__pulse')?.animate(
            walk(8, () => ({ transform: 'scale(' + rnd(0.8, 1.3) + ')', opacity: rnd(0.55, 1) })),
            { duration: 520, iterations: Infinity, easing: 'ease-in-out' },
          ),
          q('.serious-accretion__ring')?.animate(
            walk(7, () => ({ transform: 'scaleX(' + rnd(0.7, 1.12) + ') scaleY(' + rnd(0.7, 1.6) + ')', opacity: rnd(0.4, 1) })),
            { duration: 640, iterations: Infinity, easing: 'ease-in-out' },
          ),
          q('.serious-gamma__flash')?.animate(
            [
              { transform: 'scale(0.1, 0.2)', opacity: 0 },
              { transform: 'scale(1.3, 1.1)', opacity: 1, offset: 0.14 },
              { transform: 'scale(0.9, 1.2)', opacity: 0.4, offset: 0.4 },
              { transform: 'scale(0.4, 1.3)', opacity: 0 },
            ],
            { duration: 1000, iterations: Infinity, easing: 'cubic-bezier(0.1, 0.8, 0.2, 1)' },
          ),
        ];
        all('.serious-jet__flow').forEach((el) => {
          out.push(
            el.animate([{ strokeDashoffset: 0 }, { strokeDashoffset: -24 }], {
              duration: 180,
              iterations: Infinity,
            }),
          );
        });
        // Grumos de gama: nascem no núcleo e disparam até a ponta, cada um no seu ritmo.
        all('.serious-gamma__blob').forEach((el, k) => {
          const dir = el.getAttribute('class').includes('--d') ? 1 : -1;
          const reach = rnd(46, 66) * dir;
          out.push(
            el.animate(
              [
                { transform: 'translate(0,0) scale(0.3)', opacity: 0 },
                { transform: 'translate(' + rnd(-4, 4) + 'px,' + reach * 0.3 + 'px) scale(' + rnd(1.2, 2) + ')', opacity: 1, offset: 0.2 },
                { transform: 'translate(' + rnd(-6, 6) + 'px,' + reach + 'px) scale(0.4)', opacity: 0 },
              ],
              { duration: rnd(380, 720), delay: -rnd(0, 700) + k * 40, iterations: Infinity, easing: 'cubic-bezier(0.3, 0, 0.7, 1)' },
            ),
          );
        });
        return out;
      },
    };
    const loops = new Map();
    const stopLoops = (node) => {
      (loops.get(node) || []).forEach((a) => a.cancel());
      loops.delete(node);
    };
    const startLoops = (node, mode) => {
      if (loops.has(node) || reducedMotion.matches) return;
      const q = (sel) => node.querySelector(sel);
      const all = (sel) => Array.from(node.querySelectorAll(sel));
      loops.set(node, loopsOf[mode](q, all).filter(Boolean));
    };
    const syncLoops = (mode, stopDelay) => {
      nodes.forEach((node, i) => {
        if (modes[i] === mode) {
          startLoops(node, mode);
        } else if (loops.has(node)) {
          if (stopDelay) setTimeout(() => modes[i] !== current && stopLoops(node), stopDelay);
          else stopLoops(node);
        }
      });
    };

    // Linha viva entre os emblemas, em chave de teoria das cordas: uma corda presa nas
    // extremidades vibra em três harmônicos (ondas estacionárias), e a corda "b" vibra em
    // quadratura com a "a". Um laço fechado (corda fechada) desliza ao longo dela na direção do
    // modo vigente. Só o relógio de cada trecho avança; a forma é recalculada a cada quadro, então
    // funciona também em Editorial e Legacy (sem CSS). Movimento reduzido: um quadro estático.
    const STRING_MODES = [
      { n: 1, amp: 4.4, w: 2.1 },
      { n: 2, amp: 2.3, w: 3.7 },
      { n: 3, amp: 1.1, w: 5.6 },
    ];
    const SAMPLES = 48;
    const strandD = (clock, phase, quad) => {
      let d = '';
      for (let i = 0; i <= SAMPLES; i += 1) {
        const x = (i / SAMPLES) * 100;
        let y = 0;
        STRING_MODES.forEach((m, k) => {
          y += m.amp * Math.sin((m.n * Math.PI * x) / 100) * Math.cos(m.w * clock + phase * (k + 1) + quad);
        });
        d += (i ? ' L' : 'M') + x.toFixed(2) + ' ' + (8 + y * 0.9).toFixed(2);
      }
      return d;
    };
    const RADIUS_PX = 3.4;
    const loopD = (s, width) => {
      const cx = ((((s.clock * 0.07) + s.phase) % 1) + 1) % 1 * 100;
      const cy = 8 + 2.2 * Math.sin(s.clock * 1.3 + s.phase);
      const rx = RADIUS_PX / Math.max(1, width / 100);
      const ry = RADIUS_PX;
      return `M${(cx - rx).toFixed(2)} ${cy.toFixed(2)} A${rx.toFixed(2)} ${ry} 0 1 0 ${(cx + rx).toFixed(2)} ${cy.toFixed(2)} A${rx.toFixed(2)} ${ry} 0 1 0 ${(cx - rx).toFixed(2)} ${cy.toFixed(2)}`;
    };
    const strings = links.map((link, i) => ({
      link,
      a: link.querySelector('[data-flow="a"]'),
      b: link.querySelector('[data-flow="b"]'),
      loop: link.querySelector('[data-loop]'),
      clock: 0.4 * i,
      rate: 0.35,
      dir: 1,
      phase: 0.7 + i * 1.9,
    }));
    const drawStrings = (dt) => {
      strings.forEach((s) => {
        s.clock += dt * s.rate * s.dir;
        if (s.a) s.a.setAttribute('d', strandD(s.clock, s.phase, 0));
        if (s.b) s.b.setAttribute('d', strandD(s.clock, s.phase + 0.9, Math.PI / 2));
        if (s.loop) s.loop.setAttribute('d', loopD(s, s.link.getBoundingClientRect().width));
      });
    };
    let stringRaf = 0;
    let stringLast = 0;
    const stringFrame = (now) => {
      const dt = Math.min(0.05, Math.max(0, (now - stringLast) / 1000));
      stringLast = now;
      drawStrings(dt);
      stringRaf = requestAnimationFrame(stringFrame);
    };
    const startStrings = () => {
      if (reducedMotion.matches || stringRaf) return;
      stringLast = performance.now();
      stringRaf = requestAnimationFrame(stringFrame);
    };
    const stopStrings = () => {
      if (stringRaf) cancelAnimationFrame(stringRaf);
      stringRaf = 0;
    };
    // Vigente à esquerda do trecho: a energia corre para a direita; senão, para a esquerda.
    const syncLinks = (at) => {
      strings.forEach((s, i) => {
        s.dir = at <= i ? 1 : -1;
        s.rate = i === at || i + 1 === at ? 1.4 : 0.35;
      });
      if (reducedMotion.matches) {
        drawStrings(0);
        return;
      }
      startStrings();
    };
    drawStrings(0);
    reducedMotion.addEventListener?.('change', () => {
      stopStrings();
      if (reducedMotion.matches) drawStrings(0);
      else startStrings();
    });

    let running = [];
    let runId = 0;
    let unlockTimer = 0;

    const unlockPointer = () => {
      clearTimeout(unlockTimer);
      delete stage.dataset.animating;
    };

    // Termina qualquer troca em curso: o estado final já está no CSS.
    const settle = () => {
      running.forEach((animation) => {
        try {
          animation.finish();
        } catch {}
      });
      running = [];
      unlockPointer();
    };

    const differs = (a, b) =>
      a.opacity !== b.opacity || a.transform !== b.transform || a.filter !== b.filter;

    const morph = (el, from, to, options, mid) => {
      if (!differs(from, to)) return;
      const frames = mid ? [from, mid, to] : [from, to];
      running.push(el.animate(frames, { fill: 'backwards', ...options }));
    };

    // Troca de ênfase: o cometa corre pelo trilho, quem estava aceso apaga na
    // saída, quem foi escolhido acende na chegada e o losango acompanha.
    const play = (before, prev, mode) => {
      const p = profiles[mode];
      const id = ++runId;
      const fromAt = modes.indexOf(prev);
      const toAt = modes.indexOf(mode);
      const delay = p.travel * p.igniteAt;
      stage.dataset.animating = 'true';
      unlockTimer = setTimeout(unlockPointer, p.travel * 0.8);

      nodes.forEach((node, i) => {
        const els = partsOf(node);
        const isOld = i === fromAt;
        const isNew = i === toAt;
        els.forEach((el, k) => {
          const from = before.parts[i][k];
          const to = read(el);
          if (isNew) {
            const mid =
              p.flare && el.dataset.part === 'art'
                ? { ...to, transform: 'scale(1.3)', opacity: '1' }
                : null;
            morph(el, from, to, { duration: p.ignite, delay, easing: p.igniteEase }, mid);
          } else if (isOld) {
            morph(el, from, to, { duration: p.out, easing: p.outEase });
          }
        });
      });

      links.forEach((link, i) => {
        const to = { opacity: getComputedStyle(link).opacity };
        if (to.opacity === before.links[i].opacity) return;
        const lighting = Number(to.opacity) > Number(before.links[i].opacity);
        running.push(
          link.animate([before.links[i], to], {
            duration: lighting ? p.travel * 0.5 : p.out,
            delay: lighting ? p.travel * 0.25 : 0,
            easing: p.outEase,
            fill: 'backwards',
          }),
        );
      });

      if (tagText && p.tag) {
        running.push(
          tagText.animate(
            [
              { opacity: 0, transform: 'translateY(6px)', letterSpacing: '0.2em' },
              { opacity: 1, transform: 'translateY(0)', letterSpacing: '0' },
            ],
            { duration: p.ignite, delay: delay * 0.6, easing: p.igniteEase, fill: 'backwards' },
          ),
        );
      }

      if (comet) {
        const dir = toAt > fromAt ? 1 : -1;
        const head = 80;
        const x = (center) => (dir > 0 ? center - head : center + head);
        const a = x(before.centers[fromAt]);
        const b = x(before.centers[toAt]);
        const flip = dir > 0 ? 'scaleX(1)' : 'scaleX(-1)';
        running.push(
          comet.animate(
            [
              { transform: 'translateX(' + px(a) + ') ' + flip, opacity: 0 },
              { transform: 'translateX(' + px(a + (b - a) * 0.12) + ') ' + flip, opacity: 1, offset: 0.12 },
              { transform: 'translateX(' + px(a + (b - a) * 0.88) + ') ' + flip, opacity: 1, offset: 0.88 },
              { transform: 'translateX(' + px(b) + ') ' + flip, opacity: 0 },
            ],
            { duration: p.travel, easing: p.travelEase },
          ),
        );
      }

      if (p.flare && burst) {
        const target = nodes[toAt];
        burst.style.left = px(target.offsetLeft);
        running.push(
          burst.animate(
            [
              { opacity: 0, transform: 'scale(0.8)' },
              { opacity: 0.9, transform: 'scale(0.9)', offset: 0.01 },
              { opacity: 0, transform: 'scale(2.1)' },
            ],
            { duration: p.ignite + 160, delay, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'backwards' },
          ),
        );
      }

      Promise.all(running.map((a) => a.finished.catch(() => {}))).then(() => {
        if (id !== runId) return;
        running = [];
        unlockPointer();
      });
    };

    const applyMode = (
      requestedMode,
      { persist = true, updateUrl = true, animate = false, announce = false } = {},
    ) => {
      const mode = normalizeMode(requestedMode);
      const prev = current;

      document.documentElement.dataset.portfolioMode = mode;
      document.documentElement.dataset.seriousMode =
        mode === 'editorial' ? 'true' : 'false';
      document.documentElement.dataset.legacyMode =
        mode === 'legacy' ? 'true' : 'false';

      settle();
      const shouldPlay = animate && prev && prev !== mode && !reducedMotion.matches;
      const before = shouldPlay ? snapshot() : null;
      setState(mode);
      current = mode;
      syncLoops(mode, before ? profiles[mode].out : 0);
      syncLinks(modes.indexOf(mode));
      if (before) play(before, prev, mode);

      const themeColor = document.querySelector('meta[name="theme-color"]');
      if (themeColor) themeColor.setAttribute('content', themeColors[mode]);

      if (persist) {
        try {
          localStorage.setItem(key, mode);
          localStorage.removeItem(oldKey);
          localStorage.removeItem(legacyKey);
        } catch {}
      }

      if (updateUrl) syncUrl(mode);
      if (announce && status) status.textContent = 'Modo de leitura: ' + names[mode];

      window.dispatchEvent(new CustomEvent('portfolio:mode', { detail: { mode } }));
      window.dispatchEvent(
        new CustomEvent('portfolio:serious-mode', { detail: { enabled: mode === 'editorial' } }),
      );
    };

    const initialMode =
      document.documentElement.dataset.portfolioMode ||
      (document.documentElement.dataset.seriousMode === 'true'
        ? 'editorial'
        : document.documentElement.dataset.legacyMode === 'true'
          ? 'legacy'
          : 'authorial');

    applyMode(initialMode, { persist: false, updateUrl: false });
    if (!reducedMotion.matches) scheduleTagAmbient();
    if (!reducedMotion.matches && tag) {
      // A etiqueta respira em ouro, sempre.
      tag.animate(
        [
          { boxShadow: '0 0 4px 0 rgba(255,200,90,0.25)' },
          { boxShadow: '0 0 14px 2px rgba(255,200,90,0.7)' },
          { boxShadow: '0 0 4px 0 rgba(255,200,90,0.25)' },
        ],
        { duration: 2600, iterations: Infinity, easing: 'ease-in-out' },
      );
      tag.querySelector('.serious-tag__dot')?.animate(
        [{ transform: 'scale(1)' }, { transform: 'scale(1.35)' }, { transform: 'scale(1)' }],
        { duration: 1300, iterations: Infinity, easing: 'ease-in-out' },
      );
    }

    if (helpPanel) {
      // O painel nasce alinhado à direita do controle; se isso o empurrar para
      // fora da janela (telas estreitas), desloca-o de volta para dentro.
      const keepPanelInView = () => {
        helpPanel.style.right = '0px';
        const rect = helpPanel.getBoundingClientRect();
        const margin = 8;
        const viewport = document.documentElement.clientWidth;
        if (rect.left < margin) {
          helpPanel.style.right = px(rect.left - margin);
        } else if (rect.right > viewport - margin) {
          helpPanel.style.right = px(rect.right - (viewport - margin));
        }
      };
      const setHelp = (open) => {
        helpPanel.hidden = !open;
        if (tag) tag.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (open) keepPanelInView();
      };
      if (tag) {
        tag.addEventListener('click', () => {
          setHelp(helpPanel.hidden);
          showOtherLanguage();
        });
      }
      window.addEventListener('resize', () => {
        if (!helpPanel.hidden) keepPanelInView();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setHelp(false);
      });
      document.addEventListener('pointerdown', (event) => {
        if (!helpPanel.hidden && !group.contains(event.target)) setHelp(false);
      });
    }

    nodes.forEach((node, i) => {
      const button = buttonFor(node);
      button.addEventListener('click', () => {
        const id = modes[i];
        if (id === current) return;
        applyMode(id, { animate: true, announce: true });
      });
      // Setas movem o foco entre os emblemas sem trocar o modo.
      button.addEventListener('keydown', (event) => {
        const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        const next = nodes[i + step];
        if (next) {
          event.preventDefault();
          buttonFor(next).focus();
        }
      });
    });
  })();
</script>

<style>
  .serious-control {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .serious-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  /* Trilha fixa de três emblemas: α · β · γ, sempre nesta ordem. A margem à
     esquerda dá espaço ao clarão do alfa, que se projeta para fora. */
  .serious-stage {
    --side: 56px;
    --pitch: 116px;
    position: relative;
    flex: 0 0 auto;
    width: calc(var(--pitch) * 2 + var(--side));
    height: var(--side);
    margin-left: 28px;
  }

  .serious-node {
    position: absolute;
    top: 0;
    z-index: 2;
    width: var(--side);
    height: var(--side);
  }

  .serious-node[data-mode-node='authorial'] { left: 0; }
  .serious-node[data-mode-node='editorial'] { left: var(--pitch); }
  .serious-node[data-mode-node='legacy'] { left: calc(var(--pitch) * 2); }

  .serious-stage[data-animating] .serious-emblem {
    pointer-events: none;
  }

  /* Linha viva entre os emblemas: duas ondas trançadas que correm pelo trilho. */
  .serious-link {
    position: absolute;
    top: calc(var(--side) / 2 - 8px);
    width: calc(var(--pitch) - var(--side) - 8px);
    height: 16px;
    z-index: 1;
    pointer-events: none;
    opacity: 0.42;
  }

  .serious-link[data-mode-link='0'] { left: calc(var(--side) + 4px); }
  .serious-link[data-mode-link='1'] { left: calc(var(--pitch) + var(--side) + 4px); }

  .serious-link[data-lit='true'] {
    opacity: 1;
    filter: drop-shadow(0 0 3px rgba(255, 200, 90, 0.9));
  }

  .serious-link svg {
    display: block;
    overflow: visible;
  }

  .serious-link path {
    fill: none;
    vector-effect: non-scaling-stroke;
