<div class="serious-control">
  <button
    class="serious-toggle"
    type="button"
    data-serious-toggle
    aria-pressed="false"
    aria-label="Ativar Modo sério"
    title="Modo sério"
  >
    <svg
      class="serious-icon"
      viewBox="0 0 24 24"
      width="18"
      height="18"
      aria-hidden="true"
    >
      <path
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M7 3.75h7.2L18 7.55v12.7H7z M14 3.75v4h4 M9.5 11h6 M9.5 14h6 M9.5 17h4"
      ></path>
    </svg>

    <span data-serious-label>
      Modo sério
    </span>
  </button>
</div>

<script is:inline>
  (() => {
    const key = 'portfolio-serious-mode';
    const button = document.querySelector('[data-serious-toggle]');
    const label = document.querySelector('[data-serious-label]');

    if (!button) return;

    const syncUrl = (enabled) => {
      try {
        const url = new URL(window.location.href);

        if (enabled) {
          url.searchParams.set('serious', '1');
        } else {
          url.searchParams.delete('serious');
        }

        history.replaceState(
          history.state,
          '',
          url.pathname + url.search + url.hash,
        );
      } catch {}
    };

    const applyMode = (
      enabled,
      persist = true,
      updateUrl = true,
    ) => {
      document.documentElement.dataset.seriousMode =
        enabled ? 'true' : 'false';

      button.setAttribute(
        'aria-pressed',
        String(enabled),
      );

      button.setAttribute(
        'aria-label',
        enabled
          ? 'Voltar ao modo autoral'
          : 'Ativar Modo sério',
      );

      button.setAttribute(
        'title',
        enabled
          ? 'Voltar ao modo autoral'
          : 'Modo sério',
      );

      if (label) {
        label.textContent =
          enabled
            ? 'Modo autoral'
            : 'Modo sério';
      }

      const themeColor =
        document.querySelector(
          'meta[name="theme-color"]',
        );

      if (themeColor) {
        themeColor.setAttribute(
          'content',
          enabled
            ? '#f5f5f3'
            : '#f6efdc',
        );
      }

      if (persist) {
        try {
          localStorage.setItem(
            key,
            String(enabled),
          );
        } catch {}
      }

      if (updateUrl) {
        syncUrl(enabled);
      }

      window.dispatchEvent(
        new CustomEvent(
          'portfolio:serious-mode',
          { detail: { enabled } },
        ),
      );
    };

    const enabled =
      document.documentElement.dataset
        .seriousMode === 'true';

    applyMode(enabled, false, false);

    button.addEventListener('click', () => {
      const current =
        document.documentElement.dataset
          .seriousMode === 'true';

      applyMode(!current);
    });
  })();
</script>

<style>
  .serious-control {
    display: flex;
    align-items: center;
  }

  .serious-toggle {
    min-height: 42px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 0.42rem;

    padding:
      0.55rem 0.78rem;

    border:
      1px solid
      rgba(205, 188, 165, 0.92);

    border-radius:
      var(--radius-full);

    background:
      rgba(255, 250, 240, 0.76);

    color:
      var(--ink-soft);

    box-shadow:
      0 3px 12px
      rgba(94, 72, 49, 0.07);

    cursor: pointer;

    font-family:
      var(--font-ui);

    font-size: 0.78rem;
    font-weight: 800;

    white-space: nowrap;

    transition:
      transform 160ms ease,
      background-color 160ms ease,
      color 160ms ease,
      border-color 160ms ease,
      border-radius 160ms ease;
  }

  .serious-toggle:hover {
    transform:
      translateY(-1px);

    background:
      var(--surface-soft);

    color:
      var(--ink);
  }

  .serious-icon {
    flex: 0 0 auto;
  }

  :global(html[data-serious-mode='true'])
  .serious-toggle {
    border-color:
      #000000;

    border-radius:
      2px;

    background:
      #ffffff;

    color:
      #000000;

    box-shadow:
      none;
  }

  :global(html[data-serious-mode='true'])
  .serious-toggle:hover {
    background:
      #eeeeee;
  }

  @media (max-width: 720px) {
    .serious-toggle {
      min-height: 40px;

      padding:
        0.48rem 0.64rem;

      font-size: 0.72rem;
    }
  }
</style>
