<div
  class="serious-control"
  role="group"
  aria-label="Modo de leitura"
  data-mode-group
>
  <div class="serious-stage" data-mode-stage>
    <span class="serious-node" data-mode-node="editorial" data-slot="left">
      <span class="serious-identifier" data-node-ident aria-hidden="true">
        <svg viewBox="0 0 24 24" width="100%" height="100%" aria-hidden="true"><path fill="currentColor" d="M12 0C12.6 7.4 16.6 11.4 24 12C16.6 12.6 12.6 16.6 12 24C11.4 16.6 7.4 12.6 0 12C7.4 11.4 11.4 7.4 12 0Z"></path></svg>
      </span>
      <button class="serious-emblem" type="button" data-mode-option="editorial" aria-label="Mudar para Editorial" title="Mudar para Editorial">
        <span class="serious-ring" data-node-ring aria-hidden="true"></span>
        <span class="serious-disc" data-node-disc aria-hidden="true">
          <svg class="serious-glyph" viewBox="0 0 24 24" width="22" height="22"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M7 3.75h7.2L18 7.55v12.7H7z M14 3.75v4h4 M9.5 11h6 M9.5 14h6 M9.5 17h4"></path></svg>
        </span>
      </button>
    </span>

    <span class="serious-node" data-mode-node="authorial" data-slot="center">
      <span class="serious-identifier" data-node-ident aria-hidden="true">
        <svg viewBox="0 0 24 24" width="100%" height="100%" aria-hidden="true"><path fill="currentColor" d="M12 0C12.6 7.4 16.6 11.4 24 12C16.6 12.6 12.6 16.6 12 24C11.4 16.6 7.4 12.6 0 12C7.4 11.4 11.4 7.4 12 0Z"></path></svg>
      </span>
      <button class="serious-emblem" type="button" data-mode-option="authorial" aria-current="true" aria-disabled="true" tabindex="-1" aria-label="Autoral, modo atual" title="Modo atual: Autoral">
        <span class="serious-ring" data-node-ring aria-hidden="true"></span>
        <span class="serious-disc" data-node-disc aria-hidden="true">
          <svg class="serious-glyph" viewBox="0 0 24 24" width="22" height="22"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M4 20C7 16 11 11 17 5c1.5-1.5 3.5-1.5 3.5-1.5S20.5 5.5 19 7c-6 6-11 10-15 13z M9 15l2-2"></path></svg>
        </span>
      </button>
    </span>

    <span class="serious-node" data-mode-node="legacy" data-slot="right">
      <span class="serious-identifier" data-node-ident aria-hidden="true">
        <svg viewBox="0 0 24 24" width="100%" height="100%" aria-hidden="true"><path fill="currentColor" d="M12 0C12.6 7.4 16.6 11.4 24 12C16.6 12.6 12.6 16.6 12 24C11.4 16.6 7.4 12.6 0 12C7.4 11.4 11.4 7.4 12 0Z"></path></svg>
      </span>
      <button class="serious-emblem" type="button" data-mode-option="legacy" aria-label="Mudar para Legacy · 1998" title="Mudar para Legacy · 1998">
        <span class="serious-ring" data-node-ring aria-hidden="true"></span>
        <span class="serious-disc" data-node-disc aria-hidden="true">
          <svg class="serious-glyph" viewBox="0 0 24 24" width="22" height="22"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" d="M3.5 4.5h17v15h-17z M3.5 8.5h17 M6.5 6.5h.01"></path></svg>
        </span>
      </button>
    </span>

    <span class="serious-burst" aria-hidden="true" data-mode-burst></span>
  </div>

  <button class="serious-help" type="button" data-mode-help aria-expanded="false" aria-controls="serious-help-panel" aria-label="Sobre os modos de leitura" title="Sobre os modos de leitura">?</button>
  <div class="serious-help-panel" id="serious-help-panel" data-mode-help-panel hidden>
    <p><strong>Autoral</strong>: a versão completa, com Sophia, cor e movimento. É o padrão.</p>
    <p><strong>Editorial</strong>: sóbria, em tons de cinza, com o texto em primeiro plano.</p>
    <p><strong>Legacy · 1998</strong>: só texto, no estilo dos sites antigos.</p>
  </div>

  <span class="sr-only" role="status" aria-live="polite" data-mode-status></span>
</div>

<script is:inline>
  (() => {
    const key = 'portfolio-mode-v2';
    const oldKey = 'portfolio-mode';
    const legacyKey = 'portfolio-serious-mode';
    // Ordem de ciclo: cada modo "vem depois" do anterior.
    const modes = ['authorial', 'editorial', 'legacy'];
    const names = {
      authorial: 'Autoral',
      editorial: 'Editorial',
      legacy: 'Legacy · 1998',
    };
    const themeColors = {
      authorial: '#f6efdc',
      editorial: '#ffffff',
      legacy: '#ffffff',
    };

    // Cada modo tem a sua personalidade de movimento. As animações usam a Web
    // Animations API: o Editorial e o Legacy zeram animation e transition do CSS
    // (mono-modes.css), e este controle precisa continuar mostrando a mudança.
    const profiles = {
      authorial: {
        duration: 680,
        easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
        spring: 'cubic-bezier(0.34, 1.56, 0.64, 1)',
        fade: 'ease-out',
        depth: true,
        burst: true,
      },
      editorial: {
        duration: 300,
        easing: 'cubic-bezier(0.4, 0, 0.2, 1)',
        spring: 'cubic-bezier(0.4, 0, 0.2, 1)',
        fade: 'linear',
        depth: false,
        burst: false,
      },
      legacy: {
        duration: 360,
        easing: 'steps(6, end)',
        spring: 'steps(6, end)',
        fade: 'steps(6, end)',
        depth: false,
        burst: false,
      },
    };

    // O modo vigente fica maior e radiante; os outros dois recuam.
    const SCALE_CURRENT = 1.2;
    const SCALE_OTHER = 0.8;
    const scaleFor = (slot) => (slot === 'center' ? SCALE_CURRENT : SCALE_OTHER);

    const group = document.querySelector('[data-mode-group]');
    if (!group) return;
    const stage = group.querySelector('[data-mode-stage]');
    const burst = group.querySelector('[data-mode-burst]');
    const status = group.querySelector('[data-mode-status]');
    const helpButton = group.querySelector('[data-mode-help]');
    const helpPanel = group.querySelector('[data-mode-help-panel]');
    const nodes = Array.from(group.querySelectorAll('[data-mode-node]'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const normalizeMode = (mode) =>
      modes.includes(mode) ? mode : 'authorial';
    const nodeFor = (id) => nodes.find((n) => n.dataset.modeNode === id);
    const buttonFor = (node) => node.querySelector('[data-mode-option]');
    const identFor = (node) => node.querySelector('[data-node-ident]');
    const ringFor = (node) => node.querySelector('[data-node-ring]');
    const discFor = (node) => node.querySelector('[data-node-disc]');
    const px = (value) => value + 'px';

    // Ao redor do modo atual: o próximo do ciclo à esquerda, o anterior à direita.
    const slotsFor = (mode) => {
      const i = modes.indexOf(normalizeMode(mode));
      return {
        left: modes[(i + 1) % modes.length],
        center: modes[i],
        right: modes[(i + 2) % modes.length],
      };
    };

    const syncUrl = (mode) => {
      try {
        const url = new URL(window.location.href);
        url.searchParams.delete('serious');
        if (mode === 'authorial') {
          url.searchParams.delete('mode');
        } else {
          url.searchParams.set('mode', mode);
        }
        history.replaceState(
          history.state,
          '',
          url.pathname + url.search + url.hash,
        );
      } catch {}
    };

    // Posiciona os nós, atualiza os nomes acessíveis e mantém a ordem do DOM
    // igual à ordem visual (e, portanto, à ordem do foco).
    const layout = (mode) => {
      const slots = slotsFor(mode);
      ['left', 'center', 'right'].forEach((slot) => {
        const id = slots[slot];
        const node = nodeFor(id);
        const button = buttonFor(node);
        node.dataset.slot = slot;
        stage.appendChild(node);
        if (slot === 'center') {
          button.setAttribute('aria-current', 'true');
          button.setAttribute('aria-disabled', 'true');
          button.tabIndex = -1;
          button.setAttribute('aria-label', names[id] + ', modo atual');
          button.title = 'Modo atual: ' + names[id];
        } else {
          button.removeAttribute('aria-current');
          button.removeAttribute('aria-disabled');
          button.removeAttribute('tabindex');
          button.setAttribute('aria-label', 'Mudar para ' + names[id]);
          button.title = 'Mudar para ' + names[id];
        }
      });
    };

    const snapshot = () =>
      new Map(
        nodes.map((node) => [
          node,
          { slot: node.dataset.slot, left: node.offsetLeft },
        ]),
      );

    let running = [];
    let runId = 0;
    let unlockTimer = 0;

    const clearOrbit = () =>
      nodes.forEach((node) => node.removeAttribute('data-orbit'));

    const unlockPointer = () => {
      clearTimeout(unlockTimer);
      delete stage.dataset.animating;
    };

    // Termina qualquer transição em curso: o estado final já está no CSS.
    const settle = () => {
      running.forEach((animation) => {
        try {
          animation.finish();
        } catch {}
      });
      running = [];
      clearOrbit();
      unlockPointer();
    };

    // Rotação em três posições. Quem vai do centro para um lado encolhe; quem vai
    // de um lado para o centro cresce e ganha brilho; o terceiro dá a volta por
    // trás. Os dois que andam lado a lado usam a mesma curva e duração, então
    // andam em comboio, sem sobrepor.
    const play = (before, mode) => {
      const profile = profiles[mode];
      const duration = profile.duration;
      const fade = { duration, easing: profile.fade };
      const id = ++runId;
      // Enquanto os nós passam, o ponteiro parado não pode acender o hover de
      // quem está por baixo dele; libera quando o movimento já assentou.
      stage.dataset.animating = 'true';
      unlockTimer = setTimeout(unlockPointer, duration * 0.6);

      nodes.forEach((node) => {
        const from = before.get(node);
        const to = { slot: node.dataset.slot, left: node.offsetLeft };
        if (from.slot === to.slot) return;
        const orbit = from.slot !== 'center' && to.slot !== 'center';
        const emblem = buttonFor(node);
        const ident = identFor(node);
        const ring = ringFor(node);
        const disc = discFor(node);

        if (orbit && profile.depth) {
          // Autoral: a volta é uma órbita, o nó recua em profundidade por trás.
          const swing = 'cubic-bezier(0.45, 0, 0.55, 1)';
          const mid = (from.left + to.left) / 2;
          running.push(
            node.animate(
              [
                { left: px(from.left), transform: 'translateY(0)', opacity: 1, easing: swing },
                { left: px(mid), transform: 'translateY(-6px)', opacity: 0.45, easing: swing },
                { left: px(to.left), transform: 'translateY(0)', opacity: 1 },
              ],
              { duration, easing: 'linear' },
            ),
          );
        } else if (orbit) {
          // Editorial e Legacy: o nó some enquanto cruza por trás e reaparece do
          // outro lado, assim não sobra uma fatia dele no vão entre os outros dois.
          running.push(
            node.animate(
              [
                { left: px(from.left), opacity: 1 },
                { opacity: 0, offset: 0.15 },
                { opacity: 0, offset: 0.85 },
                { left: px(to.left), opacity: 1 },
              ],
              { duration, easing: profile.easing },
            ),
          );
        } else {
          running.push(
            node.animate(
              [{ left: px(from.left) }, { left: px(to.left) }],
              { duration, easing: profile.easing },
            ),
          );
        }
        if (orbit) node.dataset.orbit = 'true';

        // Escala do emblema: cresce ou encolhe com a posição.
        if (scaleFor(from.slot) !== scaleFor(to.slot)) {
          running.push(
            emblem.animate(
              [
                { transform: 'scale(' + scaleFor(from.slot) + ')' },
                { transform: 'scale(' + scaleFor(to.slot) + ')' },
              ],
              { duration, easing: profile.easing },
            ),
          );
        }

        if (to.slot === 'center') {
          // Acende: o anel e a estrela aparecem, o disco ganha brilho.
          running.push(
            ring.animate([{ opacity: 0 }, { opacity: 1 }], fade),
            ident.animate(
              [{ transform: 'scale(0.2)' }, { transform: 'scale(1)' }],
              { duration, easing: profile.spring },
            ),
          );
          if (profile.burst) {
            running.push(
              disc.animate(
                [
                  { filter: 'brightness(0.55) saturate(0.4)' },
                  { filter: 'brightness(1.3) saturate(1.2)' },
                ],
                { duration, easing: profile.easing },
              ),
            );
          }
        } else if (from.slot === 'center') {
          // Apaga: o anel e a estrela somem mais depressa que o movimento.
          running.push(
            ring.animate([{ opacity: 1 }, { opacity: 0 }], { duration: duration * 0.5, easing: profile.fade }),
            ident.animate([{ transform: 'scale(1)' }, { transform: 'scale(0.2)' }], { duration: duration * 0.5, easing: profile.fade }),
          );
        }
      });

      if (profile.burst && burst) {
        running.push(
          burst.animate(
            [
              { opacity: 0.9, transform: 'scale(0.9)' },
              { opacity: 0, transform: 'scale(1.9)' },
            ],
            { duration: duration + 120, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
          ),
        );
      }

      Promise.all(running.map((a) => a.finished.catch(() => {}))).then(() => {
        if (id !== runId) return;
        running = [];
        clearOrbit();
        unlockPointer();
      });
    };

    const render = (mode, animate) => {
      settle();
      const before = animate ? snapshot() : null;
      layout(mode);
      if (before && !reducedMotion.matches) play(before, mode);
    };

    const applyMode = (
      requestedMode,
      { persist = true, updateUrl = true, animate = false, announce = false } = {},
    ) => {
      const mode = normalizeMode(requestedMode);

      document.documentElement.dataset.portfolioMode = mode;
      document.documentElement.dataset.seriousMode =
        mode === 'editorial' ? 'true' : 'false';
      document.documentElement.dataset.legacyMode =
        mode === 'legacy' ? 'true' : 'false';

      group.dataset.portfolioModeCurrent = mode;
      group.setAttribute('aria-label', 'Modo de leitura: ' + names[mode]);
      render(mode, animate);

      const themeColor = document.querySelector('meta[name="theme-color"]');
      if (themeColor) themeColor.setAttribute('content', themeColors[mode]);

      if (persist) {
        try {
          localStorage.setItem(key, mode);
          localStorage.removeItem(oldKey);
          localStorage.removeItem(legacyKey);
        } catch {}
      }

      if (updateUrl) syncUrl(mode);
      if (announce && status) status.textContent = 'Modo de leitura: ' + names[mode];

      window.dispatchEvent(new CustomEvent('portfolio:mode', { detail: { mode } }));
      window.dispatchEvent(
        new CustomEvent('portfolio:serious-mode', { detail: { enabled: mode === 'editorial' } }),
      );
    };

    const initialMode =
      document.documentElement.dataset.portfolioMode ||
      (document.documentElement.dataset.seriousMode === 'true'
        ? 'editorial'
        : document.documentElement.dataset.legacyMode === 'true'
          ? 'legacy'
          : 'authorial');

    applyMode(initialMode, { persist: false, updateUrl: false });

    if (helpButton && helpPanel) {
      // O painel nasce alinhado à direita do controle; se isso o empurrar para
      // fora da janela (telas estreitas), desloca-o de volta para dentro.
      const keepPanelInView = () => {
        helpPanel.style.right = '0px';
        const rect = helpPanel.getBoundingClientRect();
        const margin = 8;
        const viewport = document.documentElement.clientWidth;
        if (rect.left < margin) {
          helpPanel.style.right = px(rect.left - margin);
        } else if (rect.right > viewport - margin) {
          helpPanel.style.right = px(rect.right - (viewport - margin));
        }
      };
      const setHelp = (open) => {
        helpPanel.hidden = !open;
        helpButton.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (open) keepPanelInView();
      };
      helpButton.addEventListener('click', () => setHelp(helpPanel.hidden));
      window.addEventListener('resize', () => {
        if (!helpPanel.hidden) keepPanelInView();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setHelp(false);
      });
    }

    nodes.forEach((node) => {
      const button = buttonFor(node);
      button.addEventListener('click', () => {
        if (button.getAttribute('aria-current') === 'true') return;
        const slot = node.dataset.slot;
        const hadFocus = document.activeElement === button;
        applyMode(node.dataset.modeNode, { animate: true, announce: true });
        if (hadFocus) {
          // O foco acompanha a posição: Enter de novo segue no mesmo sentido.
          const next = nodes.find((n) => n.dataset.slot === slot);
          if (next) buttonFor(next).focus({ preventScroll: true });
        }
      });
    });
  })();
</script>

<style>
  .serious-control {
    position: relative;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Trilha de três posições, de largura fixa e simétrica: lado · centro · lado. */
  .serious-stage {
    --serious-side: 52px;
    --serious-pitch: 70px;
    position: relative;
    flex: 0 0 auto;
    width: calc(var(--serious-side) * 3 + 36px);
    height: var(--serious-side);
  }

  .serious-node {
    position: absolute;
    top: 0;
    z-index: 1;
    width: var(--serious-side);
    height: var(--serious-side);
  }

  .serious-node[data-slot='left'] {
    left: 0;
  }

  .serious-node[data-slot='center'] {
    left: var(--serious-pitch);
  }

  .serious-node[data-slot='right'] {
    left: calc(var(--serious-pitch) * 2);
  }

  /* Quem dá a volta passa por trás dos outros dois. */
  .serious-node[data-orbit] {
    z-index: 0;
  }

  .serious-stage[data-animating] .serious-emblem {
    pointer-events: none;
  }

  /* Emblema: sem chrome de botão, só o disco, o anel e o glifo. */
  .serious-emblem {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    box-shadow: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .serious-node[data-slot='left'] .serious-emblem,
  .serious-node[data-slot='right'] .serious-emblem {
    transform: scale(0.8);
    opacity: 0.5;
    filter: saturate(0.3) brightness(0.85);
  }

  .serious-node[data-slot='center'] .serious-emblem {
    transform: scale(1.2);
    cursor: default;
  }

  .serious-node[data-slot='left'] .serious-emblem:hover,
  .serious-node[data-slot='right'] .serious-emblem:hover {
    opacity: 0.85;
    filter: saturate(0.8) brightness(1);
  }

  .serious-emblem:focus-visible {
    outline: 2px solid var(--sun);
    outline-offset: 4px;
  }

  .serious-disc {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: #c9b48a;
    background: radial-gradient(circle at 50% 30%, #4a3a26 0%, #1c150d 62%, #0d0905 100%);
    box-shadow: inset 0 0 0 1px rgba(255, 236, 190, 0.16);
  }

  .serious-node[data-slot='center'] .serious-disc {
    color: #fff8e1;
    background: radial-gradient(circle at 50% 26%, #fff1bf 0%, #f0b43c 34%, #8f4e1a 78%, #2a1608 100%);
    box-shadow:
      0 0 0 1px rgba(255, 236, 170, 0.75),
      0 0 16px 3px rgba(255, 190, 80, 0.6),
      0 0 40px 8px rgba(255, 140, 70, 0.28);
  }

  .serious-glyph {
    flex: 0 0 auto;
  }

  .serious-node[data-slot='center'] .serious-glyph {
    filter: drop-shadow(0 0 4px rgba(255, 255, 255, 0.85));
  }

  /* Anel de gradiente girando, herdado dos botões: só no modo vigente. Usa a
     mesma técnica de borda com gradiente de attention.css (sem máscara). */
  .serious-ring {
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 2px solid transparent;
    opacity: 0;
    background:
      linear-gradient(transparent, transparent) padding-box,
      conic-gradient(from 0deg, #e0a62e, #c0607e, #4f97bf, #8a6cc0, #6fae7c, #e0a62e) border-box;
    pointer-events: none;
  }

  .serious-node[data-slot='center'] .serious-ring {
    opacity: 1;
    animation: serious-spin 6s linear infinite;
  }

  /* Identificador do modo vigente: uma estrela de quatro pontas atrás do emblema. */
  .serious-identifier {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 104px;
    height: 104px;
    margin: -52px 0 0 -52px;
    opacity: 0;
    color: var(--sun);
    pointer-events: none;
    z-index: -1;
  }

  .serious-node[data-slot='center'] .serious-identifier {
    opacity: 0.9;
    transform: none;
    animation: serious-spin 22s linear infinite;
  }

  .serious-burst {
    position: absolute;
    top: 0;
    left: var(--serious-pitch);
    width: var(--serious-side);
    height: var(--serious-side);
    border: 2px solid var(--sun);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
  }

  @keyframes serious-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .serious-node[data-slot='center'] .serious-ring,
    .serious-node[data-slot='center'] .serious-identifier {
      animation: none;
    }
  }

  .serious-help {
    width: 40px;
    height: 40px;
    min-height: 40px;
    padding: 0;
    border: 1px solid rgba(205, 188, 165, 0.92);
    border-radius: 50%;
    background: rgba(255, 250, 240, 0.76);
    color: var(--ink-soft);
    font-family: var(--font-ui);
    font-size: 0.95rem;
    font-weight: 800;
    cursor: pointer;
  }

  .serious-help-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 20;
    width: min(20rem, calc(100vw - 16px));
    padding: 0.9rem 1rem;
    border: 1px solid rgba(205, 188, 165, 0.92);
    border-radius: 12px;
    background: #fffaf0;
    color: var(--ink-soft);
    box-shadow: 0 10px 30px rgba(94, 72, 49, 0.14);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .serious-help-panel p {
    margin: 0 0 0.45rem;
  }

  .serious-help-panel p:last-child {
    margin: 0;
  }

  /* Modos planos (Editorial e Legacy): o CSS global de mono-modes.css zera
     fundos, bordas, sombras e raios com !important. Estas regras são mais
     específicas e explícitas, para que o emblema siga desenhado nesses modos. */
  :global(html:is([data-serious-mode='true'], [data-legacy-mode='true'])) .serious-emblem {
    background: transparent !important;
    border: 0 !important;
