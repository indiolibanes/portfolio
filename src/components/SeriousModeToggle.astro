  /* Energia do "?": branca sobre preto quando o botão inverte; o círculo some. */
  :global(html:is([data-serious-mode='true'], [data-legacy-mode='true'])) .serious-help .serious-help__q {
    text-shadow: none !important;
    background: transparent !important;
  }

  :global(html:is([data-serious-mode='true'], [data-legacy-mode='true'])) .serious-help.serious-help * {
    background: transparent !important;
  }

  /* Legenda translúcida também nos modos planos (mono-modes.css zera o blur). */
  :global(html:is([data-serious-mode='true'], [data-legacy-mode='true'])) .serious-help-panel.serious-help-panel {
    background: rgba(255, 255, 255, 0.78) !important;
    -webkit-backdrop-filter: blur(10px) !important;
    backdrop-filter: blur(10px) !important;
    border: 1px solid #000000 !important;
    color: #000000 !important;
  }

  :global(html:is([data-serious-mode='true'], [data-legacy-mode='true'])) .serious-help-panel.serious-help-panel * {
    background: transparent !important;
  }

  /* Legacy: traço de pixel, sem suavização. */
  :global(html[data-legacy-mode='true']) .serious-art {
    shape-rendering: crispEdges;
  }
</style>
