          <g class="serious-fx serious-halo" data-part="halo"><g class="serious-halo__pulse"><circle cx="32" cy="32" r="31" fill="url(#serious-halo-g)"></circle></g></g><g class="serious-fx serious-jets" data-part="jets"><g class="serious-jets__pulse"><polygon points="32,32 29,-20 35,-20" fill="url(#serious-jet-up)"></polygon><polygon points="32,32 29,84 35,84" fill="url(#serious-jet-down)"></polygon><line class="serious-jet__flow" x1="32" y1="26" x2="32" y2="-18"></line><line class="serious-jet__flow" x1="32" y1="38" x2="32" y2="82"></line></g></g><g class="serious-fx serious-xrays" data-part="xrays"><g class="serious-xrays__spin"><line class="serious-xr" x1="60.49" y1="31.12" x2="68.98" y2="30.86"></line><line class="serious-xr" x1="58.96" y1="41.25" x2="64.16" y2="43.04"></line><line class="serious-xr" x1="55.14" y1="48.64" x2="59.60" y2="51.85"></line><line class="serious-xr" x1="46.82" y1="56.34" x2="49.69" y2="61.04"></line><line class="serious-xr" x1="34.93" y1="60.35" x2="35.81" y2="68.80"></line><line class="serious-xr" x1="29.33" y1="60.37" x2="27.97" y2="74.81"></line><line class="serious-xr" x1="18.10" y1="56.88" x2="13.96" y2="64.30"></line><line class="serious-xr" x1="11.53" y1="51.83" x2="1.12" y2="61.92"></line><line class="serious-xr" x1="6.05" y1="43.78" x2="1.04" y2="46.05"></line><line class="serious-xr" x1="3.59" y1="29.78" x2="-1.90" y2="29.35"></line><line class="serious-xr" x1="5.35" y1="21.89" x2="-8.21" y2="16.75"></line><line class="serious-xr" x1="8.80" y1="15.45" x2="1.88" y2="10.52"></line><line class="serious-xr" x1="15.84" y1="8.52" x2="11.02" y2="1.52"></line><line class="serious-xr" x1="26.02" y1="4.13" x2="24.24" y2="-4.18"></line><line class="serious-xr" x1="37.15" y1="3.97" x2="39.23" y2="-7.34"></line><line class="serious-xr" x1="46.51" y1="7.47" x2="50.84" y2="0.15"></line><line class="serious-xr" x1="52.51" y1="12.21" x2="58.63" y2="6.31"></line><line class="serious-xr" x1="58.56" y1="21.66" x2="63.68" y2="19.66"></line></g></g><g class="serious-fx serious-ring" data-part="ring"><g class="serious-ring__spin"><circle cx="32" cy="32" r="27" fill="none" stroke="url(#serious-rainbow)" stroke-width="2.6"></circle></g></g>
          <circle class="serious-disc" cx="32" cy="32" r="24.5" fill="url(#serious-disc)"></circle>
          <circle class="serious-ornament serious-ornament--legacy" cx="32" cy="32" r="21" fill="none"></circle>
          <path class="serious-glyph" d="M37.54 28.47C35.4 31.66 33.66 33.97 32.24 35.38C32.24 37.16 31.8 39.14 30.95 41.28C30.02 43.75 28.97 45 27.88 45C27.03 45 26.62 44.51 26.62 43.5C26.62 42.37 27.15 40.84 28.2 38.86C29.13 37.12 30.02 35.82 30.87 34.98C30.99 33.68 30.67 31.58 29.94 28.67C29.53 26.93 28.93 25.4 28.16 24.06C27.31 22.61 26.54 21.88 25.78 21.92C24.6 22.04 23.71 22.85 23.19 24.35H22.66C22.62 24.06 22.62 23.82 22.62 23.54C22.62 20.67 23.59 19.17 25.57 19.01C27.96 18.81 29.86 21.84 31.27 28.18C31.92 31.14 32.24 32.91 32.24 33.52C35.27 29.8 37.21 26.16 37.98 22.57C38.31 21.11 38.47 20.3 38.51 20.18C38.79 19.41 39.28 19.05 39.96 19.05C40.89 19.05 41.38 19.45 41.38 20.3C41.38 21.88 40.08 24.63 37.54 28.47Z" fill="url(#serious-gold)" stroke="url(#serious-gold)" stroke-width="0.8" stroke-linejoin="round"></path>
          
        </svg>
      </button>
    </span>
    <span class="serious-burst" aria-hidden="true" data-mode-burst></span>
    <span class="serious-comet" aria-hidden="true" data-mode-comet>
      <svg viewBox="0 0 88 20" width="100%" height="100%"><polygon points="0,10 72,6.2 72,13.8" fill="url(#serious-trail)"></polygon><path d="M80 1.5 82.5 7.5 88.5 10 82.5 12.5 80 18.5 77.5 12.5 71.5 10 77.5 7.5Z" fill="#fff6d0"></path></svg>
    </span>
  </div>

  <button class="serious-tag" type="button" data-mode-tag aria-expanded="false" aria-controls="serious-help-panel" aria-label="Modo de leitura atual: Autoral. Abrir legenda dos modos" title="Legenda dos modos de leitura">
    <span class="serious-tag__dot" aria-hidden="true"></span>
    <span class="serious-tag__text" data-mode-tag-text>Autoral</span>
  </button>

  <button class="serious-help" type="button" data-mode-help aria-expanded="false" aria-controls="serious-help-panel" aria-label="Sobre os modos de leitura" title="Sobre os modos de leitura">
    <svg class="serious-help__energy" data-help-energy viewBox="0 0 40 40" aria-hidden="true" focusable="false">
      <g class="serious-help__swirl" data-help-swirl>
        <circle cx="20" cy="9" r="11" fill="url(#serious-energy-a)"></circle>
        <circle cx="30" cy="25" r="11" fill="url(#serious-energy-b)"></circle>
        <circle cx="10" cy="25" r="11" fill="url(#serious-energy-c)"></circle>
      </g>
      <circle class="serious-help__core" data-help-core cx="20" cy="20" r="17" fill="url(#serious-energy)"></circle>
    </svg>
    <span class="serious-help__q" data-help-q>?</span>
  </button>
  <div class="serious-help-panel" id="serious-help-panel" data-mode-help-panel hidden>
    <p data-help-row="authorial"><strong>α · Autoral</strong>: a versão completa, com Sophia, cor e movimento. É o padrão.</p>
    <p data-help-row="editorial"><strong>β · Editorial</strong>: sóbria, em tons de cinza, com o texto em primeiro plano.</p>
    <p data-help-row="legacy"><strong>γ · Legacy · 1998</strong>: só texto, no estilo dos sites antigos.</p>
  </div>

  <span class="sr-only" role="status" aria-live="polite" data-mode-status></span>
</div>

<script is:inline>
  (() => {
    const key = 'portfolio-mode-v2';
    const oldKey = 'portfolio-mode';
    const legacyKey = 'portfolio-serious-mode';
    // Ordem fixa dos emblemas, da esquerda para a direita: α · β · γ.
    const modes = ['authorial', 'editorial', 'legacy'];
    const names = {
      authorial: 'Autoral',
      editorial: 'Editorial',
      legacy: 'Legacy',
    };
    const themeColors = {
      authorial: '#f6efdc',
      editorial: '#ffffff',
      legacy: '#ffffff',
    };

    // Cada modo tem a sua personalidade de movimento. Tudo usa a Web Animations
    // API: o Editorial e o Legacy zeram animation e transition do CSS
    // (mono-modes.css), e este controle precisa continuar mostrando a troca.
    const profiles = {
      authorial: {
        travel: 720,
        travelEase: 'cubic-bezier(0.5, 0, 0.2, 1)',
        igniteAt: 0.7,
        ignite: 560,
        igniteEase: 'cubic-bezier(0.34, 1.56, 0.64, 1)',
        out: 360,
        outEase: 'ease-out',
        flare: true,
        tag: true,
      },
      editorial: {
        travel: 260,
        travelEase: 'cubic-bezier(0.4, 0, 0.2, 1)',
        igniteAt: 0.6,
        ignite: 220,
        igniteEase: 'cubic-bezier(0.4, 0, 0.2, 1)',
        out: 200,
        outEase: 'linear',
        flare: false,
        tag: true,
      },
      legacy: {
        travel: 360,
        travelEase: 'steps(6, end)',
        igniteAt: 0.6,
        ignite: 240,
        igniteEase: 'steps(4, end)',
        out: 240,
        outEase: 'steps(4, end)',
        flare: false,
        tag: true,
      },
    };

    const group = document.querySelector('[data-mode-group]');
    if (!group) return;
    const stage = group.querySelector('[data-mode-stage]');
    const burst = group.querySelector('[data-mode-burst]');
    const comet = group.querySelector('[data-mode-comet]');
    const status = group.querySelector('[data-mode-status]');
    const tag = group.querySelector('[data-mode-tag]');
    const tagText = group.querySelector('[data-mode-tag-text]');
    const helpButton = group.querySelector('[data-mode-help]');
    const helpPanel = group.querySelector('[data-mode-help-panel]');
    const nodes = modes.map((id) =>
      group.querySelector('[data-mode-node="' + id + '"]'),
    );
    const links = Array.from(group.querySelectorAll('[data-mode-link]'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const normalizeMode = (mode) => (modes.includes(mode) ? mode : 'authorial');
    const nodeFor = (id) => nodes[modes.indexOf(id)];
    const buttonFor = (node) => node.querySelector('[data-mode-option]');
    const px = (value) => value + 'px';
    const partsOf = (node) => Array.from(node.querySelectorAll('[data-part]'));

    let current = null;

    const syncUrl = (mode) => {
      try {
        const url = new URL(window.location.href);
        url.searchParams.delete('serious');
        if (mode === 'authorial') {
          url.searchParams.delete('mode');
        } else {
          url.searchParams.set('mode', mode);
        }
        history.replaceState(
          history.state,
          '',
          url.pathname + url.search + url.hash,
        );
      } catch {}
    };

    // Estado final de cada emblema (CSS faz o resto): aceso ou apagado.
    const setState = (mode) => {
      const at = modes.indexOf(mode);
      nodes.forEach((node, i) => {
        const id = modes[i];
        const button = buttonFor(node);
        const on = id === mode;
        node.dataset.state = on ? 'active' : 'idle';
        button.setAttribute('aria-pressed', on ? 'true' : 'false');
        if (on) {
          button.setAttribute('aria-current', 'true');
          button.setAttribute('aria-label', names[id] + ', modo atual');
          button.title = 'Modo atual: ' + names[id];
        } else {
          button.removeAttribute('aria-current');
          button.setAttribute('aria-label', 'Mudar para ' + names[id]);
          button.title = 'Mudar para ' + names[id];
        }
      });
      links.forEach((link, i) => {
        link.dataset.lit = i === at || i + 1 === at ? 'true' : 'false';
      });
      stage.style.setProperty('--i', String(at));
      if (tagText) tagText.textContent = names[mode];
      if (tag) {
        tag.setAttribute(
          'aria-label',
          'Modo de leitura atual: ' + names[mode] + '. Abrir legenda dos modos',
        );
      }
      group.querySelectorAll('[data-help-row]').forEach((row) => {
        row.dataset.current = row.dataset.helpRow === mode ? 'true' : 'false';
      });
      group.dataset.portfolioModeCurrent = mode;
      group.setAttribute('aria-label', 'Modo de leitura: ' + names[mode]);
    };

    const read = (el) => {
      const s = getComputedStyle(el);
      return { opacity: s.opacity, transform: s.transform, filter: s.filter };
    };

    // Fotografia do que está aceso/apagado agora, antes da troca.
    const snapshot = () => ({
      parts: nodes.map((node) => partsOf(node).map(read)),
      links: links.map((l) => ({ opacity: getComputedStyle(l).opacity })),
      centers: nodes.map((n) => n.offsetLeft + n.offsetWidth / 2),
    });

    // Vida contínua: cada letra tem a sua assinatura. Tudo em WAAPI, para seguir
    // viva nos modos planos (mono-modes.css zera animation do CSS).
    const loopsOf = {
      authorial: (q) => {
        const spin = (el, deg, ms) =>
          el && el.animate([{ transform: 'rotate(0deg)' }, { transform: 'rotate(' + deg + 'deg)' }], { duration: ms, iterations: Infinity });
        const out = [
          spin(q('.serious-ring__spin'), 360, 5000),
          spin(q('.serious-rays__spin'), -360, 11000),
          q('.serious-halo__pulse')?.animate(
            [
              { transform: 'scale(0.9)', opacity: 0.7, filter: 'hue-rotate(0deg)' },
              { transform: 'scale(1.1)', opacity: 1, filter: 'hue-rotate(180deg)' },
              { transform: 'scale(0.9)', opacity: 0.7, filter: 'hue-rotate(360deg)' },
            ],
            { duration: 3600, iterations: Infinity, easing: 'ease-in-out' },
          ),
          q('.serious-flare__pulse')?.animate(
            [
              { transform: 'scaleX(0.72)', opacity: 0.55, filter: 'hue-rotate(0deg)' },
              { transform: 'scaleX(1.08)', opacity: 1, filter: 'hue-rotate(90deg)' },
              { transform: 'scaleX(0.72)', opacity: 0.55, filter: 'hue-rotate(0deg)' },
            ],
            { duration: 2400, iterations: Infinity, easing: 'ease-in-out' },
          ),
        ];
        group.querySelectorAll('[data-mode-node="authorial"] .serious-spark').forEach((el, k) => {
          out.push(
            el.animate([{ opacity: 0.2, transform: 'scale(0.6)' }, { opacity: 1, transform: 'scale(1.25)' }, { opacity: 0.2, transform: 'scale(0.6)' }], {
              duration: 1800,
              delay: k * 450,
              iterations: Infinity,
              easing: 'ease-in-out',
            }),
          );
        });
        return out;
      },
      editorial: (q) => {
        const out = [
          // Pulsar: o par de jatos gira e pisca a cada varredura.
          q('.serious-beams__spin')?.animate(
            [{ transform: 'rotate(18deg)' }, { transform: 'rotate(378deg)' }],
            { duration: 1700, iterations: Infinity },
          ),
          q('.serious-beams__pulse')?.animate(
            [{ opacity: 1 }, { opacity: 0.3 }, { opacity: 1 }],
            { duration: 850, iterations: Infinity, easing: 'ease-in-out' },
          ),
          q('.serious-shock__ring')?.animate(
            [
              { transform: 'scale(0.62)', opacity: 0.85 },
              { transform: 'scale(1.55)', opacity: 0 },
            ],
            { duration: 1700, iterations: Infinity, easing: 'cubic-bezier(0.1, 0.7, 0.3, 1)' },
          ),
          q('.serious-halo__pulse')?.animate(
            [
              { transform: 'scale(0.88)', opacity: 0.65 },
              { transform: 'scale(1.08)', opacity: 1 },
              { transform: 'scale(0.88)', opacity: 0.65 },
            ],
            { duration: 850, iterations: Infinity, easing: 'ease-in-out' },
          ),
          // Espaguetificação: a letra estica e afina até desfazer em fios.
          q('.serious-glyph')?.animate(
            [
              { transform: 'scale(1, 1)' },
              { transform: 'scale(0.9, 1.12)', offset: 0.55 },
              { transform: 'scale(1, 1)' },
            ],
            { duration: 1700, iterations: Infinity, easing: 'ease-in-out' },
          ),
        ];
        const ghosts = [
          [{ transform: 'scale(1, 1)', opacity: 0 }, { transform: 'scale(0.55, 1.9)', opacity: 0.85, offset: 0.55 }, { transform: 'scale(0.2, 2.8)', opacity: 0 }],
          [{ transform: 'scale(1, 1)', opacity: 0 }, { transform: 'scale(1.25, 0.4)', opacity: 0.7, offset: 0.5 }, { transform: 'scale(1.6, 0.1)', opacity: 0 }],
        ];
        ['1', '2'].forEach((n, k) => {
          out.push(
            q('.serious-ghost--' + n)?.animate(ghosts[k], {
              duration: 1700,
              delay: k * 850,
              iterations: Infinity,
              easing: 'ease-in',
            }),
          );
        });
        return out;
      },
      legacy: (q, all) => {
        const out = [
          // Quasar: os jatos oscilam e levam pulsos de energia para fora.
          q('.serious-jets__pulse')?.animate(
            [
              { transform: 'scaleY(0.62)', opacity: 0.7 },
              { transform: 'scaleY(1.08)', opacity: 1 },
              { transform: 'scaleY(0.78)', opacity: 0.8 },
              { transform: 'scaleY(1.02)', opacity: 1 },
            ],
            { duration: 900, iterations: Infinity, direction: 'alternate', easing: 'ease-in-out' },
          ),
          q('.serious-xrays__spin')?.animate(
            [{ transform: 'rotate(0deg)' }, { transform: 'rotate(360deg)' }],
            { duration: 16000, iterations: Infinity },
          ),
          q('.serious-halo__pulse')?.animate(
            [
              { transform: 'scale(0.86)', opacity: 0.6 },
              { transform: 'scale(1.12)', opacity: 1 },
              { transform: 'scale(0.86)', opacity: 0.6 },
            ],
            { duration: 700, iterations: Infinity, easing: 'ease-in-out' },
          ),
        ];
        all('.serious-jet__flow').forEach((el) => {
          out.push(
            el.animate([{ strokeDashoffset: 0 }, { strokeDashoffset: -24 }], {
              duration: 520,
              iterations: Infinity,
            }),
          );
        });
        all('.serious-xr').forEach((el, k) => {
          out.push(
            el.animate([{ opacity: 0.1 }, { opacity: 1 }, { opacity: 0.15 }], {
              duration: 260 + ((k * 97) % 520),
              delay: (k * 131) % 700,
              iterations: Infinity,
              easing: 'steps(3, end)',
            }),
          );
        });
        return out;
      },
    };
    const loops = new Map();
    const stopLoops = (node) => {
      (loops.get(node) || []).forEach((a) => a.cancel());
      loops.delete(node);
    };
    const startLoops = (node, mode) => {
      if (loops.has(node) || reducedMotion.matches) return;
      const q = (sel) => node.querySelector(sel);
      const all = (sel) => Array.from(node.querySelectorAll(sel));
      loops.set(node, loopsOf[mode](q, all).filter(Boolean));
    };
    const syncLoops = (mode, stopDelay) => {
      nodes.forEach((node, i) => {
        if (modes[i] === mode) {
          startLoops(node, mode);
        } else if (loops.has(node)) {
          if (stopDelay) setTimeout(() => modes[i] !== current && stopLoops(node), stopDelay);
          else stopLoops(node);
        }
      });
    };

    // Linha viva entre os emblemas: duas ondas trançadas que correm para longe
    // do modo vigente; o trecho ligado a ele corre mais rápido e mais claro.
    const linkLoops = links.map((link) =>
      Array.from(link.querySelectorAll('[data-flow]')).map((path) => {
        if (reducedMotion.matches) return null;
        const b = path.dataset.flow === 'b';
        return path.animate(
          [{ strokeDashoffset: 0 }, { strokeDashoffset: b ? -26 : -34 }],
          { duration: 1100, iterations: Infinity },
        );
      }),
    );
    const syncLinks = (at) => {
      links.forEach((link, i) => {
        // Vigente à esquerda do trecho: a energia corre para a direita; senão, para a esquerda.
        const dir = at <= i ? 1 : -1;
        const lit = i === at || i + 1 === at;
        (linkLoops[i] || []).forEach((a) => {
          if (a) a.updatePlaybackRate(dir * (lit ? 1.4 : 0.35));
        });
      });
    };

    let running = [];
    let runId = 0;
    let unlockTimer = 0;

    const unlockPointer = () => {
      clearTimeout(unlockTimer);
      delete stage.dataset.animating;
    };

    // Termina qualquer troca em curso: o estado final já está no CSS.
    const settle = () => {
      running.forEach((animation) => {
        try {
          animation.finish();
        } catch {}
      });
      running = [];
      unlockPointer();
    };

    const differs = (a, b) =>
      a.opacity !== b.opacity || a.transform !== b.transform || a.filter !== b.filter;

    const morph = (el, from, to, options, mid) => {
      if (!differs(from, to)) return;
      const frames = mid ? [from, mid, to] : [from, to];
      running.push(el.animate(frames, { fill: 'backwards', ...options }));
    };

    // Troca de ênfase: o cometa corre pelo trilho, quem estava aceso apaga na
    // saída, quem foi escolhido acende na chegada e o losango acompanha.
    const play = (before, prev, mode) => {
      const p = profiles[mode];
      const id = ++runId;
      const fromAt = modes.indexOf(prev);
      const toAt = modes.indexOf(mode);
      const delay = p.travel * p.igniteAt;
      stage.dataset.animating = 'true';
      unlockTimer = setTimeout(unlockPointer, p.travel * 0.8);

      nodes.forEach((node, i) => {
        const els = partsOf(node);
        const isOld = i === fromAt;
        const isNew = i === toAt;
        els.forEach((el, k) => {
          const from = before.parts[i][k];
          const to = read(el);
          if (isNew) {
            const mid =
              p.flare && el.dataset.part === 'art'
                ? { ...to, transform: 'scale(1.3)', opacity: '1' }
                : null;
            morph(el, from, to, { duration: p.ignite, delay, easing: p.igniteEase }, mid);
          } else if (isOld) {
            morph(el, from, to, { duration: p.out, easing: p.outEase });
          }
        });
      });

      links.forEach((link, i) => {
        const to = { opacity: getComputedStyle(link).opacity };
        if (to.opacity === before.links[i].opacity) return;
        const lighting = Number(to.opacity) > Number(before.links[i].opacity);
        running.push(
          link.animate([before.links[i], to], {
            duration: lighting ? p.travel * 0.5 : p.out,
            delay: lighting ? p.travel * 0.25 : 0,
            easing: p.outEase,
            fill: 'backwards',
          }),
        );
      });

      if (tagText && p.tag) {
        running.push(
          tagText.animate(
            [
              { opacity: 0, transform: 'translateY(6px)', letterSpacing: '0.2em' },
              { opacity: 1, transform: 'translateY(0)', letterSpacing: '0' },
            ],
            { duration: p.ignite, delay: delay * 0.6, easing: p.igniteEase, fill: 'backwards' },
          ),
        );
      }

      if (comet) {
        const dir = toAt > fromAt ? 1 : -1;
        const head = 80;
        const x = (center) => (dir > 0 ? center - head : center + head);
        const a = x(before.centers[fromAt]);
        const b = x(before.centers[toAt]);
        const flip = dir > 0 ? 'scaleX(1)' : 'scaleX(-1)';
        running.push(
          comet.animate(
            [
              { transform: 'translateX(' + px(a) + ') ' + flip, opacity: 0 },
              { transform: 'translateX(' + px(a + (b - a) * 0.12) + ') ' + flip, opacity: 1, offset: 0.12 },
              { transform: 'translateX(' + px(a + (b - a) * 0.88) + ') ' + flip, opacity: 1, offset: 0.88 },
              { transform: 'translateX(' + px(b) + ') ' + flip, opacity: 0 },
            ],
            { duration: p.travel, easing: p.travelEase },
          ),
        );
      }

      if (p.flare && burst) {
        const target = nodes[toAt];
        burst.style.left = px(target.offsetLeft);
        running.push(
          burst.animate(
            [
              { opacity: 0, transform: 'scale(0.8)' },
              { opacity: 0.9, transform: 'scale(0.9)', offset: 0.01 },
              { opacity: 0, transform: 'scale(2.1)' },
            ],
            { duration: p.ignite + 160, delay, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'backwards' },
          ),
        );
      }

      Promise.all(running.map((a) => a.finished.catch(() => {}))).then(() => {
        if (id !== runId) return;
        running = [];
        unlockPointer();
      });
    };

    const applyMode = (
      requestedMode,
      { persist = true, updateUrl = true, animate = false, announce = false } = {},
    ) => {
      const mode = normalizeMode(requestedMode);
      const prev = current;

      document.documentElement.dataset.portfolioMode = mode;
      document.documentElement.dataset.seriousMode =
        mode === 'editorial' ? 'true' : 'false';
      document.documentElement.dataset.legacyMode =
        mode === 'legacy' ? 'true' : 'false';

      settle();
      const shouldPlay = animate && prev && prev !== mode && !reducedMotion.matches;
      const before = shouldPlay ? snapshot() : null;
      setState(mode);
      current = mode;
      syncLoops(mode, before ? profiles[mode].out : 0);
      syncLinks(modes.indexOf(mode));
      if (before) play(before, prev, mode);

      const themeColor = document.querySelector('meta[name="theme-color"]');
      if (themeColor) themeColor.setAttribute('content', themeColors[mode]);

      if (persist) {
        try {
          localStorage.setItem(key, mode);
          localStorage.removeItem(oldKey);
          localStorage.removeItem(legacyKey);
        } catch {}
      }

      if (updateUrl) syncUrl(mode);
      if (announce && status) status.textContent = 'Modo de leitura: ' + names[mode];

      window.dispatchEvent(new CustomEvent('portfolio:mode', { detail: { mode } }));
      window.dispatchEvent(
        new CustomEvent('portfolio:serious-mode', { detail: { enabled: mode === 'editorial' } }),
      );
    };

    const initialMode =
      document.documentElement.dataset.portfolioMode ||
      (document.documentElement.dataset.seriousMode === 'true'
        ? 'editorial'
        : document.documentElement.dataset.legacyMode === 'true'
          ? 'legacy'
          : 'authorial');

    applyMode(initialMode, { persist: false, updateUrl: false });

    if (helpPanel) {
      // O painel nasce alinhado à direita do controle; se isso o empurrar para
      // fora da janela (telas estreitas), desloca-o de volta para dentro.
      const keepPanelInView = () => {
        helpPanel.style.right = '0px';
        const rect = helpPanel.getBoundingClientRect();
        const margin = 8;
        const viewport = document.documentElement.clientWidth;
        if (rect.left < margin) {
          helpPanel.style.right = px(rect.left - margin);
        } else if (rect.right > viewport - margin) {
          helpPanel.style.right = px(rect.right - (viewport - margin));
        }
      };
      const setHelp = (open) => {
        helpPanel.hidden = !open;
        [helpButton, tag].forEach((b) => b && b.setAttribute('aria-expanded', open ? 'true' : 'false'));
        if (open) keepPanelInView();
      };
      [helpButton, tag].forEach((b) => b && b.addEventListener('click', () => setHelp(helpPanel.hidden)));
      window.addEventListener('resize', () => {
        if (!helpPanel.hidden) keepPanelInView();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setHelp(false);
      });
      document.addEventListener('pointerdown', (event) => {
        if (!helpPanel.hidden && !group.contains(event.target)) setHelp(false);
      });
    }

    // Botão "?": segurar enche-o de energia por dentro (sem sair do círculo);
    // soltar faz a energia se dispersar e voltar ao ponto inicial.
    if (helpButton) {
      const energy = helpButton.querySelector('[data-help-energy]');
      const swirl = helpButton.querySelector('[data-help-swirl]');
      const core = helpButton.querySelector('[data-help-core]');
      const q = helpButton.querySelector('[data-help-q]');
      let charge = [];
      let spin = null;
      let held = false;
      const stopCharge = () => {
        charge.forEach((a) => a.cancel());
        charge = [];
        if (spin) spin.cancel();
        spin = null;
      };
      const hold = () => {
        if (held || reducedMotion.matches || !energy) return;
        held = true;
        stopCharge();
        energy.getAnimations().forEach((a) => a.cancel());
        const grow = { duration: 700, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)', fill: 'forwards' };
        charge.push(
          energy.animate([{ opacity: 0 }, { opacity: 1 }], grow),
          core.animate(
            [
              { transform: 'scale(0.15)' },
              { transform: 'scale(1)', offset: 0.7 },
              { transform: 'scale(0.92)' },
            ],
            { ...grow, duration: 900 },
          ),
          q.animate([{ transform: 'scale(1)' }, { transform: 'scale(1.18)' }], grow),
        );
        spin = swirl.animate(
          [
            { transform: 'rotate(0deg)', filter: 'hue-rotate(0deg)' },
            { transform: 'rotate(360deg)', filter: 'hue-rotate(360deg)' },
          ],
          { duration: 1300, iterations: Infinity },
        );
        // Vibração suave do núcleo enquanto segura.
        charge.push(
          core.animate(
            [{ opacity: 0.8 }, { opacity: 1 }, { opacity: 0.8 }],
            { duration: 420, iterations: Infinity, easing: 'ease-in-out' },
          ),
        );
      };
      const release = () => {
        if (!held) return;
        held = false;
        if (!energy) return;
        const cs = getComputedStyle(energy);
        const from = { opacity: cs.opacity, transform: cs.transform };
        const qs = getComputedStyle(q).transform;
        stopCharge();
        // A energia se dispersa para fora do núcleo, ainda contida no botão, e some.
        energy.animate(
          [from, { opacity: 0, transform: 'scale(1.35)' }],
          { duration: 800, easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)' },
        );
        q.animate([{ transform: qs }, { transform: 'scale(1)' }], { duration: 600, easing: 'ease-out' });
      };
      helpButton.addEventListener('pointerdown', hold);
      ['pointerup', 'pointerleave', 'pointercancel', 'blur'].forEach((type) =>
        helpButton.addEventListener(type, release),
      );
      helpButton.addEventListener('keydown', (event) => {
        if (!event.repeat && (event.key === 'Enter' || event.key === ' ')) hold();
      });
      helpButton.addEventListener('keyup', release);
    }

    nodes.forEach((node, i) => {
      const button = buttonFor(node);
      button.addEventListener('click', () => {
        const id = modes[i];
        if (id === current) return;
        applyMode(id, { animate: true, announce: true });
      });
      // Setas movem o foco entre os emblemas sem trocar o modo.
      button.addEventListener('keydown', (event) => {
        const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        const next = nodes[i + step];
        if (next) {
          event.preventDefault();
          buttonFor(next).focus();
        }
      });
    });
  })();
</script>

<style>
  .serious-control {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .serious-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  /* Trilha fixa de três emblemas: α · β · γ, sempre nesta ordem. A margem à
     esquerda dá espaço ao clarão do alfa, que se projeta para fora. */
  .serious-stage {
    --side: 56px;
    --pitch: 116px;
    position: relative;
    flex: 0 0 auto;
    width: calc(var(--pitch) * 2 + var(--side));
    height: var(--side);
    margin-left: 28px;
  }

  .serious-node {
    position: absolute;
    top: 0;
    z-index: 2;
    width: var(--side);
    height: var(--side);
  }

  .serious-node[data-mode-node='authorial'] { left: 0; }
  .serious-node[data-mode-node='editorial'] { left: var(--pitch); }
  .serious-node[data-mode-node='legacy'] { left: calc(var(--pitch) * 2); }

  .serious-stage[data-animating] .serious-emblem {
    pointer-events: none;
  }

  /* Linha viva entre os emblemas: duas ondas trançadas que correm pelo trilho. */
  .serious-link {
    position: absolute;
    top: calc(var(--side) / 2 - 8px);
    width: calc(var(--pitch) - var(--side) - 8px);
    height: 16px;
    z-index: 1;
    pointer-events: none;
    opacity: 0.42;
  }

  .serious-link[data-mode-link='0'] { left: calc(var(--side) + 4px); }
  .serious-link[data-mode-link='1'] { left: calc(var(--pitch) + var(--side) + 4px); }

  .serious-link[data-lit='true'] {
    opacity: 1;
    filter: drop-shadow(0 0 3px rgba(255, 200, 90, 0.9));
  }

  .serious-link svg {
    display: block;
    overflow: visible;
  }

  .serious-link path {
    fill: none;
    vector-effect: non-scaling-stroke;
  }

  .serious-link__base {
    stroke: rgba(214, 170, 90, 0.55);
    stroke-width: 1;
  }

  .serious-link__flow {
    stroke: url(#serious-flow);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 8 14;
  }

  .serious-link__flow--b {
    stroke-width: 1.4;
    stroke-dasharray: 3 10;
  }

  .serious-emblem {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    box-shadow: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
    overflow: visible;
    -webkit-tap-highlight-color: transparent;
  }

  .serious-node[data-state='active'] .serious-emblem {
    cursor: default;
  }

  .serious-emblem:focus-visible {
    outline: 2px solid var(--sun);
    outline-offset: 5px;
  }

  .serious-art {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* Apagado: neutro e recuado. Aceso: maior, dourado e com todas as camadas. */
  .serious-art[data-part='art'] {
    transform: scale(0.9);
    opacity: 0.62;
    filter: saturate(0.2) brightness(0.85);
  }

  .serious-node[data-state='active'] .serious-art {
    transform: scale(1.12);
    opacity: 1;
    filter: saturate(1) brightness(1);
  }

  .serious-node[data-state='idle'] .serious-emblem:hover .serious-art,
  .serious-node[data-state='idle'] .serious-emblem:focus-visible .serious-art {
    opacity: 0.95;
    filter: saturate(0.7) brightness(1);
  }

  .serious-fx {
    opacity: 0;
    transform: scale(0.6);
  }

  .serious-node[data-state='active'] .serious-fx {
    opacity: 1;
    transform: scale(1);
  }

  .serious-node[data-state='active'] .serious-halo {
    transform: scale(1.5);
  }

  .serious-ring { opacity: 0.4; transform: scale(1); }

  .serious-flare { transform: scaleX(0.3); }
  .serious-node[data-state='active'] .serious-flare { transform: scaleX(1); }

  /* Origem de transformação no centro do emblema (viewBox 64x64) para tudo que
     gira, pulsa ou estica; as animações contínuas ficam no JS (WAAPI). */
  .serious-fx,
  .serious-halo__pulse,
  .serious-ring__spin,
  .serious-rays__spin,
  .serious-flare__pulse,
  .serious-beams__spin,
  .serious-beams__pulse,
  .serious-shock__ring,
  .serious-ghost,
  .serious-glyph,
  .serious-jets__pulse,
  .serious-xrays__spin {
    transform-box: view-box;
    transform-origin: 32px 32px;
  }

  .serious-spark {
    transform-box: fill-box;
    transform-origin: center;
    fill: #fff3c4;
  }

  .serious-rays line {
    stroke: url(#serious-rainbow-us);
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .serious-shock__ring {
    stroke: #8f86d8;
  }

  .serious-ghost {
    opacity: 0;
  }

  .serious-xr {
    stroke: #4aa8ff;
    stroke-width: 1.1;
    stroke-linecap: round;
  }

  .serious-jet__flow {
    stroke: #e8f6ff;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 5 7;
  }

  .serious-ornament {
    stroke: rgba(255, 216, 130, 0.5);
  }

  .serious-ornament--authorial {
    stroke-width: 1;
    stroke-dasharray: 0.1 10.5;
    stroke-linecap: round;
  }

  .serious-ornament--editorial {
    stroke-width: 0.8;
  }

  .serious-ornament--legacy {
