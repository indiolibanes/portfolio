b serious-gamma__blob--d2" cx="32" cy="32" r="4" fill="url(#serious-blob)"></circle><circle class="serious-gamma__blob serious-gamma__blob--d3" cx="32" cy="32" r="6" fill="url(#serious-blob)"></circle><circle class="serious-gamma__blob serious-gamma__blob--d4" cx="32" cy="32" r="3.5" fill="url(#serious-blob)"></circle><path class="serious-gamma__flash" d="M32 -34 38.5 32 32 98 25.5 32Z" fill="url(#serious-flash)"></path></g></g><g class="serious-fx serious-ring" data-part="ring"><g class="serious-ring__spin"><circle cx="32" cy="32" r="27" fill="none" stroke="url(#serious-rainbow)" stroke-width="2.6"></circle></g></g>
