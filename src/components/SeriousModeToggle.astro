<div class="serious-control">
  <button
    class="serious-toggle"
    type="button"
    data-serious-toggle
    aria-pressed="false"
    aria-label="Ativar Modo sério"
    title="Modo sério"
  >
    <svg
      class="serious-icon"
      viewBox="0 0 24 24"
      width="18"
      height="18"
      aria-hidden="true"
    >
      <path
        fill="currentColor"
        d="M12 3a9 9 0 1 0 9 9c0-.35-.02-.7-.06-1.04A7 7 0 0 1 13.04 3.06C12.7 3.02 12.35 3 12 3Zm0 2v14a7 7 0 0 1 0-14Z"
      ></path>
    </svg>

    <span data-serious-label>
      Modo sério
    </span>
  </button>
</div>

<script is:inline>
  (() => {
    const key = 'portfolio-serious-mode';
    const button = document.querySelector('[data-serious-toggle]');
    const label = document.querySelector('[data-serious-label]');

    if (!button) return;

    const applyMode = (enabled, persist = true) => {
      document.documentElement.dataset.seriousMode =
        enabled ? 'true' : 'false';

      button.setAttribute(
        'aria-pressed',
        String(enabled),
      );

      button.setAttribute(
        'aria-label',
        enabled
          ? 'Desativar Modo sério'
          : 'Ativar Modo sério',
      );

      button.setAttribute(
        'title',
        enabled
          ? 'Voltar ao modo normal'
          : 'Modo sério',
      );

      if (label) {
        label.textContent =
          enabled
            ? 'Modo normal'
            : 'Modo sério';
      }

      const themeColor =
        document.querySelector(
          'meta[name="theme-color"]',
        );

      if (themeColor) {
        themeColor.setAttribute(
          'content',
          enabled
            ? '#c0c0c0'
            : '#f6efdc',
        );
      }

      if (persist) {
        try {
          localStorage.setItem(
            key,
            String(enabled),
          );
        } catch {}
      }
    };

    const enabled =
      document.documentElement.dataset
        .seriousMode === 'true';

    applyMode(enabled, false);

    button.addEventListener('click', () => {
      const current =
        document.documentElement.dataset
          .seriousMode === 'true';

      applyMode(!current);
    });
  })();
</script>

<style>
  .serious-control {
    display: flex;
    align-items: center;
  }

  .serious-toggle {
    min-height: 42px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 0.42rem;

    padding:
      0.55rem 0.78rem;

    border:
      1px solid
      rgba(205, 188, 165, 0.92);

    border-radius:
      var(--radius-full);

    background:
      rgba(255, 250, 240, 0.76);

    color:
      var(--ink-soft);

    box-shadow:
      0 3px 12px
      rgba(94, 72, 49, 0.07);

    cursor: pointer;

    font-family:
      var(--font-ui);

    font-size: 0.78rem;
    font-weight: 800;

    white-space: nowrap;

    transition:
      transform 160ms ease,
      background-color 160ms ease,
      color 160ms ease,
      border-color 160ms ease;
  }

  .serious-toggle:hover {
    transform:
      translateY(-1px);

    background:
      var(--surface-soft);

    color:
      var(--ink);
  }

  .serious-icon {
    flex: 0 0 auto;
  }

  @media (max-width: 720px) {
    .serious-toggle {
      min-height: 40px;

      padding:
        0.48rem 0.64rem;

      font-size: 0.72rem;
    }
  }
</style>
