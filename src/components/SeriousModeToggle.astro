<div
  class="serious-control"
  role="group"
  aria-label="Modo de leitura"
  data-mode-group
>
  <button class="serious-toggle serious-toggle--icon" type="button" data-mode-option="authorial" aria-pressed="false" aria-label="Autoral" title="Autoral">
    <svg class="serious-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M4 20C7 16 11 11 17 5c1.5-1.5 3.5-1.5 3.5-1.5S20.5 5.5 19 7c-6 6-11 10-15 13z M9 15l2-2"></path></svg>
  </button>
  <button class="serious-toggle serious-toggle--icon" type="button" data-mode-option="editorial" aria-pressed="false" aria-label="Editorial" title="Editorial">
    <svg class="serious-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M7 3.75h7.2L18 7.55v12.7H7z M14 3.75v4h4 M9.5 11h6 M9.5 14h6 M9.5 17h4"></path></svg>
  </button>
  <button class="serious-toggle serious-toggle--icon" type="button" data-mode-option="legacy" aria-pressed="false" aria-label="Legacy · 1998" title="Legacy · 1998">
    <svg class="serious-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" d="M3.5 4.5h17v15h-17z M3.5 8.5h17 M6.5 6.5h.01"></path></svg>
  </button>

  <span class="serious-current" data-mode-current aria-hidden="true">
    <svg class="serious-star" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 1.5l2.3 8.2 8.2 2.3-8.2 2.3L12 22.5l-2.3-8.2L1.5 12l8.2-2.3z"></path></svg>
    <span class="serious-current__name" data-mode-name>Autoral</span>
  </span>

  <button class="serious-help" type="button" data-mode-help aria-expanded="false" aria-controls="serious-help-panel" aria-label="Sobre os modos de leitura" title="Sobre os modos de leitura">?</button>
  <div class="serious-help-panel" id="serious-help-panel" data-mode-help-panel hidden>
    <p><strong>Autoral</strong>: a versão completa, com Sophia, cor e movimento. É o padrão.</p>
    <p><strong>Editorial</strong>: sóbria, em tons de cinza, com o texto em primeiro plano.</p>
    <p><strong>Legacy · 1998</strong>: só texto, no estilo dos sites antigos.</p>
  </div>
</div>

<script is:inline>
  (() => {
    const key = 'portfolio-mode-v2';
    const oldKey = 'portfolio-mode';
    const legacyKey = 'portfolio-serious-mode';
    // Ordem de ciclo: cada modo "vem depois" do anterior.
    const modes = ['authorial', 'editorial', 'legacy'];
    const names = {
      authorial: 'Autoral',
      editorial: 'Editorial',
      legacy: 'Legacy · 1998',
    };
    const themeColors = {
      authorial: '#f6efdc',
      editorial: '#ffffff',
      legacy: '#ffffff',
    };

    const group = document.querySelector('[data-mode-group]');
    if (!group) return;
    const options = Array.from(group.querySelectorAll('[data-mode-option]'));

    const normalizeMode = (mode) =>
      modes.includes(mode) ? mode : 'authorial';

    // Molécula: o modo atual primeiro, depois os demais na ordem de ciclo.
    const orderFor = (mode) => {
      const i = modes.indexOf(normalizeMode(mode));
      return [0, 1, 2].map((k) => modes[(i + k) % modes.length]);
    };

    const syncUrl = (mode) => {
      try {
        const url = new URL(window.location.href);
        url.searchParams.delete('serious');
        if (mode === 'authorial') {
          url.searchParams.delete('mode');
        } else {
          url.searchParams.set('mode', mode);
        }
        history.replaceState(
          history.state,
          '',
          url.pathname + url.search + url.hash,
        );
      } catch {}
    };

    const currentLabel = group.querySelector('[data-mode-current]');
    const currentName = group.querySelector('[data-mode-name]');
    const helpButton = group.querySelector('[data-mode-help]');
    const helpPanel = group.querySelector('[data-mode-help-panel]');

    const render = (mode) => {
      // Só as duas alternativas aparecem, na ordem de ciclo a partir do atual.
      // Ordem visual: alternativa · modo atual · alternativa · ajuda.
      const [before, after] = orderFor(mode).slice(1).map((id) =>
        options.find((o) => o.dataset.modeOption === id),
      );
      if (before && currentLabel) group.insertBefore(before, currentLabel);
      if (after && helpButton) group.insertBefore(after, helpButton);
      options.forEach((option) => {
        const id = option.dataset.modeOption;
        const visible = id !== mode;
        option.hidden = !visible;
        option.setAttribute('aria-pressed', 'false');
        option.dataset.active = 'false';
        option.title = 'Mudar para ' + names[id];
        if (visible) {
          option.classList.remove('serious-toggle--enter');
          void option.offsetWidth; // reinicia a animação de entrada
          option.classList.add('serious-toggle--enter');
        }
      });
      if (currentName) currentName.textContent = names[mode];
    };

    const applyMode = (requestedMode, persist = true, updateUrl = true) => {
      const mode = normalizeMode(requestedMode);

      document.documentElement.dataset.portfolioMode = mode;
      document.documentElement.dataset.seriousMode =
        mode === 'editorial' ? 'true' : 'false';
      document.documentElement.dataset.legacyMode =
        mode === 'legacy' ? 'true' : 'false';

      group.dataset.portfolioModeCurrent = mode;
      group.setAttribute('aria-label', 'Modo de leitura: ' + names[mode]);
      render(mode);

      const themeColor = document.querySelector('meta[name="theme-color"]');
      if (themeColor) themeColor.setAttribute('content', themeColors[mode]);

      if (persist) {
        try {
          localStorage.setItem(key, mode);
          localStorage.removeItem(oldKey);
          localStorage.removeItem(legacyKey);
        } catch {}
      }

      if (updateUrl) syncUrl(mode);

      window.dispatchEvent(new CustomEvent('portfolio:mode', { detail: { mode } }));
      window.dispatchEvent(
        new CustomEvent('portfolio:serious-mode', { detail: { enabled: mode === 'editorial' } }),
      );
    };

    const initialMode =
      document.documentElement.dataset.portfolioMode ||
      (document.documentElement.dataset.seriousMode === 'true'
        ? 'editorial'
        : document.documentElement.dataset.legacyMode === 'true'
          ? 'legacy'
          : 'authorial');

    applyMode(initialMode, false, false);

    if (helpButton && helpPanel) {
      const setHelp = (open) => {
        helpPanel.hidden = !open;
        helpButton.setAttribute('aria-expanded', open ? 'true' : 'false');
      };
      helpButton.addEventListener('click', () => setHelp(helpPanel.hidden));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setHelp(false);
      });
    }

    options.forEach((option) => {
      option.addEventListener('click', () => {
        const id = option.dataset.modeOption;
        if (id === normalizeMode(document.documentElement.dataset.portfolioMode)) return;
        applyMode(id);
      });
    });
  })();
</script>

<style>
  .serious-control {
    position: relative;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .serious-current {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    padding: 0 0.5rem;
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--ink);
    white-space: nowrap;
  }

  .serious-star {
    flex: 0 0 auto;
    color: var(--sun);
    filter: drop-shadow(0 0 6px rgba(212, 165, 72, 0.7));
  }

  .serious-toggle--icon {
    width: 44px;
    min-width: 44px;
    padding: 0;
  }

  .serious-help {
    width: 44px;
    min-height: 44px;
    border: 1px solid rgba(205, 188, 165, 0.92);
    border-radius: var(--radius-full);
    background: rgba(255, 250, 240, 0.76);
    color: var(--ink-soft);
    font-family: var(--font-ui);
    font-size: 0.95rem;
    font-weight: 800;
    cursor: pointer;
  }

  .serious-help-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 20;
    width: min(20rem, 86vw);
    padding: 0.9rem 1rem;
    border: 1px solid rgba(205, 188, 165, 0.92);
    border-radius: 12px;
    background: #fffaf0;
    color: var(--ink-soft);
    box-shadow: 0 10px 30px rgba(94, 72, 49, 0.14);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .serious-help-panel p {
    margin: 0 0 0.45rem;
  }

  .serious-help-panel p:last-child {
    margin: 0;
  }

  .serious-toggle--enter {
    animation: serious-enter 260ms ease both;
  }

  @keyframes serious-enter {
    from {
      opacity: 0;
      transform: translateX(-10px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .serious-toggle--enter {
      animation: none;
    }
  }

  .serious-toggle[data-active='true'] {
    border-color: var(--sun);
    box-shadow: inset 0 -2px 0 var(--sun);
    color: var(--ink);
    font-weight: 800;
  }

  :global(html[data-serious-mode='true']) .serious-toggle[data-active='true'] {
    background: #000000;
    color: #ffffff;
    box-shadow: none;
  }

  :global(html[data-legacy-mode='true']) .serious-toggle[data-active='true'] {
    border-style: inset;
    box-shadow: none;
    font-weight: 400;
  }

  .serious-toggle {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.42rem;
    padding: 0.55rem 0.78rem;
    border: 1px solid rgba(205, 188, 165, 0.92);
    border-radius: var(--radius-full);
    background: rgba(255, 250, 240, 0.76);
    color: var(--ink-soft);
    box-shadow: 0 3px 12px rgba(94, 72, 49, 0.07);
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 800;
    white-space: nowrap;
    transition:
      transform 160ms ease,
      background-color 160ms ease,
      color 160ms ease,
      border-color 160ms ease,
      border-radius 160ms ease;
  }

  .serious-toggle:hover {
    transform: translateY(-1px);
    background: var(--surface-soft);
    color: var(--ink);
  }

  .serious-icon {
    flex: 0 0 auto;
  }

  :global(html[data-serious-mode='true']) .serious-toggle {
    border-color: #000000;
    border-radius: 2px;
    background: #ffffff;
    color: #000000;
    box-shadow: none;
  }

  :global(html[data-serious-mode='true']) .serious-toggle:hover {
    background: #eeeeee;
  }

  :global(html[data-legacy-mode='true']) .serious-toggle {
    min-height: 44px;
    padding: 0.28rem 0.55rem;
    border: 2px outset #efefef;
    border-radius: 0;
    background: #c0c0c0;
    color: #000000;
    box-shadow: none;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.78rem;
    font-weight: 400;
    transform: none;
  }

  :global(html[data-legacy-mode='true']) .serious-toggle:hover {
    background: #c0c0c0;
    color: #000000;
    transform: none;
  }

  :global(html[data-legacy-mode='true']) .serious-toggle:active {
    border-style: inset;
  }

  @media (max-width: 720px) {
    .serious-toggle {
      min-height: 44px;
      padding: 0.48rem 0.64rem;
      font-size: 0.72rem;
    }

    :global(html[data-legacy-mode='true']) .serious-toggle {
      min-height: 44px;
      padding: 0.28rem 0.5rem;
      font-size: 0.72rem;
    }
  }
</style>
