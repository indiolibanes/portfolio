  :global(html:is([data-serious-mode='true'], [data-legacy-mode='true'])) .serious-node[data-state='idle'] .serious-emblem:hover .serious-art[data-part='art'] {
    opacity: 0.85;
  }

  :global(html:is([data-serious-mode='true'], [data-legacy-mode='true'])) .serious-pip {
    background: #000000 !important;
    box-shadow: none !important;
    border-radius: 0 !important;
  }

  :global(html:is([data-serious-mode='true'], [data-legacy-mode='true'])) .serious-tip {
    background: transparent !important;
    color: #000000 !important;
  }

  :global(html:is([data-serious-mode='true'], [data-legacy-mode='true'])) .serious-burst {
    display: none !important;
  }

  /* Legacy: traço de pixel, sem suavização. */
  :global(html[data-legacy-mode='true']) .serious-art {
