  <button class="serious-help" type="button" data-mode-help aria-expanded="false" aria-controls="serious-help-panel" aria-label="Sobre os modos de leitura" title="Sobre os modos de leitura">?</button>
  <div class="serious-help-panel" id="serious-help-panel" data-mode-help-panel hidden>
    <p><strong>α · Autoral</strong>: a versão completa, com Sophia, cor e movimento. É o padrão.</p>
    <p><strong>β · Editorial</strong>: sóbria, em tons de cinza, com o texto em primeiro plano.</p>
    <p><strong>γ · Legacy · 1998</strong>: só texto, no estilo dos sites antigos.</p>
  </div>

  <span class="sr-only" role="status" aria-live="polite" data-mode-status></span>
</div>

<script is:inline>
  (() => {
    const key = 'portfolio-mode-v2';
    const oldKey = 'portfolio-mode';
    const legacyKey = 'portfolio-serious-mode';
    // Ordem fixa dos emblemas, da esquerda para a direita: α · β · γ.
    const modes = ['authorial', 'editorial', 'legacy'];
    const names = {
      authorial: 'Autoral',
      editorial: 'Editorial',
      legacy: 'Legacy · 1998',
    };
    const themeColors = {
      authorial: '#f6efdc',
      editorial: '#ffffff',
      legacy: '#ffffff',
    };

    // Cada modo tem a sua personalidade de movimento. Tudo usa a Web Animations
    // API: o Editorial e o Legacy zeram animation e transition do CSS
    // (mono-modes.css), e este controle precisa continuar mostrando a troca.
    const profiles = {
      authorial: {
        travel: 640,
        travelEase: 'cubic-bezier(0.5, 0, 0.2, 1)',
        igniteAt: 0.7,
        ignite: 560,
        igniteEase: 'cubic-bezier(0.34, 1.56, 0.64, 1)',
        out: 360,
        outEase: 'ease-out',
        flare: true,
      },
      editorial: {
        travel: 260,
        travelEase: 'cubic-bezier(0.4, 0, 0.2, 1)',
        igniteAt: 0.6,
        ignite: 220,
        igniteEase: 'cubic-bezier(0.4, 0, 0.2, 1)',
        out: 200,
        outEase: 'linear',
        flare: false,
      },
      legacy: {
        travel: 360,
        travelEase: 'steps(6, end)',
        igniteAt: 0.6,
        ignite: 240,
        igniteEase: 'steps(4, end)',
        out: 240,
        outEase: 'steps(4, end)',
        flare: false,
      },
    };

    const group = document.querySelector('[data-mode-group]');
    if (!group) return;
    const stage = group.querySelector('[data-mode-stage]');
    const pip = group.querySelector('[data-mode-pip]');
    const burst = group.querySelector('[data-mode-burst]');
    const comet = group.querySelector('[data-mode-comet]');
    const status = group.querySelector('[data-mode-status]');
    const helpButton = group.querySelector('[data-mode-help]');
    const helpPanel = group.querySelector('[data-mode-help-panel]');
    const nodes = modes.map((id) =>
      group.querySelector('[data-mode-node="' + id + '"]'),
    );
    const links = Array.from(group.querySelectorAll('[data-mode-link]'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const PARTS = ['art', 'halo', 'rays', 'ring', 'sparks'];
    const normalizeMode = (mode) => (modes.includes(mode) ? mode : 'authorial');
    const nodeFor = (id) => nodes[modes.indexOf(id)];
    const buttonFor = (node) => node.querySelector('[data-mode-option]');
    const px = (value) => value + 'px';
    const partsOf = (node) =>
      PARTS.map((p) => node.querySelector('[data-part="' + p + '"]')).concat(
        node.querySelector('.serious-tip'),
      );

    let current = null;

    const syncUrl = (mode) => {
      try {
        const url = new URL(window.location.href);
        url.searchParams.delete('serious');
        if (mode === 'authorial') {
          url.searchParams.delete('mode');
        } else {
          url.searchParams.set('mode', mode);
        }
        history.replaceState(
          history.state,
          '',
          url.pathname + url.search + url.hash,
        );
      } catch {}
    };

    // Estado final de cada emblema (CSS faz o resto): aceso ou apagado.
    const setState = (mode) => {
      const at = modes.indexOf(mode);
      nodes.forEach((node, i) => {
        const id = modes[i];
        const button = buttonFor(node);
        const on = id === mode;
        node.dataset.state = on ? 'active' : 'idle';
        button.setAttribute('aria-pressed', on ? 'true' : 'false');
        if (on) {
          button.setAttribute('aria-current', 'true');
          button.setAttribute('aria-label', names[id] + ', modo atual');
          button.title = 'Modo atual: ' + names[id];
        } else {
          button.removeAttribute('aria-current');
          button.setAttribute('aria-label', 'Mudar para ' + names[id]);
          button.title = 'Mudar para ' + names[id];
        }
      });
      links.forEach((link, i) => {
        link.dataset.lit = i === at || i + 1 === at ? 'true' : 'false';
      });
      stage.style.setProperty('--i', String(at));
      group.dataset.portfolioModeCurrent = mode;
      group.setAttribute('aria-label', 'Modo de leitura: ' + names[mode]);
    };

    const read = (el) => {
      const s = getComputedStyle(el);
      return { opacity: s.opacity, transform: s.transform, filter: s.filter };
    };

    // Fotografia do que está aceso/apagado agora, antes da troca.
    const snapshot = () => ({
      parts: nodes.map((node) => partsOf(node).map(read)),
      links: links.map((l) => ({ opacity: getComputedStyle(l).opacity })),
      pip: getComputedStyle(pip).left,
      centers: nodes.map((n) => n.offsetLeft + n.offsetWidth / 2),
    });

    let running = [];
    let runId = 0;
    let unlockTimer = 0;

    const unlockPointer = () => {
      clearTimeout(unlockTimer);
      delete stage.dataset.animating;
    };

    // Termina qualquer troca em curso: o estado final já está no CSS.
    const settle = () => {
      running.forEach((animation) => {
        try {
          animation.finish();
        } catch {}
      });
      running = [];
      unlockPointer();
    };

    const differs = (a, b) =>
      a.opacity !== b.opacity || a.transform !== b.transform || a.filter !== b.filter;

    const morph = (el, from, to, options, mid) => {
      if (!differs(from, to)) return;
      const frames = mid ? [from, mid, to] : [from, to];
      running.push(el.animate(frames, { fill: 'backwards', ...options }));
    };

    // Troca de ênfase: o cometa corre pelo trilho, quem estava aceso apaga na
    // saída, quem foi escolhido acende na chegada e o losango acompanha.
    const play = (before, prev, mode) => {
      const p = profiles[mode];
      const id = ++runId;
      const fromAt = modes.indexOf(prev);
      const toAt = modes.indexOf(mode);
      const delay = p.travel * p.igniteAt;
      stage.dataset.animating = 'true';
      unlockTimer = setTimeout(unlockPointer, p.travel * 0.8);

      nodes.forEach((node, i) => {
        const els = partsOf(node);
        const isOld = i === fromAt;
        const isNew = i === toAt;
        els.forEach((el, k) => {
          const from = before.parts[i][k];
          const to = read(el);
          if (isNew) {
            const mid =
              p.flare && el.dataset.part === 'art'
                ? { ...to, transform: 'scale(1.3)', opacity: '1' }
                : null;
            morph(el, from, to, { duration: p.ignite, delay, easing: p.igniteEase }, mid);
          } else if (isOld) {
            morph(el, from, to, { duration: p.out, easing: p.outEase });
          }
        });
      });

      links.forEach((link, i) => {
        const to = { opacity: getComputedStyle(link).opacity };
        if (to.opacity === before.links[i].opacity) return;
        const lighting = Number(to.opacity) > Number(before.links[i].opacity);
        running.push(
          link.animate([before.links[i], to], {
            duration: lighting ? p.travel * 0.5 : p.out,
            delay: lighting ? p.travel * 0.25 : 0,
            easing: p.outEase,
            fill: 'backwards',
          }),
        );
      });

      const pipTo = getComputedStyle(pip).left;
      if (pipTo !== before.pip) {
        running.push(
          pip.animate([{ left: before.pip }, { left: pipTo }], {
            duration: p.travel,
            easing: p.travelEase,
          }),
        );
      }
      if (p.flare) {
        running.push(
          pip.animate(
            [
              { transform: 'rotate(45deg) scale(1)' },
              { transform: 'rotate(45deg) scale(1.9)', offset: 0.75 },
              { transform: 'rotate(45deg) scale(1)' },
            ],
            { duration: p.travel + p.ignite * 0.5, easing: 'ease-out' },
          ),
        );
      }

      if (comet) {
        const dir = toAt > fromAt ? 1 : -1;
        const head = 80;
        const x = (center) => (dir > 0 ? center - head : center + head);
        const a = x(before.centers[fromAt]);
        const b = x(before.centers[toAt]);
        const flip = dir > 0 ? 'scaleX(1)' : 'scaleX(-1)';
        running.push(
          comet.animate(
            [
              { transform: 'translateX(' + px(a) + ') ' + flip, opacity: 0 },
              { transform: 'translateX(' + px(a + (b - a) * 0.12) + ') ' + flip, opacity: 1, offset: 0.12 },
              { transform: 'translateX(' + px(a + (b - a) * 0.88) + ') ' + flip, opacity: 1, offset: 0.88 },
              { transform: 'translateX(' + px(b) + ') ' + flip, opacity: 0 },
            ],
            { duration: p.travel, easing: p.travelEase },
          ),
        );
      }

      if (p.flare && burst) {
        const target = nodes[toAt];
        burst.style.left = px(target.offsetLeft);
        running.push(
          burst.animate(
            [
              { opacity: 0, transform: 'scale(0.8)' },
              { opacity: 0.9, transform: 'scale(0.9)', offset: 0.01 },
              { opacity: 0, transform: 'scale(2.1)' },
            ],
            { duration: p.ignite + 160, delay, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'backwards' },
          ),
        );
      }

      Promise.all(running.map((a) => a.finished.catch(() => {}))).then(() => {
        if (id !== runId) return;
        running = [];
        unlockPointer();
      });
    };

    const applyMode = (
      requestedMode,
      { persist = true, updateUrl = true, animate = false, announce = false } = {},
    ) => {
      const mode = normalizeMode(requestedMode);
      const prev = current;

      document.documentElement.dataset.portfolioMode = mode;
      document.documentElement.dataset.seriousMode =
        mode === 'editorial' ? 'true' : 'false';
      document.documentElement.dataset.legacyMode =
        mode === 'legacy' ? 'true' : 'false';

      settle();
      const shouldPlay = animate && prev && prev !== mode && !reducedMotion.matches;
      const before = shouldPlay ? snapshot() : null;
      setState(mode);
      current = mode;
      if (before) play(before, prev, mode);

      const themeColor = document.querySelector('meta[name="theme-color"]');
      if (themeColor) themeColor.setAttribute('content', themeColors[mode]);

      if (persist) {
        try {
          localStorage.setItem(key, mode);
          localStorage.removeItem(oldKey);
          localStorage.removeItem(legacyKey);
        } catch {}
      }

      if (updateUrl) syncUrl(mode);
      if (announce && status) status.textContent = 'Modo de leitura: ' + names[mode];

      window.dispatchEvent(new CustomEvent('portfolio:mode', { detail: { mode } }));
      window.dispatchEvent(
        new CustomEvent('portfolio:serious-mode', { detail: { enabled: mode === 'editorial' } }),
      );
    };

    const initialMode =
      document.documentElement.dataset.portfolioMode ||
      (document.documentElement.dataset.seriousMode === 'true'
        ? 'editorial'
        : document.documentElement.dataset.legacyMode === 'true'
          ? 'legacy'
          : 'authorial');

    applyMode(initialMode, { persist: false, updateUrl: false });

    if (helpButton && helpPanel) {
      // O painel nasce alinhado à direita do controle; se isso o empurrar para
      // fora da janela (telas estreitas), desloca-o de volta para dentro.
      const keepPanelInView = () => {
        helpPanel.style.right = '0px';
        const rect = helpPanel.getBoundingClientRect();
        const margin = 8;
        const viewport = document.documentElement.clientWidth;
        if (rect.left < margin) {
          helpPanel.style.right = px(rect.left - margin);
        } else if (rect.right > viewport - margin) {
          helpPanel.style.right = px(rect.right - (viewport - margin));
        }
      };
      const setHelp = (open) => {
        helpPanel.hidden = !open;
        helpButton.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (open) keepPanelInView();
      };
      helpButton.addEventListener('click', () => setHelp(helpPanel.hidden));
      window.addEventListener('resize', () => {
        if (!helpPanel.hidden) keepPanelInView();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setHelp(false);
      });
    }

    nodes.forEach((node, i) => {
      const button = buttonFor(node);
      button.addEventListener('click', () => {
        const id = modes[i];
        if (id === current) return;
        applyMode(id, { animate: true, announce: true });
      });
      // Setas movem o foco entre os emblemas sem trocar o modo.
      button.addEventListener('keydown', (event) => {
        const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        const next = nodes[i + step];
        if (next) {
          event.preventDefault();
          buttonFor(next).focus();
        }
      });
    });
  })();
</script>

<style>
  .serious-control {
    position: relative;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .serious-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  /* Trilha fixa de três emblemas: α · β · γ, sempre nesta ordem. */
  .serious-stage {
    --side: 56px;
    --pitch: 92px;
    --i: 0;
    position: relative;
    flex: 0 0 auto;
    width: calc(var(--pitch) * 2 + var(--side));
    height: calc(var(--side) + 26px);
  }

  .serious-node {
    position: absolute;
    top: 0;
    z-index: 2;
    width: var(--side);
    height: var(--side);
  }

  .serious-node[data-mode-node='authorial'] { left: 0; }
  .serious-node[data-mode-node='editorial'] { left: var(--pitch); }
  .serious-node[data-mode-node='legacy'] { left: calc(var(--pitch) * 2); }

  .serious-stage[data-animating] .serious-emblem {
    pointer-events: none;
  }

  /* Trilho entre emblemas: um fio de luz que acende ao lado do modo vigente. */
  .serious-link {
    position: absolute;
    top: calc(var(--side) / 2 - 8px);
    width: calc(var(--pitch) - var(--side) - 8px);
    height: 16px;
    z-index: 1;
    pointer-events: none;
    opacity: 0.28;
  }

  .serious-link[data-mode-link='0'] { left: calc(var(--side) + 4px); }
  .serious-link[data-mode-link='1'] { left: calc(var(--pitch) + var(--side) + 4px); }

  .serious-link[data-lit='true'] {
    opacity: 1;
  }

  .serious-link svg {
    display: block;
    overflow: visible;
  }

  .serious-emblem {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    box-shadow: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
    overflow: visible;
    -webkit-tap-highlight-color: transparent;
  }

  .serious-node[data-state='active'] .serious-emblem {
    cursor: default;
  }

  .serious-emblem:focus-visible {
    outline: 2px solid var(--sun);
    outline-offset: 5px;
  }

  .serious-art {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* Apagado: neutro e recuado. Aceso: maior, dourado e com todas as camadas. */
  .serious-art[data-part='art'] {
    transform: scale(0.9);
    opacity: 0.62;
    filter: saturate(0.2) brightness(0.85);
  }

  .serious-node[data-state='active'] .serious-art {
    transform: scale(1.12);
    opacity: 1;
    filter: saturate(1) brightness(1);
  }

  .serious-node[data-state='idle'] .serious-emblem:hover .serious-art,
  .serious-node[data-state='idle'] .serious-emblem:focus-visible .serious-art {
    opacity: 0.95;
    filter: saturate(0.7) brightness(1);
  }

  .serious-halo,
  .serious-rays,
  .serious-ring,
  .serious-sparks {
    transform-box: view-box;
    transform-origin: 32px 32px;
  }

  .serious-halo { opacity: 0; transform: scale(0.6); }
  .serious-rays { opacity: 0; transform: scale(0.75); }
  .serious-ring { opacity: 0.4; transform: scale(1); }
  .serious-sparks { opacity: 0; transform: scale(0.5); }

  .serious-node[data-state='active'] .serious-halo { opacity: 1; transform: scale(1.5); }
  .serious-node[data-state='active'] .serious-rays { opacity: 1; transform: scale(1); }
  .serious-node[data-state='active'] .serious-ring { opacity: 1; }
  .serious-node[data-state='active'] .serious-sparks { opacity: 1; transform: scale(1); }

  .serious-rays line {
    stroke: #ffd77a;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .serious-ornament {
    stroke: rgba(255, 216, 130, 0.5);
    fill: rgba(255, 216, 130, 0.7);
  }

  .serious-ornament--ring {
    fill: none;
  }

  .serious-spark {
    fill: #fff3c4;
  }

  .serious-disc {
    stroke: rgba(255, 220, 140, 0.35);
    stroke-width: 1;
  }

  .serious-node[data-state='active'] .serious-disc {
    stroke: #ffe39a;
    stroke-width: 1.4;
  }

  /* Movimento contínuo do modo vigente (CSS; o modo Autoral é o único que o permite). */
  .serious-node[data-state='active'] .serious-rays__spin,
  .serious-node[data-state='active'] .serious-ring__spin {
    transform-box: view-box;
    transform-origin: 32px 32px;
    animation: serious-spin 14s linear infinite;
  }

  .serious-node[data-state='active'] .serious-ring__spin {
    animation-duration: 6s;
  }

  .serious-node[data-state='active'] .serious-halo__pulse {
    transform-box: view-box;
    transform-origin: 32px 32px;
    animation: serious-pulse 2.6s ease-in-out infinite;
  }

  .serious-node[data-state='active'] .serious-spark {
    animation: serious-twinkle 2.2s ease-in-out infinite;
  }

  .serious-sparks g:nth-child(2) .serious-spark { animation-delay: 0.7s; }
  .serious-sparks g:nth-child(3) .serious-spark { animation-delay: 1.4s; }

  @keyframes serious-spin {
    to { transform: rotate(360deg); }
  }

  @keyframes serious-pulse {
    0%, 100% { transform: scale(0.92); opacity: 0.75; }
    50% { transform: scale(1.06); opacity: 1; }
  }

  @keyframes serious-twinkle {
    0%, 100% { opacity: 0.25; }
    50% { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .serious-node[data-state='active'] .serious-rays__spin,
    .serious-node[data-state='active'] .serious-ring__spin,
    .serious-node[data-state='active'] .serious-halo__pulse,
    .serious-node[data-state='active'] .serious-spark {
      animation: none;
    }
  }

  /* Identificador do modo vigente: losango dourado sob o emblema + nome. */
  .serious-pip {
    position: absolute;
    top: calc(var(--side) + 7px);
    left: calc(var(--i) * var(--pitch) + var(--side) / 2);
    width: 9px;
    height: 9px;
    margin-left: -4.5px;
    background: linear-gradient(135deg, #fff3c4, #d89a2b);
    box-shadow: 0 0 8px 1px rgba(255, 190, 80, 0.8);
    transform: rotate(45deg);
    z-index: 3;
    pointer-events: none;
  }

  .serious-tip {
    position: absolute;
    top: calc(var(--side) + 14px);
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-ui);
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.04em;
    white-space: nowrap;
    color: var(--ink-soft);
    opacity: 0;
    pointer-events: none;
  }

  .serious-node[data-state='active'] .serious-tip {
    opacity: 1;
    color: var(--ink);
  }

  @media (hover: hover) {
    .serious-node[data-state='idle']:hover .serious-tip {
      opacity: 0.8;
    }
  }

  .serious-burst {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--side);
    height: var(--side);
    border: 2px solid var(--sun);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
    z-index: 3;
  }

  .serious-comet {
    position: absolute;
    top: calc(var(--side) / 2 - 10px);
    left: 0;
    width: 88px;
    height: 20px;
    opacity: 0;
    transform-origin: 0 50%;
    pointer-events: none;
    z-index: 4;
  }

  .serious-help {
    width: 40px;
    height: 40px;
    min-height: 40px;
    padding: 0;
    border: 1px solid rgba(205, 188, 165, 0.92);
    border-radius: 50%;
    background: rgba(255, 250, 240, 0.76);
    color: var(--ink-soft);
    font-family: var(--font-ui);
    font-size: 0.95rem;
    font-weight: 800;
    cursor: pointer;
    align-self: flex-start;
  }

  .serious-help-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 20;
    width: min(20rem, calc(100vw - 16px));
    padding: 0.9rem 1rem;
    border: 1px solid rgba(205, 188, 165, 0.92);
    border-radius: 12px;
    background: #fffaf0;
    color: var(--ink-soft);
    box-shadow: 0 10px 30px rgba(94, 72, 49, 0.14);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .serious-help-panel p {
    margin: 0 0 0.45rem;
  }

  .serious-help-panel p:last-child {
    margin: 0;
  }

  @media (max-width: 560px) {
    .serious-control {
      gap: 0.4rem;
    }

    .serious-stage {
      --side: 42px;
      --pitch: 64px;
      height: calc(var(--side) + 24px);
    }

    .serious-help {
      width: 34px;
      height: 34px;
      min-height: 34px;
    }
  }

  /* Modos planos (Editorial e Legacy): mono-modes.css zera fundos, bordas,
     sombras, filtros e animações com !important. Aqui o emblema segue
     desenhado em preto e branco, sem depender de filtro nem de animação CSS:
     o recuado fica mais claro (opacidade) e o vigente ganha raios e anel. */
  :global(html:is([data-serious-mode='true'], [data-legacy-mode='true'])) .serious-node .serious-emblem.serious-emblem,
  :global(html:is([data-serious-mode='true'], [data-legacy-mode='true'])) .serious-node .serious-emblem.serious-emblem:hover,
  :global(html:is([data-serious-mode='true'], [data-legacy-mode='true'])) .serious-node .serious-emblem.serious-emblem:focus-visible {
    background: transparent !important;
    color: inherit !important;
    border: 0 !important;
    border-radius: 50% !important;
    box-shadow: none !important;
  }

  /* mono-modes.css pinta de preto todo descendente de botão em hover/foco. */
  :global(html:is([data-serious-mode='true'], [data-legacy-mode='true'])) .serious-node .serious-emblem.serious-emblem:is(:hover, :focus-visible) *,
  :global(html:is([data-serious-mode='true'], [data-legacy-mode='true'])) .serious-node .serious-emblem.serious-emblem * {
    background: transparent !important;
    box-shadow: none !important;
  }

  :global(html:is([data-serious-mode='true'], [data-legacy-mode='true'])) .serious-node .serious-emblem.serious-emblem:focus-visible {
    outline: 2px solid #000000 !important;
    outline-offset: 4px;
  }

  :global(html:is([data-serious-mode='true'], [data-legacy-mode='true'])) .serious-art[data-part='art'] {
    opacity: 0.5;
    filter: none;
