---
import crimsonBatonSvgSource from '../../assets/phrolova/crimson-baton-vector-draft.svg?raw';

// Motion-only layer: loose petals that drift down while the baton slowly comes
// apart, then fade as it re-forms. Invisible at rest, so the approved static
// geometry of the SVG is untouched. Coordinates use the SVG's 448 x 448 space
// (flower crown near 214,158).
const fall = [
  [206,150,-34,150,-70,7.6,.00],[222,146,26,168,52,6.8,.07],[212,160,-12,190,-95,8.2,.13],
  [230,156,46,142,80,7.2,.19],[200,162,-52,160,-60,6.6,.25],[218,152,8,210,110,8.6,.31],
  [208,158,-28,176,40,7.0,.37],[226,162,34,196,-84,7.8,.43],[214,148,-4,160,66,6.4,.49],
  [202,154,-44,200,-40,8.0,.55],[232,150,56,178,92,6.9,.61],[216,164,16,226,-72,8.4,.67],
];
const petalPath = 'M8 68C1 42 7 14 31 3C26 21 22 46 14 68C12 70 9 70 8 68Z';
const batonPetals = `
  <g id="baton-fall" aria-hidden="true">
    ${fall.map(([x,y,dx,dy,rot,size,d],i)=>`<g class="baton-fall-petal" style="--fx:${dx}px;--fy:${dy}px;--fr:${rot}deg;--fd:${d};--fs:${(size*2.6/68).toFixed(3)}" transform="translate(${x} ${y})"><path d="${petalPath}" transform="scale(${(size*2.6/68).toFixed(3)}) translate(-14 -34) rotate(${(i*47)%360} 14 34)" fill="${i%3===0?'#e0405a':i%3===1?'#b3173c':'#ff8d9c'}" /></g>`).join('')}
  </g>`;
const crimsonBatonSvg = crimsonBatonSvgSource.replace('</svg>', `${batonPetals}</svg>`);
---

<!--
  #sobre motion:
  - Shorekeeper keeps the approved flower/butterfly geometry and animates only
    the already-separated layers.
  - Phrolova uses the approved editable Crimson Baton SVG so its real petal,
    stamen, shaft and ornament groups can dissolve independently.
-->
<div class="phrolova-underlay" data-about-baton aria-hidden="true">
  <div
    class="about-baton-vector"
    set:html={crimsonBatonSvg}
  ></div>
</div>

<div class="shorekeeper-underlay" data-about-butterfly aria-hidden="true">
  <div class="about-shorekeeper-layers">
    <div class="about-shorekeeper-flower-reactor">
      <img
        class="about-shorekeeper-flower"
        src="/assets/about/shorekeeper-flower.webp"
        width="1477"
        height="1065"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="about-shorekeeper-butterfly-flight">
      <img
        class="about-shorekeeper-wing about-shorekeeper-wing--left"
        src="/assets/about/shorekeeper-butterfly.webp"
        width="1477"
        height="1065"
        alt=""
        loading="lazy"
        decoding="async"
      />

      <img
        class="about-shorekeeper-wing about-shorekeeper-wing--right"
        src="/assets/about/shorekeeper-butterfly.webp"
        width="1477"
        height="1065"
        alt=""
        loading="lazy"
        decoding="async"
      />

      <img
        class="about-shorekeeper-butterfly-body"
        src="/assets/about/shorekeeper-butterfly.webp"
        width="1477"
        height="1065"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const ornaments =
      document.querySelector(
        '#sobre .hero-ornaments',
      );

    if (!ornaments) return;

    const reducedMotion =
      window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      );

    const update = (visible = true) => {
      const enabled =
        visible &&
        !document.hidden &&
        !reducedMotion.matches &&
        document.documentElement.dataset
          .seriousMode !== 'true' &&
        document.documentElement.dataset
          .legacyMode !== 'true';

      ornaments.dataset.ornamentsVisible =
        String(enabled);
    };

    let visible = true;

    if ('IntersectionObserver' in window) {
      const observer =
        new IntersectionObserver(
          ([entry]) => {
            visible =
              Boolean(entry?.isIntersecting);
            update(visible);
          },
          {
            threshold: 0.12,
          },
        );

      observer.observe(ornaments);
    } else {
      update(true);
    }

    reducedMotion.addEventListener(
      'change',
      () => update(visible),
    );

    document.addEventListener(
      'visibilitychange',
      () => update(visible),
    );

    const modeObserver =
      new MutationObserver(
        () => update(visible),
      );

    modeObserver.observe(
      document.documentElement,
      {
        attributes: true,
        attributeFilter: [
          'data-serious-mode',
          'data-legacy-mode',
        ],
      },
    );
  })();
</script>

<style is:global>
  #sobre .hero-ornaments
  :is(
    .phrolova-underlay,
    .shorekeeper-underlay
  ) {
    pointer-events: none;
    transition: none !important;
  }

  /* --------------------------------------------------
     Shorekeeper
     -------------------------------------------------- */

  #sobre .about-shorekeeper-layers {
    position: relative;

    width: 100%;
    aspect-ratio: 1477 / 1065;

    overflow: visible;
  }

  #sobre
  :is(
    .about-shorekeeper-flower-reactor,
    .about-shorekeeper-butterfly-flight
  ) {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    transform-origin: 50% 50%;

    will-change:
      transform;
  }

  #sobre .about-shorekeeper-layers img {
    position: absolute;
    inset: 0;

    display: block;

    width: 100%;
    height: 100%;
    max-width: none;

    object-fit: contain;

    pointer-events: none;

    filter: none !important;
  }

  /*
    The butterfly remains exactly on the approved static coordinates until
    take-off. Its inner scale pulse is intentionally subtle: it reads as wing
    pressure without creating a second sprite or shrinking the butterfly into
    a residual particle.
  */
  #sobre
  .about-shorekeeper-butterfly-flight {
    animation:
      shorekeeper-butterfly-flight
      9.2s
      cubic-bezier(
        .42,
        .02,
        .2,
        1
      )
      infinite;

    transform-origin:
      42% 58%;

    perspective:
      520px;

    transform-style:
      preserve-3d;
  }

  #sobre
  .about-shorekeeper-wing {
    z-index: 1;

    transform-box:
      border-box;

    backface-visibility:
      visible;

    will-change:
      transform;
  }

  #sobre
  .about-shorekeeper-wing--left {
    clip-path:
      polygon(
        0 0,
        42.5% 0,
        42.5% 100%,
        0 100%
      );

    transform-origin:
      42.5% 54%;

    animation:
      shorekeeper-wing-left
      9.2s
      ease-in-out
      infinite;
  }

  #sobre
  .about-shorekeeper-wing--right {
    clip-path:
      polygon(
        42.5% 0,
        100% 0,
        100% 100%,
        42.5% 100%
      );

    transform-origin:
      42.5% 54%;

    animation:
      shorekeeper-wing-right
      9.2s
      ease-in-out
      infinite;
  }

  #sobre
  .about-shorekeeper-butterfly-body {
    z-index: 2;

    clip-path:
      polygon(
        36.5% 0,
        48.5% 0,
        48.5% 100%,
        36.5% 100%
      );

    transform:
      none !important;
  }

  #sobre
  .about-shorekeeper-flower-reactor {
    animation:
      shorekeeper-flower-recoil
      9.2s
      ease-in-out
      infinite;

    transform-origin:
      72% 74%;
  }

  /*
    Flight path (9.2 s): rest on the flower, take off, arc out over the hero
    and land again. Amplitude is a fraction of the layer box, set per
    breakpoint below, so the same path reads on phones and on desktop.
  */
  #sobre .about-shorekeeper-layers {
    --flight-x: 150%;
    --flight-y: -38%;
  }

  @media (max-width: 920px) {
    #sobre .about-shorekeeper-layers { --flight-x: 95%; --flight-y: -46%; }
  }

  @media (max-width: 600px) {
    #sobre .about-shorekeeper-layers { --flight-x: 52%; --flight-y: -58%; }
  }

  @keyframes
  shorekeeper-butterfly-flight {
    0%, 12%, 100% { transform: translate(0, 0) rotate(0deg) scale(1); }
    18% { transform: translate(calc(var(--flight-x) * .06), calc(var(--flight-y) * .3)) rotate(5deg) scale(1); }
    28% { transform: translate(calc(var(--flight-x) * .32), calc(var(--flight-y) * .9)) rotate(10deg) scale(.97); }
    40% { transform: translate(calc(var(--flight-x) * .72), calc(var(--flight-y) * 1)) rotate(5deg) scale(.93); }
    50% { transform: translate(var(--flight-x), calc(var(--flight-y) * .55)) rotate(-3deg) scale(.9); }
    60% { transform: translate(calc(var(--flight-x) * .74), calc(var(--flight-y) * .15)) rotate(-11deg) scale(.93); }
    70% { transform: translate(calc(var(--flight-x) * .38), calc(var(--flight-y) * .5)) rotate(-8deg) scale(.96); }
    80% { transform: translate(calc(var(--flight-x) * .12), calc(var(--flight-y) * .32)) rotate(-4deg) scale(.99); }
    88% { transform: translate(calc(var(--flight-x) * .02), calc(var(--flight-y) * .06)) rotate(-1deg) scale(1); }
    93% { transform: translate(0, 0) rotate(0deg) scale(1); }
  }

  @keyframes
  shorekeeper-wing-left {
    0%, 14%, 93%, 100% { transform: rotateY(0deg) rotateZ(0deg) scaleX(1); }
    17.0% { transform: rotateY(25deg) rotateZ(-0.77deg) scaleX(0.91); animation-timing-function: cubic-bezier(.5,0,.75,.4); }
    19.4% { transform: rotateY(-7deg) rotateZ(0.70deg) scaleX(1.03); animation-timing-function: cubic-bezier(.3,.2,.5,1); }
    22.6% { transform: rotateY(32deg) rotateZ(-0.98deg) scaleX(0.89); animation-timing-function: cubic-bezier(.5,0,.75,.4); }
    25.0% { transform: rotateY(-7deg) rotateZ(0.70deg) scaleX(1.03); animation-timing-function: cubic-bezier(.3,.2,.5,1); }
    28.2% { transform: rotateY(39deg) rotateZ(-1.19deg) scaleX(0.86); animation-timing-function: cubic-bezier(.5,0,.75,.4); }
    30.6% { transform: rotateY(-7deg) rotateZ(0.70deg) scaleX(1.03); animation-timing-function: cubic-bezier(.3,.2,.5,1); }
    33.8% { transform: rotateY(46deg) rotateZ(-1.40deg) scaleX(0.84); animation-timing-function: cubic-bezier(.5,0,.75,.4); }
    36.2% { transform: rotateY(-7deg) rotateZ(0.70deg) scaleX(1.03); animation-timing-function: cubic-bezier(.3,.2,.5,1); }
    39.4% { transform: rotateY(46deg) rotateZ(-1.40deg) scaleX(0.84); animation-timing-function: cubic-bezier(.5,0,.75,.4); }
    41.8% { transform: rotateY(-7deg) rotateZ(0.70deg) scaleX(1.03); animation-timing-function: cubic-bezier(.3,.2,.5,1); }
    45.0% { transform: rotateY(46deg) rotateZ(-1.40deg) scaleX(0.84); animation-timing-function: cubic-bezier(.5,0,.75,.4); }
    47.4% { transform: rotateY(-7deg) rotateZ(0.70deg) scaleX(1.03); animation-timing-function: cubic-bezier(.3,.2,.5,1); }
    50.6% { transform: rotateY(46deg) rotateZ(-1.40deg) scaleX(0.84); animation-timing-function: cubic-bezier(.5,0,.75,.4); }
    53.0% { transform: rotateY(-7deg) rotateZ(0.70deg) scaleX(1.03); animation-timing-function: cubic-bezier(.3,.2,.5,1); }
    56.2% { transform: rotateY(46deg) rotateZ(-1.40deg) scaleX(0.84); animation-timing-function: cubic-bezier(.5,0,.75,.4); }
    58.6% { transform: rotateY(-7deg) rotateZ(0.70deg) scaleX(1.03); animation-timing-function: cubic-bezier(.3,.2,.5,1); }
    61.8% { transform: rotateY(46deg) rotateZ(-1.40deg) scaleX(0.84); animation-timing-function: cubic-bezier(.5,0,.75,.4); }
    64.2% { transform: rotateY(-7deg) rotateZ(0.70deg) scaleX(1.03); animation-timing-function: cubic-bezier(.3,.2,.5,1); }
    67.4% { transform: rotateY(46deg) rotateZ(-1.40deg) scaleX(0.84); animation-timing-function: cubic-bezier(.5,0,.75,.4); }
    69.8% { transform: rotateY(-7deg) rotateZ(0.70deg) scaleX(1.03); animation-timing-function: cubic-bezier(.3,.2,.5,1); }
    73.0% { transform: rotateY(39deg) rotateZ(-1.19deg) scaleX(0.86); animation-timing-function: cubic-bezier(.5,0,.75,.4); }
    75.4% { transform: rotateY(-7deg) rotateZ(0.70deg) scaleX(1.03); animation-timing-function: cubic-bezier(.3,.2,.5,1); }
    78.6% { transform: rotateY(32deg) rotateZ(-0.98deg) scaleX(0.89); animation-timing-function: cubic-bezier(.5,0,.75,.4); }
    81.0% { transform: rotateY(-7deg) rotateZ(0.70deg) scaleX(1.03); animation-timing-function: cubic-bezier(.3,.2,.5,1); }
    84.2% { transform: rotateY(25deg) rotateZ(-0.77deg) scaleX(0.91); animation-timing-function: cubic-bezier(.5,0,.75,.4); }
    86.6% { transform: rotateY(-7deg) rotateZ(0.70deg) scaleX(1.03); animation-timing-function: cubic-bezier(.3,.2,.5,1); }
  }

  @keyframes
  shorekeeper-wing-right {
    0%, 14%, 93%, 100% { transform: rotateY(0deg) rotateZ(0deg) scaleX(1); }
    17.0% { transform: rotateY(-25deg) rotateZ(0.77deg) scaleX(0.91); animation-timing-function: cubic-bezier(.5,0,.75,.4); }
    19.4% { transform: rotateY(7deg) rotateZ(-0.70deg) scaleX(1.03); animation-timing-function: cubic-bezier(.3,.2,.5,1); }
    22.6% { transform: rotateY(-32deg) rotateZ(0.98deg) scaleX(0.89); animation-timing-function: cubic-bezier(.5,0,.75,.4); }
    25.0% { transform: rotateY(7deg) rotateZ(-0.70deg) scaleX(1.03); animation-timing-function: cubic-bezier(.3,.2,.5,1); }
    28.2% { transform: rotateY(-39deg) rotateZ(1.19deg) scaleX(0.86); animation-timing-function: cubic-bezier(.5,0,.75,.4); }
    30.6% { transform: rotateY(7deg) rotateZ(-0.70deg) scaleX(1.03); animation-timing-function: cubic-bezier(.3,.2,.5,1); }
    33.8% { transform: rotateY(-46deg) rotateZ(1.40deg) scaleX(0.84); animation-timing-function: cubic-bezier(.5,0,.75,.4); }
    36.2% { transform: rotateY(7deg) rotateZ(-0.70deg) scaleX(1.03); animation-timing-function: cubic-bezier(.3,.2,.5,1); }
    39.4% { transform: rotateY(-46deg) rotateZ(1.40deg) scaleX(0.84); animation-timing-function: cubic-bezier(.5,0,.75,.4); }
    41.8% { transform: rotateY(7deg) rotateZ(-0.70deg) scaleX(1.03); animation-timing-function: cubic-bezier(.3,.2,.5,1); }
    45.0% { transform: rotateY(-46deg) rotateZ(1.40deg) scaleX(0.84); animation-timing-function: cubic-bezier(.5,0,.75,.4); }
    47.4% { transform: rotateY(7deg) rotateZ(-0.70deg) scaleX(1.03); animation-timing-function: cubic-bezier(.3,.2,.5,1); }
    50.6% { transform: rotateY(-46deg) rotateZ(1.40deg) scaleX(0.84); animation-timing-function: cubic-bezier(.5,0,.75,.4); }
    53.0% { transform: rotateY(7deg) rotateZ(-0.70deg) scaleX(1.03); animation-timing-function: cubic-bezier(.3,.2,.5,1); }
    56.2% { transform: rotateY(-46deg) rotateZ(1.40deg) scaleX(0.84); animation-timing-function: cubic-bezier(.5,0,.75,.4); }
    58.6% { transform: rotateY(7deg) rotateZ(-0.70deg) scaleX(1.03); animation-timing-function: cubic-bezier(.3,.2,.5,1); }
    61.8% { transform: rotateY(-46deg) rotateZ(1.40deg) scaleX(0.84); animation-timing-function: cubic-bezier(.5,0,.75,.4); }
    64.2% { transform: rotateY(7deg) rotateZ(-0.70deg) scaleX(1.03); animation-timing-function: cubic-bezier(.3,.2,.5,1); }
    67.4% { transform: rotateY(-46deg) rotateZ(1.40deg) scaleX(0.84); animation-timing-function: cubic-bezier(.5,0,.75,.4); }
    69.8% { transform: rotateY(7deg) rotateZ(-0.70deg) scaleX(1.03); animation-timing-function: cubic-bezier(.3,.2,.5,1); }
    73.0% { transform: rotateY(-39deg) rotateZ(1.19deg) scaleX(0.86); animation-timing-function: cubic-bezier(.5,0,.75,.4); }
    75.4% { transform: rotateY(7deg) rotateZ(-0.70deg) scaleX(1.03); animation-timing-function: cubic-bezier(.3,.2,.5,1); }
    78.6% { transform: rotateY(-32deg) rotateZ(0.98deg) scaleX(0.89); animation-timing-function: cubic-bezier(.5,0,.75,.4); }
    81.0% { transform: rotateY(7deg) rotateZ(-0.70deg) scaleX(1.03); animation-timing-function: cubic-bezier(.3,.2,.5,1); }
    84.2% { transform: rotateY(-25deg) rotateZ(0.77deg) scaleX(0.91); animation-timing-function: cubic-bezier(.5,0,.75,.4); }
    86.6% { transform: rotateY(7deg) rotateZ(-0.70deg) scaleX(1.03); animation-timing-function: cubic-bezier(.3,.2,.5,1); }
  }

  @keyframes
  shorekeeper-flower-recoil {
    0%, 12%, 44%, 89%, 100% { transform: translateY(0) rotate(0deg); }
    16% { transform: translateY(1px) rotate(-1.15deg); }
    21% { transform: translateY(-1px) rotate(.72deg); }
    26% { transform: translateY(.5px) rotate(-.48deg); }
    32% { transform: translateY(0) rotate(.22deg); }
    38% { transform: translateY(0) rotate(-.1deg); }
    /* landing */
    93% { transform: translateY(1.5px) rotate(.9deg); }
    96% { transform: translateY(-.5px) rotate(-.35deg); }
  }

  /* --------------------------------------------------
     Phrolova / Crimson Baton
     -------------------------------------------------- */

  #sobre .about-baton-vector {
    display: block;

    width: 100%;

    overflow: visible;
  }

  #sobre .about-baton-vector > svg {
    display: block;

    width: 100%;
    height: auto;

    overflow: visible;

    filter:
      drop-shadow(
        0 9px 14px
        rgba(74, 8, 28, .12)
      );
  }

  #sobre
  .about-baton-vector
  :is(
    #petals-front,
    #petals-back,
    #staff,
    #stamens,
    #junction,
    #ornaments
  ) {
    transform-box:
      fill-box;

    transform-origin:
      center;

    will-change:
      transform,
      opacity,
      filter;
  }

  #sobre
  .about-baton-vector
  :is(
    #petals-front,
    #petals-back
  )
  > [id^='petal-'] {
    --petal-x: 22px;
    --petal-y: -26px;
    --petal-rotate: 26deg;

    transform-box:
      fill-box;

    transform-origin:
      center;

    animation:
      crimson-petal-unravel
      14s
      cubic-bezier(
        .36,
        0,
        .22,
        1
      )
      infinite;

    will-change:
      transform,
      opacity,
      filter;
  }

  #sobre
  .about-baton-vector
  :is(
    #petals-front,
    #petals-back
  )
  > [id^='petal-']:nth-child(4n + 1) {
    --petal-x: 28px;
    --petal-y: -29px;
    --petal-rotate: 34deg;
  }

  #sobre
  .about-baton-vector
  :is(
    #petals-front,
    #petals-back
  )
  > [id^='petal-']:nth-child(4n + 2) {
    --petal-x: -24px;
    --petal-y: -34px;
    --petal-rotate: -38deg;
  }

  #sobre
  .about-baton-vector
  :is(
    #petals-front,
    #petals-back
  )
  > [id^='petal-']:nth-child(4n + 3) {
    --petal-x: 34px;
    --petal-y: 8px;
    --petal-rotate: 46deg;
  }

  #sobre
  .about-baton-vector
  :is(
    #petals-front,
    #petals-back
  )
  > [id^='petal-']:nth-child(4n) {
    --petal-x: -31px;
    --petal-y: 14px;
    --petal-rotate: -42deg;
  }

  #sobre
  .about-baton-vector
  #petals-back
  > [id^='petal-'] {
    animation-duration:
      14.4s;

    filter:
      saturate(.94);
  }

  @keyframes
  crimson-petal-unravel {
    0%,
    24%,
    100% {
      opacity: 1;

      transform:
        translate(0, 0)
        rotate(0deg)
        scale(1);

      filter:
        blur(0)
        saturate(1);
    }

    34% {
      opacity: .98;

      transform:
        translate(
          calc(
            var(--petal-x) * .16
          ),
          calc(
            var(--petal-y) * .16
          )
        )
        rotate(
          calc(
            var(--petal-rotate) * .18
          )
        )
        scale(.995);
    }

    47% {
      opacity: .82;

      transform:
        translate(
          calc(
            var(--petal-x) * .56
          ),
          calc(
            var(--petal-y) * .56
          )
        )
        rotate(
          calc(
            var(--petal-rotate) * .62
          )
        )
        scale(.95);

      filter:
        blur(.12px)
        saturate(1.04);
    }

    60% {
      opacity: .08;

      transform:
        translate(
          var(--petal-x),
          var(--petal-y)
        )
        rotate(
          var(--petal-rotate)
        )
        scale(.84);

      filter:
        blur(.55px)
        saturate(.88);
    }

    68% {
      opacity: 0;

      transform:
        translate(
          calc(
            var(--petal-x) * 1.08
          ),
          calc(
            var(--petal-y) * 1.08
          )
        )
        rotate(
          calc(
            var(--petal-rotate) * 1.12
          )
        )
        scale(.8);
    }

    76% {
      opacity: .06;

      transform:
        translate(
          calc(
            var(--petal-x) * .84
          ),
          calc(
            var(--petal-y) * .84
          )
        )
        rotate(
          calc(
            var(--petal-rotate) * .84
          )
        )
        scale(.86);
    }

    89% {
      opacity: .94;

      transform:
        translate(
          calc(
            var(--petal-x) * .08
          ),
          calc(
            var(--petal-y) * .08
          )
        )
        rotate(
          calc(
            var(--petal-rotate) * .08
          )
        )
        scale(.99);

      filter:
        blur(0)
        saturate(1);
    }

    95% {
      opacity: 1;

      transform:
        translate(0, 0)
        rotate(0deg)
        scale(1);
