<!-- The existing transparent cut-outs are deliberately separate from both original illustrations. -->
<div class="hero-micro-effects" data-hero-micro-effects aria-hidden="true"></div>

<style is:global>
  /* Only #sobre: never reuse the music panorama's pointer/click effects. */
  #sobre .hero-micro-effects {
    position: absolute;
    inset: 0;
    z-index: 3; /* artwork above the paper, below hero copy (z-index: 4) */
    /* The sprite must be able to travel beyond the narrow ornament strip. */
    overflow: visible;
    pointer-events: none;
    contain: layout style;
  }

  #sobre .hero-ornament-particle {
    position: absolute;
    left: var(--ornament-x);
    top: var(--ornament-y);
    display: block;
    pointer-events: none;
    will-change: transform, opacity;
  }

  /* The flower belongs to the unchanged Shorekeeper illustration.
     Only the separately cut-out butterfly takes flight. */
  #sobre .hero-ornament-particle--butterfly {
    width: clamp(55px, 6.5vw, 91px);
    aspect-ratio: 231 / 143;
    transform-origin: 50% 50%;
    animation: about-butterfly-flight 2400ms cubic-bezier(.18,.61,.33,1) both;
  }
  #sobre .hero-ornament-particle--butterfly img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform-origin: 50% 50%;
    filter: drop-shadow(0 5px 9px rgba(54,83,166,.26));
    animation: about-butterfly-flutter 180ms ease-in-out 0ms 13 alternate;
  }
  @keyframes about-butterfly-flight {
    0% {
      opacity: 0;
      transform: translate(-50%,-50%) rotate(-9deg) scale(.75);
    }
    9% { opacity: 1; }
    26% {
      opacity: 1;
      transform: translate(calc(-50% + 13px),calc(-50% - 31px)) rotate(11deg) scale(.86);
    }
    55% {
      opacity: .96;
      transform: translate(calc(-50% - 35px),calc(-50% - 85px)) rotate(-8deg) scale(.95);
    }
    100% {
      opacity: 0;
      transform: translate(calc(-50% - 106px),calc(-50% - 157px)) rotate(-17deg) scale(.85);
    }
  }
  @keyframes about-butterfly-flutter {
    from { transform: perspective(180px) rotateY(-36deg) scaleX(.68); }
    to   { transform: perspective(180px) rotateY(26deg) scaleX(1); }
  }

  /* The original baton stays fixed. Three transparent pieces of its bow
     split away independently rather than fading the entire illustration. */
  #sobre .hero-ornament-particle--ribbon {
    width: clamp(82px,9vw,118px);
    aspect-ratio: 133 / 125;
    animation: about-ribbon-vanish 1940ms ease-out both;
  }
  #sobre .hero-ornament-ribbon-piece {
    position: absolute;
    inset: 0;
    display: block;
    transform-origin: center;
    animation: about-ribbon-unwind 1800ms cubic-bezier(.22,.59,.26,1) both;
  }
  #sobre .hero-ornament-ribbon-piece img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 5px 7px rgba(100,19,60,.25));
  }
  #sobre .hero-ornament-ribbon-piece--left {
    --ribbon-x: -107px;
    --ribbon-y: -33px;
    --ribbon-angle: -65deg;
  }
  #sobre .hero-ornament-ribbon-piece--right {
    --ribbon-x: 112px;
    --ribbon-y: -24px;
    --ribbon-angle: 78deg;
  }
  #sobre .hero-ornament-ribbon-piece--knot {
    --ribbon-x: 5px;
    --ribbon-y: -142px;
    --ribbon-angle: 31deg;
  }
  #sobre .hero-ornament-ribbon-piece--left img { clip-path: inset(0 50% 0 0); }
  #sobre .hero-ornament-ribbon-piece--right img { clip-path: inset(0 0 0 50%); }
  #sobre .hero-ornament-ribbon-piece--knot img { clip-path: circle(27% at 50% 49%); }

  @keyframes about-ribbon-vanish {
    0% { opacity: 0; transform: translate(-50%,-50%) rotate(-4deg) scale(.86); }
    12%, 50% { opacity: 1; }
    100% { opacity: 0; transform: translate(-50%,calc(-50% - 22px)) rotate(7deg) scale(1.02); }
  }
  @keyframes about-ribbon-unwind {
    0%, 16% { transform: translate(0,0) rotate(0deg); }
    100% { transform: translate(var(--ribbon-x),var(--ribbon-y)) rotate(var(--ribbon-angle)); }
  }

  @media (prefers-reduced-motion: reduce) {
    #sobre .hero-ornament-particle,
    #sobre .hero-ornament-particle * {
      animation: none !important;
      display: none !important;
    }
  }
</style>

<script>
  // The underlays have pointer-events:none so copy, CV links and buttons win.
  // Hit-testing their rectangles allows a real hover without blocking any UI.
  const hero = document.querySelector<HTMLElement>('#sobre');
  const layer = hero?.querySelector<HTMLElement>('[data-hero-micro-effects]');

  if (hero && layer) {
    type Ornament = 'butterfly' | 'ribbon';
    const shorekeeper = hero.querySelector<HTMLElement>('.shorekeeper-underlay');
    const phrolova = hero.querySelector<HTMLElement>('.phrolova-underlay');
    const hoverCapable = window.matchMedia('(hover: hover) and (pointer: fine)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const spritePaths: Record<Ornament, string> = {
      butterfly: '/assets/shorekeeper-butterfly.webp',
      ribbon: '/assets/phrolova-baton-bow.webp',
    };
    let previous: Ornament | null = null;
    const active = new Set<Ornament>();

    const motionDisabled = () =>
      reducedMotion.matches ||
      document.documentElement.dataset.seriousMode === 'true' ||
      document.documentElement.dataset.legacyMode === 'true';
    const disabled = () => !hoverCapable.matches || motionDisabled();

    function inside(element: HTMLElement | null, x: number, y: number) {
      if (!element) return false;
      const r = element.getBoundingClientRect();
      // Exclude the outer empty margins of each transparent asset.
      const padX = r.width * .09;
      const padY = r.height * .09;
      return x >= r.left + padX && x <= r.right - padX
        && y >= r.top + padY && y <= r.bottom - padY;
    }

    function zoneAt(x: number, y: number): Ornament | null {
      if (inside(phrolova, x, y)) return 'ribbon';
      if (inside(shorekeeper, x, y)) return 'butterfly';
      return null;
    }

    function cutout(src: string, width: number, height: number) {
      const img = document.createElement('img');
      img.src = src;
      img.width = width;
      img.height = height;
      img.alt = '';
      img.draggable = false;
      return img;
    }

    function animate(ornament: Ornament) {
      const source = ornament === 'butterfly' ? shorekeeper : phrolova;
      if (!source || !layer || active.has(ornament)) return;
      active.add(ornament);
      const sourceRect = source.getBoundingClientRect();
      // .hero-micro-effects is positioned inside .hero-ornaments.
      // Use its rectangle instead of the entire #sobre section.
      const layerRect = layer.getBoundingClientRect();
      const x = sourceRect.left + sourceRect.width * (ornament === 'butterfly' ? .52 : .50) - layerRect.left;
      const y = sourceRect.top + sourceRect.height * (ornament === 'butterfly' ? .42 : .50) - layerRect.top;
      const particle = document.createElement('span');
      particle.className = 'hero-ornament-particle hero-ornament-particle--' + ornament;
      particle.style.setProperty('--ornament-x', x + 'px');
      particle.style.setProperty('--ornament-y', y + 'px');

      if (ornament === 'butterfly') {
        particle.appendChild(cutout(spritePaths.butterfly, 231, 143));
      } else {
        for (const name of ['left', 'right', 'knot']) {
          const piece = document.createElement('span');
          piece.className = 'hero-ornament-ribbon-piece hero-ornament-ribbon-piece--' + name;
          piece.appendChild(cutout(spritePaths.ribbon, 133, 125));
          particle.appendChild(piece);
        }
      }

      layer.appendChild(particle);
      const finish = () => {
        if (!particle.isConnected) return;
        particle.remove();
        active.delete(ornament);
      };
      particle.addEventListener('animationend', (event) => {
        if (event.target === particle) finish();
      });
      // Safety fallback if an animation is interrupted by browser lifecycle.
      window.setTimeout(finish, ornament === 'butterfly' ? 2700 : 2300);
    }

    hero.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse' || disabled()) {
        previous = null;
        return;
      }
      const next = zoneAt(event.clientX, event.clientY);
      if (next === previous) return;
      previous = next;
      if (next) animate(next);
    }, { passive: true });
    hero.addEventListener('pointerleave', () => { previous = null; });
    // On mobile require an intentional tap; swiping to scroll must not animate.
    let touchStart: { id: number; x: number; y: number; zone: Ornament } | null = null;
    hero.addEventListener('pointerdown', (event) => {
      touchStart = null;
      if (event.pointerType === 'mouse' || motionDisabled()) return;
      if ((event.target as Element).closest('a,button,input,select,textarea')) return;
      const zone = zoneAt(event.clientX, event.clientY);
      if (zone) touchStart = { id: event.pointerId, x: event.clientX, y: event.clientY, zone };
    }, { passive: true });
    hero.addEventListener('pointerup', (event) => {
      const start = touchStart;
      touchStart = null;
      if (!start || start.id !== event.pointerId || motionDisabled()) return;
      if (Math.hypot(event.clientX - start.x, event.clientY - start.y) > 12) return;
      if (zoneAt(event.clientX, event.clientY) === start.zone) animate(start.zone);
    }, { passive: true });
    hero.addEventListener('pointercancel', () => { touchStart = null; });
    const clear = () => { layer.replaceChildren(); active.clear(); previous = null; touchStart = null; };
    reducedMotion.addEventListener('change', clear);
    document.addEventListener('visibilitychange', () => { if (document.hidden) clear(); });
    // Confined to #sobre; no event handlers or CSS changes in the Music shelf.
  }
</script>
