---

<!--
  #sobre motion:
  - Shorekeeper keeps the approved flower/butterfly geometry and animates only
    the already-separated layers.
  - Phrolova uses the approved editable Crimson Baton SVG so its real petal,
    stamen, shaft and ornament groups can dissolve independently.
-->
<div class="phrolova-underlay" data-about-baton aria-hidden="true">
  <div
    class="about-baton-vector"
    set:html={crimsonBatonSvg}
  ></div>
</div>

<div class="shorekeeper-underlay" data-about-butterfly aria-hidden="true">
  <div class="about-shorekeeper-layers">
    <div class="about-shorekeeper-flower-reactor">
      <img
        class="about-shorekeeper-flower"
        src="/assets/about/shorekeeper-flower.webp"
        width="1477"
        height="1065"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="about-shorekeeper-butterfly-flight">
      <img
        class="about-shorekeeper-wing about-shorekeeper-wing--left"
        src="/assets/about/shorekeeper-butterfly.webp"
        width="1477"
        height="1065"
        alt=""
        loading="lazy"
        decoding="async"
      />

      <img
        class="about-shorekeeper-wing about-shorekeeper-wing--right"
        src="/assets/about/shorekeeper-butterfly.webp"
        width="1477"
        height="1065"
        alt=""
        loading="lazy"
        decoding="async"
      />

      <img
        class="about-shorekeeper-butterfly-body"
        src="/assets/about/shorekeeper-butterfly.webp"
        width="1477"
        height="1065"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const ornaments =
      document.querySelector(
        '#sobre .hero-ornaments',
      );

    if (!ornaments) return;

    const reducedMotion =
      window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      );

    const update = (visible = true) => {
      const enabled =
        visible &&
        !document.hidden &&
        !reducedMotion.matches &&
        document.documentElement.dataset
          .seriousMode !== 'true' &&
        document.documentElement.dataset
          .legacyMode !== 'true';

      ornaments.dataset.ornamentsVisible =
        String(enabled);
    };

    let visible = true;

    if ('IntersectionObserver' in window) {
      const observer =
        new IntersectionObserver(
          ([entry]) => {
            visible =
              Boolean(entry?.isIntersecting);
            update(visible);
          },
          {
            threshold: 0.12,
          },
        );

      observer.observe(ornaments);
    } else {
      update(true);
    }

    reducedMotion.addEventListener(
      'change',
      () => update(visible),
    );

    document.addEventListener(
      'visibilitychange',
      () => update(visible),
    );

    const modeObserver =
      new MutationObserver(
        () => update(visible),
      );

    modeObserver.observe(
      document.documentElement,
      {
        attributes: true,
        attributeFilter: [
          'data-serious-mode',
          'data-legacy-mode',
        ],
      },
    );
  })();
</script>

<style is:global>
  #sobre .hero-ornaments
  :is(
    .phrolova-underlay,
    .shorekeeper-underlay
  ) {
    pointer-events: none;
    transition: none !important;
  }

  /* --------------------------------------------------
     Shorekeeper
     -------------------------------------------------- */

  #sobre .about-shorekeeper-layers {
    position: relative;

    width: 100%;
    aspect-ratio: 1477 / 1065;

    overflow: visible;
  }

  #sobre
  :is(
    .about-shorekeeper-flower-reactor,
    .about-shorekeeper-butterfly-flight
  ) {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    transform-origin: 50% 50%;

    will-change:
      transform;
  }

  #sobre .about-shorekeeper-layers img {
    position: absolute;
    inset: 0;

    display: block;

    width: 100%;
    height: 100%;
    max-width: none;

    object-fit: contain;

    pointer-events: none;

    filter: none !important;
  }

  /*
    The butterfly remains exactly on the approved static coordinates until
    take-off. Its inner scale pulse is intentionally subtle: it reads as wing
    pressure without creating a second sprite or shrinking the butterfly into
    a residual particle.
  */
  #sobre
  .about-shorekeeper-butterfly-flight {
    animation:
      shorekeeper-butterfly-flight
      9.2s
      cubic-bezier(
        .42,
        .02,
        .2,
        1
      )
      infinite;

    transform-origin:
      42% 58%;

    perspective:
      520px;

    transform-style:
      preserve-3d;
  }

  #sobre
  .about-shorekeeper-wing {
    z-index: 1;

    transform-box:
      border-box;

    backface-visibility:
      visible;

    will-change:
      transform;
  }

  #sobre
  .about-shorekeeper-wing--left {
    clip-path:
      polygon(
        0 0,
        42.5% 0,
        42.5% 100%,
        0 100%
      );

    transform-origin:
      42.5% 54%;

    animation:
      shorekeeper-wing-left
      9.2s
      ease-in-out
      infinite;
  }

  #sobre
  .about-shorekeeper-wing--right {
    clip-path:
      polygon(
        42.5% 0,
        100% 0,
