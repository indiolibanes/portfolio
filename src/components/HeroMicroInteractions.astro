    height: auto;
    overflow: visible;
    filter: none !important;
  }
  #sobre .about-shorekeeper-layers {
    position: relative;
    width: 100%;
    aspect-ratio: 1477 / 1065;
  }
  #sobre .about-shorekeeper-layers img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
    pointer-events: none;
    transform: none !important;
    filter: none !important;
  }
  html[data-serious-mode='true'] #sobre .hero-ornaments,
  html[data-legacy-mode='true'] #sobre .hero-ornaments { display: none; }
</style>
