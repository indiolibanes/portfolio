<!-- Static #sobre artwork only: original Shorekeeper layers and editable Phrolova SVG. -->
<div class="phrolova-underlay" data-about-baton aria-hidden="true">
  <img class="about-baton-art" src="/assets/phrolova/crimson-baton.svg" width="448" height="448" alt="" decoding="async" />
</div>

<div class="shorekeeper-underlay" data-about-butterfly aria-hidden="true">
  <div class="about-shorekeeper-layers">
    <img class="about-shorekeeper-flower" src="/assets/about/shorekeeper-flower.webp" width="1477" height="1065" alt="" decoding="async" />
    <img class="about-shorekeeper-wings" src="/assets/about/shorekeeper-butterfly.webp" width="1477" height="1065" alt="" decoding="async" />
  </div>
</div>

<style is:global>
  #sobre .hero-ornaments :is(.phrolova-underlay,.shorekeeper-underlay) {
    pointer-events: none;
    transition: none !important;
  }
  #sobre .hero-ornaments .about-baton-art {
    display: block;
