---
// Menu do modo-experimental (protótipo, fora do site público).
// Botão orbitado por “CONHEÇA ●”, gaveta de vidro em tabela periódica e contatos.
// Estilos: src/styles/experimental.css · comportamento: public/scripts/experimental-menu.js
import { PROFILE } from '../config';
import { spell, isElement, LOOSE_GLOW } from '../periodic-table';

const NAV = [
  { href: '/#sobre', label: 'Sobre' },
  { href: '/#lab', label: 'Laboratório' },
  { href: '/#percurso', label: 'Percurso' },
  { href: '/#metodo', label: 'Método' },
  { href: '/#bastidores', label: 'Bastidores' },
  { href: '/#musica', label: 'Música' },
  { href: '/curiosidades/', label: 'Curiosidades' },
  { href: '/#contato', label: 'Contato' },
].map((item) => ({ ...item, segs: spell(item.label) }));

// Órbita elíptica em volta do botão (pílula de 92 × 44 px). O texto corre pelo caminho:
// a volta completa leva --xm-orbit-period (10 s), e a duração abaixo precisa casar com ela.
const RX = 58;
const RY = 28;
const h = ((RX - RY) / (RX + RY)) ** 2;
const ORBIT_LENGTH = Math.round(Math.PI * (RX + RY) * (1 + (3 * h) / (10 + Math.sqrt(4 - 3 * h))) * 10) / 10;
const ORBIT_PATH = `M 0 ${-RY} A ${RX} ${RY} 0 1 1 0 ${RY} A ${RX} ${RY} 0 1 1 0 ${-RY} Z`;
const ORBIT_REPEATS = [0, 1, 2];
---

<header class="xm-header" data-xm>
  <div class="xm-wrap">
    <nav class="xm-bar" aria-label="Navegação principal (modo experimental)">
      <a class="xm-brand" href="/#top" aria-label={`${PROFILE.name}, início`}>
        <span class="xm-brand__mark" aria-hidden="true"><img src="/brand/avatar-poster.jpg" alt="" width="44" height="44" decoding="async" /></span>
        <span class="xm-brand__copy">
          <strong>{PROFILE.name}</strong>
          <small>{PROFILE.tagline}</small>
        </span>
      </a>

      <div class="xm-menu">
        <button class="xm-toggle" type="button" aria-expanded="false" aria-controls="xm-drawer" data-xm-toggle>
          <svg class="xm-orbit" viewBox="-80 -44 160 88" width="160" height="88" aria-hidden="true" focusable="false" data-xm-orbit>
            <defs>
              <path id="xm-orbit-path" d={ORBIT_PATH}></path>
              <linearGradient id="xm-orbit-grad" gradientUnits="userSpaceOnUse" x1="-66" y1="0" x2="66" y2="0">
                <stop offset="0" stop-color="#d8326f"></stop>
                <stop offset="0.25" stop-color="#c98a00"></stop>
                <stop offset="0.5" stop-color="#1d83c4"></stop>
                <stop offset="0.75" stop-color="#7550d8"></stop>
                <stop offset="1" stop-color="#1f9d62"></stop>
                <animateTransform attributeName="gradientTransform" type="rotate" from="0 0 0" to="360 0 0" dur="7s" repeatCount="indefinite"></animateTransform>
              </linearGradient>
            </defs>
            <ellipse class="xm-orbit__hit" cx="0" cy="0" rx="68" ry="38"></ellipse>
            <g class="xm-orbit__text" fill="url(#xm-orbit-grad)">
              <text>
                <textPath href="#xm-orbit-path" startOffset="0" textLength={ORBIT_LENGTH} lengthAdjust="spacing">
                  <animate attributeName="startOffset" from="0" to={ORBIT_LENGTH} dur="10s" repeatCount="indefinite"></animate>
                  {ORBIT_REPEATS.map(() => <Fragment>CONHEÇA&nbsp;<tspan class="xm-orbit__dot">●</tspan>&nbsp;</Fragment>)}
                </textPath>
              </text>
              <text>
                <textPath href="#xm-orbit-path" startOffset={-ORBIT_LENGTH} textLength={ORBIT_LENGTH} lengthAdjust="spacing">
                  <animate attributeName="startOffset" from={-ORBIT_LENGTH} to="0" dur="10s" repeatCount="indefinite"></animate>
                  {ORBIT_REPEATS.map(() => <Fragment>CONHEÇA&nbsp;<tspan class="xm-orbit__dot">●</tspan>&nbsp;</Fragment>)}
                </textPath>
              </text>
            </g>
          </svg>

          <span class="xm-core">
            <span class="xm-globe" aria-hidden="true"></span>
            <svg class="xm-plasma" data-xm-plasma viewBox="0 0 80 44" preserveAspectRatio="none" aria-hidden="true" focusable="false">
              <defs>
                <radialGradient id="xm-plasma-a"><stop offset="0" stop-color="#ff6fa8"></stop><stop offset="0.55" stop-color="#ff6fa8" stop-opacity="0.7"></stop><stop offset="1" stop-color="#ff6fa8" stop-opacity="0"></stop></radialGradient>
                <radialGradient id="xm-plasma-b"><stop offset="0" stop-color="#ffd15a"></stop><stop offset="0.55" stop-color="#ffd15a" stop-opacity="0.7"></stop><stop offset="1" stop-color="#ffd15a" stop-opacity="0"></stop></radialGradient>
                <radialGradient id="xm-plasma-c"><stop offset="0" stop-color="#5cc3ff"></stop><stop offset="0.55" stop-color="#5cc3ff" stop-opacity="0.7"></stop><stop offset="1" stop-color="#5cc3ff" stop-opacity="0"></stop></radialGradient>
                <radialGradient id="xm-plasma-d"><stop offset="0" stop-color="#a98bff"></stop><stop offset="0.55" stop-color="#a98bff" stop-opacity="0.7"></stop><stop offset="1" stop-color="#a98bff" stop-opacity="0"></stop></radialGradient>
                <radialGradient id="xm-plasma-e"><stop offset="0" stop-color="#7be3a0"></stop><stop offset="0.55" stop-color="#7be3a0" stop-opacity="0.7"></stop><stop offset="1" stop-color="#7be3a0" stop-opacity="0"></stop></radialGradient>
              </defs>
              <g>
                <circle cx="16" cy="12" r="17" fill="url(#xm-plasma-a)"></circle>
                <circle cx="40" cy="30" r="18" fill="url(#xm-plasma-b)"></circle>
                <circle cx="64" cy="14" r="17" fill="url(#xm-plasma-c)"></circle>
                <circle cx="26" cy="34" r="16" fill="url(#xm-plasma-d)"></circle>
                <circle cx="54" cy="22" r="15" fill="url(#xm-plasma-e)"></circle>
                <circle cx="40" cy="10" r="14" fill="url(#xm-plasma-a)"></circle>
              </g>
            </svg>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
              <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M4 7h16M4 12h16M4 17h10"></path>
            </svg>
            <span class="xm-label">Menu</span>
          </span>
        </button>
      </div>
    </nav>

    <div class="xm-drawer" id="xm-drawer" data-xm-drawer data-state="closed">
      <div class="xm-glass">
        <ul class="xm-list">
          {NAV.map((item) => (
            <li>
              <a class="xm-link" href={item.href}>
                <span class="xm-sr">{item.label}</span>
                <span class="xm-elements" aria-hidden="true">
                  {item.segs.map((seg) => isElement(seg)
                    ? <span class="xm-el" data-cat={seg.cat} style={`--glow:${seg.glow}`}><i>{seg.z}</i><b>{seg.sym}</b><u>{seg.name}</u></span>
                    : <span class="xm-ch" style={`--glow:${LOOSE_GLOW}`}>{seg.ch}</span>)}
                </span>
              </a>
            </li>
          ))}
        </ul>

        <div class="xm-social" role="group" aria-label="Contato e redes">
          <a class="xm-social__link" href={PROFILE.linkedin} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065ZM7.119 20.452H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003Z"></path></svg>
            <span>LinkedIn</span><span class="xm-sr"> (abre em nova aba)</span>
          </a>
          {PROFILE.whatsapp && (
            <a class="xm-social__link" href={PROFILE.whatsapp} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.198.297-.767.966-.94 1.164-.173.198-.347.223-.644.074-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.372-.025-.521-.075-.149-.669-1.612-.916-2.207-.242-.58-.487-.501-.669-.51-.173-.009-.372-.011-.57-.011-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.693.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.045 21.35h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.981.998-3.648-.235-.374A9.86 9.86 0 0 1 2.152 11.45c.002-5.447 4.435-9.88 9.892-9.88a9.82 9.82 0 0 1 6.988 2.895A9.82 9.82 0 0 1 21.92 11.45c-.002 5.447-4.435 9.9-9.875 9.9m8.413-18.297A11.82 11.82 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.89a11.84 11.84 0 0 0 1.588 5.93L.057 24l6.329-1.66a11.9 11.9 0 0 0 5.658 1.44h.005c6.554 0 11.89-5.335 11.893-11.89a11.82 11.82 0 0 0-3.484-8.837Z"></path></svg>
              <span>WhatsApp</span><span class="xm-sr"> (abre em nova aba)</span>
            </a>
          )}
          {PROFILE.email && (
            <a class="xm-social__link" href={`mailto:${PROFILE.email}`}>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M3.5 6.5h17v11h-17zM3.8 7l8.2 6.2L20.2 7"></path></svg>
              <span>E-mail</span>
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</header>

<script is:inline src="/scripts/experimental-menu.js" defer></script>
