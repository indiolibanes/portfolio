---
// Menu do modo-experimental (protótipo, fora do site público).
// Botão circular (três linhas, padrão Material You) com “CONHEÇA ●” girando em órbita circular
// em volta dele; ao abrir, a gaveta de vidro aparece e a legenda “MENU” surge à esquerda do botão.
// Estilos: src/styles/experimental.css · comportamento: public/scripts/experimental-menu.js
import { PROFILE, SOCIALS } from '../config';

interface Props { variant?: 'authorial' | 'immersive' }
const { variant = 'immersive' } = Astro.props;
const immersive = variant === 'immersive';
const drawerId = immersive ? 'xm-drawer-immersive' : 'xm-drawer-authorial';
const orbitPathId = immersive ? 'xm-orbit-immersive' : 'xm-orbit-authorial';
import { spell, isElement, LOOSE_GLOW } from '../periodic-table';

// Copy the exact Greek glyph outlines from the existing α, β, γ reading-mode emblems.
// Ω is deliberately omitted here: the user is already in the immersive mode.
const MODE_CHOICES = [
  {
    "id": "authorial",
    "name": "Autoral",
    "href": "/",
    "glyph": "M44 37.21C43.74 40.33 41.83 42.81 39.88 42.81C37.6 42.81 36.44 41.59 36.49 39.22C35.33 40.54 34.27 41.44 33.27 41.91C32.05 42.49 30.57 42.81 28.83 42.81C26.24 42.76 24.18 42.02 22.59 40.54C20.85 38.9 20 36.52 20 33.4C20 32.82 20.05 32.19 20.11 31.55C20.42 28.54 21.64 26.05 23.75 24.1C25.81 22.14 28.19 21.19 30.89 21.19C31.58 21.19 32.32 21.24 33 21.4C35.81 22.04 37.18 24.41 37.07 28.59L38.29 21.56H42.52L37.55 37.68C37.5 39.22 38.5 40.43 39.93 40.43C41.36 40.43 42.47 39.37 43.31 37.21C43.58 37.15 43.84 37.15 44 37.21ZM36.07 30.07C36.18 28.8 36.07 27.59 35.81 26.48C35.28 24.41 34.22 23.2 32.58 22.88C32.26 22.83 31.95 22.83 31.58 22.83C29.94 22.83 28.51 23.46 27.3 24.73C25.92 26.21 25.02 28.43 24.55 31.39C24.33 32.61 24.23 33.72 24.23 34.72C24.23 39.06 25.81 41.28 28.93 41.44C31.21 41.54 32.95 40.48 34.17 38.21C35.17 36.47 35.81 33.72 36.07 30.07Z"
  },
  {
    "id": "editorial",
    "name": "Editorial",
    "href": "/?mode=editorial",
    "glyph": "M39.19 23.38C39.22 24.79 38.7 25.97 37.62 26.99C36.6 27.96 35.47 28.43 34.23 28.43C34.87 28.51 35.61 28.95 36.49 29.78C37.68 30.91 38.26 32.2 38.26 33.69C38.26 34.21 38.17 34.77 38.03 35.34C37.62 36.75 36.77 37.74 35.47 38.35C34.56 38.79 33.49 39.01 32.3 39.01C31.94 39.01 31.61 38.98 31.37 38.95C30.18 38.76 29.08 38.1 28.06 36.91C26.87 42.29 26.27 44.96 26.24 44.93C26.24 45.02 25.77 45.02 24.81 44.96C24.81 45.02 25.08 43.83 25.66 41.41C26.3 38.73 26.79 36.53 27.15 34.85L29.33 24.38C30.07 20.85 31.7 19.06 34.23 19C35.25 18.97 36.19 19.2 37.07 19.66C38.45 20.41 39.16 21.65 39.19 23.38ZM37.1 23.55C37.13 23.38 37.13 23.22 37.13 23.05C37.13 21.98 36.77 21.18 36.05 20.66C35.53 20.27 34.89 20.08 34.12 20.08C33.24 20.08 32.47 20.6 31.83 21.62C31.34 22.39 30.95 23.36 30.7 24.51C30.4 25.75 29.63 29.36 28.36 35.37C29.05 36.69 30.37 37.77 31.48 37.85C32.33 37.93 33.1 37.77 33.82 37.41C34.78 36.89 35.44 36.03 35.83 34.85C36.02 34.27 36.11 33.66 36.11 33.06C36.11 31.18 35.09 29.53 33.46 28.87C32.94 29.12 32.39 29.25 31.86 29.25C30.95 29.25 30.51 28.92 30.54 28.29C30.57 27.74 30.98 27.46 31.78 27.46C32.5 27.46 33.07 27.66 33.54 28.01C34.78 27.6 35.66 26.99 36.22 26.25C36.68 25.59 36.99 24.68 37.1 23.55Z"
  },
  {
    "id": "legacy",
    "name": "Legacy · 1998",
    "href": "/?mode=legacy",
    "glyph": "M37.54 28.47C35.4 31.66 33.66 33.97 32.24 35.38C32.24 37.16 31.8 39.14 30.95 41.28C30.02 43.75 28.97 45 27.88 45C27.03 45 26.62 44.51 26.62 43.5C26.62 42.37 27.15 40.84 28.2 38.86C29.13 37.12 30.02 35.82 30.87 34.98C30.99 33.68 30.67 31.58 29.94 28.67C29.53 26.93 28.93 25.4 28.16 24.06C27.31 22.61 26.54 21.88 25.78 21.92C24.6 22.04 23.71 22.85 23.19 24.35H22.66C22.62 24.06 22.62 23.82 22.62 23.54C22.62 20.67 23.59 19.17 25.57 19.01C27.96 18.81 29.86 21.84 31.27 28.18C31.92 31.14 32.24 32.91 32.24 33.52C35.27 29.8 37.21 26.16 37.98 22.57C38.31 21.11 38.47 20.3 38.51 20.18C38.79 19.41 39.28 19.05 39.96 19.05C40.89 19.05 41.38 19.45 41.38 20.3C41.38 21.88 40.08 24.63 37.54 28.47Z"
  }
];

const NAV = [
  { href: '/#sobre', label: 'Sobre' },
  { href: '/#lab', label: 'Laboratório' },
  { href: '/#percurso', label: 'Percurso' },
  { href: '/#metodo', label: 'Método' },
  { href: '/#bastidores', label: 'Bastidores' },
  { href: '/#musica', label: 'Música' },
  { href: '/curiosidades/', label: 'Curiosidades' },
  { href: '/#contato', label: 'Contato' },
].map((item) => ({ ...item, segs: spell(item.label) }));

// Órbita circular, raio 40 em torno do centro do botão (56 px). Uma volta = --xm-orbit-period (10 s),
// e o texto ocupa a circunferência inteira (251,3), então a volta é contínua e simétrica.
const R = 40;
const CIRCUMFERENCE = Math.round(2 * Math.PI * R * 10) / 10;
const ORBIT_PATH = `M 0 ${-R} A ${R} ${R} 0 1 1 0 ${R} A ${R} ${R} 0 1 1 0 ${-R} Z`;
---

<header class:list={["xm-header", `xm-header--${variant}`]} data-xm>
  <div class="xm-menu">
    <button class="xm-toggle" type="button" aria-expanded="false" aria-controls={drawerId} data-xm-toggle>
      <svg class="xm-orbit" viewBox="-60 -60 120 120" width="120" height="120" aria-hidden="true" focusable="false" data-xm-orbit>
        <defs>
          <path id={orbitPathId} d={ORBIT_PATH}></path>
          <linearGradient id="xm-orbit-grad" gradientUnits="userSpaceOnUse" x1="-60" y1="0" x2="60" y2="0">
            <stop offset="0" stop-color="#d8326f"></stop>
            <stop offset="0.25" stop-color="#c98a00"></stop>
            <stop offset="0.5" stop-color="#1d83c4"></stop>
            <stop offset="0.75" stop-color="#7550d8"></stop>
            <stop offset="1" stop-color="#1f9d62"></stop>
          </linearGradient>
        </defs>
        <circle class="xm-orbit__hit" cx="0" cy="0" r="54"></circle>
        <g class="xm-orbit__spin" fill="url(#xm-orbit-grad)">
          <animateTransform attributeName="transform" type="rotate" from="0" to="360" dur="10s" repeatCount="indefinite"></animateTransform>
          <text class="xm-orbit__text">
            <textPath href={`#${orbitPathId}`} textLength={CIRCUMFERENCE} lengthAdjust="spacing">CONHEÇA&nbsp;<tspan class="xm-orbit__dot">●</tspan>&nbsp;CONHEÇA&nbsp;<tspan class="xm-orbit__dot">●</tspan>&nbsp;CONHEÇA&nbsp;<tspan class="xm-orbit__dot">●</tspan>&nbsp;</textPath>
          </text>
        </g>
      </svg>

      <span class="xm-core">
        <span class="xm-globe" aria-hidden="true"></span>
        <svg class="xm-plasma" data-xm-plasma viewBox="0 0 80 44" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <defs>
            <radialGradient id="xm-plasma-a"><stop offset="0" stop-color="#ff6fa8"></stop><stop offset="0.55" stop-color="#ff6fa8" stop-opacity="0.7"></stop><stop offset="1" stop-color="#ff6fa8" stop-opacity="0"></stop></radialGradient>
            <radialGradient id="xm-plasma-b"><stop offset="0" stop-color="#ffd15a"></stop><stop offset="0.55" stop-color="#ffd15a" stop-opacity="0.7"></stop><stop offset="1" stop-color="#ffd15a" stop-opacity="0"></stop></radialGradient>
            <radialGradient id="xm-plasma-c"><stop offset="0" stop-color="#5cc3ff"></stop><stop offset="0.55" stop-color="#5cc3ff" stop-opacity="0.7"></stop><stop offset="1" stop-color="#5cc3ff" stop-opacity="0"></stop></radialGradient>
            <radialGradient id="xm-plasma-d"><stop offset="0" stop-color="#a98bff"></stop><stop offset="0.55" stop-color="#a98bff" stop-opacity="0.7"></stop><stop offset="1" stop-color="#a98bff" stop-opacity="0"></stop></radialGradient>
            <radialGradient id="xm-plasma-e"><stop offset="0" stop-color="#7be3a0"></stop><stop offset="0.55" stop-color="#7be3a0" stop-opacity="0.7"></stop><stop offset="1" stop-color="#7be3a0" stop-opacity="0"></stop></radialGradient>
          </defs>
          <g>
            <circle cx="16" cy="12" r="17" fill="url(#xm-plasma-a)"></circle>
            <circle cx="40" cy="30" r="18" fill="url(#xm-plasma-b)"></circle>
            <circle cx="64" cy="14" r="17" fill="url(#xm-plasma-c)"></circle>
            <circle cx="26" cy="34" r="16" fill="url(#xm-plasma-d)"></circle>
            <circle cx="54" cy="22" r="15" fill="url(#xm-plasma-e)"></circle>
            <circle cx="40" cy="10" r="14" fill="url(#xm-plasma-a)"></circle>
          </g>
        </svg>
        <svg class="xm-icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"></path>
        </svg>
      </span>

      <span class="xm-label">Menu</span>
    </button>

    <div class="xm-drawer" id={drawerId} data-xm-drawer data-state="closed">
      <div class="xm-glass">
        {immersive ? (
          <nav class="xm-mode-nav" aria-label="Outros modos de leitura">
            {MODE_CHOICES.map((choice) => (
              <a class="xm-mode-choice" href={choice.href} aria-label={`Abrir modo ${choice.name}`} title={choice.name} data-xm-mode={choice.id}>
                <svg class="xm-mode-art" viewBox="0 0 64 64" width="64" height="64" aria-hidden="true" focusable="false">
                  <defs>
                    <linearGradient id={`xm-gold-${choice.id}`} x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0" stop-color="#fff3c4" />
                      <stop offset="0.5" stop-color="#f2c15a" />
                      <stop offset="1" stop-color="#d08b1f" />
                    </linearGradient>
                  </defs>
                  <circle cx="32" cy="32" r="25.5" fill="#24180f" stroke="#b68d49" stroke-width="1.5" />
                  <path d={choice.glyph} fill={`url(#xm-gold-${choice.id})`} stroke={`url(#xm-gold-${choice.id})`} stroke-width=".8" stroke-linejoin="round" />
                </svg>
              </a>
            ))}
          </nav>
        ) : (
          <ul class="xm-list">
          {NAV.map((item) => (
            <li>
              <a class="xm-link" href={item.href}>
                <span class="xm-sr">{item.label}</span>
                <span class="xm-elements" aria-hidden="true">
                  {item.segs.map((seg) => isElement(seg)
                    ? <span class="xm-el" data-cat={seg.cat} style={`--glow:${seg.glow}`}><i>{seg.z}</i><b>{seg.sym}</b><u>{seg.name}</u></span>
                    : <span class="xm-ch" style={`--glow:${LOOSE_GLOW}`}>{seg.ch}</span>)}
                </span>
              </a>
            </li>
          ))}
          </ul>

        )}

        <div class="xm-social" role="group" aria-label="Contato e redes">
          <a class="xm-social__link" href={SOCIALS.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub (abre em nova aba)" title="GitHub">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 .7A11.3 11.3 0 0 0 8.43 22.7c.56.1.77-.24.77-.54v-2.1c-3.12.68-3.79-1.33-3.79-1.33-.51-1.3-1.24-1.65-1.24-1.65-1.02-.7.08-.68.08-.68 1.13.08 1.72 1.16 1.72 1.16 1 .1.77 2.07 3.25 1.48.1-.72.4-1.21.72-1.49-2.49-.28-5.1-1.25-5.1-5.57 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .94-.3 3.1 1.15a10.8 10.8 0 0 1 5.64 0c2.16-1.46 3.1-1.15 3.1-1.15.61 1.55.23 2.7.11 2.98.73.79 1.16 1.8 1.16 3.02 0 4.33-2.62 5.28-5.12 5.56.42.36.79 1.07.79 2.16v3.2c0 .31.2.65.78.54A11.3 11.3 0 0 0 12 .7Z" /></svg>
          </a>
          <a class="xm-social__link" href={SOCIALS.lastfm} target="_blank" rel="noopener noreferrer" aria-label="Last.fm (abre em nova aba)" title="Last.fm">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M10.1 17.45c-3.2 0-4.5-.76-5.6-3.14l-.6-1.3c-.4-.9-.8-1.3-1.7-1.3H1v-2.6h1.2c2 0 3.2 1.1 4 2.9l.7 1.6c.5 1.1 1.1 1.4 3.2 1.4 1.3 0 2.6-.3 3.6-.8l.9 2.4a11.3 11.3 0 0 1-4.5.85Zm8.4-.05c-2.9 0-4.5-1.1-5-3.4l2.8-.5c.3.9 1 1.3 2.3 1.3 1.1 0 1.8-.4 1.8-1.1 0-.7-.5-.9-2-1.3-2.7-.7-4-1.7-4-3.7 0-2.4 2-4 5-4 2.6 0 4.4 1.1 5 3.4l-2.7.6c-.3-1-1-1.5-2.3-1.5-1.1 0-1.8.5-1.8 1.2 0 .6.5.9 2.2 1.3 2.5.7 3.7 1.8 3.7 3.7 0 2.5-2 3.9-5 3.9Z" /></svg>
          </a>
          <a class="xm-social__link" href={PROFILE.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (abre em nova aba)" title="LinkedIn">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065ZM7.119 20.452H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003Z"></path></svg>
          </a>
          {PROFILE.whatsapp && (
            <a class="xm-social__link" href={PROFILE.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp (abre em nova aba)" title="WhatsApp">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.198.297-.767.966-.94 1.164-.173.198-.347.223-.644.074-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.372-.025-.521-.075-.149-.669-1.612-.916-2.207-.242-.58-.487-.501-.669-.51-.173-.009-.372-.011-.57-.011-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.693.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.045 21.35h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.981.998-3.648-.235-.374A9.86 9.86 0 0 1 2.152 11.45c.002-5.447 4.435-9.88 9.892-9.88a9.82 9.82 0 0 1 6.988 2.895A9.82 9.82 0 0 1 21.92 11.45c-.002 5.447-4.435 9.9-9.875 9.9m8.413-18.297A11.82 11.82 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.89a11.84 11.84 0 0 0 1.588 5.93L.057 24l6.329-1.66a11.9 11.9 0 0 0 5.658 1.44h.005c6.554 0 11.89-5.335 11.893-11.89a11.82 11.82 0 0 0-3.484-8.837Z"></path></svg>
            </a>
          )}
          {PROFILE.email && (
            <a class="xm-social__link" href={`mailto:${PROFILE.email}`} aria-label="E-mail" title="E-mail">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M3.5 6.5h17v11h-17zM3.8 7l8.2 6.2L20.2 7"></path></svg>
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</header>

<script is:inline src="/scripts/experimental-menu.js" defer></script>
